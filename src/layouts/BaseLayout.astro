---
import { ClientRouter } from 'astro:transitions';
import { ui, languages } from '../data/i18n.js';
import { socialLinks } from '../data/social-links.js';
import { organizationDescription, organizationSlogan, founders } from '../data/positioning.js';
import '../styles/global.css';

const {
  title = 'callidus A&M',
  description = 'Ganzheitliche Gesundheit, fundiertes Wissen und praktische Impulse für Körper, Geist und Seele.',
  lang = 'de',
  alternatePath,
  ogImage,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  // Zusätzliches strukturiertes Markup, z. B. FAQPage. Einzelnes Objekt oder Array.
  jsonLd,
} = Astro.props;

const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const t = ui[lang] || ui.de;
const labels = lang === 'en'
  ? {
      knowledge: 'Knowledge',
      health: 'Health',
      healthKnowledge: 'Health knowledge',
      menuOpen: 'Open menu',
      walletOpen: 'Open Valus Wallet',
      toggleTheme: 'Toggle dark mode',
      socialOpen: (label) => `Open ${label}`,
      cookieLabel: 'Cookie notice',
      cookieTitle: 'Cookies & external content',
      cookieTextBefore: 'This website is tracking-free by default. Data is transferred to third-party providers only when you load embedded YouTube videos, the newsletter form, or actively use the chatbot.',
      cookieTextMore: 'More information is available in our',
      cookieAnalytics: 'By accepting, you also consent to aggregated website usage measurement with Google Analytics and to conversion tracking with Google Ads. Both are loaded only after your consent, and you can withdraw it at any time via "Cookie settings" in the footer.',
      cookiePrivacy: 'privacy policy',
      cookieDecline: 'Necessary only',
      cookieAccept: 'Accept',
      backToTop: 'Back to top',
      trustpilotLocale: 'en-US',
    }
  : {
      knowledge: 'Wissen',
      health: 'Gesundheit',
      healthKnowledge: 'Gesundheits-Wissen',
      menuOpen: 'Menü öffnen',
      walletOpen: 'Valus Wallet öffnen',
      toggleTheme: 'Darkmode umschalten',
      socialOpen: (label) => `${label} öffnen`,
      cookieLabel: 'Cookie-Hinweis',
      cookieTitle: 'Cookies & externe Inhalte',
      cookieTextBefore: 'Diese Webseite ist standardmäßig tracking-frei. Erst wenn du eingebettete YouTube-Videos, das Newsletter-Formular oder den Chatbot aktiv nutzt, werden Daten an Drittanbieter übertragen.',
      cookieTextMore: 'Mehr Infos in unserer',
      cookieAnalytics: 'Mit "Akzeptieren" stimmst du zusätzlich der aggregierten Nutzungsanalyse mit Google Analytics und dem Conversion-Tracking von Google Ads zu. Beides wird erst nach deiner Zustimmung geladen; du kannst sie jederzeit über "Cookie-Einstellungen" im Fußbereich widerrufen.',
      cookiePrivacy: 'Datenschutzerklärung',
      cookieDecline: 'Nur Notwendige',
      cookieAccept: 'Akzeptieren',
      backToTop: 'Nach oben',
      trustpilotLocale: 'de-DE',
    };
const currentPath = Astro.url.pathname;
const siteOrigin = 'https://www.callidus-am.de';
const fbConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
const canonicalUrl = new URL(currentPath, siteOrigin).href;
const switchPath = alternatePath || (lang === 'de' ? '/en/' : '/');
const switchLang = lang === 'de' ? 'en' : 'de';
const logoPath = '/assets/original/001-wp-content-uploads-go-x-u-bdfcc883-6576-4ab2-951d-c90c6ccf47d3-image-911x911.png';
// Social-Sharing-Bild: 1200x630 callidus A&M Logo mit goldenem Verlauf
const socialImage = ogImage || '/og-image.png';
const absoluteSocialImage = new URL(socialImage, siteOrigin).href;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'callidus A&M',
  url: siteOrigin,
  logo: new URL('/favicon.png', siteOrigin).href,
  email: 'info@callidus-am.de',
  description: organizationDescription,
  slogan: organizationSlogan,
  founder: founders.map((name) => ({ '@type': 'Person', name })),
  knowsAbout: [
    'Ganzheitliche Gesundheit',
    'Ernährung und Mikronährstoffe',
    'Stressbewältigung und Schlaf',
    'Bewegung und Regeneration',
    'Digitale Gesundheitsbegleitung',
  ],
  sameAs: [
    'https://www.instagram.com/callidusam/',
    'https://www.youtube.com/@callidus-am',
    'https://www.tiktok.com/@callidusam',
    'https://www.facebook.com/profile.php?id=61580058447671',
  ],
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'callidus A&M',
  url: siteOrigin,
  inLanguage: lang === 'en' ? 'en-US' : 'de-DE',
  description,
};
// Die Kopfzeile führt bewusst nur zu den vier wichtigsten Wegen. Alles andere
// bleibt erreichbar, konkurriert aber nicht mehr mit dem Kernangebot.
const navPrimary = [
  { href: t.paths.compass ?? '/gesundheits-kompass/', label: t.nav.compass ?? 'Kompass' },
  { href: t.paths.course, label: t.nav.course ?? 'Stress Reset' },
];
const navGroups = [
  {
    label: labels.knowledge,
    items: [
      { href: t.paths.guide, label: t.nav.guide },
      { href: '/wissenskarten/', label: labels.healthKnowledge },
      { href: t.paths.lexicon, label: t.nav.lexicon },
    ],
  },
  {
    label: lang === 'en' ? 'About Callidus' : 'Über Callidus',
    items: [
      { href: t.paths.about, label: t.nav.about },
      { href: t.paths.apps, label: t.nav.apps },
      { href: t.paths.methodology ?? '/quellen-methodik/', label: t.nav.methodology ?? 'Quellen' },
      { href: t.paths.faq ?? '/faq/', label: t.nav.faq ?? 'FAQ' },
    ],
  },
];
const footerLabels = lang === 'en'
  ? { explore: 'Explore', more: 'More from callidus', company: 'Company', lab: 'Callidus Lab', legal: 'Legal' }
  : { explore: 'Entdecken', more: 'Mehr von callidus', company: 'Unternehmen', lab: 'Callidus Lab', legal: 'Rechtliches' };
const footerGroups = [
  {
    label: footerLabels.explore,
    items: [
      { href: t.paths.compass ?? '/gesundheits-kompass/', label: t.nav.compass ?? 'Kompass' },
      { href: t.paths.course, label: t.nav.course ?? 'Stress Reset' },
      { href: t.paths.guide, label: t.nav.guide },
      { href: '/audio/', label: t.footerExtras?.audio ?? 'Audio-Raum' },
    ],
  },
  {
    label: footerLabels.more,
    items: [
      { href: t.paths.recommendations, label: t.nav.recommendations },
      { href: '/unsere-produkte/', label: lang === 'en' ? 'Our products' : 'Unsere Produkte' },
      { href: t.paths.apps, label: t.nav.apps },
      { href: '/kinderbuch/', label: t.footerExtras?.kinderbuch ?? 'Kinderbuch' },
    ],
  },
  {
    label: footerLabels.company,
    items: [
      { href: t.paths.about, label: t.nav.about },
      { href: t.paths.methodology ?? '/quellen-methodik/', label: t.nav.methodology ?? 'Quellen' },
      { href: t.paths.faq ?? '/faq/', label: t.nav.faq ?? 'FAQ' },
      { href: t.paths.portal, label: t.nav.portal },
    ],
  },
  {
    label: footerLabels.lab,
    items: [
      { href: t.paths.wallet ?? '/wallet/', label: t.nav.wallet ?? 'Wallet' },
      { href: t.paths.valus ?? '/valus/', label: t.nav.valus ?? 'Valus' },
      { href: '/krypto-verstehen/', label: t.footerExtras?.krypto ?? 'Krypto verstehen' },
      { href: '/krypto-hinweis/', label: t.footerExtras?.kryptoHinweis ?? 'Krypto-Hinweis' },
      { href: '/valus-litepaper.html', label: t.footerExtras?.litepaper ?? 'Litepaper' },
    ],
  },
  {
    label: footerLabels.legal,
    items: [
      { href: t.paths.legal, label: t.legal.imprint },
      { href: t.paths.privacy, label: t.legal.privacy },
      { href: t.paths.terms, label: t.legal.terms },
      { href: '/agb/', label: lang === 'en' ? 'Terms of sale' : 'AGB' },
      { href: '/widerruf/', label: lang === 'en' ? 'Right of withdrawal' : 'Widerruf' },
      { action: 'cookie', label: lang === 'en' ? 'Cookie settings' : 'Cookie-Einstellungen' },
    ],
  },
];
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
const socialIcons = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle>',
  youtube: '<path d="M22 12s0-3.4-.44-5.02a2.8 2.8 0 0 0-1.98-1.98C17.86 4.55 12 4.55 12 4.55s-5.86 0-7.58.45a2.8 2.8 0 0 0-1.98 1.98C2 8.6 2 12 2 12s0 3.4.44 5.02a2.8 2.8 0 0 0 1.98 1.98c1.72.45 7.58.45 7.58.45s5.86 0 7.58-.45a2.8 2.8 0 0 0 1.98-1.98C22 15.4 22 12 22 12Z"></path><path d="m10 15 5.2-3L10 9v6Z"></path>',
  tiktok: '<path d="M15 3c.35 2.6 1.8 4.3 4.4 4.7v3.4a7.7 7.7 0 0 1-4.3-1.3v5.6a5.6 5.6 0 1 1-5.6-5.6c.38 0 .74.04 1.1.12v3.55a2.2 2.2 0 1 0 1.55 2.1V3h2.85Z"></path>',
  facebook: '<path d="M14 8.5h2.5V5h-2.9C10.4 5 9 6.9 9 9.7V12H6.5v3.6H9V22h4v-6.4h3l.6-3.6H13V9.9c0-.95.32-1.4 1-1.4Z"></path>',
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7e9" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="google-site-verification" content="8KLDJfH1b3S3xeES2mOIT-bH3XPW1SxviRPEsNrJBFk" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={new URL(currentPath, siteOrigin).href} />
    <link rel="alternate" hreflang={switchLang} href={new URL(switchPath, siteOrigin).href} />
    <link rel="alternate" hreflang="x-default" href={siteOrigin + '/'} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta property="og:site_name" content="callidus A&M" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteSocialImage} />
    <meta property="og:image:alt" content="callidus A&M" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteSocialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
    {extraJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)}></script>
    ))}
    <!-- Trustpilot Widget Loader -->
    <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('callidus-theme');
        const theme = stored || 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <!-- Google Consent Mode v2. Steht bewusst vor allen Messskripten und setzt
         alle Werbe- und Analyse-Kategorien auf "denied". Das Google-Tag selbst
         wird erst nach aktiver Einwilligung nachgeladen (siehe Cookie-Banner
         weiter unten) - bis dahin geht keine Anfrage an Google raus. -->
    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500,
        });
        gtag('js', new Date());
        gtag('config', 'AW-17709649802');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={t.paths.home} aria-label="callidus A&M">
        <span class="brand-mark">
          <img src={logoPath} alt="" width="48" height="48" loading="eager" />
        </span>
        <span>
          <strong>callidus A&M</strong>
          <small>{t.brandSubline}</small>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={labels.menuOpen}>
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="header-actions" id="site-menu">
        <nav class="main-nav" aria-label={t.navLabel}>
          {navPrimary.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          {navGroups.map((group) => {
            const groupActive = group.items.some(item => isActive(item.href));
            return (
              <div class={`nav-group${groupActive ? ' has-active' : ''}`}>
                <button class="nav-group-btn" aria-expanded="false" aria-haspopup="true">
                  {group.label}
                  <svg class="nav-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="nav-dropdown" role="menu">
                  {group.items.map((item) => (
                    <a href={item.href} role="menuitem" aria-current={isActive(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </nav>
        <div class="language-switch" aria-label={t.languageLabel}>
          <span>{lang.toUpperCase()}</span>
          <a href={switchPath}>{languages[switchLang]}</a>
        </div>
        <button class="theme-toggle" type="button" aria-label={labels.toggleTheme} aria-pressed="false">
          <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
          </svg>
          <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 14.4A8 8 0 0 1 9.6 3.5 8.8 8.8 0 1 0 20.5 14.4Z"></path>
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <!-- Trustpilot Review Collector Widget -->
      <div class="trustpilot-wrapper">
        <div class="trustpilot-widget" data-locale={labels.trustpilotLocale} data-template-id="56278e9abfbbba0bdcd568bc" data-businessunit-id="6a0765bcbcabb859c8675fbb" data-style-height="52px" data-style-width="100%" data-token="ed79da09-c348-4913-89dc-6e60a759e0ba">
          <a href="https://de.trustpilot.com/review/callidus-am.de" target="_blank" rel="noopener">Trustpilot</a>
        </div>
      </div>
      <div class="footer-brand">
        <p>© callidus A&M. {t.footer}</p>
        <nav class="social-nav" aria-label={t.socialLabel}>
          {socialLinks.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={labels.socialOpen(item.label)} title={item.label}>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={socialIcons[item.icon]} />
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>
      </div>
      <div class="footer-link-groups">
        {footerGroups.map((group) => (
          <nav class="footer-nav-group" aria-label={group.label}>
            <strong class="footer-nav-heading">{group.label}</strong>
            <div class="footer-nav-links">
              {group.items.map((item) => item.action === 'cookie' ? (
                <button type="button" class="footer-consent-reset" data-cookie-reopen>{item.label}</button>
              ) : (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          </nav>
        ))}
      </div>
    </footer>
    <div class="cookie-banner" role="dialog" aria-live="polite" aria-label={labels.cookieLabel} hidden>
      <div class="cookie-banner-inner">
        <div>
          <strong>{labels.cookieTitle}</strong>
          <p>
            {labels.cookieTextBefore}
            {' '}{labels.cookieAnalytics}
            {' '}
            {labels.cookieTextMore} <a href={t.paths.privacy}>{labels.cookiePrivacy}</a>.
          </p>
        </div>
        <div class="cookie-banner-actions">
          <button type="button" class="button" data-cookie-decline>{labels.cookieDecline}</button>
          <button type="button" class="button primary" data-cookie-accept>{labels.cookieAccept}</button>
        </div>
      </div>
    </div>
    <div class="callidus-assistant" data-callidus-assistant>
      <button
        class="assistant-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="callidus-assistant-panel"
        data-assistant-toggle
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2h9A3.5 3.5 0 0 1 20 5.5v6A3.5 3.5 0 0 1 16.5 15H11l-4.5 4v-4A2.5 2.5 0 0 1 4 12.5v-7Z"></path>
          <path d="M8 7h8M8 10.5h5"></path>
        </svg>
        <span>{t.assistant?.toggle ?? 'Assistent'}</span>
      </button>
      <section class="assistant-panel" id="callidus-assistant-panel" aria-label={t.assistant?.panelLabel ?? 'Callidus Assistent'} hidden>
        <header>
          <div>
            <strong>{t.assistant?.title ?? 'Callidus Assistent'}</strong>
            <small>{t.assistant?.subtitle ?? 'Antwortet aus Callidus-Wissen und kuratierten Quellen.'}</small>
          </div>
          <button type="button" aria-label={t.assistant?.close ?? 'Assistent schließen'} data-assistant-close>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </header>
        <div class="assistant-messages" data-assistant-messages aria-live="polite"></div>
        <form class="assistant-form" data-assistant-form>
          <label>
            <span>{t.assistant?.questionLabel ?? 'Frage'}</span>
            <textarea name="message" rows="2" maxlength="700" placeholder={t.assistant?.placeholder ?? 'Frage zu Stress, Schlaf, Mikronährstoffen oder NEXUS'}></textarea>
          </label>
          <button class="button primary" type="submit" data-assistant-submit>{t.assistant?.submit ?? 'Fragen'}</button>
        </form>
        <p class="assistant-privacy">
          {t.assistant?.privacy ?? 'Keine Diagnose. Fragen werden zur Antwort an Firebase/Gemini übertragen.'}
        </p>
      </section>
    </div>
    <button class="back-to-top" type="button" aria-label={labels.backToTop}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 15 6-6 6 6"></path>
      </svg>
    </button>
    <script is:inline>
      // ── Dropdown-Navigation ─────────────────────────────────────
      (() => {
        let outsideBound = false;
        const initDropdowns = () => {
          const isMobile = () => window.innerWidth <= 820;
          document.querySelectorAll('.nav-group').forEach(group => {
            const btn = group.querySelector('.nav-group-btn');
            // Mehrfach-Bindung vermeiden: astro:page-load (ClientRouter) feuert
            // bei jeder Navigation und beim Erststart → sonst doppelte Handler,
            // die das Auf-/Zuklappen sofort wieder rückgängig machen.
            if (!btn || btn.dataset.navGroupReady) return;
            btn.dataset.navGroupReady = 'true';
            // Mobile: click to toggle accordion
            btn.addEventListener('click', (e) => {
              if (!isMobile()) return;
              const isOpen = group.classList.contains('is-open');
              document.querySelectorAll('.nav-group.is-open').forEach(g => {
                g.classList.remove('is-open');
                g.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'false');
              });
              if (!isOpen) {
                group.classList.add('is-open');
                btn.setAttribute('aria-expanded', 'true');
              }
            });
            // Desktop: keyboard support
            btn.addEventListener('keydown', (e) => {
              if (isMobile()) return;
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                const isOpen = group.classList.contains('is-open');
                if (isOpen) {
                  group.classList.remove('is-open');
                  btn.setAttribute('aria-expanded', 'false');
                } else {
                  document.querySelectorAll('.nav-group.is-open').forEach(g => {
                    g.classList.remove('is-open');
                    g.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'false');
                  });
                  group.classList.add('is-open');
                  btn.setAttribute('aria-expanded', 'true');
                }
              }
              if (e.key === 'Escape') {
                group.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
              }
            });
          });
          // Close dropdowns when clicking outside (nur einmal global binden)
          if (!outsideBound) {
            outsideBound = true;
            document.addEventListener('click', (e) => {
              if (!e.target.closest('.nav-group')) {
                document.querySelectorAll('.nav-group.is-open').forEach(g => {
                  g.classList.remove('is-open');
                  g.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'false');
                });
              }
            });
          }
        };
        initDropdowns();
        document.addEventListener('astro:page-load', initDropdowns);
      })();
    </script>
    <script is:inline define:vars={{ FB_CONFIG: fbConfig, ASSISTANT_I18N: t.assistant }}>
      (() => {
        const SESSION_KEY = 'callidus-assistant-session';
        const A_TEXT = ASSISTANT_I18N || {};
        const setupAssistant = () => {
          const root = document.querySelector('[data-callidus-assistant]');
          if (!root || root.dataset.ready) return;
          root.dataset.ready = 'true';

          const toggle = root.querySelector('[data-assistant-toggle]');
          const close = root.querySelector('[data-assistant-close]');
          const panel = root.querySelector('.assistant-panel');
          const messages = root.querySelector('[data-assistant-messages]');
          const form = root.querySelector('[data-assistant-form]');
          const input = form?.querySelector('textarea');
          const submit = root.querySelector('[data-assistant-submit]');
          const history = [];
          let callable = null;
          let suppressToggleClick = false;
          const POSITION_KEY = 'callidus-assistant-y';
          const isAssistantMobile = () => window.matchMedia('(max-width: 640px)').matches;

          const resetMobileAssistantPosition = () => {
            if (!isAssistantMobile()) return;
            root.style.removeProperty('top');
            root.style.removeProperty('bottom');
          };

          const syncAssistantViewport = () => {
            const viewport = window.visualViewport;
            const visualHeight = viewport?.height || window.innerHeight;
            const keyboardOffset = viewport
              ? Math.max(0, window.innerHeight - viewport.height - viewport.offsetTop)
              : 0;
            root.style.setProperty('--assistant-visual-height', `${Math.round(visualHeight)}px`);
            root.style.setProperty('--assistant-keyboard-offset', `${Math.round(keyboardOffset)}px`);
            if (!panel.hidden) messages.scrollTop = messages.scrollHeight;
          };

          const sessionId = (() => {
            const existing = localStorage.getItem(SESSION_KEY);
            if (existing) return existing;
            const fresh = `session_${Date.now()}_${Math.random().toString(36).slice(2)}`;
            localStorage.setItem(SESSION_KEY, fresh);
            return fresh;
          })();

          const setOpen = (open) => {
            panel.hidden = !open;
            toggle.setAttribute('aria-expanded', String(open));
            root.classList.toggle('is-open', open);
            if (open) {
              resetMobileAssistantPosition();
              syncAssistantViewport();
              window.setTimeout(() => input?.focus(), 60);
            }
          };

          const clampAssistantY = (value) => {
            const toggleHeight = toggle?.offsetHeight || 56;
            const minY = 72;
            const maxY = Math.max(minY, window.innerHeight - toggleHeight - 18);
            return Math.min(maxY, Math.max(minY, value));
          };

          const applyAssistantY = (value, persist = true) => {
            const nextY = clampAssistantY(value);
            root.style.top = `${nextY}px`;
            root.style.bottom = 'auto';
            if (persist) localStorage.setItem(POSITION_KEY, String(Math.round(nextY)));
          };

          const storedY = Number(localStorage.getItem(POSITION_KEY));
          if (Number.isFinite(storedY) && !isAssistantMobile()) {
            window.requestAnimationFrame(() => applyAssistantY(storedY, false));
          }

          const setupAssistantDrag = () => {
            if (!toggle || toggle.dataset.dragReady) return;
            toggle.dataset.dragReady = 'true';
            toggle.addEventListener('pointerdown', (event) => {
              if (event.button !== undefined && event.button !== 0) return;
              const startY = event.clientY;
              const startTop = root.getBoundingClientRect().top;
              let moved = false;

              const onPointerMove = (moveEvent) => {
                const deltaY = moveEvent.clientY - startY;
                if (!moved && Math.abs(deltaY) < 6) return;
                moved = true;
                root.classList.add('is-dragging');
                applyAssistantY(startTop + deltaY, false);
                moveEvent.preventDefault();
              };

              const onPointerEnd = () => {
                document.removeEventListener('pointermove', onPointerMove);
                document.removeEventListener('pointerup', onPointerEnd);
                document.removeEventListener('pointercancel', onPointerEnd);
                root.classList.remove('is-dragging');
                if (moved) {
                  const currentY = Number.parseFloat(root.style.top);
                  if (Number.isFinite(currentY)) {
                    localStorage.setItem(POSITION_KEY, String(Math.round(currentY)));
                  }
                  suppressToggleClick = true;
                  window.setTimeout(() => { suppressToggleClick = false; }, 0);
                }
              };

              toggle.setPointerCapture?.(event.pointerId);
              document.addEventListener('pointermove', onPointerMove, { passive: false });
              document.addEventListener('pointerup', onPointerEnd, { once: true });
              document.addEventListener('pointercancel', onPointerEnd, { once: true });
            });
          };

          setupAssistantDrag();
          syncAssistantViewport();
          window.visualViewport?.addEventListener('resize', syncAssistantViewport);
          window.visualViewport?.addEventListener('scroll', syncAssistantViewport);
          window.addEventListener('resize', () => {
            syncAssistantViewport();
            if (isAssistantMobile() && !panel.hidden) {
              resetMobileAssistantPosition();
              return;
            }
            const currentY = Number.parseFloat(root.style.top);
            if (Number.isFinite(currentY)) applyAssistantY(currentY);
          });
          input?.addEventListener('focus', () => {
            resetMobileAssistantPosition();
            syncAssistantViewport();
            window.setTimeout(syncAssistantViewport, 90);
            window.setTimeout(syncAssistantViewport, 320);
          });

          const appendMessage = ({ role, text, sources = [], safetyNotice = '', pending = false }) => {
            const item = document.createElement('article');
            item.className = `assistant-message assistant-message-${role}${pending ? ' is-pending' : ''}`;
            const body = document.createElement('p');
            body.textContent = text;
            item.append(body);
            if (sources.length) {
              const sourceBox = document.createElement('div');
              sourceBox.className = 'assistant-sources';
              const label = document.createElement('strong');
              label.textContent = A_TEXT.sourcesLabel || 'Quellen';
              sourceBox.append(label);
              sources.slice(0, 5).forEach((source) => {
                const link = document.createElement('a');
                link.href = source.url || '#';
                if (!String(source.url || '').startsWith('/')) {
                  link.target = '_blank';
                  link.rel = 'noopener';
                }
                const type = document.createElement('span');
                type.textContent = source.type || 'Quelle';
                const title = document.createElement('b');
                title.textContent = source.title || source.url;
                link.append(type, title);
                sourceBox.append(link);
              });
              item.append(sourceBox);
            }
            if (safetyNotice) {
              const safety = document.createElement('small');
              safety.className = 'assistant-safety';
              safety.textContent = safetyNotice;
              item.append(safety);
            }
            messages.append(item);
            messages.scrollTop = messages.scrollHeight;
            return item;
          };

          const loadCallable = async () => {
            if (callable) return callable;
            const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-app.js');
            const { getFunctions, httpsCallable } = await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-functions.js');
            const app = getApps().length === 0 ? initializeApp(FB_CONFIG) : getApps()[0];
            const fns = getFunctions(app, 'us-central1');
            callable = httpsCallable(fns, 'askCallidus');
            return callable;
          };

          appendMessage({
            role: 'assistant',
            text: A_TEXT.greeting || 'Frag mich zu Stress, Schlaf, Mikronährstoffen, Gesundheits-Wissen, Produkten, Videos, NEXUS, Valus (VAL), Krypto verstehen, Sport & Energie, dem Kinderbuch, dem Audio-Raum, dem Wissens-Quiz, dem Stress-Reset-Kurs (SRK) oder den Callidus-Artikeln. Ich antworte mit Quellen, wenn die Wissensbasis dazu etwas hergibt.',
          });

          toggle?.addEventListener('click', (event) => {
            if (suppressToggleClick) {
              event.preventDefault();
              event.stopPropagation();
              return;
            }
            setOpen(panel.hidden);
          });
          close?.addEventListener('click', () => setOpen(false));
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !panel.hidden) setOpen(false);
          });

          form?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const message = (input?.value || '').trim();
            if (!message) return;
            appendMessage({ role: 'user', text: message });
            history.push({ role: 'user', text: message });
            input.value = '';
            submit.disabled = true;
            submit.textContent = A_TEXT.busy || 'Antwortet...';
            const pending = appendMessage({ role: 'assistant', text: A_TEXT.searching || 'Ich suche in der Callidus-Wissensbasis...', pending: true });
            try {
              const ask = await loadCallable();
              const response = await ask({
                message,
                history: history.slice(-6),
                pagePath: window.location.pathname,
                sessionId,
              });
              const payload = response.data || {};
              pending.remove();
              appendMessage({
                role: 'assistant',
                text: payload.answer || A_TEXT.noAnswer || 'Ich konnte gerade keine Antwort erzeugen.',
                sources: payload.sources || [],
                safetyNotice: payload.safetyNotice || '',
              });
              history.push({ role: 'assistant', text: payload.answer || '' });
            } catch (_) {
              pending.remove();
              appendMessage({
                role: 'assistant',
                text: A_TEXT.error || 'Der Assistent ist gerade nicht erreichbar. Bitte versuche es später erneut oder nutze die Quellen- und Check-Seiten.',
              });
            } finally {
              submit.disabled = false;
              submit.textContent = A_TEXT.submit || 'Fragen';
            }
          });
        };

        setupAssistant();
        document.addEventListener('astro:page-load', setupAssistant);
      })();
    </script>
    <script>
      import { setupConsentAwareAnalytics } from '../scripts/analytics-consent.js';
      setupConsentAwareAnalytics();
    </script>
    <script is:inline>
      const revealItems = () => {
        const items = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.05 });
        items.forEach((item) => observer.observe(item));
      };
      revealItems();
      document.addEventListener('astro:page-load', revealItems);

      let scrollListenerAdded = false;
      const setupNavigation = () => {
        const header = document.querySelector('.site-header');
        const toggle = document.querySelector('.menu-toggle');
        const menu = document.querySelector('#site-menu');
        const backToTop = document.querySelector('.back-to-top');
        const updateScrollState = () => {
          header?.classList.toggle('is-scrolled', window.scrollY > 12);
          backToTop?.classList.toggle('is-visible', window.scrollY > 280);
        };

        if (toggle && !toggle.dataset.navReady) {
          toggle.dataset.navReady = 'true';
          const handleToggle = (event) => {
            event.preventDefault();
            const isOpen = document.body.classList.toggle('menu-open');
            toggle.setAttribute('aria-expanded', String(isOpen));
          };
          toggle.addEventListener('click', handleToggle);
          toggle.addEventListener('touchend', handleToggle, { passive: false });
        }

        menu?.querySelectorAll('a').forEach((link) => {
          if (link.dataset.navReady) return;
          link.dataset.navReady = 'true';
          link.addEventListener('click', () => {
            document.body.classList.remove('menu-open');
            toggle?.setAttribute('aria-expanded', 'false');
          });
        });

        if (backToTop && !backToTop.dataset.navReady) {
          backToTop.dataset.navReady = 'true';
          backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        }

        if (!scrollListenerAdded) {
          scrollListenerAdded = true;
          window.addEventListener('scroll', updateScrollState, { passive: true });
        }
        updateScrollState();
      };
      setupNavigation();
      document.addEventListener('astro:page-load', setupNavigation);

      const setupTheme = () => {
        const toggle = document.querySelector('.theme-toggle');
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        const applyTheme = (theme) => {
          document.documentElement.dataset.theme = theme;
          localStorage.setItem('callidus-theme', theme);
          toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
          metaTheme?.setAttribute('content', theme === 'dark' ? '#08100d' : '#f5f7e9');
        };
        applyTheme(localStorage.getItem('callidus-theme') || document.documentElement.dataset.theme || 'light');
        if (toggle && !toggle.dataset.themeReady) {
          toggle.dataset.themeReady = 'true';
          toggle.addEventListener('click', () => {
            applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
          });
        }
      };
      setupTheme();
      document.addEventListener('astro:page-load', setupTheme);

      const initTrustpilot = () => {
        const widget = document.querySelector('.trustpilot-widget');
        if (!widget) return;
        if (window.Trustpilot) {
          window.Trustpilot.loadFromElement(widget, true);
          return;
        }
        // Script not ready yet — retry up to 5× every 800 ms
        let tries = 0;
        const id = setInterval(() => {
          tries++;
          if (window.Trustpilot) {
            window.Trustpilot.loadFromElement(widget, true);
            clearInterval(id);
          } else if (tries >= 5) {
            clearInterval(id);
          }
        }, 800);
      };
      initTrustpilot();
      document.addEventListener('astro:page-load', initTrustpilot);

      const COOKIE_KEY = 'callidus-cookie-consent-v2';

      // Google Ads: Das Tag wird ausschliesslich nach Einwilligung geladen.
      // Vorher steht Consent Mode auf "denied" (siehe <head>), es faellt also
      // weder ein Cookie noch eine Anfrage an Google an.
      const GOOGLE_ADS_ID = 'AW-17709649802';
      let googleAdsRequested = false;
      const enableGoogleAds = () => {
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
        if (googleAdsRequested) return;
        googleAdsRequested = true;
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + GOOGLE_ADS_ID;
        // Erst wenn die Bibliothek wirklich da ist, duerfen Conversion-Events
        // abgesetzt werden. Vorher in die dataLayer-Warteschlange geschriebene
        // Ereignisse werden nicht zuverlaessig nachgespielt.
        tag.addEventListener('load', () => {
          window.callidusGtagReady = true;
          window.dispatchEvent(new CustomEvent('callidus-gtag-ready'));
        });
        document.head.appendChild(tag);
      };

      // Beim Widerruf reicht es nicht, kuenftige Messung zu stoppen: bereits
      // gesetzte Mess- und Werbe-Cookies werden entfernt, damit nichts
      // zurueckbleibt, wofuer die Rechtsgrundlage entfallen ist.
      const clearMeasurementCookies = () => {
        const hosts = [];
        const parts = location.hostname.split('.');
        for (let i = 0; i < parts.length - 1; i += 1) {
          hosts.push(parts.slice(i).join('.'), '.' + parts.slice(i).join('.'));
        }
        hosts.push('');
        document.cookie.split(';').forEach((entry) => {
          const name = entry.split('=')[0].trim();
          if (!/^(_ga|_gac_|_gcl_|_gid)/.test(name)) return;
          hosts.forEach((host) => {
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/'
              + (host ? '; domain=' + host : '');
          });
        });
      };

      const disableGoogleAds = () => {
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
          });
        }
        clearMeasurementCookies();
      };

      const setupCookieBanner = () => {
        const banner = document.querySelector('.cookie-banner');
        if (!banner || banner.dataset.ready) return;
        banner.dataset.ready = 'true';
        const stored = localStorage.getItem(COOKIE_KEY);
        const apply = (consent) => {
          document.documentElement.dataset.consent = consent;
          localStorage.setItem(COOKIE_KEY, consent);
          banner.hidden = true;
          if (consent === 'all') enableGoogleAds();
          else disableGoogleAds();
          window.dispatchEvent(new CustomEvent('callidus-consent', { detail: consent }));
        };
        if (!stored) {
          banner.hidden = false;
        } else {
          document.documentElement.dataset.consent = stored;
          if (stored === 'all') enableGoogleAds();
        }
        banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => apply('all'));
        banner.querySelector('[data-cookie-decline]')?.addEventListener('click', () => apply('necessary'));
      };
      setupCookieBanner();
      document.addEventListener('astro:page-load', setupCookieBanner);

      // Widerruf: Art. 7 Abs. 3 DSGVO verlangt, dass die Einwilligung so
      // einfach zurueckziehbar ist, wie sie erteilt wurde. Der Footer-Button
      // setzt die Auswahl zurueck und zeigt den Hinweis erneut an.
      const setupConsentReset = () => {
        document.querySelectorAll('[data-cookie-reopen]').forEach((button) => {
          if (button.dataset.ready) return;
          button.dataset.ready = 'true';
          button.addEventListener('click', () => {
            localStorage.removeItem(COOKIE_KEY);
            delete document.documentElement.dataset.consent;
            disableGoogleAds();
            const banner = document.querySelector('.cookie-banner');
            if (banner) {
              banner.hidden = false;
              banner.scrollIntoView({ block: 'nearest' });
              banner.querySelector('[data-cookie-decline]')?.focus();
            }
            window.dispatchEvent(new CustomEvent('callidus-consent', { detail: 'reset' }));
          });
        });
      };
      setupConsentReset();
      document.addEventListener('astro:page-load', setupConsentReset);
    </script>
  </body>
</html>

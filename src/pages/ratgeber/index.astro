---
import BaseLayout from '../../layouts/BaseLayout.astro';
import structure from '../../data/site-structure.json';
import { guideCopy, categoryForLang } from '../../data/i18n.js';
import { allArticles, appBadgeMeta } from '../../data/all-articles.js';

const lang = 'de';
const copy = guideCopy[lang];
const categorize = (article) => {
  if (article.category) {
    const direct = structure.categories.find((c) => c.slug === article.category);
    if (direct) return direct;
  }
  const haystack = `${article.slug || ''} ${article.title || ''} ${article.description || ''} ${(article.h2 || []).join(' ')}`.toLowerCase();
  return structure.categories.find((category) => category.keywords.some((keyword) => haystack.includes(keyword))) || structure.categories[0];
};
const grouped = structure.categories.map((category) => ({
  ...categoryForLang(category, lang),
  path: `/ratgeber/#${category.slug}`,
  articles: allArticles.filter((article) => categorize(article).slug === category.slug),
}));
const totalArticles = allArticles.length;
const nexusCount = allArticles.filter((a) => a.app === 'nexus').length;
const momusCount = allArticles.filter((a) => a.app === 'momus').length;
---
<BaseLayout lang={lang} alternatePath="/en/guide/" title={copy.title} description={copy.description}>
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
      <h1 data-reveal="2">{copy.headline}</h1>
      <p class="lede" data-reveal="3">{copy.lede}</p>
      <p style="margin-top:.75rem;color:var(--muted);font-size:.9rem;" data-reveal="3">
        {totalArticles} Artikel insgesamt &middot;
        <span class="app-badge app-badge-nexus">NEXUS</span> {nexusCount}
        <span class="app-badge app-badge-momus" style="margin-left:.5rem;">MOMUS</span> {momusCount}
      </p>

      <form class="ratgeber-filter" data-article-filter data-reveal="2" aria-label="Artikel filtern">
        <label>
          <span>Suche</span>
          <input type="search" name="query" placeholder="Stichwort, Titel, Tag…" autocomplete="off" />
        </label>
        <label>
          <span>Bereich</span>
          <select name="category">
            <option value="">Alle Bereiche</option>
            {structure.categories.map((category) => (
              <option value={category.slug}>{categoryForLang(category, lang).title}</option>
            ))}
          </select>
        </label>
        <label>
          <span>App</span>
          <select name="app">
            <option value="">Alle Apps</option>
            <option value="nexus">NEXUS</option>
            <option value="momus">MOMUS</option>
          </select>
        </label>
        <button type="reset">Zurücksetzen</button>
      </form>
      <p class="filter-count" data-filter-count>{totalArticles} Artikel</p>
    </div>
  </section>

  <section class="section tight search-results-section" data-search-results hidden>
    <div class="container">
      <p class="eyebrow">Suchergebnisse</p>
      <div class="carousel-wrapper">
        <button class="carousel-btn carousel-btn-prev" data-carousel-prev aria-label="Zurück" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="carousel-track" data-search-results-grid></div>
        <button class="carousel-btn carousel-btn-next" data-carousel-next aria-label="Weiter" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </section>

  {grouped.map((category, sectionIndex) => (
    <section id={category.slug} class={`section category-section ${sectionIndex % 2 === 1 ? 'band' : 'tight'}`} data-category={category.slug}>
      <div class="container split">
        <div class="sticky-note" data-reveal>
          <span class={`badge ${category.accent}`} data-category-badge={category.slug}>{category.articles.length} {copy.articleLabel}</span>
          <h2>{category.title}</h2>
          <p>{category.description}</p>
        </div>
        <div class="grid">
          {category.articles.map((article, index) => {
            const meta = appBadgeMeta(article.app);
            const tagText = (article.tags || []).join(' ');
            return (
              <a
                class="card"
                href={article.path}
                data-reveal={String((index % 3) + 1)}
                data-article-card
                data-category={category.slug}
                data-app={article.app}
                data-search={`${article.title || ''} ${article.description || ''} ${tagText}`.toLowerCase()}
              >
                <span class={meta.className}>{meta.label}</span>
                {article.image && <img src={article.image} alt={article.title} loading="lazy" decoding="async" />}
                <div class="card-body">
                  <span class={`badge ${category.accent}`}>{article.readingTime} Min.</span>
                  <h3>{article.title}</h3>
                  <p>{article.description || article.h2?.[0]}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <script is:inline>
    const setupArticleFilter = () => {
      const form = document.querySelector('[data-article-filter]');
      const cards = Array.from(document.querySelectorAll('[data-article-card]'));
      const sections = Array.from(document.querySelectorAll('.category-section'));
      const count = document.querySelector('[data-filter-count]');
      const resultsSection = document.querySelector('[data-search-results]');
      const resultsGrid = document.querySelector('[data-search-results-grid]');
      const btnPrev = document.querySelector('[data-carousel-prev]');
      const btnNext = document.querySelector('[data-carousel-next]');
      if (!form || !cards.length || form.dataset.ready) return;
      form.dataset.ready = 'true';

      // ── Carousel helpers ──────────────────────────────────────────
      const CARD_WIDTH = () => {
        const first = resultsGrid?.firstElementChild;
        if (!first) return 280;
        return first.getBoundingClientRect().width + 16; // width + gap
      };

      const updateArrows = () => {
        if (!resultsGrid || !btnPrev || !btnNext) return;
        const { scrollLeft, scrollWidth, clientWidth } = resultsGrid;
        const hasOverflow = scrollWidth > clientWidth + 4;
        btnPrev.hidden = !hasOverflow || scrollLeft < 8;
        btnNext.hidden = !hasOverflow || scrollLeft >= scrollWidth - clientWidth - 8;
      };

      const scroll = (dir) => {
        if (!resultsGrid) return;
        resultsGrid.scrollBy({ left: dir * CARD_WIDTH() * 2, behavior: 'smooth' });
      };

      btnPrev?.addEventListener('click', () => scroll(-1));
      btnNext?.addEventListener('click', () => scroll(1));
      resultsGrid?.addEventListener('scroll', updateArrows, { passive: true });

      // Mouse drag to scroll
      let dragStart = null;
      let scrollStart = 0;
      resultsGrid?.addEventListener('mousedown', (e) => {
        dragStart = e.clientX;
        scrollStart = resultsGrid.scrollLeft;
        resultsGrid.classList.add('is-dragging');
      });
      window.addEventListener('mousemove', (e) => {
        if (dragStart === null) return;
        resultsGrid.scrollLeft = scrollStart - (e.clientX - dragStart);
      });
      window.addEventListener('mouseup', () => {
        dragStart = null;
        resultsGrid?.classList.remove('is-dragging');
        updateArrows();
      });

      // ── Filter logic ──────────────────────────────────────────────
      const update = () => {
        const query = (form.query.value || '').trim().toLowerCase();
        const cat = form.category.value;
        const app = form.app.value;
        const isFiltering = query || cat || app;
        let visible = 0;
        const visibleByCategory = {};
        const matchedCards = [];

        cards.forEach((card) => {
          const matchesQuery = !query || card.dataset.search.includes(query);
          const matchesCategory = !cat || card.dataset.category === cat;
          const matchesApp = !app || card.dataset.app === app;
          const show = matchesQuery && matchesCategory && matchesApp;
          card.hidden = false;
          if (show) {
            visible += 1;
            visibleByCategory[card.dataset.category] = (visibleByCategory[card.dataset.category] || 0) + 1;
            matchedCards.push(card);
          }
        });

        if (isFiltering) {
          sections.forEach((s) => { s.hidden = true; });
          if (resultsSection && resultsGrid) {
            resultsGrid.innerHTML = '';
            matchedCards.forEach((card) => {
              const clone = card.cloneNode(true);
              clone.hidden = false;
              clone.removeAttribute('data-reveal');
              clone.classList.add('is-visible');
              resultsGrid.appendChild(clone);
            });
            resultsSection.hidden = false;
            resultsGrid.scrollLeft = 0;
            window.setTimeout(updateArrows, 50);
          }
        } else {
          sections.forEach((section) => {
            section.hidden = false;
            const slug = section.dataset.category;
            const badge = section.querySelector(`[data-category-badge="${slug}"]`);
            if (badge && badge.dataset.originalCount) {
              badge.textContent = badge.textContent.replace(/^\d+/, badge.dataset.originalCount);
            }
          });
          if (resultsSection) resultsSection.hidden = true;
          if (btnPrev) btnPrev.hidden = true;
          if (btnNext) btnNext.hidden = true;
        }

        if (count) count.textContent = `${visible} Artikel`;
      };

      // Store original counts
      sections.forEach((section) => {
        const slug = section.dataset.category;
        const badge = section.querySelector(`[data-category-badge="${slug}"]`);
        if (badge) badge.dataset.originalCount = badge.textContent.match(/^\d+/)?.[0] || '';
      });

      form.addEventListener('input', update);
      form.addEventListener('reset', () => window.setTimeout(update, 0));
      update();
    };
    setupArticleFilter();
    document.addEventListener('astro:page-load', setupArticleFilter);
  </script>
</BaseLayout>

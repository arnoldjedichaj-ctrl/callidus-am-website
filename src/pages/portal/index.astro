---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalGate from '../../components/PortalGate.astro';
import { portalAppList, portalNavList } from '../../data/portal.js';
import healthCompass from '../../data/health-compass.json';
import '../../styles/portal.css';

const firebaseConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
---

<BaseLayout
  title="Callidus Portal | NEXUS, MOMUS & KAIROS"
  description="Geschuetzter Callidus Mitgliederbereich fuer Wallet, VAL, XP und die freigegebenen Daten aus NEXUS, MOMUS und KAIROS."
  lang="de"
>
  <section class="section portal-section">
    <div class="container">
      <PortalGate firebaseConfig={firebaseConfig} view="overview">
        <div class="portal-hero" data-reveal>
          <div>
            <p class="eyebrow">Callidus Portal</p>
            <h1>Ein Konto fuer deine Apps.</h1>
            <p class="lede portal-copy">
              Wallet, Valus, XP und freigegebene App-Daten laufen hier in einem geschuetzten Bereich zusammen.
            </p>
          </div>
          <nav class="portal-subnav" aria-label="Portal Bereiche">
            <a href="/portal/" aria-current="page">Portal</a>
            <a href="/wallet/">Wallet</a>
            {portalNavList.map((app) => <a href={app.href}>{app.name}</a>)}
          </nav>
        </div>

        <div class="portal-kpi-grid" data-reveal="2" style="margin-top:1.25rem">
          <div class="portal-kpi">
            <span>VAL</span>
            <strong id="portal-valus">-</strong>
            <small>Einloesbares Valus-Guthaben</small>
          </div>
          <div class="portal-kpi portal-xp-kpi">
            <span>XP</span>
            <strong id="portal-xp">-</strong>
            <small>NEXUS-Aktivitaet und Umwandlung</small>
            <form class="portal-convert-form" id="portal-xp-convert-form">
              <label for="portal-xp-convert-amount">NEXUS-XP in VAL</label>
              <div class="portal-convert-row">
                <input id="portal-xp-convert-amount" type="number" min="10000" max="100000" step="10000" value="10000" />
                <button class="button" id="portal-xp-convert-button" type="submit">Umwandeln</button>
              </div>
              <small id="portal-xp-convert-preview">10000 XP = 1 VAL</small>
              <p class="portal-convert-status" id="portal-xp-convert-status" hidden></p>
            </form>
          </div>
          <div class="portal-kpi">
            <span>Wallet</span>
            <strong id="portal-wallet">-</strong>
            <small>Verknuepfte Ethereum-Adresse</small>
          </div>
          <div class="portal-kpi">
            <span>Apps</span>
            <strong id="portal-linked-apps">-</strong>
            <small>Sichtbare App-Verbindungen</small>
          </div>
        </div>

        <section
          class="portal-panel portal-compass-panel"
          data-portal-compass
          data-compass-storage-key={healthCompass.storageKey}
          data-reveal="2"
          style="margin-top:1rem"
        >
          <div>
            <p class="eyebrow">Gesundheits-Kompass</p>
            <h2>Öffentliche Orientierung im Portal weiterführen.</h2>
            <p class="portal-copy" data-portal-compass-copy>
              Starte den öffentlichen Kompass ohne Anmeldung. Nach dem Login erscheint hier dein letzter Fokusbereich
              und kann später mit freigegebenen App-Daten, Journal und Coach verbunden werden.
            </p>
          </div>
          <div class="portal-compass-state" data-portal-compass-state>
            <span class="portal-pill" data-state="pending">Noch kein Kompass-Ergebnis</span>
            <strong>Bereit für Stufe 1</strong>
            <small>Öffentlichen Kompass starten und danach hier weiterführen.</small>
          </div>
          <div class="portal-compass-actions">
            <a class="button primary" href="/gesundheits-kompass/#kompass-tool">Kompass starten</a>
            <a class="button" href="/portal/coach/">Coach öffnen</a>
          </div>
        </section>

        <div class="portal-app-grid" data-reveal="3" style="margin-top:1rem">
          {portalAppList.map((app) => (
            <a class={`portal-app-card portal-app-${app.color}`} href={app.href} data-app-card={app.id}>
              <div class="portal-app-head">
                <img class="portal-app-icon" src={app.icon} alt="" width="64" height="64" loading="lazy" />
                <div class="portal-pill-stack">
                  <span class="portal-pill" id={`portal-${app.id}-status`} data-state="off">Noch nicht aktiv</span>
                  <span class="portal-pill portal-plan-pill" id={`portal-${app.id}-plan`} data-state="off">Free</span>
                </div>
              </div>
              <div>
                <h2>{app.name}</h2>
                <p>{app.eyebrow}</p>
              </div>
              <div class="portal-app-metrics">
                <div>
                  <span>{app.id === 'nexus' ? 'Schritte' : app.id === 'momus' ? 'Phoenix' : 'Profil'}</span>
                  <strong id={`portal-${app.id}-primary`}>-</strong>
                </div>
                <div>
                  <span>{app.id === 'nexus' ? 'Mahlzeiten' : app.id === 'momus' ? 'Akku' : 'Kontext'}</span>
                  <strong id={`portal-${app.id}-secondary`}>-</strong>
                </div>
              </div>
            </a>
          ))}
          <a class="portal-app-card portal-app-coral" href="/portal/coach/" data-app-card="coach">
            <div class="portal-app-head">
              <div class="portal-app-icon portal-app-icon-symbol" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 12h12" />
                  <path d="M8 8v8" />
                  <path d="M16 8v8" />
                  <path d="M4 10v4" />
                  <path d="M20 10v4" />
                </svg>
              </div>
              <div class="portal-pill-stack">
                <span class="portal-pill" data-state="pending">Gemini vorbereitet</span>
                <span class="portal-pill portal-plan-pill" data-state="off">MVP</span>
              </div>
            </div>
            <div>
              <h2>Coach</h2>
              <p>Trainingsplan, Ernaehrung und Regeneration aus App-Daten plus Fragebogen.</p>
            </div>
            <div class="portal-app-metrics">
              <div>
                <span>Plan</span>
                <strong>Hybrid</strong>
              </div>
              <div>
                <span>KI</span>
                <strong>Gemini</strong>
              </div>
            </div>
          </a>
        </div>

        <div class="portal-grid-2" data-reveal style="margin-top:1rem">
          <section class="portal-panel">
            <h2>App-Verbindungen</h2>
            <ul class="portal-list" id="portal-integration-list">
              <li><span class="portal-empty">Lade...</span></li>
            </ul>
          </section>
          <section class="portal-panel">
            <h2>VAL-Verlauf</h2>
            <ul class="portal-list" id="portal-ledger-list">
              <li><span class="portal-empty">Lade...</span></li>
            </ul>
          </section>
        </div>
      </PortalGate>
    </div>
  </section>
  <script is:inline>
    (() => {
      const setupPortalCompass = () => {
        const root = document.querySelector('[data-portal-compass]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = 'true';
        const state = root.querySelector('[data-portal-compass-state]');
        const copy = root.querySelector('[data-portal-compass-copy]');
        const key = root.dataset.compassStorageKey;
        if (!state || !key) return;
        let result = null;
        try {
          result = JSON.parse(localStorage.getItem(key) || 'null');
        } catch (_) {}
        if (!result?.focusLabel) return;
        const date = result.createdAt
          ? new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium' }).format(new Date(result.createdAt))
          : 'zuletzt gespeichert';
        state.innerHTML = '';
        const pill = document.createElement('span');
        pill.className = 'portal-pill';
        pill.dataset.state = 'on';
        pill.textContent = 'Kompass vorhanden';
        const title = document.createElement('strong');
        title.textContent = result.focusLabel;
        const detail = document.createElement('small');
        detail.textContent = `${result.profileTitle || 'Auswertung'} · ${result.total ?? '-'} von 15 Punkten · ${date}`;
        state.append(pill, title, detail);
        if (copy) {
          copy.textContent = 'Dein öffentlicher Kompass-Fokus ist lokal gespeichert. Im Portal kann daraus ein Verlauf mit App-Daten, Journal und Coach-Impulsen werden, sobald du Daten freigibst.';
        }
      };
      setupPortalCompass();
      document.addEventListener('astro:page-load', setupPortalCompass);
    })();
  </script>
</BaseLayout>

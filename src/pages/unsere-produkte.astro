---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Unsere Produkte: callidus A&M Eigenmarke | callidus A&M';
const description = 'Die callidus A&M Eigenmarke – sorgfältig formulierte Nahrungsergänzungsmittel, in der EU hergestellt, chargenweise laborgeprüft und aus Deutschland versendet.';

const shop = 'https://ywg7pa-bq.myshopify.com';

const products = [
  {
    key: 'magnesium',
    preisCents: 1999,
    name: '4-fach Magnesium Komplex',
    category: 'Körper & Ernährung',
    color: '#3f7f5a',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/8b603e19-eee5-4cb1-bbf6-1d686b9d7099_4688ce52-8432-48b5-8b7f-62c7c38dd9c2.jpg?v=1784968924',
    desc: 'Vier hochwertige Magnesiumverbindungen mit 200 mg elementarem Magnesium. 60 vegane Tabletten.',
    price: '19,99 €',
    grundpreis: '21,82 €/100 g · 91,6 g',
    variant: '58671561113925',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-magnesium-komplex.pdf',
  },
  {
    key: 'curcuma',
    preisCents: 1999,
    name: 'Curcuma + Piperin',
    category: 'Körper & Ernährung',
    color: '#3f7f5a',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/fe691202-cfe8-4fc3-9da9-6074c5931014_4ec34408-d5f0-4a02-8a4f-a5c6d2e2706c.jpg?v=1784969278',
    desc: 'Curcuma-Wurzelpulver mit schwarzem Pfeffer Extrakt. Rein pflanzlich, ohne Zusätze. 60 vegane Kapseln.',
    price: '19,99 €',
    grundpreis: '44,72 €/100 g · 44,7 g',
    variant: '58671554167109',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-curcuma-piperin.pdf',
  },
  {
    key: 'd3k2',
    preisCents: 1699,
    name: 'Vitamin D3 + K2 Tropfen',
    category: 'Sport & Energie',
    color: '#26301f',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/8b400a6b-412d-4449-884d-e3656b515091_4d20af50-61a2-4cdf-b963-59309a7e0d16.jpg?v=1784969178',
    desc: '1.000 I.E. Vitamin D3 pro Tropfen, kombiniert mit Vitamin K2 als MK-7. 1.700 Tropfen / 50 ml.',
    price: '16,99 €',
    grundpreis: '33,98 €/100 ml · 50 ml',
    variant: '58671539224901',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-vitamin-d3-k2.pdf',
  },
];

const redemptionProducts = products.map((p) => ({ id: p.key, titel: p.name, preisCents: p.preisCents }));
---

<BaseLayout lang="de" title={title} description={description}>
  <section class="section produkte-hero">
    <div class="container">
      <div class="produkte-intro" data-reveal>
        <p class="eyebrow">callidus A&M · Unsere Eigenmarke</p>
        <h1>Wir stehen mit unserem Namen dahinter.</h1>
        <p class="lede">Wir empfehlen nicht nur – wir entwickeln auch selbst. Jede Charge unserer Eigenmarke wird unabhängig im Labor geprüft, in der EU hergestellt und aus Deutschland versendet. Sicher bezahlt wird über Shopify.</p>
      </div>
    </div>
  </section>

  <section class="section produkte-section">
    <div class="container">
      <div class="produkte-grid">
        {products.map((p, i) => (
          <article class="produkt-card" data-reveal={i === 0 ? undefined : String((i % 2) + 2)}>
            <span class="produkt-band" style={`background:${p.color}`}></span>
            <div class="produkt-img">
              <img src={p.image} alt={`callidus A&M ${p.name}`} loading="lazy" width="320" height="320" />
            </div>
            <div class="produkt-body">
              <span class="produkt-cat"><span class="produkt-dot" style={`background:${p.color}`}></span>{p.category}</span>
              <h2 class="produkt-name">{p.name}</h2>
              <p class="produkt-desc">{p.desc}</p>
              <div class="produkt-foot">
                <span class="produkt-pricebox">
                  <span class="produkt-price">{p.price}</span>
                  <span class="produkt-grund">{p.grundpreis}</span>
                </span>
                <a class="produkt-buy" href={`${shop}/cart/${p.variant}:1`}>Jetzt kaufen</a>
              </div>
              <button class="produkt-redeem-open" type="button" data-product-key={p.key}>VAL einlösen</button>
              <div class="produkt-meta">
                <span class="produkt-secure">🔒 Sichere Bezahlung über Shopify</span>
                <a class="produkt-lab" href={p.lab} target="_blank" rel="noopener">🔬 Laborbericht</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="shop-redemption-panel" id="val-einloesung" data-shop-redemption data-reveal>
        <div class="shop-redemption-copy">
          <p class="eyebrow">VAL einlösen</p>
          <h2>VAL-Guthaben für unsere Eigenmarke verwenden.</h2>
          <p>
            Dein <strong>VAL-Guthaben</strong> kannst du als Rabattwert für alle Produkte der Eigenmarke einsetzen
            (<strong>1 VAL = 1,00 €</strong>). Du kannst ein Produkt vollständig oder nur teilweise einlösen und den
            Rest normal im Shopify-Checkout bezahlen. App-XP wandelst du vorher selbst auf der
            <a href="/valus/">VAL-Seite</a> in VAL um. Versandkosten bleiben bestehen.
          </p>
        </div>

        <div class="shop-redemption-app">
          <div id="shop-redeem-loading" class="shop-redeem-state">
            <strong>Guthaben wird geprüft...</strong>
            <small>Wenn du bereits im Portal angemeldet bist, erscheint dein XP-/VAL-Stand automatisch.</small>
          </div>

          <div id="shop-redeem-auth" class="shop-redeem-state" hidden>
            <strong>Anmelden, dann einlösen</strong>
            <small>Deine XP und VAL werden sicher über dein Callidus-Konto geladen.</small>
            <a class="produkt-buy" href="/portal/">Zum Portal-Login</a>
          </div>

          <div id="shop-redeem-dashboard" hidden>
            <div class="shop-wallet-row">
              <div>
                <span>XP</span>
                <strong id="shop-xp-balance">-</strong>
              </div>
              <div>
                <span>VAL</span>
                <strong id="shop-val-balance">-</strong>
              </div>
              <div>
                <span>Einlösbar</span>
                <strong id="shop-credit-balance">-</strong>
              </div>
            </div>

            <form class="shop-redemption-form" id="shop-redemption-form">
              <label for="shop-redemption-product">Produkt auswählen</label>
              <select id="shop-redemption-product">
                {redemptionProducts.map((item) => (
                  <option value={item.id}>{item.titel}</option>
                ))}
              </select>

              <label for="shop-redemption-euro">Rabattwert einsetzen</label>
              <div class="shop-redemption-input-row">
                <input id="shop-redemption-euro" type="number" min="0.10" max="19.99" step="0.10" value="19.99" />
                <button class="produkt-buy" type="button" id="shop-redemption-full">Maximal</button>
              </div>

              <div class="shop-redemption-preview" id="shop-redemption-preview"></div>

              <button class="produkt-buy" type="submit" id="shop-redemption-submit">Einlösecode erstellen</button>
              <p class="shop-redemption-status" id="shop-redemption-status" hidden></p>
            </form>
          </div>
        </div>
      </div>

      <ul class="produkte-trust" data-reveal>
        <li><strong>✓</strong> Herstellung in der EU</li>
        <li><strong>✓</strong> Chargen-laborgeprüft</li>
        <li><strong>✓</strong> Versand aus Deutschland</li>
        <li><strong>✓</strong> Vegan</li>
      </ul>

      <p class="produkte-legal">
        Gemäß § 19 UStG (Kleinunternehmerregelung) wird keine Umsatzsteuer ausgewiesen. Alle Preise zzgl.
        <a href="/agb/">Versandkosten</a>. Es gelten unsere <a href="/agb/">AGB</a> und die
        <a href="/widerruf/">Widerrufsbelehrung</a>.
      </p>
      <p class="produkte-legal">
        Nahrungsergänzungsmittel sind kein Ersatz für eine ausgewogene und abwechslungsreiche Ernährung sowie
        eine gesunde Lebensweise. Die angegebene empfohlene tägliche Verzehrmenge darf nicht überschritten
        werden. Außerhalb der Reichweite von kleinen Kindern aufbewahren.
      </p>
    </div>
  </section>

  <script id="shop-product-data" type="application/json" set:html={JSON.stringify(redemptionProducts)}></script>
  <script>
    import { onAuthStateChanged } from 'firebase/auth';
    import { doc, getDoc } from 'firebase/firestore';
    import { auth, db, getValusBalance, createShopifyRedemption } from '../lib/firebase-client.js';

    (() => {
      const XP_PER_CENT = 100;
      const CENTS_PER_EURO = 100;
      const items = JSON.parse(document.getElementById('shop-product-data')?.textContent || '[]');
      const root = document.querySelector('[data-shop-redemption]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const state = {
        user: null,
        balance: { xp: 0, valus: 0 },
      };

      const $ = (id) => document.getElementById(id);
      const formatInt = (value) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Number(value) || 0);
      const formatEuro = (cents) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format((Number(cents) || 0) / CENTS_PER_EURO);
      const itemById = (id) => items.find((item) => item.id === id) || items[0];
      const creditCents = () => Math.floor((Number(state.balance.valus) || 0) * CENTS_PER_EURO);
      const show = (id) => {
        ['shop-redeem-loading', 'shop-redeem-auth', 'shop-redeem-dashboard'].forEach((viewId) => {
          const el = $(viewId);
          if (el) el.hidden = viewId !== id;
        });
      };
      const setStatus = (message, kind = '') => {
        const el = $('shop-redemption-status');
        if (!el) return;
        el.textContent = message || '';
        el.hidden = !message;
        el.dataset.state = kind;
      };

      function normalizeBalance(payload = {}) {
        const raw = payload.balance || payload.balances || payload;
        const user = payload.user || payload.userDoc || {};
        const valus = Math.max(0, Number(raw.valus ?? raw.val ?? user.valus ?? user.val ?? user.valus_balance ?? 0) || 0);
        const xp = Math.max(0, Number(raw.xp ?? raw.current_xp ?? raw.total_xp ?? user.current_xp ?? user.total_xp ?? 0) || 0);
        return { valus, xp };
      }

      function updateBalanceView() {
        $('shop-xp-balance').textContent = `${formatInt(state.balance.xp)} XP`;
        $('shop-val-balance').textContent = `${new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(state.balance.valus)} VAL`;
        $('shop-credit-balance').textContent = formatEuro(creditCents());
        updatePreview();
      }

      function selectedCreditCents() {
        const euro = Number.parseFloat(String($('shop-redemption-euro')?.value || '0').replace(',', '.'));
        return Math.max(0, Math.round((Number.isFinite(euro) ? euro : 0) * CENTS_PER_EURO));
      }

      function updatePreview() {
        const item = itemById($('shop-redemption-product')?.value);
        const available = creditCents();
        const desired = selectedCreditCents();
        const maxCents = Math.min(item?.preisCents || 0, available);
        const usable = Math.min(desired, maxCents);
        const rest = Math.max(0, (item?.preisCents || 0) - usable);
        const preview = $('shop-redemption-preview');
        if (!preview || !item) return;
        if (available < 1) {
          preview.textContent = 'Noch kein einlösbares VAL-Guthaben sichtbar. XP kannst du auf der VAL-Seite in VAL umwandeln.';
          return;
        }
        const tooHigh = desired > maxCents ? ` · maximal aktuell ${formatEuro(maxCents)}` : '';
        preview.textContent = `${formatEuro(usable)} Rabatt = ${(usable / CENTS_PER_EURO).toLocaleString('de-DE', { maximumFractionDigits: 2 })} VAL · Restbetrag ${formatEuro(rest)} zzgl. Versand${tooHigh}`;
      }

      async function loadBalance(user) {
        try {
          const callable = getValusBalance();
          const result = await callable({});
          state.balance = normalizeBalance(result.data || {});
        } catch (error) {
          try {
            const [balanceSnap, userSnap] = await Promise.all([
              getDoc(doc(db, 'users', user.uid, 'balances', 'current')),
              getDoc(doc(db, 'users', user.uid)),
            ]);
            state.balance = normalizeBalance({
              balance: balanceSnap.exists() ? balanceSnap.data() : {},
              user: userSnap.exists() ? userSnap.data() : {},
            });
          } catch (fallbackError) {
            console.warn('Shop balance load failed', error, fallbackError);
            state.balance = { xp: 0, valus: 0 };
            setStatus('Guthaben konnte gerade nicht geladen werden. Bitte im Portal anmelden und erneut versuchen.', 'error');
          }
        }
        updateBalanceView();
      }

      function initAuth() {
        onAuthStateChanged(auth, async (user) => {
          state.user = user;
          if (!user) {
            show('shop-redeem-auth');
            return;
          }
          show('shop-redeem-dashboard');
          await loadBalance(user);
        });
      }

      $('shop-redemption-product')?.addEventListener('change', updatePreview);
      $('shop-redemption-euro')?.addEventListener('input', updatePreview);
      $('shop-redemption-full')?.addEventListener('click', () => {
        const item = itemById($('shop-redemption-product')?.value);
        const maxCents = Math.min(item?.preisCents || 0, creditCents());
        $('shop-redemption-euro').value = (maxCents / CENTS_PER_EURO).toFixed(2);
        updatePreview();
      });
      document.querySelectorAll('.produkt-redeem-open').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.productKey;
          const select = $('shop-redemption-product');
          if (select && key) select.value = key;
          const item = itemById(key);
          const maxCents = Math.min(item?.preisCents || 0, creditCents() || item?.preisCents || 0);
          if ($('shop-redemption-euro')) $('shop-redemption-euro').value = (maxCents / CENTS_PER_EURO).toFixed(2);
          updatePreview();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      $('shop-redemption-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setStatus('');
        if (!state.user) {
          show('shop-redeem-auth');
          setStatus('Bitte zuerst im Portal anmelden.', 'error');
          return;
        }
        const item = itemById($('shop-redemption-product')?.value);
        const desired = selectedCreditCents();
        const maxCents = Math.min(item?.preisCents || 0, creditCents());
        const credit = Math.min(desired, maxCents);
        if (!item || credit < 1) {
          setStatus('Bitte ein Produkt und einen einlösbaren Betrag auswählen.', 'error');
          return;
        }
        const button = $('shop-redemption-submit');
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        setStatus('Einlösecode wird erstellt...', 'pending');
        try {
          const callable = createShopifyRedemption();
          const result = await callable({ productKey: item.id, creditCents: credit });
          const data = result.data || {};
          const rest = formatEuro(data.remainingCents || 0);
          const checkoutUrl = data.checkoutUrl;
          setStatus(`Rabattcode ${data.code} wurde erstellt (${formatEuro(data.creditCents || credit)} Rabatt, Restbetrag ${rest} zzgl. Versand). Der Code wird im Shopify-Checkout automatisch angewendet und gilt 24 Stunden. Dein VAL-Guthaben wird erst nach bestätigter Zahlung abgebucht.`, 'ok');
          if (checkoutUrl) {
            setTimeout(() => {
              window.open(checkoutUrl, '_blank', 'noopener');
            }, 900);
          }
        } catch (error) {
          setStatus(error?.message || 'Einlösung konnte nicht erstellt werden.', 'error');
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });

      show('shop-redeem-loading');
      try {
        initAuth();
      } catch (error) {
        console.warn('Shop Firebase init failed', error);
        show('shop-redeem-auth');
        setStatus('Portal konnte gerade nicht geladen werden. Bitte später erneut versuchen.', 'error');
      }
    })();
  </script>
</BaseLayout>

<style>
  .produkte-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem; }
  .produkte-intro { max-width: 42rem; }
  .produkte-intro h1 { margin: 0.4rem 0 0.8rem; }
  .produkte-section { padding-top: 1.5rem; }

  .produkte-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .produkt-card {
    position: relative;
    background: var(--card-bg, #fffef8);
    border: 1px solid rgba(131, 137, 97, 0.22);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 26px rgba(38, 48, 38, 0.06);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .produkt-card:hover { box-shadow: 0 16px 40px rgba(38, 48, 38, 0.13); transform: translateY(-3px); }
  .produkt-band { display: block; height: 5px; width: 100%; }
  .produkt-img {
    background: #faf8ef;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-bottom: 1px solid rgba(131, 137, 97, 0.18);
  }
  .produkt-img img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .produkt-body { padding: 1.15rem 1.35rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .produkt-cat {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.64rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase;
    color: var(--text-muted, #5e6757); margin-bottom: 0.5rem;
  }
  .produkt-dot { width: 0.55em; height: 0.55em; border-radius: 50%; display: inline-block; }
  .produkt-name { font-size: 1.5rem; line-height: 1.14; margin: 0 0 0.35rem; }
  .produkt-desc { color: var(--text-muted, #5e6757); font-size: 0.9rem; margin: 0 0 1rem; flex: 1; }
  .produkt-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; }
  .produkt-pricebox { display: flex; flex-direction: column; line-height: 1.15; }
  .produkt-price { font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .produkt-grund { font-size: 0.7rem; color: var(--text-muted, #5e6757); font-variant-numeric: tabular-nums; margin-top: 0.15rem; }
  .produkt-buy {
    display: inline-block; background: #3f7f5a; color: #fff; text-decoration: none;
    font-weight: 800; font-size: 0.9rem; padding: 0.62rem 1.2rem; border-radius: 999px;
    white-space: nowrap; transition: background 0.18s ease;
  }
  .produkt-buy:hover { background: #26301f; }
  .produkt-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.7rem; }
  .produkt-secure { font-size: 0.72rem; color: var(--text-muted, #5e6757); }
  .produkt-lab { font-size: 0.74rem; color: #3f7f5a; font-weight: 700; text-decoration: none; border-bottom: 1px solid transparent; }
  .produkt-lab:hover { border-bottom-color: #3f7f5a; }

  .produkt-redeem-open {
    margin-top: 0.7rem;
    width: 100%;
    min-height: 42px;
    background: transparent;
    color: #3f7f5a;
    border: 1px solid rgba(63, 127, 90, 0.45);
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .produkt-redeem-open:hover { background: #3f7f5a; color: #fff; }

  .shop-redemption-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    margin-top: 2.6rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid rgba(63, 127, 90, 0.26);
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(63, 127, 90, 0.10), rgba(131, 137, 97, 0.08)), var(--card-bg, #fffef8);
    box-shadow: 0 18px 50px rgba(38, 48, 38, 0.08);
  }
  @media (max-width: 840px) {
    .shop-redemption-panel { grid-template-columns: 1fr; }
  }
  .shop-redemption-copy h2 { margin: 0.4rem 0 0.7rem; font-size: 1.6rem; line-height: 1.15; }
  .shop-redemption-copy p { max-width: 62ch; margin: 0; color: var(--text-muted, #5e6757); }
  .shop-redemption-copy a { color: #3f7f5a; }
  .shop-redemption-app {
    background: #fffef8;
    border: 1px solid rgba(131, 137, 97, 0.22);
    border-radius: 12px;
    padding: 1rem;
  }
  .shop-redeem-state {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 170px;
  }
  .shop-redeem-state[hidden],
  #shop-redeem-dashboard[hidden] { display: none !important; }
  .shop-redeem-state strong { font-size: 1.1rem; }
  .shop-redeem-state small { color: var(--text-muted, #5e6757); line-height: 1.55; }
  .shop-redeem-state .produkt-buy { text-align: center; justify-self: start; }

  .shop-wallet-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 560px) {
    .shop-wallet-row { grid-template-columns: 1fr; }
  }
  .shop-wallet-row div {
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid rgba(131, 137, 97, 0.2);
    border-radius: 8px;
    background: #faf8ef;
  }
  .shop-wallet-row span {
    display: block;
    color: var(--text-muted, #5e6757);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .shop-wallet-row strong {
    display: block;
    margin-top: 0.2rem;
    color: #3f7f5a;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .shop-redemption-form { display: grid; gap: 0.75rem; }
  .shop-redemption-form label { font-weight: 800; font-size: 0.85rem; }
  .shop-redemption-form select,
  .shop-redemption-form input {

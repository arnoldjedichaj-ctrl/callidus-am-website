---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Unsere Produkte: callidus A&M Eigenmarke | callidus A&M';
const description = 'Die callidus A&M Eigenmarke – sorgfältig formulierte Nahrungsergänzungsmittel, in der EU hergestellt, chargenweise laborgeprüft und aus Deutschland versendet.';

const shop = 'https://ywg7pa-bq.myshopify.com';

const products = [
  {
    key: 'magnesium',
    preisCents: 1999,
    name: '4-fach Magnesium Komplex',
    category: 'Körper & Ernährung',
    color: '#3f7f5a',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/8b603e19-eee5-4cb1-bbf6-1d686b9d7099_4688ce52-8432-48b5-8b7f-62c7c38dd9c2.jpg?v=1784968924',
    desc: 'Vier hochwertige Magnesiumverbindungen mit 200 mg elementarem Magnesium. 60 vegane Tabletten.',
    price: '19,99 €',
    grundpreis: '21,82 €/100 g · 91,6 g',
    variant: '58671561113925',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-magnesium-komplex.pdf',
  },
  {
    key: 'curcuma',
    preisCents: 1999,
    name: 'Curcuma + Piperin',
    category: 'Körper & Ernährung',
    color: '#3f7f5a',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/fe691202-cfe8-4fc3-9da9-6074c5931014_4ec34408-d5f0-4a02-8a4f-a5c6d2e2706c.jpg?v=1784969278',
    desc: 'Curcuma-Wurzelpulver mit schwarzem Pfeffer Extrakt. Rein pflanzlich, ohne Zusätze. 60 vegane Kapseln.',
    price: '19,99 €',
    grundpreis: '44,72 €/100 g · 44,7 g',
    variant: '58671554167109',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-curcuma-piperin.pdf',
  },
  {
    key: 'd3k2',
    preisCents: 1699,
    name: 'Vitamin D3 + K2 Tropfen',
    category: 'Sport & Energie',
    color: '#26301f',
    image: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/8b400a6b-412d-4449-884d-e3656b515091_4d20af50-61a2-4cdf-b963-59309a7e0d16.jpg?v=1784969178',
    desc: '1.000 I.E. Vitamin D3 pro Tropfen, kombiniert mit Vitamin K2 als MK-7. 1.700 Tropfen / 50 ml.',
    price: '16,99 €',
    grundpreis: '33,98 €/100 ml · 50 ml',
    variant: '58671539224901',
    lab: 'https://cdn.shopify.com/s/files/1/1080/3281/9525/files/callidus-laborbericht-vitamin-d3-k2.pdf',
  },
];

const redemptionProducts = products.map((p) => ({
  id: p.key,
  titel: p.name,
  preisCents: p.preisCents,
  variant: p.variant,
}));

// Muss zu den Versandeinstellungen im Shopify-Shop passen.
const versand = { pauschaleCents: 390, gratisAbCents: 3500 };
---

<BaseLayout lang="de" title={title} description={description}>
  <section class="section produkte-hero">
    <div class="container">
      <div class="produkte-intro" data-reveal>
        <p class="eyebrow">callidus A&M · Unsere Eigenmarke</p>
        <h1>Wir stehen mit unserem Namen dahinter.</h1>
        <p class="lede">Wir empfehlen nicht nur – wir entwickeln auch selbst. Jede Charge unserer Eigenmarke wird unabhängig im Labor geprüft, in der EU hergestellt und aus Deutschland versendet. Sicher bezahlt wird über Shopify.</p>
      </div>
    </div>
  </section>

  <section class="section produkte-section">
    <div class="container">
      <div class="produkte-grid">
        {products.map((p, i) => (
          <article class="produkt-card" data-reveal={i === 0 ? undefined : String((i % 2) + 2)}>
            <span class="produkt-band" style={`background:${p.color}`}></span>
            <div class="produkt-img">
              <img src={p.image} alt={`callidus A&M ${p.name}`} loading="lazy" width="320" height="320" />
            </div>
            <div class="produkt-body">
              <span class="produkt-cat"><span class="produkt-dot" style={`background:${p.color}`}></span>{p.category}</span>
              <h2 class="produkt-name">{p.name}</h2>
              <p class="produkt-desc">{p.desc}</p>
              <div class="produkt-foot">
                <span class="produkt-pricebox">
                  <span class="produkt-price">{p.price}</span>
                  <span class="produkt-grund">{p.grundpreis}</span>
                </span>
                <button class="produkt-buy produkt-add" type="button" data-key={p.key}>In den Warenkorb</button>
              </div>
              <div class="produkt-meta">
                <span class="produkt-secure">🔒 Sichere Bezahlung über Shopify</span>
                <a class="produkt-lab" href={p.lab} target="_blank" rel="noopener">🔬 Laborbericht</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <ul class="produkte-trust" data-reveal>
        <li><strong>✓</strong> Herstellung in der EU</li>
        <li><strong>✓</strong> Chargen-laborgeprüft</li>
        <li><strong>✓</strong> Versand aus Deutschland</li>
        <li><strong>✓</strong> Vegan</li>
      </ul>

      <p class="produkte-legal">
        Gemäß § 19 UStG (Kleinunternehmerregelung) wird keine Umsatzsteuer ausgewiesen. Alle Preise zzgl.
        <a href="/agb/">Versandkosten</a>. Es gelten unsere <a href="/agb/">AGB</a> und die
        <a href="/widerruf/">Widerrufsbelehrung</a>.
      </p>
      <p class="produkte-legal">
        Nahrungsergänzungsmittel sind kein Ersatz für eine ausgewogene und abwechslungsreiche Ernährung sowie
        eine gesunde Lebensweise. Die angegebene empfohlene tägliche Verzehrmenge darf nicht überschritten
        werden. Außerhalb der Reichweite von kleinen Kindern aufbewahren.
      </p>
    </div>
  </section>

  <button class="wk-fab" id="wk-fab" type="button" hidden aria-controls="wk-drawer" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 7h12l-1.2 11a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 7Z" />
      <path d="M9 7V5.5a3 3 0 0 1 6 0V7" />
    </svg>
    <span class="wk-fab-label">Warenkorb</span>
    <span class="wk-fab-badge" id="wk-fab-badge">0</span>
  </button>

  <div class="wk-overlay" id="wk-overlay" hidden></div>

  <aside class="wk-drawer" id="wk-drawer" role="dialog" aria-modal="true" aria-labelledby="wk-title" hidden>
    <header class="wk-head">
      <h2 id="wk-title">Dein Warenkorb</h2>
      <button type="button" class="wk-close" id="wk-close" aria-label="Warenkorb schließen">✕</button>
    </header>

    <div class="wk-body">
      <div class="wk-progress" id="wk-progress">
        <div class="wk-progress-bar"><span id="wk-progress-fill"></span></div>
        <p id="wk-progress-text"></p>
      </div>

      <ul class="wk-list" id="wk-list"></ul>

      <dl class="wk-sums">
        <div><dt>Zwischensumme</dt><dd id="wk-subtotal">0,00 €</dd></div>
        <div><dt>Versand</dt><dd id="wk-shipping">–</dd></div>
        <div class="wk-discount" id="wk-discount-row" hidden><dt>VAL-Rabatt</dt><dd id="wk-discount">–</dd></div>
        <div class="wk-total"><dt>Gesamt</dt><dd id="wk-total">0,00 €</dd></div>
      </dl>

      <section class="wk-val" aria-labelledby="wk-val-title">
        <h3 id="wk-val-title">VAL einlösen</h3>

        <p class="wk-val-state" id="wk-val-loading">Guthaben wird geprüft…</p>

        <p class="wk-val-state" id="wk-val-auth" hidden>
          <a href="/portal/">Im Portal anmelden</a>, um dein VAL-Guthaben als Rabatt einzusetzen.
          <span>1 VAL = 1,00 €</span>
        </p>

        <div id="wk-val-form" hidden>
          <p class="wk-val-balance">
            Verfügbar: <strong id="wk-val-credit">0,00 €</strong>
            <span id="wk-val-xp"></span>
          </p>

          <label for="wk-val-product">Auf welches Produkt?</label>
          <select id="wk-val-product"></select>

          <label for="wk-val-euro">Betrag</label>
          <div class="wk-val-row">
            <input id="wk-val-euro" type="number" min="0.10" step="0.10" inputmode="decimal" />
            <button type="button" id="wk-val-max">Max</button>
          </div>

          <button type="button" class="wk-val-submit" id="wk-val-submit">Rabattcode erstellen</button>
        </div>

        <p class="wk-val-status" id="wk-val-status" hidden></p>
      </section>
    </div>

    <footer class="wk-foot">
      <a class="wk-checkout" id="wk-checkout" href="#">Zur Kasse</a>
      <button type="button" class="wk-clear" id="wk-clear">Warenkorb leeren</button>
    </footer>
  </aside>

  <script id="shop-product-data" type="application/json" set:html={JSON.stringify(redemptionProducts)}></script>
  <script id="shop-config-data" type="application/json" set:html={JSON.stringify({ shop, versand })}></script>
  <script>
    import { onAuthStateChanged } from 'firebase/auth';
    import { doc, getDoc } from 'firebase/firestore';
    import { auth, db, getValusBalance, createShopifyRedemption } from '../lib/firebase-client.js';

    (() => {
      const CENTS_PER_EURO = 100;
      const MAX_QTY = 20;
      const CART_KEY = 'callidus-warenkorb';

      const items = JSON.parse(document.getElementById('shop-product-data')?.textContent || '[]');
      const config = JSON.parse(document.getElementById('shop-config-data')?.textContent || '{}');
      const drawer = document.getElementById('wk-drawer');
      if (!drawer || drawer.dataset.ready === 'true' || !items.length) return;
      drawer.dataset.ready = 'true';

      const $ = (id) => document.getElementById(id);
      const formatEuro = (cents) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' })
        .format((Number(cents) || 0) / CENTS_PER_EURO);
      const formatInt = (value) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Number(value) || 0);
      const strictItem = (id) => items.find((item) => item.id === id) || null;

      const state = {
        user: null,
        balance: { xp: 0, valus: 0 },
        // Aktive Einloesung: haelt Code und Betrag, bis der Warenkorb sich aendert.
        redemption: null,
      };

      const cart = new Map();

      // ---- Warenkorb -----------------------------------------------------
      // Shopify-Warenkorb-Permalinks nehmen mehrere Varianten kommagetrennt
      // entgegen. Dadurch braucht die Seite weder eigenen Checkout noch
      // Storefront-Token — der Sprung zur Kasse bleibt ein einfacher Link.
      function loadCart() {
        try {
          const raw = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
          for (const entry of Array.isArray(raw) ? raw : []) {
            const qty = Math.max(0, Math.min(MAX_QTY, Number(entry?.qty) || 0));
            if (qty > 0 && strictItem(entry?.id)) cart.set(entry.id, qty);
          }
        } catch (error) {
          console.warn('Warenkorb konnte nicht geladen werden', error);
        }
      }

      function saveCart() {
        try {
          localStorage.setItem(CART_KEY, JSON.stringify([...cart].map(([id, qty]) => ({ id, qty }))));
        } catch (error) {
          // Privater Modus oder volle Quota: Warenkorb gilt dann nur fuer diese Sitzung.
        }
      }

      const subtotalCents = () => [...cart].reduce(
        (sum, [id, qty]) => sum + (strictItem(id)?.preisCents || 0) * qty, 0,
      );
      const discountCents = () => (state.redemption?.creditCents || 0);
      // Shopify prueft die Versandkostengrenze gegen die rabattierte Summe.
      const shippingCents = () => (
        Math.max(0, subtotalCents() - discountCents()) >= config.versand.gratisAbCents
          ? 0
          : config.versand.pauschaleCents
      );
      const creditCents = () => Math.floor((Number(state.balance.valus) || 0) * CENTS_PER_EURO);

      function buildCheckoutUrl() {
        const parts = [...cart]
          .filter(([id, qty]) => qty > 0 && strictItem(id))
          .map(([id, qty]) => `${strictItem(id).variant}:${qty}`);
        if (!parts.length) return '';
        const code = state.redemption?.code;
        return `${config.shop}/cart/${parts.join(',')}${code ? `?discount=${encodeURIComponent(code)}` : ''}`;
      }

      function setQty(id, qty) {
        const next = Math.max(0, Math.min(MAX_QTY, qty));
        if (next === 0) cart.delete(id);
        else cart.set(id, next);
        // Ein erstellter Code haengt an einem Produkt. Faellt es aus dem Korb,
        // ist der Code hinfaellig und darf nicht weiter angerechnet werden.
        if (state.redemption && !cart.has(state.redemption.productId)) clearRedemption();
        saveCart();
        render();
      }

      function clearRedemption() {
        state.redemption = null;
        setStatus('');
      }

      // ---- Schublade -----------------------------------------------------
      let lastFocus = null;
      // Das Ausblenden laeuft verzoegert, damit die Animation sichtbar bleibt.
      // Wird zwischendurch wieder geoeffnet, muss der Timer weg — sonst
      // versteckt er die gerade geoeffnete Schublade.
      let hideTimer = null;

      function openDrawer() {
        if (!cart.size) return;
        clearTimeout(hideTimer);
        lastFocus = document.activeElement;
        $('wk-overlay').hidden = false;
        drawer.hidden = false;
        $('wk-fab').setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        // Reflow erzwingen, damit die Transition vom versteckten Zustand aus
        // greift. requestAnimationFrame waere hier unzuverlaessig, weil es in
        // nicht gezeichneten Tabs gar nicht ausgeloest wird.
        void drawer.offsetWidth;
        drawer.classList.add('is-open');
        $('wk-overlay').classList.add('is-open');
        $('wk-close').focus();
      }

      function closeDrawer() {
        drawer.classList.remove('is-open');
        $('wk-overlay').classList.remove('is-open');
        $('wk-fab').setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => {
          drawer.hidden = true;
          $('wk-overlay').hidden = true;
        }, 240);
        if (lastFocus instanceof HTMLElement) lastFocus.focus();
      }

      const setStatus = (message, kind = '') => {
        const el = $('wk-val-status');
        if (!el) return;
        el.textContent = message || '';
        el.hidden = !message;
        el.dataset.state = kind;
      };

      // ---- Darstellung ---------------------------------------------------
      function renderCartLines() {
        const list = $('wk-list');
        list.textContent = '';
        for (const [id, qty] of cart) {
          const item = strictItem(id);
          if (!item) continue;

          const li = document.createElement('li');

          const name = document.createElement('div');
          name.className = 'wk-line-name';
          name.textContent = item.titel;

          const price = document.createElement('div');
          price.className = 'wk-line-price';
          price.textContent = formatEuro(item.preisCents * qty);

          const stepper = document.createElement('div');
          stepper.className = 'wk-stepper';
          for (const step of [-1, 1]) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = step < 0 ? '−' : '+';
            btn.setAttribute('aria-label', `${step < 0 ? 'Weniger' : 'Mehr'} ${item.titel}`);
            btn.addEventListener('click', () => setQty(id, qty + step));
            if (step < 0) stepper.append(btn);
            else {
              const value = document.createElement('span');
              value.textContent = String(qty);
              stepper.append(value, btn);
            }
          }

          li.append(name, stepper, price);
          list.append(li);
        }
      }

      function renderValSection() {
        const product = $('wk-val-product');
        if (!product) return;
        const previous = product.value;
        product.textContent = '';
        for (const [id] of cart) {
          const item = strictItem(id);
          if (!item) continue;
          const option = document.createElement('option');
          option.value = item.id;
          option.textContent = item.titel;
          product.append(option);
        }
        if ([...product.options].some((o) => o.value === previous)) product.value = previous;

        const selected = strictItem(product.value);
        const max = Math.min(selected?.preisCents || 0, creditCents());
        const euro = $('wk-val-euro');
        euro.max = (max / CENTS_PER_EURO).toFixed(2);
        if (!euro.value || Number(euro.value) * CENTS_PER_EURO > max) {
          euro.value = (max / CENTS_PER_EURO).toFixed(2);
        }

        $('wk-val-credit').textContent = formatEuro(creditCents());
        $('wk-val-xp').textContent = state.balance.xp ? ` · ${formatInt(state.balance.xp)} XP` : '';
        $('wk-val-submit').disabled = max < 1 || Boolean(state.redemption);
      }

      function render() {
        const count = [...cart.values()].reduce((a, b) => a + b, 0);
        const fab = $('wk-fab');
        fab.hidden = count === 0;
        $('wk-fab-badge').textContent = String(count);

        if (count === 0) {
          if (!drawer.hidden) closeDrawer();
          return;
        }

        renderCartLines();

        const subtotal = subtotalCents();
        const discount = discountCents();
        const shipping = shippingCents();

        $('wk-subtotal').textContent = formatEuro(subtotal);
        $('wk-shipping').textContent = shipping === 0 ? 'kostenlos' : formatEuro(shipping);
        $('wk-discount-row').hidden = discount === 0;
        $('wk-discount').textContent = `− ${formatEuro(discount)}`;
        $('wk-total').textContent = formatEuro(Math.max(0, subtotal - discount) + shipping);

        const rest = config.versand.gratisAbCents - Math.max(0, subtotal - discount);
        const pct = Math.min(100, Math.round((Math.max(0, subtotal - discount) / config.versand.gratisAbCents) * 100));
        $('wk-progress-fill').style.width = `${pct}%`;
        $('wk-progress-text').textContent = rest > 0
          ? `Noch ${formatEuro(rest)} bis zum kostenlosen Versand`
          : 'Kostenloser Versand erreicht';
        $('wk-progress').dataset.done = rest > 0 ? 'false' : 'true';

        $('wk-checkout').href = buildCheckoutUrl();
        $('wk-checkout').textContent = state.redemption ? 'Zur Kasse mit Rabatt' : 'Zur Kasse';

        // Mengen auf den Produktkarten spiegeln.
        for (const item of items) {
          const qty = cart.get(item.id) || 0;
          const add = document.querySelector(`.produkt-add[data-key="${item.id}"]`);
          if (add) add.textContent = qty > 0 ? `Im Warenkorb (${qty})` : 'In den Warenkorb';
        }

        renderValSection();
      }

      // ---- Guthaben ------------------------------------------------------
      function normalizeBalance(payload = {}) {
        const raw = payload.balance || payload.balances || payload;
        const user = payload.user || payload.userDoc || {};
        const valus = Math.max(0, Number(raw.valus ?? raw.val ?? user.valus ?? user.val ?? user.valus_balance ?? 0) || 0);
        const xp = Math.max(0, Number(raw.xp ?? raw.current_xp ?? raw.total_xp ?? user.current_xp ?? user.total_xp ?? 0) || 0);
        return { valus, xp };
      }

      function showValView(id) {
        for (const viewId of ['wk-val-loading', 'wk-val-auth', 'wk-val-form']) {
          const el = $(viewId);
          if (el) el.hidden = viewId !== id;
        }
      }

      async function loadBalance(user) {
        try {
          const result = await getValusBalance()({});
          state.balance = normalizeBalance(result.data || {});
        } catch (error) {
          try {
            const [balanceSnap, userSnap] = await Promise.all([
              getDoc(doc(db, 'users', user.uid, 'balances', 'current')),
              getDoc(doc(db, 'users', user.uid)),
            ]);
            state.balance = normalizeBalance({
              balance: balanceSnap.exists() ? balanceSnap.data() : {},
              user: userSnap.exists() ? userSnap.data() : {},
            });
          } catch (fallbackError) {
            console.warn('Guthaben konnte nicht geladen werden', error, fallbackError);
            state.balance = { xp: 0, valus: 0 };
          }
        }
        render();
      }

      // ---- Ereignisse ----------------------------------------------------
      document.querySelectorAll('.produkt-add').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.key;
          setQty(key, (cart.get(key) || 0) + 1);
          openDrawer();
        });
      });

      $('wk-fab').addEventListener('click', openDrawer);
      $('wk-close').addEventListener('click', closeDrawer);
      $('wk-overlay').addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !drawer.hidden) closeDrawer();
      });

      $('wk-clear').addEventListener('click', () => {
        cart.clear();
        clearRedemption();
        saveCart();
        render();
      });

      $('wk-val-product').addEventListener('change', renderValSection);
      $('wk-val-max').addEventListener('click', () => {
        const selected = strictItem($('wk-val-product').value);
        const max = Math.min(selected?.preisCents || 0, creditCents());
        $('wk-val-euro').value = (max / CENTS_PER_EURO).toFixed(2);
      });

      $('wk-val-submit').addEventListener('click', async () => {
        setStatus('');
        if (!state.user) {
          showValView('wk-val-auth');
          return;
        }
        const item = strictItem($('wk-val-product').value);
        const euro = Number.parseFloat(String($('wk-val-euro').value || '0').replace(',', '.'));
        const wanted = Math.round((Number.isFinite(euro) ? euro : 0) * CENTS_PER_EURO);
        const credit = Math.min(wanted, item?.preisCents || 0, creditCents());
        if (!item || credit < 1) {
          setStatus('Bitte einen einlösbaren Betrag wählen.', 'error');
          return;
        }

        const button = $('wk-val-submit');
        button.disabled = true;
        setStatus('Rabattcode wird erstellt…', 'pending');
        try {
          const result = await createShopifyRedemption()({ productKey: item.id, creditCents: credit });
          const data = result.data || {};
          state.redemption = {
            code: data.code,
            creditCents: data.creditCents || credit,
            productId: item.id,
          };
          setStatus(`Code ${data.code} ist aktiv und gilt 24 Stunden. Dein Guthaben wird erst nach bestätigter Zahlung abgebucht.`, 'ok');
          render();
        } catch (error) {
          setStatus(error?.message || 'Einlösung konnte nicht erstellt werden.', 'error');
        } finally {
          button.disabled = false;
          render();
        }
      });

      // ---- Start ---------------------------------------------------------
      loadCart();
      render();
      showValView('wk-val-loading');

      try {
        onAuthStateChanged(auth, async (user) => {
          state.user = user;
          if (!user) {
            showValView('wk-val-auth');
            return;
          }
          showValView('wk-val-form');
          await loadBalance(user);
        });
      } catch (error) {
        console.warn('Firebase-Init fehlgeschlagen', error);
        showValView('wk-val-auth');
      }
    })();
  </script>
</BaseLayout>

<style>

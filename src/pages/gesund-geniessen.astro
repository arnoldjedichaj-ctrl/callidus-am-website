---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Gesund genießen: Tagesrezept & Wochenidee | callidus A&M';
const description = 'Jeden Tag ein unkompliziertes, gesundes Rezept und jede Woche eine neue Snack- oder Shake-Idee von Callidus.';
const foodEndpoint = 'https://us-central1-nexus-app-61494.cloudfunctions.net/getPublicFoodContent';
---

<BaseLayout lang="de" title={title} description={description}>
  <section class="section food-hero">
    <div class="container food-hero-grid">
      <div data-reveal>
        <p class="eyebrow">Gesund genießen</p>
        <h1>Eine gute Idee für heute. Ein Genuss für die Woche.</h1>
        <p class="lede">Jeden Morgen erscheint hier eine allgemeine, alltagstaugliche Rezeptidee. Sonntags kommt die aktuelle NEXUS Snack- oder Shake-Idee dazu – mit Zutaten, Zubereitung und Nährwerten.</p>
        <div class="actions">
          <a class="button primary" href="#tagesmahlzeit">Tagesidee ansehen</a>
          <a class="button" href="#wochenidee">Wochenidee ansehen</a>
        </div>
      </div>
      <aside class="food-hero-note" data-reveal="2" aria-label="So funktionieren die Rezeptideen">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path><path d="M8 13h3M8 16h6"></path></svg>
        <div><strong>Automatisch aktuell</strong><p>Die Tagesidee wird morgens neu erstellt. Die Wochenidee kommt direkt aus dem bestehenden NEXUS Rhythmus.</p></div>
      </aside>
    </div>
  </section>

  <section class="section food-section" id="tagesmahlzeit">
    <div class="container">
      <div class="food-section-heading" data-reveal>
        <div><p class="eyebrow">Heute auf dem Tisch</p><h2>Die gesunde Tagesidee</h2></div>
        <p>Ein allgemeines Rezept für alle – ohne Login und ohne persönliche Daten.</p>
      </div>
      <nav class="food-daynav" data-food-daynav="daily" hidden aria-label="Zwischen den Tagesideen wechseln">
        <button class="food-daynav-button" type="button" data-food-step="1">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
          <span>Vorheriger Tag</span>
        </button>
        <p class="food-daynav-label"><strong data-food-nav-date></strong><small data-food-nav-note></small></p>
        <button class="food-daynav-button" type="button" data-food-step="-1">
          <span>Nächster Tag</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </nav>
      <article class="food-recipe-card is-loading" data-food-card="daily" aria-busy="true" data-reveal="2">
        <div class="food-image-wrap" data-food-image-wrap hidden><img data-food-image alt="" width="1024" height="768" loading="eager" decoding="async" /></div>
        <div class="food-recipe-body">
          <div class="food-card-topline"><span class="badge mint" data-food-badge>Tagesidee</span><time data-food-date></time></div>
          <p class="food-loading" data-food-state aria-live="polite">Die heutige Tagesidee wird geladen…</p>
          <div data-food-content hidden>
            <h3 data-food-title></h3><p class="food-description" data-food-description></p>
            <div class="food-facts" data-food-facts aria-label="Nährwerte pro Portion"></div><p class="food-prep-time" data-food-prep-time></p>
            <div class="food-actions">
              <button class="button primary food-details-toggle" type="button" data-food-toggle aria-expanded="false" aria-controls="tagesidee-details">Rezept ansehen</button>
              <a class="button food-action-ghost" href="/nexus-app/">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M4.2 7.5l2.6 1.5M17.2 15l2.6 1.5M4.2 16.5l2.6-1.5M17.2 9l2.6-1.5"></path><circle cx="12" cy="12" r="3.4"></circle></svg>
                <span>Persönlich mit KI erstellen</span>
              </a>
            </div>
            <div class="food-details" id="tagesidee-details" data-food-details hidden>
              <div class="food-details-grid">
                <div><h4>Zutaten</h4><ul data-food-ingredients></ul></div>
                <div><h4>Zubereitung</h4><ol data-food-preparation></ol></div>
              </div>
              <div class="food-quick" data-food-quick hidden>
                <p class="food-quick-head">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.5.4.8 1 .9 1.6h5.4c.1-.6.4-1.2.9-1.6A6 6 0 0 0 12 3Z"></path></svg>
                  <strong data-food-quick-title>Schnelle Alternative</strong>
                  <span class="food-quick-time" data-food-quick-time hidden></span>
                </p>
                <p class="food-quick-description" data-food-quick-description></p>
                <ol class="food-quick-steps" data-food-quick-steps></ol>
              </div>
            </div>
          </div>
        </div>
      </article>
      <section class="food-history" data-food-history-section="daily" hidden aria-label="Letzte sieben Tagesideen">
        <h3>Weitere Tagesideen</h3><div class="food-history-list" data-food-history="daily"></div>
      </section>
    </div>
  </section>

  <section class="section band food-section" id="wochenidee">
    <div class="container">
      <div class="food-section-heading" data-reveal>
        <div><p class="eyebrow">NEXUS Wochenidee</p><h2>Snack oder Shake der Woche</h2></div>
        <p>Jeden Sonntag neu: eine leichte, praktische Idee für zwischendurch.</p>
      </div>
      <nav class="food-daynav" data-food-daynav="weekly" hidden aria-label="Zwischen den Wochenideen wechseln">
        <button class="food-daynav-button" type="button" data-food-step="1">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
          <span>Vorherige Woche</span>
        </button>
        <p class="food-daynav-label"><strong data-food-nav-date></strong><small data-food-nav-note></small></p>
        <button class="food-daynav-button" type="button" data-food-step="-1">
          <span>Nächste Woche</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </nav>
      <article class="food-recipe-card food-recipe-card--weekly is-loading" data-food-card="weekly" aria-busy="true" data-reveal="2">
        <div class="food-image-wrap" data-food-image-wrap hidden><img data-food-image alt="" width="1024" height="768" loading="lazy" decoding="async" /></div>
        <div class="food-recipe-body">
          <div class="food-card-topline"><span class="badge gold" data-food-badge>Wochenidee</span><time data-food-date></time></div>
          <p class="food-loading" data-food-state aria-live="polite">Die aktuelle Wochenidee wird geladen…</p>
          <div data-food-content hidden>
            <h3 data-food-title></h3><p class="food-description" data-food-description></p>
            <div class="food-facts" data-food-facts aria-label="Nährwerte pro Portion"></div><p class="food-prep-time" data-food-prep-time></p>
            <div class="food-actions">
              <button class="button primary food-details-toggle" type="button" data-food-toggle aria-expanded="false" aria-controls="wochenidee-details">Rezept ansehen</button>
              <a class="button food-action-ghost" href="/nexus-app/">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M4.2 7.5l2.6 1.5M17.2 15l2.6 1.5M4.2 16.5l2.6-1.5M17.2 9l2.6-1.5"></path><circle cx="12" cy="12" r="3.4"></circle></svg>
                <span>Persönlich mit KI erstellen</span>
              </a>
            </div>
            <div class="food-details" id="wochenidee-details" data-food-details hidden>
              <div class="food-details-grid">
                <div><h4>Zutaten</h4><ul data-food-ingredients></ul></div>
                <div><h4>Zubereitung</h4><ol data-food-preparation></ol></div>
              </div>
            </div>
          </div>
        </div>
      </article>
      <section class="food-history" data-food-history-section="weekly" hidden aria-label="Letzte sieben Wochenideen">
        <h3>Weitere Wochenideen</h3><div class="food-history-list" data-food-history="weekly"></div>
      </section>
      <p class="food-disclaimer" data-reveal="3">Nährwerte sind Orientierungswerte pro Portion. Die Ideen ersetzen keine individuelle Ernährungs- oder medizinische Beratung.</p>
    </div>
  </section>

  <script is:inline define:vars={{ foodEndpoint }}>
    (() => {
      const formatDate = (key) => /^\d{4}-\d{2}-\d{2}$/.test(key || '') ? new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }).format(new Date(`${key}T12:00:00`)) : '';
      const list = (target, values) => {
        target.replaceChildren();
        (Array.isArray(values) ? values : []).forEach((value) => {
          const item = document.createElement('li');
          item.textContent = typeof value === 'string' ? value : `${value.amount || ''} ${value.name || ''}`.trim();
          if (item.textContent) target.append(item);
        });
        target.parentElement.hidden = target.children.length === 0;
      };
      const facts = (target, nutrition = {}) => {
        target.replaceChildren();
        [['Kalorien', nutrition.calories, 'kcal'], ['Eiweiß', nutrition.protein, 'g'], ['Kohlenhydrate', nutrition.carbs, 'g'], ['Fett', nutrition.fat, 'g']]
          .filter(([, value]) => Number.isFinite(Number(value)))
          .forEach(([label, value, unit]) => {
            const item = document.createElement('span');
            const number = document.createElement('strong'); number.textContent = `${Math.round(Number(value))} ${unit}`;
            const text = document.createElement('small'); text.textContent = label;
            item.append(number, text); target.append(item);
          });
        target.hidden = !target.children.length;
      };
      const unavailable = (kind, message) => {
        const card = document.querySelector(`[data-food-card="${kind}"]`);
        if (!card) return;
        card.classList.remove('is-loading'); card.setAttribute('aria-busy', 'false');
        card.querySelector('[data-food-state]').textContent = message;
      };
      const quickAlternative = (card, value) => {
        const box = card.querySelector('[data-food-quick]');
        if (!box) return;
        const content = !value ? null : (typeof value === 'string' ? { description: value, steps: [] } : value);
        const steps = (content && Array.isArray(content.steps) ? content.steps : []).filter(Boolean);
        if (!content || (!content.description && !steps.length)) { box.hidden = true; return; }
        box.hidden = false;
        box.querySelector('[data-food-quick-title]').textContent = content.title || 'Schnelle Alternative';
        const time = box.querySelector('[data-food-quick-time]');
        time.textContent = content.prepTime ? `ca. ${content.prepTime} Min.` : '';
        time.hidden = !content.prepTime;
        box.querySelector('[data-food-quick-description]').textContent = content.description || '';
        const target = box.querySelector('[data-food-quick-steps]');
        target.replaceChildren();
        steps.forEach((step) => { const item = document.createElement('li'); item.textContent = step; target.append(item); });
        target.hidden = steps.length === 0;
      };
      const recipe = (kind, content) => {
        const card = document.querySelector(`[data-food-card="${kind}"]`);
        if (!card || !content) return;
        const state = card.querySelector('[data-food-state]'); const body = card.querySelector('[data-food-content]');
        card.classList.remove('is-loading'); card.setAttribute('aria-busy', 'false'); state.hidden = true; body.hidden = false;
        card.querySelector('[data-food-title]').textContent = content.title || 'Rezeptidee';
        card.querySelector('[data-food-description]').textContent = content.description || '';
        card.querySelector('[data-food-prep-time]').textContent = content.prepTime ? `Zubereitungszeit: ca. ${content.prepTime} Minuten` : '';
        quickAlternative(card, content.quickAlternative);
        const date = card.querySelector('[data-food-date]'); const dateKey = content.dateKey || content.publishedDate || '';
        date.textContent = formatDate(dateKey); date.dateTime = dateKey;
        card.querySelector('[data-food-badge]').textContent = kind === 'weekly' ? (content.type || 'Wochenidee') : 'Tagesidee';
        facts(card.querySelector('[data-food-facts]'), content.nutrition); list(card.querySelector('[data-food-ingredients]'), content.ingredients); list(card.querySelector('[data-food-preparation]'), content.preparation);
        const image = card.querySelector('[data-food-image]'); const wrap = card.querySelector('[data-food-image-wrap]');
        if (content.imageUrl) {
          // Laedt das Bild nicht, bleibt die Karte einspaltig statt mit leerer Bildspalte.
          image.onerror = () => { wrap.hidden = true; card.classList.remove('has-image'); };
          image.src = content.imageUrl; image.alt = `Serviervorschlag: ${content.title || 'gesunde Rezeptidee'}`;
          wrap.hidden = false; card.classList.add('has-image');
        } else {
          image.removeAttribute('src'); wrap.hidden = true; card.classList.remove('has-image');
        }
        const toggle = card.querySelector('[data-food-toggle]'); const details = card.querySelector('[data-food-details]');
        if (!toggle.dataset.foodToggleReady) {
          toggle.dataset.foodToggleReady = 'true';
          toggle.addEventListener('click', () => { details.hidden = !details.hidden; toggle.setAttribute('aria-expanded', String(!details.hidden)); toggle.textContent = details.hidden ? 'Rezept ansehen' : 'Rezept schließen'; });
        }
      };
      // Die Historie kommt neu zuerst; Index 0 ist damit immer die aktuelle Idee.
      const archive = (kind, entries) => {
        const values = (Array.isArray(entries) ? entries : []).filter(Boolean).slice(0, 7);
        const section = document.querySelector(`[data-food-history-section="${kind}"]`);
        const target = section?.querySelector('[data-food-history]');
        const nav = document.querySelector(`[data-food-daynav="${kind}"]`);
        if (!values.length) { if (section) section.hidden = true; if (nav) nav.hidden = true; return; }
        let index = 0;
        const label = nav?.querySelector('[data-food-nav-date]'); const note = nav?.querySelector('[data-food-nav-note]');
        const buttons = [];
        const show = (next) => {
          index = Math.min(Math.max(next, 0), values.length - 1);
          const entry = values[index];
          recipe(kind, entry);
          buttons.forEach((button, position) => button.setAttribute('aria-pressed', String(position === index)));
          if (!nav) return;
          label.textContent = formatDate(entry.dateKey || entry.publishedDate || '') || (entry.title || '');
          note.textContent = index === 0
            ? (kind === 'weekly' ? 'Aktuelle Wochenidee' : 'Heute')
            : `${index} ${kind === 'weekly' ? (index === 1 ? 'Woche' : 'Wochen') : (index === 1 ? 'Tag' : 'Tage')} zurück`;
          nav.querySelectorAll('[data-food-step]').forEach((button) => {
            const step = Number(button.dataset.foodStep);
            button.disabled = index + step < 0 || index + step > values.length - 1;
          });
        };
        if (target) {
          target.replaceChildren();
          values.forEach((entry, position) => {
            const button = document.createElement('button'); button.type = 'button'; button.className = 'food-history-item';
            const date = document.createElement('small'); date.textContent = formatDate(entry.dateKey || entry.publishedDate || '');
            const title = document.createElement('strong'); title.textContent = entry.title || 'Rezeptidee';
            button.append(date, title);
            button.addEventListener('click', () => { show(position); nav?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
            buttons.push(button); target.append(button);
          });
          section.hidden = values.length < 2;
        }
        if (nav) {
          nav.hidden = values.length < 2;
          // Der Handler wird bei jedem Laden neu gesetzt, der Listener nur einmal
          // registriert - sonst bliebe nach astro:page-load der alte Stand aktiv.
          nav.foodStep = (delta) => show(index + delta);
          if (!nav.dataset.foodNavReady) {
            nav.dataset.foodNavReady = 'true';
            nav.addEventListener('click', (event) => {
              const button = event.target.closest('[data-food-step]');
              if (button && !button.disabled) nav.foodStep(Number(button.dataset.foodStep));
            });
          }
        }
        show(0);
      };
      const load = async () => {
        try {
          const response = await fetch(foodEndpoint, { headers: { Accept: 'application/json' } }); if (!response.ok) throw new Error();
          const content = await response.json();
          const dailyEntries = content.dailyHistory?.length ? content.dailyHistory : (content.daily ? [content.daily] : []);
          const weeklyEntries = content.weeklyHistory?.length ? content.weeklyHistory : (content.weekly ? [content.weekly] : []);
          dailyEntries.length ? archive('daily', dailyEntries) : unavailable('daily', 'Die heutige Tagesidee wird gerade vorbereitet. Schau bitte in Kürze noch einmal vorbei.');
          weeklyEntries.length ? archive('weekly', weeklyEntries) : unavailable('weekly', 'Die neue Wochenidee erscheint am Sonntag nach 12 Uhr.');
        } catch (_) {
          unavailable('daily', 'Die Tagesmahlzeit ist gerade nicht erreichbar. Bitte versuche es später noch einmal.');
          unavailable('weekly', 'Die Wochenidee ist gerade nicht erreichbar. Bitte versuche es später noch einmal.');
        }
      };
      load(); document.addEventListener('astro:page-load', load);
    })();
  </script>

  <style is:global>
    .food-hero { overflow:hidden; background:radial-gradient(circle at 85% 10%,rgba(var(--gold-rgb),.17),transparent 30rem),linear-gradient(135deg,rgba(var(--mint-rgb),.12),rgba(var(--gold-rgb),.07)); }
    .food-hero-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr); gap:clamp(1.5rem,5vw,4rem); align-items:center; }.food-hero h1{max-width:13ch}
    .food-hero-note{display:flex;gap:1rem;align-items:flex-start;padding:clamp(1.25rem,3vw,1.75rem);border:1px solid rgba(var(--mint-rgb),.28);border-radius:1.15rem;background:var(--panel);box-shadow:var(--shadow)}.food-hero-note svg{width:2rem;height:2rem;flex:0 0 auto;color:var(--mint)}.food-hero-note strong{display:block;margin-bottom:.3rem;font-size:1.05rem}.food-hero-note p,.food-section-heading>p,.food-description,.food-disclaimer{margin:0;color:var(--muted);line-height:1.65}
    .food-section-heading{display:flex;justify-content:space-between;gap:1.5rem;align-items:end;margin-bottom:1.4rem}.food-section-heading h2{margin-bottom:0}.food-section-heading>p{max-width:36rem}
    .food-recipe-card{display:grid;grid-template-columns:minmax(0,1fr);min-height:330px;overflow:hidden;border:1px solid var(--line);border-radius:1.15rem;background:var(--panel);box-shadow:var(--shadow)}.food-recipe-card.has-image{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr)}.food-recipe-card--weekly.has-image{grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr)}.food-recipe-card--weekly .food-image-wrap{order:2}.food-image-wrap{min-height:100%;background:linear-gradient(135deg,rgba(var(--mint-rgb),.13),rgba(var(--gold-rgb),.12))}.food-image-wrap img{display:block;width:100%;height:100%;min-height:330px;object-fit:cover}
    .food-recipe-body{display:grid;align-content:start;gap:1rem;padding:clamp(1.3rem,3vw,2.1rem)}.food-card-topline{display:flex;gap:.75rem;align-items:center;justify-content:space-between}.food-card-topline time{color:var(--muted);font-size:.86rem;text-align:right}.food-recipe-body h3{margin:0;font-size:clamp(1.45rem,3vw,2rem);line-height:1.2}.food-loading{margin:auto 0;color:var(--muted);line-height:1.6}.food-recipe-card.is-loading .food-recipe-body{background:linear-gradient(90deg,transparent,rgba(var(--mint-rgb),.05),transparent);background-size:200% 100%;animation:foodLoading 1.6s ease-in-out infinite}
    .food-facts{display:flex;flex-wrap:wrap;gap:.6rem}.food-facts span{display:grid;gap:.1rem;min-width:5.2rem;padding:.55rem .7rem;border:1px solid rgba(var(--mint-rgb),.24);border-radius:.65rem;background:rgba(var(--mint-rgb),.07)}.food-facts strong{font-size:.92rem}.food-facts small{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}.food-prep-time{margin:0;color:var(--soft);font-size:.9rem}.food-recipe-body [data-food-content]:not([hidden]){display:grid;gap:1rem}
    .food-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:.9rem 0 .35rem}.food-actions .button{min-height:48px;padding:.72rem 1.35rem;gap:.5rem}.food-actions .button svg{width:1.1rem;height:1.1rem;flex:0 0 auto}.food-action-ghost{background:transparent;border-color:rgba(var(--mint-rgb),.5);color:var(--text);box-shadow:none}.food-action-ghost:hover{background:rgba(var(--mint-rgb),.1);border-color:rgba(var(--mint-rgb),.75);color:var(--text)}.food-actions .button:focus-visible{outline:3px solid rgba(var(--mint-rgb),.45);outline-offset:2px}
    .food-details{display:grid;gap:1.35rem;padding-top:.35rem;border-top:1px solid var(--line);margin-top:.35rem}.food-details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;padding-top:.9rem}.food-details h4{margin:0 0 .55rem;font-size:.9rem;text-transform:uppercase;letter-spacing:.08em}.food-details ul,.food-details ol{display:grid;gap:.45rem;margin:0;padding-left:1.1rem;color:var(--muted);line-height:1.5}.food-disclaimer{margin-top:1.2rem;font-size:.84rem}
    .food-details[hidden],.food-quick[hidden],.food-quick-steps[hidden],.food-quick-time[hidden],.food-daynav[hidden]{display:none}
    .food-quick{display:grid;gap:.6rem;padding:1rem 1.1rem;border:1px solid rgba(var(--mint-rgb),.3);border-left:4px solid var(--mint);border-radius:.9rem;background:rgba(var(--mint-rgb),.08)}.food-quick-head{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin:0}.food-quick-head svg{width:1.25rem;height:1.25rem;flex:0 0 auto;color:var(--mint)}.food-quick-head strong{font-size:1rem}.food-quick-time{padding:.15rem .55rem;border-radius:999px;background:rgba(var(--mint-rgb),.2);color:var(--text);font-size:.75rem;font-weight:700}.food-quick-description{margin:0;color:var(--soft);font-size:.92rem;line-height:1.6}.food-quick-steps{display:grid;gap:.4rem;margin:0;padding-left:1.1rem;color:var(--muted);font-size:.9rem;line-height:1.5}

---
import BaseLayout from '../layouts/BaseLayout.astro';

// Das Digistore24-Partnerprogramm fuer die Kinderbuchreihe ist seit November 2026 beendet:
// Die E-Books sind exklusiv bei Amazon (KDP Select). Die Seite bleibt erreichbar, damit
// bestehende Partnerlinks nicht ins Leere laufen.
const title = 'Partnerprogramm beendet: Callis Gesundheits-Kompass | callidus A&M';
const description = 'Das Digistore24-Partnerprogramm für die Kinderbuchreihe Callis Gesundheits-Kompass ist beendet. Die Bücher gibt es als Taschenbuch und Kindle-E-Book bei Amazon.';
const cover = '/assets/kinderbuch/cover-band1.jpg';
---

<BaseLayout lang="de" title={title} description={description} ogImage={cover} robots="noindex, follow">
  <section class="section">
    <div class="container" style="max-width: 760px">
      <p class="eyebrow" data-reveal>Digistore24 · Affiliate-Support</p>
      <h1 data-reveal="2">Das Partnerprogramm ist beendet.</h1>
      <p class="lede" data-reveal="3">
        Danke an alle, die Callis Gesundheits-Kompass empfohlen haben. Die sechs Bände gibt es nicht mehr
        als PDF über Digistore24, sondern als Taschenbuch und Kindle-E-Book bei Amazon. Deshalb werden
        über Digistore24 keine neuen Verkäufe und Provisionen mehr erfasst.
      </p>
      <p data-reveal="3">
        Bereits erfasste Provisionen rechnet Digistore24 wie gewohnt ab. Wer die Reihe weiter empfehlen
        möchte, kann das über das eigene Amazon-Partnerprogramm tun.
      </p>
      <p data-reveal="4"><a class="button primary" href="/kinderbuch/">Zur Buchreihe</a></p>
    </div>
  </section>
</BaseLayout>

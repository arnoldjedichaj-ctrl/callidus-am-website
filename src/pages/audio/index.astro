---
import BaseLayout from '../../layouts/BaseLayout.astro';
import audioSessions from '../../data/audio-sessions.json';
import articles from '../../data/articles.json';
import structure from '../../data/site-structure.json';

const title = 'Audio-Raum: geführte Klarheit, Fokus und Ruhe | callidus A&M';
const description = 'Geführte Audio-Sessions von callidus A&M für Klarheit, Fokus, innere Ordnung und ruhige Mikro-Routinen im Alltag.';
const siteOrigin = 'https://www.callidus-am.de';
const publishedSessions = audioSessions.filter((session) => session.status === 'published');
const plannedSessions = audioSessions.filter((session) => session.status === 'planned');
const featured = publishedSessions[0];
const podcastCategoryFor = (article) => {
  const haystack = `${article.slug || ''} ${article.title || ''} ${article.description || ''} ${(article.h2 || []).join(' ')}`.toLowerCase();
  return structure.categories.find((category) =>
    category.keywords.some((keyword) => haystack.includes(keyword))
  ) || structure.categories.find((category) => category.slug === 'zukunft-gesundheit');
};
const podcastEpisodes = articles.flatMap((article) => {
  const podcast = article.media?.find((media) => media.type === 'audio' && /podcast/i.test(media.title || ''));
  if (!podcast?.src) return [];
  const category = podcastCategoryFor(article);
  const duration = podcast.title?.match(/(\d{1,2}:\d{2})/)?.[1] || 'Podcast';
  return [{
    title: (article.title || '').replace(/\s*\|\s*callidus A&M\s*$/i, ''),
    description: article.description || article.h2?.[0] || '',
    path: article.path,
    src: podcast.src,
    duration,
    category,
  }];
}).sort((a, b) => a.category.title.localeCompare(b.category.title, 'de') || a.title.localeCompare(b.title, 'de'));
const podcastCategories = structure.categories.filter((category) =>
  podcastEpisodes.some((episode) => episode.category.slug === category.slug)
);
const audioObjects = publishedSessions.map((session) => ({
  '@context': 'https://schema.org',
  '@type': 'AudioObject',
  name: session.title,
  description: session.summary,
  contentUrl: new URL(session.path, siteOrigin).href,
  duration: `PT${Math.round((session.durationSeconds || 0) / 60)}M`,
  encodingFormat: 'audio/mpeg',
  inLanguage: 'de-DE',
  datePublished: session.publishedAt,
  publisher: {
    '@type': 'Organization',
    name: 'callidus A&M',
    url: siteOrigin,
  },
}));
---

<BaseLayout lang="de" title={title} description={description}>
  {audioObjects.map((object) => (
    <script type="application/ld+json" set:html={JSON.stringify(object)}></script>
  ))}

  <section class="section audio-hero">
    <div class="container audio-hero-grid">
      <div data-reveal>
        <p class="eyebrow">Callidus Audio-Raum</p>
        <h1>Geführte Klarheit, wenn der Kopf zu voll ist.</h1>
        <p class="lede">
          Kuratierte Audio-Sessions für Fokus, innere Ordnung und kurze mentale Reset-Momente.
          Neben dem 15-Minuten-Klarheitsreset findest du hier auch intensive Breathwork und klare Sprachimpulse ohne Hintergrundmusik.
        </p>
        <div class="actions">
          <a class="button primary" href="#aktuelle-folge">Jetzt anhören</a>
          <a class="button" href="#hinweise">Hinweise lesen</a>
        </div>
      </div>

      {featured && (
        <aside class="audio-feature-player" id="aktuelle-folge" data-reveal="2" aria-labelledby="featured-audio-title">
          <div class="audio-player-topline">
            <span class={`badge ${featured.accent}`}>{featured.badge}</span>
            <span>{featured.duration}</span>
          </div>
          <h2 id="featured-audio-title">{featured.title}</h2>
          <p>{featured.summary}</p>
          <audio class="audio-player" controls preload="metadata" src={featured.path}>
            Dein Browser kann diese Audio-Datei nicht direkt abspielen.
          </audio>
          <div class="audio-waveform" aria-hidden="true">
            {Array.from({ length: 28 }).map((_, index) => (
              <span style={`--bar:${(index % 7) + 2}`}></span>
            ))}
          </div>
          <div class="audio-player-actions">
            <a class="button" href={featured.path} download>Audio herunterladen</a>
          </div>
        </aside>
      )}
    </div>
  </section>

  <section class="section tight">
    <div class="container audio-intro-grid">
      <article class="audio-principle" data-reveal>
        <span class="audio-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M7 12h10M10 18h4"></path>
          </svg>
        </span>
        <h2>Sortieren</h2>
        <p>Die Führung hilft, offene Gedanken aus dem Kopf zu nehmen und in eine ruhigere Reihenfolge zu bringen.</p>
      </article>
      <article class="audio-principle" data-reveal="2">
        <span class="audio-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8"></circle>
            <circle cx="12" cy="12" r="2.6"></circle>
          </svg>
        </span>
        <h2>Fokussieren</h2>
        <p>Statt alles auf einmal zu wollen, wird am Ende ein einzelner nächster Schritt wichtiger als perfekte Pläne.</p>
      </article>
      <article class="audio-principle" data-reveal="3">
        <span class="audio-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 12 4 4L19 6"></path>
          </svg>
        </span>
        <h2>Handeln</h2>
        <p>Die Session endet nicht im Schweben, sondern mit einer kleinen, alltagstauglichen Entscheidung.</p>
      </article>
    </div>
  </section>

  {featured && (
    <section class="section band">
      <div class="container split audio-detail-split">
        <div class="sticky-note" data-reveal>
          <p class="eyebrow">So nutzt du die Folge</p>
          <h2>15 Minuten, ein ruhiger Ort, keine Leistung.</h2>
          <p>
            Setz dich bequem hin, nutze bei Bedarf Kopfhörer und lass das Audio im Hintergrund tragen.
            Die Folge arbeitet bewusst ohne starkes Luftanhalten oder forcierte Atemtechnik.
          </p>
          <p>
            Wenn sich etwas unangenehm anfühlt, brich die Session ab, öffne die Augen und orientiere dich im Raum.
          </p>
        </div>
        <div class="audio-use-panel" data-reveal="2">
          <div>
            <h3>Geeignet für</h3>
            <ul>
              {featured.bestFor.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3>Am Ende soll entstehen</h3>
            <ul>
              {featured.outcomes.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3>Gute Momente dafür</h3>
            <ul>
              {featured.listenWhen.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Audiothek</p>
      <h2 data-reveal="2">Aktuelle und kommende Folgen.</h2>
      <div class="audio-session-grid">
        {audioSessions.map((session, index) => (
          <article class={`audio-session-card audio-session-${session.status}`} data-reveal={String((index % 3) + 1)}>
            <div class="audio-card-meta">
              <span class={`badge ${session.accent}`}>{session.badge}</span>
              <span>{session.duration}</span>
            </div>
            <h3>{session.title}</h3>
            <p>{session.summary}</p>
            {session.status === 'published' ? (
              <>
                {session.safety && <p class="audio-card-safety">{session.safety}</p>}
                <audio class="audio-card-player" controls preload="metadata" src={session.path}>
                  Dein Browser kann diese Audio-Datei nicht direkt abspielen.
                </audio>
                <div class="audio-card-actions">
                  <a class="button" href={session.path} download>Herunterladen</a>
                </div>
              </>
            ) : (
              <span class="audio-coming-soon">In Vorbereitung</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {podcastEpisodes.length > 0 && (
    <section class="section band" id="podcasts">
      <div class="container">
        <p class="eyebrow" data-reveal>Podcast-Bibliothek</p>
        <h2 data-reveal="2">Gesundheitswissen zum Anhören.</h2>
        <p class="lede podcast-lede" data-reveal="3">
          Diese Folgen gehören zu den Ratgeber-Artikeln. Wähle ein Thema, höre direkt hinein oder lies den passenden Artikel weiter.
        </p>

        <form class="podcast-filter" data-podcast-filter aria-label="Podcast-Bibliothek filtern" data-reveal="2">
          <label>
            <span>Podcast suchen</span>
            <input type="search" name="query" placeholder="Thema oder Stichwort" autocomplete="off" />
          </label>
          <label>
            <span>Kategorie</span>
            <select name="category">
              <option value="">Alle Kategorien</option>
              {podcastCategories.map((category) => <option value={category.slug}>{category.title}</option>)}
            </select>
          </label>
          <button type="reset">Zurücksetzen</button>
        </form>
        <p class="podcast-count" data-podcast-count>{podcastEpisodes.length} Podcast-Folgen</p>

        <div class="podcast-grid" data-podcast-grid>
          {podcastEpisodes.map((episode, index) => (
            <article
              class="podcast-card"
              data-podcast-card
              data-category={episode.category.slug}
              data-search={`${episode.title} ${episode.description} ${episode.category.title}`.toLowerCase()}
              data-reveal={String((index % 3) + 1)}
            >
              <div class="audio-card-meta">
                <span class={`badge ${episode.category.accent}`}>{episode.category.title}</span>
                <span>{episode.duration} Min.</span>
              </div>
              <h3>{episode.title}</h3>
              <p>{episode.description}</p>
              <audio class="audio-card-player" controls preload="none" src={episode.src}>
                Dein Browser kann diese Podcast-Folge nicht direkt abspielen.
              </audio>
              <div class="audio-card-actions">
                <a class="button" href={episode.path}>Artikel lesen</a>
                <a class="podcast-source-link" href={episode.src} target="_blank" rel="noopener">Audio öffnen</a>
              </div>
            </article>
          ))}
        </div>
        <p class="podcast-empty" data-podcast-empty hidden>Zu dieser Auswahl wurde keine Podcast-Folge gefunden.</p>
      </div>
    </section>
  )}

  {featured && (
    <section class="section band" id="hinweise">
      <div class="container split audio-trust-split">
        <div data-reveal>
          <p class="eyebrow">Transparenz</p>
          <h2>Produktion, Rechte und Einordnung.</h2>
          <p class="lede">
            Professionelle Audio-Angebote sollten klar sagen, was sie sind: eine geführte Selbstreflexion,
            kein Heilversprechen und keine medizinische oder psychotherapeutische Behandlung.
          </p>
        </div>
        <div class="audio-trust-panel" data-reveal="2">
          <dl>
            <div>
              <dt>Stimme</dt>
              <dd>{featured.production.voice}</dd>
            </div>
            <div>
              <dt>Musik</dt>
              <dd>
                <a href={featured.production.musicSource} target="_blank" rel="noopener">
                  {featured.production.musicTitle} von {featured.production.musicCreator}
                </a>
              </dd>
            </div>
            <div>
              <dt>Lizenz</dt>
              <dd>
                <a href={featured.production.musicLicenseUrl} target="_blank" rel="noopener">
                  {featured.production.musicLicense}
                </a>
              </dd>
            </div>
            <div>
              <dt>Atmosphäre</dt>
              <dd>{featured.production.background}</dd>
            </div>
            <div>
              <dt>Skript</dt>
              <dd>{featured.production.note}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="container audio-safety" data-reveal>
      <strong>Wichtiger Hinweis</strong>
      <p>
        Die Audio-Sessions dienen der allgemeinen Entspannung, Selbstreflexion und mentalen Orientierung.
        Sie ersetzen keine Diagnose, Therapie, Notfallhilfe oder ärztliche Beratung. Bitte nicht beim Autofahren,
        Bedienen von Maschinen oder in Situationen nutzen, die volle Aufmerksamkeit erfordern.
      </p>
    </div>
  </section>

  <script is:inline>
    const setupPodcastFilter = () => {
      const form = document.querySelector('[data-podcast-filter]');
      const cards = Array.from(document.querySelectorAll('[data-podcast-card]'));
      const count = document.querySelector('[data-podcast-count]');
      const empty = document.querySelector('[data-podcast-empty]');
      if (!form || !cards.length || form.dataset.ready) return;
      form.dataset.ready = 'true';

      const update = () => {
        const query = (form.query.value || '').trim().toLowerCase();
        const category = form.category.value;
        let visible = 0;
        cards.forEach((card) => {
          const show = (!query || card.dataset.search.includes(query)) && (!category || card.dataset.category === category);
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (count) count.textContent = `${visible} ${visible === 1 ? 'Podcast-Folge' : 'Podcast-Folgen'}`;
        if (empty) empty.hidden = visible !== 0;
      };

      form.addEventListener('input', update);
      form.addEventListener('change', update);
      form.addEventListener('reset', () => window.setTimeout(update, 0));
    };
    setupPodcastFilter();
    document.addEventListener('astro:page-load', setupPodcastFilter);
  </script>
</BaseLayout>

<style>
.audio-hero {
  padding-bottom: clamp(2rem, 5vw, 4rem);
}
.audio-hero-grid,
.audio-detail-split,
.audio-trust-split {
  display: grid;
  grid-template-columns: minmax(0, .95fr) minmax(320px, .75fr);
  gap: clamp(1.5rem, 5vw, 4rem);
  align-items: center;
}
.audio-hero h1 {
  max-width: 12ch;
}
.audio-feature-player,
.audio-principle,
.audio-use-panel,
.audio-session-card,
.podcast-card,
.audio-trust-panel,
.audio-safety {
  border: 1px solid var(--line);
  border-radius: .9rem;
  background: var(--panel);
  box-shadow: 0 18px 52px rgba(58, 64, 38, .12);
}
.audio-feature-player {
  display: grid;
  gap: 1rem;
  padding: clamp(1rem, 3vw, 1.4rem);
  background:
    linear-gradient(135deg, rgba(var(--mint-rgb), .10), rgba(var(--gold-rgb), .07)),
    var(--panel);
}
.audio-player-topline,
.audio-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .75rem;
}
.audio-player-topline > span:last-child,
.audio-card-meta > span:last-child {
  color: var(--muted);
  font-size: .84rem;
  font-weight: 850;
}
.audio-feature-player h2,
.audio-feature-player p,
.audio-principle h2,
.audio-principle p,
.audio-session-card h3,
.audio-session-card p,
.audio-safety p {
  margin: 0;
}
.audio-feature-player h2 {
  font-size: clamp(1.7rem, 3.2vw, 2.5rem);
}
.audio-player {
  width: 100%;
  min-height: 44px;
  accent-color: var(--mint);
}
.audio-waveform {
  display: grid;
  grid-template-columns: repeat(28, 1fr);
  align-items: end;
  gap: .22rem;
  height: 4.2rem;
  padding: .7rem;
  border: 1px solid rgba(var(--mint-rgb), .18);
  border-radius: .75rem;
  background: rgba(var(--mint-rgb), .05);
}
.audio-waveform span {
  display: block;
  height: calc(var(--bar) * .42rem);
  border-radius: 999px;
  background: linear-gradient(180deg, var(--mint), var(--gold));
  opacity: .78;
}
.audio-player-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .65rem;
}
.audio-intro-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}
.audio-principle {
  display: grid;
  gap: .75rem;
  padding: clamp(1rem, 3vw, 1.25rem);
}
.audio-icon {
  display: grid;
  place-items: center;
  width: 2.6rem;
  height: 2.6rem;
  border-radius: 50%;
  background: rgba(var(--mint-rgb), .10);
  color: var(--mint);
}
.audio-icon svg {
  width: 1.35rem;
  height: 1.35rem;
}
.audio-principle h2 {
  font-size: clamp(1.25rem, 2vw, 1.6rem);
}
.audio-use-panel {
  display: grid;
  gap: 1rem;
  padding: clamp(1rem, 3vw, 1.25rem);
}
.audio-use-panel > div {
  border: 1px solid rgba(var(--mint-rgb), .18);
  border-radius: .75rem;
  padding: .9rem;
  background: rgba(var(--mint-rgb), .045);
}
.audio-use-panel h3 {
  font-size: 1rem;
}
.audio-use-panel ul {
  margin: .65rem 0 0;
  padding-left: 1.1rem;
  color: var(--muted);
  line-height: 1.65;
}
.audio-session-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
  margin-top: 1.5rem;
}
.podcast-lede {
  max-width: 68ch;
  margin-top: .55rem;
}
.podcast-filter {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(200px, .5fr) auto;
  gap: .8rem;
  align-items: end;
  margin-top: 1.5rem;
  padding: 1rem;
  border: 1px solid var(--line);
  border-radius: .9rem;
  background: var(--panel);
}
.podcast-filter label {
  display: grid;
  gap: .38rem;
  color: var(--muted);
  font-size: .85rem;
  font-weight: 800;
}
.podcast-filter input,
.podcast-filter select,
.podcast-filter button {
  min-height: 44px;
  border: 1px solid var(--line);
  border-radius: .6rem;
  padding: .65rem .75rem;
  background: var(--panel);
  color: var(--text);
  font: inherit;
}
.podcast-filter button {
  cursor: pointer;
  font-weight: 850;
}
.podcast-filter input:focus-visible,
.podcast-filter select:focus-visible,
.podcast-filter button:focus-visible,
.podcast-source-link:focus-visible {
  outline: 3px solid rgba(var(--mint-rgb), .45);
  outline-offset: 2px;
}
.podcast-count {
  margin: 1rem 0 0;
  color: var(--muted);
  font-size: .9rem;
  font-weight: 800;
}
.podcast-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}
.podcast-card {
  display: grid;
  align-content: start;
  gap: .8rem;
  padding: clamp(1rem, 3vw, 1.25rem);
}
.podcast-card h3,
.podcast-card p {
  margin: 0;
}
.podcast-card h3 {
  font-size: clamp(1.15rem, 2.2vw, 1.45rem);
}
.podcast-source-link {
  align-self: center;
  color: var(--mint);
  font-size: .88rem;
  font-weight: 850;
}
.podcast-empty {
  margin: 1rem 0 0;
  color: var(--muted);
}
.audio-session-card {
  display: grid;
  align-content: start;
  gap: .8rem;
  padding: clamp(1rem, 3vw, 1.25rem);
}
.audio-card-player {
  width: 100%;
  min-height: 40px;
  accent-color: var(--mint);
}
.audio-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: .55rem;
}
.audio-card-safety {
  border: 1px solid rgba(var(--coral-rgb), .26);
  border-radius: .7rem;
  padding: .7rem;
  background: rgba(var(--coral-rgb), .07);
  color: var(--soft);
  font-size: .86rem;
  line-height: 1.55;
}
.audio-session-card h3 {
  font-size: clamp(1.2rem, 2.4vw, 1.55rem);
}
.audio-session-planned {
  background:
    linear-gradient(135deg, rgba(var(--blue-rgb), .06), rgba(var(--gold-rgb), .04)),
    var(--panel);
}
.audio-coming-soon {
  justify-self: start;
  border: 1px dashed var(--line);
  border-radius: 999px;
  padding: .48rem .75rem;
  color: var(--muted);
  font-size: .85rem;
  font-weight: 850;
}
.audio-trust-panel {
  padding: clamp(1rem, 3vw, 1.25rem);
}
.audio-trust-panel dl {
  display: grid;
  gap: .85rem;
  margin: 0;
}
.audio-trust-panel div {
  display: grid;
  gap: .25rem;
  padding-bottom: .8rem;
  border-bottom: 1px solid var(--line);
}
.audio-trust-panel div:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}
.audio-trust-panel dt {
  color: var(--gold);
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.audio-trust-panel dd {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
}
.audio-trust-panel a {
  color: var(--mint);
  font-weight: 850;
}
.audio-safety {
  padding: clamp(1rem, 3vw, 1.25rem);
  border-color: rgba(var(--coral-rgb), .24);
  background:
    linear-gradient(135deg, rgba(var(--coral-rgb), .08), rgba(var(--gold-rgb), .04)),
    var(--panel);
}
.audio-safety strong {
  display: block;
  margin-bottom: .4rem;
  color: var(--text);
}
@media (max-width: 920px) {
  .audio-hero-grid,
  .audio-detail-split,
  .audio-trust-split,
  .audio-intro-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 560px) {
  .audio-card-meta,
  .audio-player-topline {
    align-items: flex-start;
    flex-direction: column;
  }
  .audio-waveform {
    grid-template-columns: repeat(14, 1fr);
  }
  .podcast-filter {
    grid-template-columns: 1fr;
  }
}
</style>

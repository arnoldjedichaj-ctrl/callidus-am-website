---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { bonusFor } from '../../../../data/book-bonus.js';

// English edition of volume 5 of the children's series (Calli's Compass).
// The German counterpart is the series page /kinderbuch/, there is no per-volume
// German page. Amazon is linked by ISBN so the paperback and the Kindle edition
// both show up once they are linked on Amazon's side.
const asset = '/assets/books/the-weather-inside-me';
const amazonUrl = 'https://www.amazon.com/s?k=9798161727881';

const inside = [
  {
    title: 'A story to read aloud',
    text: 'Seven short chapters, one for each kind of weather. Perfect for reading one at a time, told with humor and without a wagging finger.',
  },
  {
    title: 'Calli’s “Did You Know” pages',
    text: 'Explained for children: why there are no bad feelings, and why some of them still feel unpleasant.',
  },
  {
    title: 'Simple activities',
    text: 'The Sunshine Collector, the Comfort Plan, the Thunder Catcher and more. Small exercises that help a child name what they feel.',
  },
  {
    title: 'Notes for grown-ups',
    text: 'Short pages for whoever is reading along, including helpful things to say in stormy moments, plus a Feelings Explorer certificate at the end.',
  },
];

const weathers = [
  { feeling: 'Joy', weather: 'sunshine' },
  { feeling: 'Sadness', weather: 'rain' },
  { feeling: 'Anger', weather: 'thunder' },
  { feeling: 'Fear', weather: 'a swirling wind' },
];

const editions = [
  { name: 'Paperback', detail: '54 pages · 8.5 × 11 in · watercolor pictures throughout', price: '$12.99' },
  { name: 'Kindle eBook', detail: 'Included with Kindle Unlimited', price: '' },
];

const bonus = bonusFor('en');
---

<BaseLayout
  lang="en"
  alternatePath="/kinderbuch/"
  title="The Weather Inside Me: A Read-Aloud Story About Big Feelings | Callidus"
  description="A warm read-aloud picture book for children ages 5 to 8. Joy is like sunshine, sadness like rain, anger like thunder. Pippa the feelings cloud shows Mira and Noah that every kind of weather passes."
  ogImage={`${asset}/og.jpg`}
>
  <section class="section">
    <div class="container tw-hero">
      <figure class="tw-cover" data-reveal>
        <img
          src={`${asset}/cover.jpg`}
          alt="Book cover: The Weather Inside Me, A Read-Aloud Story About Big Feelings, a Calli's Compass book by Callidus"
          width="600"
          height="960"
          loading="eager"
        />
      </figure>
      <div>
        <p class="eyebrow" data-reveal>A Calli’s Compass Book</p>
        <h1 data-reveal="2">The Weather Inside Me</h1>
        <p class="tw-sub" data-reveal="2">A Read-Aloud Story About Big Feelings</p>
        <p class="lede" data-reveal="3">
          What do you do when it storms inside? Feelings are like weather. They come, and
          they move along. Pippa, the feelings cloud, shows Mira and Noah that every kind of
          weather belongs, and that every kind passes.
        </p>
        <div class="actions" data-reveal="3">
          <a class="button primary" href={amazonUrl} target="_blank" rel="noopener">View on Amazon</a>
        </div>
        <ul class="tw-facts" data-reveal="3">
          <li><strong>5–8</strong><span>years</span></li>
          <li><strong>7</strong><span>chapters</span></li>
          <li><strong>54</strong><span>pages</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container narrow">
      <h2 data-reveal>Every feeling has its weather</h2>
      <ul class="tw-weathers" data-reveal="2">
        {weathers.map((w) => (
          <li><strong>{w.feeling}</strong><span>is like {w.weather}</span></li>
        ))}
      </ul>
      <p data-reveal="2">
        The big idea of the book is a quiet one: every feeling is welcome. Feeling angry is
        okay, but hurting is not. And courage starts with one small step, which is asking
        for help.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 data-reveal>Inside the book</h2>
      <div class="tw-inside" data-reveal="2">
        {inside.map((item) => (
          <div class="tw-card">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <div class="tw-scenes" data-reveal="2">
        <img src={`${asset}/scene-cloud.jpg`} alt="Mira and Noah meet Pippa, the feelings cloud, in a sunny garden" width="760" height="760" loading="lazy" />
        <img src={`${asset}/scene-weathers.jpg`} alt="Pippa shows four kinds of weather side by side while Calli explains" width="760" height="760" loading="lazy" />
        <img src={`${asset}/scene-sunshine.jpg`} alt="Noah jumps over a puddle and Pippa turns into a golden sun" width="760" height="760" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container narrow">
      <h2 data-reveal>Editions</h2>
      <ul class="tw-editions" data-reveal="2">
        {editions.map((e) => (
          <li>
            <strong>{e.name}</strong>
            <small>{e.detail}</small>
            {e.price && <span>{e.price}</span>}
          </li>
        ))}
      </ul>
      <p class="tw-series" data-reveal="2">
        This is the first volume of the series to appear in English. The full series,
        <em>Callis Gesundheits-Kompass</em>, runs to six volumes in German and covers body
        signals, food, movement, sleep, feelings and the immune system.
        <a href="/kinderbuch/">See the German series</a>.
      </p>
    </div>
  </section>

  {bonus.formUrl && (
    <section class="section">
      <div class="container narrow">
        <div class="bonus-teaser" data-reveal>
          <strong>Printables and audio for our books</strong>
          <p>
            We send the collected bonus material for the Callidus books in one email: printables,
            logs and audio companions. The colouring sheets for this series are in German for now.
          </p>
          <a class="button" href={bonus.href}>{'Bonus material →'}</a>
        </div>
      </div>
    </section>
  )}

  <style>
    .container.narrow { max-width: 760px; }
    .tw-hero { display: grid; gap: 2.5rem; align-items: start; }
    @media (min-width: 860px) { .tw-hero { grid-template-columns: 320px 1fr; gap: 3rem; } }
    .tw-cover { margin: 0; }
    .tw-cover img { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 18px 40px rgba(0,0,0,.18); }
    .tw-sub { font-size: 1.1rem; color: var(--muted); margin: .25rem 0 1rem; }
    .tw-facts { display: flex; gap: 1.75rem; list-style: none; padding: 0; margin: 1.75rem 0 0; }
    .tw-facts strong { display: block; font-size: 1.7rem; line-height: 1.1; }
    .tw-facts span { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    .tw-weathers { display: grid; gap: .5rem; list-style: none; padding: 0; margin: 1.5rem 0 2rem; }
    .tw-weathers li { display: flex; gap: .5rem; align-items: baseline; }
    .tw-weathers strong { min-width: 5.5rem; }
    .tw-weathers span { color: var(--muted); }
    .tw-inside { display: grid; gap: 1rem; margin: 1.5rem 0 2.5rem; }
    @media (min-width: 760px) { .tw-inside { grid-template-columns: repeat(2, 1fr); } }
    .tw-card { padding: 1.25rem 1.4rem; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; }
    .tw-card strong { display: block; margin-bottom: .4rem; }
    .tw-card p { margin: 0; color: var(--muted); }
    .tw-scenes { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
    .tw-scenes img { width: 100%; height: auto; border-radius: 12px; }
    @media (max-width: 640px) { .tw-scenes { grid-template-columns: 1fr; } }
    .tw-editions { display: grid; gap: .75rem; list-style: none; padding: 0; margin: 1.5rem 0 2rem; }
    .tw-editions li { display: grid; gap: .2rem; padding: 1rem 1.25rem; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; }
    .tw-editions small { color: var(--muted); }
    .tw-series { color: var(--muted); }
    .bonus-teaser { padding: 1.5rem 1.6rem; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; }
    .bonus-teaser strong { display: block; margin-bottom: .4rem; }
    .bonus-teaser p { margin: 0 0 1rem; color: var(--muted); }
  </style>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import structure from '../../../data/site-structure.json';
import { categoryForLang } from '../../../data/i18n.js';
import { momusAll } from '../../../data/all-articles.js';

// Englische Artikelseiten für MOMUS-Artikel mit vorhandener Übersetzung
// (titleEn/descriptionEn/blocksEn). Nur über den Sprachschalter erreichbar.
export function getStaticPaths() {
  return momusAll
    .filter((article) => Array.isArray(article.blocksEn) && article.blocksEn.length > 0)
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const title = article.titleEn || article.title;
const description = article.descriptionEn || article.description;
const rawCategory = structure.categories.find((category) => category.slug === article.category) || structure.categories[0];
const category = categoryForLang(rawCategory, 'en');
const related = momusAll
  .filter((item) => item.slug !== article.slug && item.category === article.category && Array.isArray(item.blocksEn) && item.blocksEn.length > 0)
  .slice(0, 3);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'en-US',
  author: { '@type': 'Organization', name: 'callidus A&M' },
  publisher: {
    '@type': 'Organization',
    name: 'callidus A&M',
    logo: { '@type': 'ImageObject', url: 'https://www.callidus-am.de/favicon.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/en/guide/${article.slug}/`, 'https://www.callidus-am.de').href },
};
---
<BaseLayout
  lang="en"
  alternatePath={article.path}
  title={`${title} | callidus A&M`}
  description={description}
  ogImage={article.image}
  pageType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
  <section class="section">
    <article class="article-shell">
      <div class="article-hero">
        <p class="eyebrow">{article.readingTime} min read · <span class="app-badge app-badge-momus">MOMUS</span></p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {article.image && <img class="article-image" src={article.image} alt="" loading="lazy" decoding="async" />}
      </div>
      <div class="article-layout">
        <div class="prose">
          <div class="notice">
            <strong>Satire notice:</strong>
            <p>MOMUS articles are satire and deliberately recommend the opposite of healthy behavior. They are a mindset mirror, not health advice.</p>
          </div>
          {article.blocksEn.map((block) => {
            if (block.type === 'heading') {
              return block.level < 3 ? <h2>{block.text}</h2> : <h3>{block.text}</h3>;
            }
            if (block.type === 'list') {
              return <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
            }
            return <p>{block.text}</p>;
          })}
          <div class="notice">
            <strong>Note:</strong>
            <p>This satirical article does not replace medical advice. For real guidance, see the English guide overview or the German knowledge pages.</p>
          </div>
          <aside class="article-bridge-box" aria-labelledby="article-bridge-heading-en">
            <div>
              <span class="badge mint">Next step</span>
              <h2 id="article-bridge-heading-en">From reading to action.</h2>
              <p>Continue in the English guide or explore the category this article belongs to.</p>
            </div>
            <div class="article-bridge-grid">
              <a href="/en/guide/">
                <span>Guide</span>
                <strong>All English articles</strong>
                <small>Back to the full English article overview.</small>
              </a>
              <a href="/en/guide/">
                <span>{category.title}</span>
                <strong>More from {category.title}</strong>
                <small>{category.description}</small>
              </a>
            </div>
          </aside>
          {related.length > 0 && (
            <aside class="article-source-box" aria-labelledby="related-heading-en">
              <div>
                <span class="badge gold">Related</span>
                <h2 id="related-heading-en">More satire from this category</h2>
              </div>
              <div class="article-source-list">
                {related.map((item) => (
                  <a href={`/en/guide/${item.slug}/`}>
                    <span>MOMUS</span>
                    <strong>{item.titleEn || item.title}</strong>
                  </a>
                ))}
              </div>
            </aside>
          )}
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import inventory from '../data/inventory.json';
import images from '../data/images.json';
import specialPages from '../data/special-pages.json';
import structure from '../data/site-structure.json';
import healthCompass from '../data/health-compass.json';
import { homeCopy, categoryForLang } from '../data/i18n.js';
import { allArticles, getWeeklyFeatured, appBadgeMeta } from '../data/all-articles.js';
import { portalAppList } from '../data/portal.js';
import { audience, mission, vision, brandPromise, problemSolution } from '../data/positioning.js';
import Faq from '../components/Faq.astro';
import { faqGroupsById, faqJsonLd } from '../data/faq.js';

// Auf der Startseite steht nur die allgemeine FAQ-Gruppe, damit die Seite kurz bleibt.
const homeFaqGroups = faqGroupsById('allgemein');

// Alle Artikel inkl. Momus-Beiträge fließen in die Kategorie-Counts.
const articles = allArticles;

const lang = 'de';
const copy = homeCopy[lang];
const imageMap = new Map(images.filter((item) => item.status === 'ok').map((item) => [item.url, item.localPath.replace('source/assets/original/', '/assets/original/')]));
const pages = inventory.filter((page) => page.status === 'ok');
const heroImage = imageMap.get(pages.find((page) => page.slug === 'home')?.images?.[1]) || imageMap.get(pages.find((page) => page.slug === 'home')?.images?.[0]);
const logoPath = '/assets/original/001-wp-content-uploads-go-x-u-bdfcc883-6576-4ab2-951d-c90c6ccf47d3-image-911x911.png';
const nexusPreviewPath = '/assets/original/006-wp-content-uploads-go-x-u-f0b406a7-c356-4935-99d5-4fa5a26d9ff4-l86-t0-w1000-h1000-image-768x768.png';
const imageFor = (page) => page.image || heroImage;
const categorize = (page) => {
  if (page.category) {
    const direct = structure.categories.find((category) => category.slug === page.category);
    if (direct) return direct;
  }
  const haystack = `${page.slug || ''} ${page.title || ''} ${page.description || ''} ${(page.h2 || []).join(' ')}`.toLowerCase();
  return structure.categories.find((category) => category.keywords.some((keyword) => haystack.includes(keyword))) || structure.categories[0];
};
const categoryCounts = structure.categories.map((category) => ({
  ...categoryForLang(category, lang),
  path: `/ratgeber/#${category.slug}`,
  count: articles.filter((page) => categorize(page).slug === category.slug).length,
}));
const compassItems = [
  { slug: 'geist-seele', position: 'top', shortTitle: 'Geist & Seele' },
  { slug: 'zukunft-gesundheit', position: 'right', shortTitle: 'Zukunft' },
  { slug: 'sport-energie', position: 'bottom', shortTitle: 'Sport & Energie' },
  { slug: 'koerper-ernaehrung', position: 'left', shortTitle: 'Körper & Ernährung' },
].map((item) => ({
  ...categoryCounts.find((category) => category.slug === item.slug),
  position: item.position,
  shortTitle: item.shortTitle,
})).filter((item) => item.slug);
const compassApps = portalAppList.map((app) => ({
  ...app,
  href: app.appHref || app.href,
  status: app.comingSoon ? 'bald' : 'aktiv',
}));
const featured = getWeeklyFeatured(structure.categories);
const brevoSignupLink = specialPages
  .find((page) => page.slug === 'stress-reset-kurs')
  ?.links?.find((link) => link.href?.includes('sibforms.com'));
const guidedPaths = healthCompass.guidedPaths;
const todayStarts = [
  {
    time: '2 Minuten',
    title: 'Kompass starten',
    text: 'Stress, Schlaf, Bewegung, Ernährung und Energie schnell einordnen.',
    href: '/gesundheits-kompass/#kompass-tool',
    accent: 'mint',
  },
  {
    time: '15 Minuten',
    title: 'Klarheitsreset hören',
    text: 'Geführte Audio-Session für Fokus, innere Ordnung und den nächsten Schritt.',
    href: '/audio/',
    accent: 'blue',
  },
  {
    time: '10 Minuten',
    title: 'Körper aktivieren',
    text: 'Ein kurzer Bewegungsimpuls für Energie, Fokus und Alltagstauglichkeit.',
    href: '/10-minuten-morgen-workout/',
    accent: 'gold',
  },
  {
    time: 'Heute lesen',
    title: 'Schlaf priorisieren',
    text: 'Abendroutine, Reizmanagement und Regeneration als Basis verstehen.',
    href: '/der-schlaf-reset/',
    accent: 'blue',
  },
  {
    time: 'Heute testen',
    title: 'Health IQ prüfen',
    text: 'Wissen zu Vitaminen, Stress, Schlaf und Supplement-Sicherheit spielerisch testen.',
    href: '/gesundheits-checks/#check-tool',
    accent: 'coral',
  },
];
---
<BaseLayout lang={lang} alternatePath="/en/" title={copy.title} description={copy.description} jsonLd={faqJsonLd(homeFaqGroups)}>
  <section class="section">
    <div class="container hero">
      <div data-reveal>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.headline}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="actions">
          <a class="button primary" href="/gesundheits-kompass/">{copy.primaryCta}</a>
          <a class="button" href="/ratgeber/">Ratgeber entdecken</a>
        </div>
      </div>
      <figure class="logo-hero-visual" data-reveal="2" aria-label="callidus Gesundheits-Kompass">
        <div class="hero-compass">
          <div class="compass-track" aria-hidden="true"></div>
          <div class="compass-track compass-track-inner" aria-hidden="true"></div>
          <img class="hero-logo" src={logoPath} alt="callidus A&M Logo" width="320" height="320" />
          <div class="compass-orbit" aria-label="callidus Universum aus Apps und Themenbereichen">
            {compassItems.map((category, index) => (
              <div class={`compass-anchor compass-anchor-${index}`}>
                <a class={`compass-label ${category.accent}`} href={category.path} aria-label={`${category.title}: ${category.count} ${copy.contentLabel} ansehen`}>
                  <span class="compass-dot" aria-hidden="true"></span>
                  <span class="planet-title">{category.shortTitle}</span>
                  <span class="planet-meta">{category.count} {copy.contentLabel}</span>
                </a>
              </div>
            ))}
            <div class="compass-app-orbit" aria-label="callidus Apps">
              {compassApps.map((app, index) => (
                <div class={`compass-app-anchor compass-app-anchor-${index}`}>
                  <a class={`compass-app ${app.color}`} href={app.href} aria-label={`${app.name} App ${app.status}`}>
                    <span>{app.name}</span>
                    <small>{app.status}</small>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="section band home-problem">
    <div class="container">
      <p class="eyebrow" data-reveal>{problemSolution.problemEyebrow}</p>
      <h2 data-reveal="2">{problemSolution.problemHeadline}</h2>
      <div class="problem-grid">
        {problemSolution.problems.map((item, index) => (
          <div class="problem-card" data-reveal={String((index % 3) + 1)}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <p class="problem-bridge" data-reveal>{problemSolution.bridge}</p>
    </div>
  </section>

  <section class="section home-solution">
    <div class="container">
      <p class="eyebrow" data-reveal>{problemSolution.solutionEyebrow}</p>
      <h2 data-reveal="2">{problemSolution.solutionHeadline}</h2>
      <div class="solution-grid">
        {problemSolution.solutions.map((item, index) => (
          <div class="solution-card" data-reveal={String((index % 3) + 1)}>
            <span class={`solution-step ${item.accent}`} aria-hidden="true">{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="solution-link" href={item.href}>{item.linkLabel}</a>
          </div>
        ))}
      </div>
      <div class="solution-actions">
        <a class="button primary" href="/gesundheits-kompass/#kompass-tool">{copy.primaryCta}</a>
        <span>Ohne Anmeldung · rund 3 Minuten · kein Ergebnis wird gespeichert</span>
      </div>
    </div>
  </section>

  <section class="section tight home-audience">
    <div class="container audience-panel" data-reveal>
      <div>
        <p class="eyebrow">{audience.eyebrow}</p>
        <h2>{audience.headline}</h2>
        <p class="lede">{audience.summary}</p>
      </div>
      <div class="audience-lists">
        <div class="audience-list">
          <h3>Passt zu dir, wenn</h3>
          <ul>{audience.fits.map((entry) => <li>{entry}</li>)}</ul>
        </div>
        <div class="audience-list audience-list-out">
          <h3>Eher nicht, wenn</h3>
          <ul>{audience.fitsNot.map((entry) => <li>{entry}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight home-today-start">
    <div class="container">
      <p class="eyebrow" data-reveal>Heute starten</p>
      <h2 data-reveal="2">Kleine Einstiege statt lange Suche.</h2>
      <div class="today-start-grid" style="margin-top:1.5rem;">
        {todayStarts.map((item, index) => (
          <a class="today-start-card" href={item.href} data-reveal={String((index % 3) + 1)}>
            <span class={`badge ${item.accent}`}>{item.time}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band home-guided-paths">
    <div class="container">
      <p class="eyebrow" data-reveal>Themenpfade</p>
      <h2 data-reveal="2">Geführte Wege für Wiederkehr.</h2>
      <div class="grid" style="margin-top: 1.5rem;">
        {guidedPaths.map((path, index) => (
          <a class="card compass-path-card" href={path.href} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class={`badge ${path.accent}`}>Pfad</span>
              <h3>{path.title}</h3>
              <p>{path.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <h2 data-reveal="2">{copy.orientationHeadline}</h2>
      <div class="grid" style="margin-top: 1.5rem;">
        {categoryCounts.map((category, index) => (
          <a class="card" href={category.path} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class={`badge ${category.accent}`}>{category.count} {copy.contentLabel}</span>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">{copy.selectionEyebrow}</p>
        <h2>{copy.selectionHeadline}</h2>
        <p>Jede Woche frische Lese-Empfehlungen aus allen Bereichen, plus einen Beitrag aus der Momus-App.</p>
        <a class="button" href="/ratgeber/">{copy.allArticles}</a>
      </div>
      <div class="grid featured">
        {featured.map((article, index) => {
          const cat = categoryForLang(categorize(article), lang);
          const meta = appBadgeMeta(article.app);
          return (
            <a class="card" href={article.path} data-reveal={String((index % 3) + 1)}>
              <span class={meta.className}>{meta.label}</span>
              {article.image && <img src={article.image} alt={article.title} loading="lazy" decoding="async" />}
              <div class="card-body">
                <span class={`badge ${cat.accent}`}>{cat.title}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div data-reveal>
        <p class="eyebrow">{copy.appsEyebrow}</p>
        <h2>{copy.appsHeadline}</h2>
        <p class="lede app-cta-text">{copy.appsText}</p>
      </div>
      <div class="app-showcase" data-reveal="2">
        <img src={nexusPreviewPath} alt="NEXUS App Vorschau – KI-Gesundheits-App von callidus A&M" loading="lazy" decoding="async" />
        <div class="grid app-cards">
          <a class="card" href="/handbuch/"><div class="card-body"><span class="badge mint">Dokumentation</span><h3>{copy.manualCardTitle}</h3><p>{copy.manualCardText}</p></div></a>
          <a class="card" href="/nexus-app/"><div class="card-body"><span class="badge gold">Produkt</span><h3>NEXUS, MOMUS &amp; KAIROS</h3><p>{copy.nexusCardText}</p></div></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-brand">
    <div class="container">
      <p class="eyebrow" data-reveal>{brandPromise.eyebrow}</p>
      <h2 data-reveal="2">{brandPromise.headline}</h2>

      <div class="brand-statements">
        <div class="brand-statement" data-reveal>
          <span class="badge mint">{mission.label}</span>
          <p>{mission.statement}</p>
        </div>
        <div class="brand-statement" data-reveal="2">
          <span class="badge gold">{vision.label}</span>
          <p>{vision.statement}</p>
        </div>
      </div>

      <div class="grid brand-grid">
        {brandPromise.pillars.map((pillar, index) => (
          <a class="card brand-pillar" href={pillar.href} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class={`badge ${pillar.accent}`}>{String(index + 1).padStart(2, '0')}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
              <span class="brand-pillar-link">{pillar.linkLabel}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band home-faq">
    <div class="container">
      <Faq
        groups={homeFaqGroups}
        eyebrow="Häufige Fragen"
        headline="Bevor du startest, das Wichtigste vorweg."
        lede="Die Fragen, die uns am häufigsten erreichen. Alle weiteren Themen findest du auf der FAQ-Seite."
        showGroupTitles={false}
      />
      <p class="home-faq-more">
        <a class="button" href="/faq/">Alle Fragen ansehen</a>
      </p>
    </div>
  </section>

  <section class="section band" id="newsletter">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">Newsletter & Gratis-Download</p>
        <h2>Das ultimative Vitamin-Kompendium – komplett kostenlos.</h2>
        <p>
          Du bekommst unser 38-seitiges E-Book über alle 13 essenziellen Vitamine. Trag einfach
          deine E-Mail-Adresse ein, dann landet der Download-Link direkt in deinem Postfach.
          Dazu einmal im Monat unser Newsletter mit Impulsen und Empfehlungen.
        </p>
        <p>
          Du willst mehr? Über dieselbe Anmeldung schaltest du auch den
          <a href="/stress-reset-kurs/">Stress Reset</a> frei: Kompendium, Journal und die ersten
          Video-Module.
        </p>
        <p style="font-size:.85rem;color:var(--muted);">
          Mit der Anmeldung akzeptierst du unsere
          <a href="/datenschutz/">Datenschutzerklärung</a>. Abmeldung jederzeit per Klick möglich.
        </p>
      </div>
      <div data-reveal="2">
        <div id="brevo-embed" class="newsletter-placeholder" data-newsletter-embed data-form-url={brevoSignupLink?.href || ''}>
          <p>Wir laden das Anmeldeformular von Brevo. Bitte stimme dafür der Datenübertragung an Brevo zu.</p>
          <button class="button primary" type="button" data-load-newsletter>Formular laden</button>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* --- Problem --- */
    .problem-grid,
    .solution-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
      margin-top: 1.75rem;
    }
    .problem-card {
      padding: clamp(1.1rem, 2.5vw, 1.5rem);
      border: 1px solid var(--line);
      border-left: 3px solid var(--coral);
      border-radius: 14px;
      background: var(--panel);
    }
    .problem-card h3 {
      font-size: 1.08rem;
      margin-bottom: .4rem;
    }
    .problem-card p {
      color: var(--muted);
      margin-bottom: 0;
    }
    .problem-bridge {
      margin: clamp(1.5rem, 4vw, 2.25rem) 0 0;
      font-size: clamp(1.25rem, 2.6vw, 1.8rem);
      font-weight: 900;
      line-height: 1.3;
      max-width: 26ch;
      color: var(--mint);
    }

    /* --- Lösung --- */
    .solution-card {
      position: relative;
      padding: clamp(1.1rem, 2.5vw, 1.5rem);
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel);
      box-shadow: var(--shadow);
    }
    .solution-step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      font-weight: 900;
      font-size: .95rem;
      margin-bottom: .75rem;
      color: var(--mint);
      background: rgba(var(--mint-rgb), .14);
    }
    .solution-step.blue { color: var(--blue); background: rgba(var(--blue-rgb), .14); }
    .solution-step.gold { color: var(--gold); background: rgba(var(--gold-rgb), .16); }
    .solution-card h3 { font-size: 1.12rem; margin-bottom: .4rem; }
    .solution-card p { color: var(--muted); }
    .solution-link {
      font-weight: 850;
      font-size: .88rem;
      color: var(--mint);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .solution-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      margin-top: clamp(1.5rem, 4vw, 2.25rem);
    }
    .solution-actions span {
      color: var(--muted);
      font-size: .85rem;
      font-weight: 850;
    }

    /* --- Zielgruppe --- */
    .audience-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(1.25rem, 4vw, 2.5rem);
      padding: clamp(1.25rem, 3vw, 2rem);
      border: 1px solid var(--line);
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(var(--mint-rgb), .08), rgba(var(--blue-rgb), .08)), var(--panel);
    }
    .audience-panel .lede { margin-bottom: 0; max-width: 46ch; }
    .audience-lists {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      align-content: start;
    }
    .audience-list h3 {
      font-size: .82rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--mint);
      margin-bottom: .6rem;
    }
    .audience-list-out h3 { color: var(--coral); }
    .audience-list ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: .5rem;
    }
    .audience-list li {
      position: relative;
      padding-left: 1.4rem;
      color: var(--muted);
      font-size: .93rem;
      line-height: 1.5;
    }
    .audience-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: .5em;
      width: .55rem;
      height: .55rem;
      border-radius: 50%;
      background: var(--mint);
    }
    .audience-list-out li::before {
      background: none;
      border: 2px solid var(--coral);
      top: .42em;
    }

    /* --- Marke --- */
    .brand-statements {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-top: 1.75rem;
    }
    .brand-statement {
      padding: clamp(1.1rem, 2.5vw, 1.5rem);
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel-2);
    }
    .brand-statement p {
      margin-bottom: 0;
      font-size: 1.02rem;
      line-height: 1.55;
      font-weight: 650;
    }
    .brand-grid { margin-top: 1rem; }
    .brand-pillar-link {
      display: inline-block;
      margin-top: .75rem;
      font-weight: 850;
      font-size: .86rem;
      color: var(--mint);
    }

    /* --- FAQ --- */
    .home-faq-more { margin-top: 1.75rem; }

    @media (max-width: 860px) {
      .audience-panel { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    (() => {
      const setupCompassDrag = () => {
        const compass = document.querySelector('.hero-compass');
        const orbit = document.querySelector('.compass-orbit');
        if (!compass || !orbit) return;

        let dragging = false;
        let startAngle = 0;
        let accumulated = 0;

        const angleFromCenter = (event) => {
          const bounds = compass.getBoundingClientRect();
          const centerX = bounds.left + bounds.width / 2;
          const centerY = bounds.top + bounds.height / 2;
          const pointX = (event.clientX ?? event.touches?.[0]?.clientX ?? centerX) - centerX;
          const pointY = (event.clientY ?? event.touches?.[0]?.clientY ?? centerY) - centerY;
          return Math.atan2(pointY, pointX) * (180 / Math.PI);
        };

        const onStart = (event) => {
          dragging = true;
          startAngle = angleFromCenter(event) - accumulated;
          compass.classList.add('is-dragging');
        };
        const onMove = (event) => {
          if (!dragging) return;
          event.preventDefault();
          accumulated = angleFromCenter(event) - startAngle;
          orbit.style.transform = 'rotate(' + accumulated + 'deg)';
        };
        const onEnd = () => {
          dragging = false;
          compass.classList.remove('is-dragging');
        };

        compass.addEventListener('mousedown', onStart);
        compass.addEventListener('touchstart', onStart, { passive: true });
        window.addEventListener('mousemove', onMove);
        window.addEventListener('touchmove', onMove, { passive: false });
        window.addEventListener('mouseup', onEnd);
        window.addEventListener('touchend', onEnd);
      };
      setupCompassDrag();
      document.addEventListener('astro:page-load', setupCompassDrag);
    })();
  </script>

  <script is:inline>
    (() => {
      const setupNewsletter = () => {
        const wrapper = document.querySelector('[data-newsletter-embed]');
        if (!wrapper || wrapper.dataset.ready) return;
        wrapper.dataset.ready = 'true';
        const url = wrapper.dataset.formUrl;
        if (!url) return;
        const mount = () => {
          wrapper.innerHTML = '<iframe class="newsletter-embed" src="' + url + '" title="Newsletter-Anmeldung Vitamin-Kompendium" loading="lazy"></iframe>';
        };
        const consent = localStorage.getItem('callidus-cookie-consent');
        if (consent === 'all') {
          mount();
          return;
        }
        wrapper.querySelector('[data-load-newsletter]')?.addEventListener('click', () => {
          localStorage.setItem('callidus-cookie-consent', 'all');
          document.documentElement.dataset.consent = 'all';
          mount();
        });
        window.addEventListener('callidus-consent', (event) => {
          if (event.detail === 'all') mount();
        });
      };
      setupNewsletter();
      document.addEventListener('astro:page-load', setupNewsletter);
    })();
  </script>
</BaseLayout>

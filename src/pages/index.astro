---
import BaseLayout from '../layouts/BaseLayout.astro';
import inventory from '../data/inventory.json';
import images from '../data/images.json';
import specialPages from '../data/special-pages.json';
import structure from '../data/site-structure.json';
import healthCompass from '../data/health-compass.json';
import { homeCopy, categoryForLang } from '../data/i18n.js';
import { allArticles, getWeeklyFeatured, appBadgeMeta } from '../data/all-articles.js';

// Alle Artikel inkl. Momus-Beiträge fließen in die Kategorie-Counts.
const articles = allArticles;

const lang = 'de';
const copy = homeCopy[lang];
const imageMap = new Map(images.filter((item) => item.status === 'ok').map((item) => [item.url, item.localPath.replace('source/assets/original/', '/assets/original/')]));
const pages = inventory.filter((page) => page.status === 'ok');
const heroImage = imageMap.get(pages.find((page) => page.slug === 'home')?.images?.[1]) || imageMap.get(pages.find((page) => page.slug === 'home')?.images?.[0]);
const nexusPreviewPath = '/assets/original/006-wp-content-uploads-go-x-u-f0b406a7-c356-4935-99d5-4fa5a26d9ff4-l86-t0-w1000-h1000-image-768x768.png';
const cosmicHeroPath = '/assets/media/callidus-cosmic-health-hero-v1.png';
const imageFor = (page) => page.image || heroImage;
const categorize = (page) => {
  if (page.category) {
    const direct = structure.categories.find((category) => category.slug === page.category);
    if (direct) return direct;
  }
  const haystack = `${page.slug || ''} ${page.title || ''} ${page.description || ''} ${(page.h2 || []).join(' ')}`.toLowerCase();
  return structure.categories.find((category) => category.keywords.some((keyword) => haystack.includes(keyword))) || structure.categories[0];
};
const categoryCounts = structure.categories.map((category) => ({
  ...categoryForLang(category, lang),
  path: `/ratgeber/#${category.slug}`,
  count: articles.filter((page) => categorize(page).slug === category.slug).length,
}));
const featured = getWeeklyFeatured(structure.categories);
const brevoSignupLink = specialPages
  .find((page) => page.slug === 'stress-reset-kurs')
  ?.links?.find((link) => link.href?.includes('sibforms.com'));
const resources = [
  brevoSignupLink && {
    path: brevoSignupLink.href,
    external: true,
    kind: 'funnel',
    badge: 'Gratis',
    hero: 'Stress-Reset Gratis-Ressourcen freischalten',
    lead: 'Tragen Sie sich in die E-Mail-Liste ein und erhalten Sie Zugang zu Kompendium, Journal und den ersten Video-Modulen.',
  }
].filter(Boolean);
const guidedPaths = healthCompass.guidedPaths;
const todayStarts = [
  {
    time: '2 Minuten',
    title: 'Kompass starten',
    text: 'Stress, Schlaf, Bewegung, Ernährung und Energie schnell einordnen.',
    href: '/gesundheits-kompass/#kompass-tool',
    accent: 'mint',
  },
  {
    time: '15 Minuten',
    title: 'Klarheitsreset hören',
    text: 'Geführte Audio-Session für Fokus, innere Ordnung und den nächsten Schritt.',
    href: '/audio/',
    accent: 'blue',
  },
  {
    time: '10 Minuten',
    title: 'Körper aktivieren',
    text: 'Ein kurzer Bewegungsimpuls für Energie, Fokus und Alltagstauglichkeit.',
    href: '/10-minuten-morgen-workout/',
    accent: 'gold',
  },
  {
    time: 'Heute lesen',
    title: 'Schlaf priorisieren',
    text: 'Abendroutine, Reizmanagement und Regeneration als Basis verstehen.',
    href: '/der-schlaf-reset/',
    accent: 'blue',
  },
  {
    time: 'Heute testen',
    title: 'Health IQ prüfen',
    text: 'Wissen zu Vitaminen, Stress, Schlaf und Supplement-Sicherheit spielerisch testen.',
    href: '/gesundheits-checks/#check-tool',
    accent: 'coral',
  },
];
---
<BaseLayout lang={lang} alternatePath="/en/" title={copy.title} description={copy.description}>
  <section class="section home-hero-section">
    <div class="container hero hero-space">
      <div class="hero-space-copy" data-reveal>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.headline}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="actions">
          <a class="button primary" href="/gesundheits-kompass/">{copy.primaryCta}</a>
          <a class="button" href="/ratgeber/">Ratgeber entdecken</a>
        </div>
      </div>
      <figure class="space-hero-visual" data-reveal="2">
        <img
          class="space-hero-art"
          src={cosmicHeroPath}
          alt="Leuchtende Sonne und vier realistisch dargestellte Planeten in einem tiefen Sternenfeld"
          width="1536"
          height="1536"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="space-hero-caption">
          <span>Gesundheit ist ein System</span>
          <a href="/gesundheits-kompass/">Zum Gesundheits-Kompass <span aria-hidden="true">→</span></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section home-check-cta">
    <div class="container home-check-panel" data-reveal>
      <div>
        <p class="eyebrow">Neu: Callidus Gesundheits-Kompass</p>
        <h2>Finde deinen nächsten sinnvollen Schritt.</h2>
        <p>
          Starte öffentlich ohne Anmeldung, erhalte sofort eine grobe Einordnung und führe
          deinen Pfad später im Portal mit App-Daten, Verlauf und KI-Begleitung weiter.
        </p>
      </div>
      <div class="home-check-actions" aria-label="Gesundheitschecks starten">
        <a class="button primary" href="/gesundheits-kompass/#kompass-tool">Kompass starten</a>
        <a class="button" href="/gesundheits-checks/">Checks ansehen</a>
      </div>
    </div>
  </section>

  <section class="section tight home-audio-cta">
    <div class="container home-audio-panel" data-reveal>
      <div>
        <p class="eyebrow">Neu: Audio-Raum</p>
        <h2>Klarheit hören, bevor du weiterarbeitest.</h2>
        <p>
          Die erste geführte Callidus-Audiofolge ist ein 15-Minuten-Klarheitsreset für Fokus,
          innere Ordnung und einen konkreten nächsten Schritt. Später können hier weitere Folgen
          für Atemruhe, Schlafübergang und mentale Ausrichtung folgen.
        </p>
      </div>
      <div class="home-audio-actions" aria-label="Callidus Audio-Raum öffnen">
        <a class="button primary" href="/audio/">Erste Folge anhören</a>
        <span>15 Minuten · Musik · Wellenatmosphäre</span>
      </div>
    </div>
  </section>
  <section class="section tight home-today-start">
    <div class="container">
      <p class="eyebrow" data-reveal>Heute starten</p>
      <h2 data-reveal="2">Kleine Einstiege statt lange Suche.</h2>
      <div class="today-start-grid" style="margin-top:1.5rem;">
        {todayStarts.map((item, index) => (
          <a class="today-start-card" href={item.href} data-reveal={String((index % 3) + 1)}>
            <span class={`badge ${item.accent}`}>{item.time}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band home-guided-paths">
    <div class="container">
      <p class="eyebrow" data-reveal>Themenpfade</p>
      <h2 data-reveal="2">Geführte Wege für Wiederkehr.</h2>
      <div class="grid" style="margin-top: 1.5rem;">
        {guidedPaths.map((path, index) => (
          <a class="card compass-path-card" href={path.href} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class={`badge ${path.accent}`}>Pfad</span>
              <h3>{path.title}</h3>
              <p>{path.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <h2 data-reveal="2">{copy.orientationHeadline}</h2>
      <div class="grid" style="margin-top: 1.5rem;">
        {categoryCounts.map((category, index) => (
          <a class="card" href={category.path} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class={`badge ${category.accent}`}>{category.count} {copy.contentLabel}</span>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">{copy.selectionEyebrow}</p>
        <h2>{copy.selectionHeadline}</h2>
        <p>Wöchentlich frische Lese-Empfehlungen aus allen Bereichen — plus einen Beitrag aus der Momus-App.</p>
        <a class="button" href="/ratgeber/">{copy.allArticles}</a>
      </div>
      <div class="grid featured">
        {featured.map((article, index) => {
          const cat = categoryForLang(categorize(article), lang);
          const meta = appBadgeMeta(article.app);
          return (
            <a class="card" href={article.path} data-reveal={String((index % 3) + 1)}>
              <span class={meta.className}>{meta.label}</span>
              {article.image && <img src={article.image} alt={article.title} loading="lazy" decoding="async" />}
              <div class="card-body">
                <span class={`badge ${cat.accent}`}>{cat.title}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div data-reveal>
        <p class="eyebrow">{copy.appsEyebrow}</p>
        <h2>{copy.appsHeadline}</h2>
        <p class="lede app-cta-text">{copy.appsText}</p>
      </div>
      <div class="app-showcase" data-reveal="2">
        <img src={nexusPreviewPath} alt="NEXUS App Vorschau – KI-Gesundheits-App von callidus A&M" loading="lazy" decoding="async" />
        <div class="grid app-cards">
          <a class="card" href="/handbuch/"><div class="card-body"><span class="badge mint">Dokumentation</span><h3>{copy.manualCardTitle}</h3><p>{copy.manualCardText}</p></div></a>
          <a class="card" href="/nexus-app/"><div class="card-body"><span class="badge gold">Produkt</span><h3>NEXUS App</h3><p>{copy.nexusCardText}</p></div></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">Kurse & Ressourcen</p>
        <h2>Gratis-Ressourcen für den Stress Reset.</h2>
        <p>Der Einstieg läuft über die E-Mail-Anmeldung. Danach erhalten Sie Zugang zu Kompendium, Journal und den ersten Video-Modulen.</p>
        <a class="button primary" href="/stress-reset-kurs/">Stress Reset öffnen</a>
      </div>
      <div class="grid featured">
        {resources.map((page, index) => (
          <a class="card" href={page.path} target={page.external ? '_blank' : undefined} rel={page.external ? 'noopener' : undefined} data-reveal={String((index % 3) + 1)}>
            <div class="card-body">
              <span class="badge gold">{page.badge || (page.kind === 'lexicon' ? 'Lexicon' : page.kind === 'funnel' ? 'Download' : 'Kurs')}</span>
              <h3>{page.hero}</h3>
              <p>{page.lead}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band" id="newsletter">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">Newsletter & Gratis-Download</p>
        <h2>Das ultimative Vitamin-Kompendium – komplett kostenlos.</h2>
        <p>
          Erhalten Sie unser umfassendes 38-seitiges E-Book über alle 13 essenziellen Vitamine.
          Tragen Sie einfach Ihre E-Mail-Adresse ein und Sie erhalten den Download-Link direkt
          in Ihr Postfach. Zusätzlich einmal im Monat unser exklusiver Newsletter mit
          Gesundheits-Tipps und Empfehlungen.
        </p>
        <p style="font-size:.85rem;color:var(--muted);">
          Mit der Anmeldung akzeptieren Sie unsere
          <a href="/datenschutz/">Datenschutzerklärung</a>. Abmeldung jederzeit per Klick möglich.
        </p>
      </div>
      <div data-reveal="2">
        <div id="brevo-embed" class="newsletter-placeholder" data-newsletter-embed data-form-url={brevoSignupLink?.href || ''}>
          <p>Wir laden das Anmeldeformular von Brevo. Bitte stimmen Sie dafür der Datenübertragung an Brevo zu.</p>
          <button class="button primary" type="button" data-load-newsletter>Formular laden</button>
        </div>
      </div>
    </div>
  </section>

  <style>
    .home-hero-section {
      position: relative;
      overflow: clip;
      padding-top: clamp(4rem, 8vw, 7rem);
    }
    .hero-space {
      grid-template-columns: minmax(0, .9fr) minmax(340px, 1.1fr);
      gap: clamp(2rem, 5vw, 4.75rem);
      min-height: min(780px, calc(100vh - 5rem));
    }
    .hero-space-copy {
      position: relative;
      z-index: 1;
    }
    .space-hero-visual {
      position: relative;
      isolation: isolate;
      justify-self: end;
      width: min(100%, 42rem);
      aspect-ratio: 1;
      margin: 0;
      overflow: hidden;
      border: 1px solid rgba(229, 239, 235, .24);
      border-radius: 42% 58% 48% 52% / 48% 43% 57% 52%;
      background: #05080d;
      box-shadow:
        0 40px 88px rgba(15, 25, 36, .24),
        0 0 0 10px rgba(var(--mint-rgb), .045),
        0 0 100px rgba(var(--gold-rgb), .13);
      transition: border-color 220ms ease, box-shadow 220ms ease;
    }
    .space-hero-visual::before,
    .space-hero-visual::after {
      content: '';
      position: absolute;
      z-index: 1;
      pointer-events: none;
    }
    .space-hero-visual::before {
      inset: 2.5%;
      border: 1px solid rgba(255, 255, 255, .15);
      border-radius: inherit;
      box-shadow: inset 0 0 32px rgba(0, 0, 0, .42);
    }
    .space-hero-visual::after {
      inset: 0;
      background:
        linear-gradient(180deg, transparent 48%, rgba(2, 6, 11, .08) 61%, rgba(2, 6, 11, .84) 100%),
        radial-gradient(circle at 51% 42%, transparent 38%, rgba(2, 6, 11, .20) 100%);
    }
    .space-hero-art {
      position: relative;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.035);
    }
    .space-hero-caption {
      position: absolute;
      z-index: 2;
      right: clamp(1rem, 4vw, 2rem);
      bottom: clamp(1rem, 4vw, 2rem);
      left: clamp(1rem, 4vw, 2rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: #fff;
    }
    .space-hero-caption > span {
      font-size: clamp(.62rem, 1.1vw, .75rem);
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .76);
    }
    .space-hero-caption a {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      min-height: 44px;
      padding: .5rem .75rem;
      border: 1px solid rgba(255, 255, 255, .30);
      border-radius: 999px;
      background: rgba(5, 10, 16, .48);
      color: #fff;
      font-size: clamp(.74rem, 1.25vw, .88rem);
      font-weight: 800;
      text-decoration: none;
      backdrop-filter: blur(10px);
      transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
    }
    .space-hero-caption a:hover,
    .space-hero-caption a:focus-visible {
      border-color: rgba(255, 239, 193, .88);
      background: rgba(255, 255, 255, .16);
      transform: translateY(-2px);
    }
    .space-hero-caption a:focus-visible {
      outline: 3px solid var(--mint);
      outline-offset: 3px;
    }
    .space-hero-visual:hover,
    .space-hero-visual:focus-within {
      border-color: rgba(255, 239, 193, .52);
      box-shadow:
        0 40px 88px rgba(15, 25, 36, .30),
        0 0 0 10px rgba(var(--mint-rgb), .065),
        0 0 120px rgba(var(--gold-rgb), .20);
    }
    @media (prefers-reduced-motion: no-preference) {
      .space-hero-art { animation: space-hero-drift 18s ease-in-out infinite alternate; }
    }
    @keyframes space-hero-drift {
      from { transform: scale(1.035) translate3d(-.7%, -.55%, 0); }
      to { transform: scale(1.09) translate3d(.7%, .55%, 0); }
    }
    @media (max-width: 760px) {
      .home-hero-section { padding-top: 2.25rem; }
      .hero-space {
        grid-template-columns: 1fr;
        min-height: auto;
        gap: 2rem;
      }
      .space-hero-visual {
        justify-self: center;
        width: min(100%, 34rem);
      }
      .space-hero-caption { align-items: flex-end; }
      .space-hero-caption > span { max-width: 11ch; line-height: 1.25; }
    }
    @media (prefers-reduced-motion: reduce) {
      .space-hero-art { transform: scale(1.035); }
    }
    .home-audio-cta { padding-top: 0; }
    .home-audio-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(1rem, 4vw, 2rem);
      align-items: center;
      padding: clamp(1.2rem, 3vw, 2rem);
      border: 1px solid rgba(var(--blue-rgb), .24);
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(var(--blue-rgb), .10), rgba(var(--gold-rgb), .10)), var(--panel);
      box-shadow: var(--shadow);
    }
    .home-audio-panel h2 {
      font-size: clamp(1.8rem, 3vw, 3rem);
    }
    .home-audio-panel p {
      max-width: 68ch;
      margin-bottom: 0;
    }
    .home-audio-actions {
      display: grid;
      justify-items: end;
      gap: .65rem;
      min-width: min(100%, 18rem);
    }
    .home-audio-actions span {
      color: var(--muted);
      font-size: .85rem;
      font-weight: 850;
      text-align: right;
    }
    @media (max-width: 760px) {
      .home-audio-panel {
        grid-template-columns: 1fr;
      }
      .home-audio-actions {
        justify-items: start;
      }
      .home-audio-actions span {
        text-align: left;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const setupNewsletter = () => {
        const wrapper = document.querySelector('[data-newsletter-embed]');
        if (!wrapper || wrapper.dataset.ready) return;
        wrapper.dataset.ready = 'true';
        const url = wrapper.dataset.formUrl;
        if (!url) return;
        const mount = () => {
          wrapper.innerHTML = '<iframe class="newsletter-embed" src="' + url + '" title="Newsletter-Anmeldung Vitamin-Kompendium" loading="lazy"></iframe>';
        };
        const consent = localStorage.getItem('callidus-cookie-consent');
        if (consent === 'all') {
          mount();
          return;
        }
        wrapper.querySelector('[data-load-newsletter]')?.addEventListener('click', () => {
          localStorage.setItem('callidus-cookie-consent', 'all');
          document.documentElement.dataset.consent = 'all';
          mount();
        });
        window.addEventListener('callidus-consent', (event) => {
          if (event.detail === 'all') mount();
        });
      };
      setupNewsletter();
      document.addEventListener('astro:page-load', setupNewsletter);
    })();
  </script>
</BaseLayout>

      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .crypto-wallet-mini svg,
    .crypto-bridge-device svg {
      color: var(--crypto-blue);
      flex: 0 0 auto;
    }

    .crypto-gas-chip {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      min-height: 34px;
      padding: .35rem .6rem;
      border: 1px solid rgba(var(--crypto-orange-rgb), .28);
      border-radius: 8px;
      background: rgba(var(--crypto-orange-rgb), .10);
      color: var(--crypto-orange);
      font-size: .82rem;
      font-weight: 900;
    }

    .crypto-bridge-column {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 240px;
    }

    .crypto-route-line {
      position: absolute;
      left: -50%;
      right: -50%;
      top: 50%;
      height: 4px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(var(--blue-rgb), .18), rgba(var(--crypto-orange-rgb), .74), rgba(var(--blue-rgb), .18));
      transform: translateY(-50%);
    }

    .crypto-route-line::before,
    .crypto-route-line::after {
      content: "";
      position: absolute;
      top: 50%;
      width: .85rem;
      height: .85rem;
      border-radius: 50%;
      background: var(--crypto-orange);
      transform: translateY(-50%);
      box-shadow: 0 0 0 8px rgba(var(--crypto-orange-rgb), .10);
    }

    .crypto-route-line::before { left: 0; }
    .crypto-route-line::after { right: 0; }

    .crypto-moving-token {
      position: absolute;
      top: 50%;
      left: 4%;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 4.2rem;
      height: 4.2rem;
      border: 1px solid rgba(var(--gold-rgb), .36);
      border-radius: 50%;
      background: var(--crypto-panel);
      box-shadow: 0 18px 36px rgba(0, 0, 0, .18);
      transform: translate(-50%, -50%);
      animation: cryptoBridgeTransfer 7s ease-in-out infinite;
    }

    .crypto-moving-token img {
      width: 82%;
      height: 82%;
      object-fit: contain;
      filter: drop-shadow(0 8px 14px rgba(0, 0, 0, .25));
    }

    .crypto-bridge-device {
      display: grid;
      place-items: center;
      gap: .45rem;
      width: min(100%, 190px);
      min-height: 172px;

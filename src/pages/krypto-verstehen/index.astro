---
import BaseLayout from '../../layouts/BaseLayout.astro';

const basics = [
  {
    label: 'Wallet',
    title: 'Dein digitaler Schlüsselbund',
    text: 'Eine Wallet verwahrt keine Coins wie ein Tresor. Sie verwaltet die Schlüssel, mit denen du Transaktionen unterschreibst.',
  },
  {
    label: 'Blockchain',
    title: 'Ein öffentliches Kassenbuch',
    text: 'Transaktionen werden in einem Netzwerk gespeichert. Viele Dinge sind sichtbar, aber niemand kann einfach eine fertige Zahlung zurückholen.',
  },
  {
    label: 'Token',
    title: 'Eine Marke auf einer Chain',
    text: 'Ein Token ist ein digitaler Eintrag nach festen Regeln. Sein Wert entsteht nicht automatisch, sondern nur durch Nachfrage, Nutzen und Vertrauen.',
  },
  {
    label: 'DEX',
    title: 'Ein Markt ohne Bankfiliale',
    text: 'Auf dezentralen Börsen handelst du direkt mit Smart Contracts. Das ist offen, aber Fehler landen bei dir.',
  },
];

const commonChains = [
  {
    name: 'Bitcoin',
    coin: 'BTC',
    type: 'Layer 1',
    note: 'Ursprüngliche Kryptowährung; Gebühren werden in BTC bezahlt.',
    href: 'https://bitcoin.org/en/how-it-works',
  },
  {
    name: 'Ethereum',
    coin: 'ETH',
    type: 'Layer 1 / Smart Contracts',
    note: 'ETH ist Gas-Coin für Transaktionen und Smart Contracts.',
    href: 'https://ethereum.org/developers/docs/gas/',
  },
  {
    name: 'Base',
    coin: 'ETH',
    type: 'Ethereum Layer 2',
    note: 'Auf Base brauchst du ETH auf Base, nicht ETH auf Ethereum Mainnet.',
    href: 'https://docs.base.org/base-chain/network-information',
  },
  {
    name: 'Arbitrum One',
    coin: 'ETH',
    type: 'Ethereum Layer 2',
    note: 'Rollup-Netzwerk; Gas wird typischerweise in ETH bezahlt.',
    href: 'https://docs.arbitrum.io/',
  },
  {
    name: 'OP Mainnet',
    coin: 'ETH',
    type: 'Ethereum Layer 2',
    note: 'Optimism/OP-Stack-Netzwerk; ETH ist der übliche Gas-Coin.',
    href: 'https://docs.optimism.io/',
  },
  {
    name: 'Polygon PoS',
    coin: 'POL',
    type: 'EVM Chain',
    note: 'POL ist der Nachfolger von MATIC im Polygon-Ökosystem.',
    href: 'https://polygon.technology/',
  },
  {
    name: 'BNB Smart Chain',
    coin: 'BNB',
    type: 'EVM Chain',
    note: 'BNB wird für Gas auf BNB Smart Chain benötigt.',
    href: 'https://docs.bnbchain.org/',
  },
  {
    name: 'Solana',
    coin: 'SOL',
    type: 'Layer 1',
    note: 'SOL bezahlt Transaktionen und Account-Rent/Fees im Solana-Netzwerk.',
    href: 'https://solana.com/docs/core/fees',
  },
  {
    name: 'Avalanche C-Chain',
    coin: 'AVAX',
    type: 'EVM Chain',
    note: 'AVAX wird als native Coin für Gebühren im Avalanche-Netzwerk genutzt.',
    href: 'https://docs.avax.network/',
  },
  {
    name: 'Cardano',
    coin: 'ADA',
    type: 'Layer 1',
    note: 'ADA ist die native Coin für Transaktionen und Staking.',
    href: 'https://docs.cardano.org/',
  },
  {
    name: 'XRP Ledger',
    coin: 'XRP',
    type: 'Payment Chain',
    note: 'XRP wird für Gebühren und Reserve-Anforderungen im Ledger verwendet.',
    href: 'https://xrpl.org/',
  },
  {
    name: 'TRON',
    coin: 'TRX',
    type: 'Layer 1',
    note: 'TRX deckt Bandbreite, Energie und Gebühren im TRON-Netzwerk ab.',
    href: 'https://developers.tron.network/',
  },
  {
    name: 'Polkadot',
    coin: 'DOT',
    type: 'Multi-Chain Netzwerk',
    note: 'DOT wird für Governance, Staking und Netzwerkfunktionen genutzt.',
    href: 'https://wiki.polkadot.network/',
  },
  {
    name: 'Cosmos Hub',
    coin: 'ATOM',
    type: 'Interchain Hub',
    note: 'ATOM ist die native Coin des Cosmos Hub.',
    href: 'https://hub.cosmos.network/',
  },
  {
    name: 'Near Protocol',
    coin: 'NEAR',
    type: 'Layer 1',
    note: 'NEAR bezahlt Transaktionen und Speicher im Netzwerk.',
    href: 'https://docs.near.org/',
  },
  {
    name: 'Sui',
    coin: 'SUI',
    type: 'Move Layer 1',
    note: 'SUI wird für Gas, Storage Fund und Staking verwendet.',
    href: 'https://docs.sui.io/',
  },
  {
    name: 'Aptos',
    coin: 'APT',
    type: 'Move Layer 1',
    note: 'APT ist die native Coin für Gas und Staking.',
    href: 'https://aptos.dev/',
  },
  {
    name: 'TON',
    coin: 'TON',
    type: 'Layer 1',
    note: 'Toncoin wird für Gebühren und Netzwerkfunktionen genutzt.',
    href: 'https://docs.ton.org/',
  },
  {
    name: 'Algorand',
    coin: 'ALGO',
    type: 'Layer 1',
    note: 'ALGO ist native Coin für Gebühren, Governance und Staking-ähnliche Funktionen.',
    href: 'https://developer.algorand.org/docs/',
  },
  {
    name: 'Stellar',
    coin: 'XLM',
    type: 'Payment Chain',
    note: 'XLM wird für kleine Gebühren und Mindestreserven benötigt.',
    href: 'https://developers.stellar.org/docs/',
  },
  {
    name: 'Litecoin',
    coin: 'LTC',
    type: 'Payment Chain',
    note: 'LTC ist native Coin und bezahlt Transaktionsgebühren.',
    href: 'https://litecoin.org/',
  },
  {
    name: 'Dogecoin',
    coin: 'DOGE',
    type: 'Payment / Meme Chain',
    note: 'DOGE ist native Coin; auch Meme-Coins können eigene Chains haben.',
    href: 'https://dogecoin.com/',
  },
];

const checklist = [
  {
    title: 'Tokenomics',
    text: 'Wie viele Token gibt es? Gibt es Nachminting? Wer besitzt die größten Anteile? Sind Team- oder Reserve-Bestände nachvollziehbar?',
  },
  {
    title: 'Nutzen',
    text: 'Hat der Token einen echten Zweck oder lebt er nur von Aufmerksamkeit? Bei Memecoins ist fehlender Nutzen normal, aber genau deshalb ist das Risiko höher.',
  },
  {
    title: 'Liquidität',
    text: 'Kann man überhaupt kaufen und verkaufen, ohne den Preis stark zu bewegen? Wenig Liquidität macht Ein- und Ausstieg riskanter.',
  },
  {
    title: 'Contract',
    text: 'Stimmt die offizielle Contract-Adresse? Ist der Code verifiziert? Gibt es versteckte Steuern, Sperren oder Funktionen, die den Handel beeinflussen?',
  },
  {
    title: 'Halter-Verteilung',
    text: 'Wenn wenige Wallets sehr viel besitzen, können einzelne Verkäufe den Kurs stark drücken. Das nennt man Whale-Risiko.',
  },
  {
    title: 'Versprechen',
    text: 'Garantierte Rendite, sichere Gewinne oder Druck zum schnellen Kaufen sind rote Flaggen. Krypto bleibt Risiko, auch wenn es freundlich aussieht.',
  },
  {
    title: 'Gebühren',
    text: 'Prüfe Gas, Bridge-Kosten, DEX-Gebühren und Slippage. Ein kleiner Kauf kann durch Nebenkosten deutlich teurer werden.',
  },
  {
    title: 'Eigenverantwortung',
    text: 'Seed Phrase, Zieladresse und Netzwerk müssen stimmen. Es gibt meist keinen Kundendienst, der eine falsche Transaktion repariert.',
  },
];

const redFlags = [
  'Niemand erklärt die Tokenomics klar.',
  'Die Contract-Adresse wird nur in Chats oder Screenshots geteilt.',
  'Es gibt Gewinnversprechen oder Zeitdruck.',
  'Einzelne Wallets halten auffällig große Anteile.',
  'Du musst erst weitere Gebühren zahlen, um angebliche Gewinne auszuzahlen.',
  'Die Community verbietet kritische Fragen.',
];

const glossaryTerms = [
  {
    term: 'Native Coin',
    text: 'Die Grundwährung einer Blockchain. Sie bezahlt meistens Gas oder Netzwerkgebühren, zum Beispiel ETH auf Ethereum oder SOL auf Solana.',
  },
  {
    term: 'Token',
    text: 'Ein digitaler Vermögenswert, der auf einer bestehenden Chain läuft. Ein Token ist nicht automatisch die Gas-Währung dieser Chain.',
  },
  {
    term: 'Gas',
    text: 'Gebühr für Rechenarbeit im Netzwerk. Ohne passenden Gas-Coin kann eine Wallet oft nichts senden, auch wenn Token vorhanden sind.',
  },
  {
    term: 'Gwei',
    text: 'Kleine Einheit von ETH, in der Gaspreise auf Ethereum und vielen EVM-Netzwerken angezeigt werden.',
  },
  {
    term: 'Seed Phrase',
    text: 'Die Wiederherstellungswörter deiner Wallet. Wer sie hat, kann deine Wallet kontrollieren. Niemals teilen.',
  },
  {
    term: 'Private Key',
    text: 'Der geheime Schlüssel zu einer Adresse. Noch sensibler als ein Passwort, weil es meist keine Rücksetzung gibt.',
  },
  {
    term: 'Public Address',
    text: 'Die öffentliche Empfangsadresse. Man darf sie teilen, sollte aber wissen, dass Transaktionen oft öffentlich sichtbar sind.',
  },
  {
    term: 'Smart Contract',
    text: 'Programm auf der Blockchain. Es führt Regeln automatisch aus, kann aber Fehler oder gefährliche Funktionen enthalten.',
  },
  {
    term: 'Contract-Adresse',
    text: 'Die eindeutige Adresse eines Tokens oder Smart Contracts. Bei Memecoins wichtiger als Logo, Name oder Chat-Link.',
  },
  {
    term: 'DEX',
    text: 'Dezentrale Börse. Du handelst direkt mit Smart Contracts statt über eine klassische Börse mit Kundendienst.',
  },
  {
    term: 'Liquidity Pool',
    text: 'Ein Topf aus zwei oder mehr Assets, aus dem eine DEX Handel ermöglicht. Wenig Liquidität bedeutet mehr Preisrutsch.',
  },
  {
    term: 'Slippage',
    text: 'Unterschied zwischen erwartetem Preis und tatsächlichem Ausführungspreis. Bei kleinen Memecoins oft ein echtes Problem.',
  },
  {
    term: 'Bridge',
    text: 'Verbindung zwischen Chains. Sie bewegt Werte technisch zwischen Netzwerken, bringt aber zusätzliche Kosten und Risiken.',
  },
  {
    term: 'Layer 1',
    text: 'Eigenständige Basis-Blockchain wie Bitcoin, Ethereum oder Solana.',
  },
  {
    term: 'Layer 2',
    text: 'Netzwerk, das auf einer Basis-Chain aufsetzt, etwa Base, Arbitrum oder OP Mainnet auf Ethereum.',
  },
  {
    term: 'Rollup',
    text: 'Layer-2-Technik, die viele Transaktionen bündelt und auf einer Layer 1 absichert.',
  },
  {
    term: 'Block Explorer',
    text: 'Suchmaschine für Blockchain-Daten. Dort prüfst du Transaktionen, Contract-Adressen und Wallet-Aktivität.',
  },
  {
    term: 'Tokenomics',
    text: 'Die wirtschaftlichen Regeln eines Tokens: Menge, Verteilung, Gebühren, Sperrfristen, Minting und Anreize.',
  },
  {
    term: 'Circulating Supply',
    text: 'Menge der Token, die aktuell im Umlauf ist. Nicht immer gleich der maximalen Gesamtmenge.',
  },
  {
    term: 'Market Cap',
    text: 'Preis mal umlaufende Menge. Bei geringer Liquidität kann diese Zahl größer wirken, als sie praktisch handelbar ist.',
  },
  {
    term: 'FDV',
    text: 'Fully Diluted Valuation: theoretischer Wert, wenn alle Token im Umlauf wären. Hilft, versteckte Verwässerung zu erkennen.',
  },
  {
    term: 'Rug Pull',
    text: 'Betrug oder Projektabbruch, bei dem Liquidität, Vertrauen oder Tokenwert plötzlich verschwinden.',
  },
  {
    term: 'Honeypot',
    text: 'Token, den man kaufen, aber nicht oder kaum verkaufen kann. Deshalb immer Contract und kleine Testbeträge prüfen.',
  },
  {
    term: 'Approval',
    text: 'Erlaubnis, dass ein Smart Contract Token aus deiner Wallet bewegen darf. Alte Approvals regelmäßig widerrufen.',
  },
  {
    term: 'Staking',
    text: 'Token werden zur Netzwerksicherheit oder Teilnahme hinterlegt. Renditen sind nicht risikofrei.',
  },
  {
    term: 'Validator',
    text: 'Teilnehmer, der Transaktionen prüft oder Blöcke produziert. Je nach Netzwerk braucht er Stake, Hardware oder Reputation.',
  },
  {
    term: 'Oracle',
    text: 'Datenquelle, die externe Informationen wie Preise in Smart Contracts bringt. Falsche Daten können große Schäden auslösen.',
  },
  {
    term: 'MEV',
    text: 'Wert, der durch Sortieren oder Einschieben von Transaktionen entstehen kann. Für Nutzer zeigt sich das oft als schlechterer Preis.',
  },
];

const sources = [
  {
    label: 'Ethereum.org: Gas und Gebühren',
    href: 'https://ethereum.org/developers/docs/gas/',
  },
  {
    label: 'Ethereum.org: Blockchain Bridges',
    href: 'https://ethereum.org/bridges/',
  },
  {
    label: 'Investor.gov: Crypto Assets',
    href: 'https://www.investor.gov/additional-resources/spotlight/crypto-assets',
  },
  {
    label: 'Bitcoin.org: Grundlagen',
    href: 'https://bitcoin.org/en/how-it-works',
  },
  {
    label: 'Solana: Gebühren',
    href: 'https://solana.com/docs/core/fees',
  },
  {
    label: 'Base: Netzwerkdaten',
    href: 'https://docs.base.org/base-chain/network-information',
  },
  {
    label: 'Avalanche Docs',
    href: 'https://docs.avax.network/',
  },
  {
    label: 'Cardano Docs',
    href: 'https://docs.cardano.org/',
  },
  {
    label: 'Callidus: Krypto-Hinweis',
    href: '/krypto-hinweis/',
  },
  {
    label: 'Callidus: Krypto-Training',
    href: '/krypto-training/',
  },
  {
    label: 'Valus Litepaper',
    href: '/valus-litepaper.html',
  },
];
---

<BaseLayout
  title="Krypto einfach erklärt | callidus A&M"
  description="Ein leicht verständlicher Krypto-Leitfaden zu Wallets, Bridges, Gas-Gebühren, Tokenomics, Memecoins und Eigenverantwortung."
  lang="de"
  ogImage="/assets/valus-coin.png"
>
  <article class="crypto-education">
    <section class="crypto-hero" aria-labelledby="crypto-title">
      <div class="crypto-container crypto-hero-grid">
        <div class="crypto-hero-copy" data-reveal>
          <p class="crypto-eyebrow">Krypto ohne Hype</p>
          <h1 id="crypto-title">Verstehen, bevor du verbindest.</h1>
          <p class="crypto-lead">
            Diese Seite erklärt Krypto so, dass man kein Technikstudium braucht:
            Wallets, Bridges, Gebühren, Tokenomics, Memecoins und warum du selbst
            Verantwortung trägst. Nicht als Kaufempfehlung, sondern als Schutz vor
            falscher Sicherheit.
          </p>
          <div class="crypto-actions" aria-label="Schnelle Einstiege">
            <a class="crypto-button crypto-button-primary" href="#checkliste">Checkliste lesen</a>
            <a class="crypto-button" href="/krypto-training/">Krypto-Training üben</a>
            <a class="crypto-button" href="#bridge">Bridge verstehen</a>
            <a class="crypto-button" href="#chains">Chains & Coins</a>
            <a class="crypto-button" href="#begriffe">Glossar</a>
            <a class="crypto-button" href="/valus-litepaper.html">Valus Litepaper</a>
          </div>
        </div>

        <div class="crypto-visual" data-reveal="2">
          <div class="crypto-visual-title">
            <span>Animation 1 von 4 · Die Wallet</span>
            <strong>Schlüsselbund, keine Geldbörse</strong>
          </div>

          <div class="ca-stage" role="img" aria-label="Animierte Darstellung: Eine Wallet verwahrt privaten Schlüssel und Adresse, die Coins bleiben auf der Blockchain">
            <div class="ca-scene ca-wallet" aria-hidden="true">
              <div class="caw-card">
                <span class="caw-kicker">Deine Wallet</span>
                <span class="caw-key">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3L22 7l-3-3"></path></svg>
                  Privater Schlüssel
                </span>
                <span class="caw-addr">Adresse: <span class="caw-type">0x71C…F92A</span></span>
              </div>
              <div class="caw-chain">
                <span class="caw-coins">
                  <span class="ca-coin">Ξ</span>
                  <span class="ca-coin">Ξ</span>
                </span>
                <span class="caw-chainnote">Coins bleiben auf der Blockchain</span>
              </div>
              <div class="ca-merksatz caw-merk">Wallet = Schlüsselbund, nicht Geldbörse</div>
            </div>
          </div>

          <ol class="crypto-visual-steps" aria-label="Wallet-Grundlagen in vier Schritten">
            <li><strong>1</strong><span>Die Wallet erzeugt deine Schlüssel.</span></li>
            <li><strong>2</strong><span>Die Adresse darfst du öffentlich teilen.</span></li>
            <li><strong>3</strong><span>Seed Phrase und Private Key bleiben geheim.</span></li>
            <li><strong>4</strong><span>Die Coins liegen auf der Chain, nicht im Gerät.</span></li>
          </ol>

          <p class="crypto-visual-note">Wer deine Schlüssel hat, hat dein Geld. Die Wallet ist nur der Schlüsselbund – das Kassenbuch ist die Blockchain. <a class="ca-next" href="#transaktion">Weiter: Die Transaktion ↓</a></p>
        </div>
      </div>
    </section>

    <section class="crypto-facts" aria-label="Kernaussagen">
      <div class="crypto-container crypto-fact-grid">
        <div class="crypto-fact">
          <strong>Keine Bank</strong>
          <span>Du unterschreibst selbst. Es gibt normalerweise keine Rückbuchung.</span>
        </div>
        <div class="crypto-fact">
          <strong>Gebühren sind normal</strong>
          <span>Netzwerke verlangen Gas, damit Transaktionen verarbeitet werden.</span>
        </div>
        <div class="crypto-fact">
          <strong>Memecoin ist Risiko</strong>
          <span>Spaß schützt nicht vor Verlust. Aufmerksamkeit ist kein Fundament.</span>
        </div>
      </div>
    </section>

    <section class="crypto-section" id="grundlagen">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">Grundlagen</p>
        <h2>Vier Begriffe, die alles leichter machen.</h2>
        <p>
          Krypto wirkt kompliziert, weil viele Worte gleichzeitig auftauchen.
          Fang mit diesen vier Bildern an, dann wird der Rest deutlich ruhiger.
        </p>
      </div>
      <div class="crypto-container crypto-basics-grid">
        {basics.map((item) => (
          <article class="crypto-info-card">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <div class="crypto-container">
        <div class="ca-card ca-card--center" id="transaktion" data-reveal>
          <div class="ca-head">
            <h3>Die Transaktion</h3>
            <span class="ca-chip">Animation 2 von 4</span>
          </div>
          <div class="ca-stage" role="img" aria-label="Animierte Darstellung: Eine signierte Transaktion wandert vom Absender über das Netzwerk zum Empfänger und wird in einem neuen Block gespeichert">
            <div class="ca-scene ca-tx" aria-hidden="true">
              <div class="cat-line"></div>
              <div class="cat-node cat-you">
                <span class="cat-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
                </span>
                <span>Du</span>
              </div>
              <div class="cat-node cat-net">
                <span class="cat-icon cat-icon-net">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><circle cx="4" cy="5" r="2"></circle><circle cx="20" cy="5" r="2"></circle><circle cx="4" cy="19" r="2"></circle><circle cx="20" cy="19" r="2"></circle><path d="m5.5 6.5 4.5 3.5"></path><path d="m18.5 6.5-4.5 3.5"></path><path d="m5.5 17.5 4.5-3.5"></path><path d="m18.5 17.5-4.5-3.5"></path></svg>
                </span>
                <span>Netzwerk prüft</span>
              </div>
              <div class="cat-node cat-rcv">
                <span class="cat-icon cat-icon-rcv">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path></svg>
                  <i class="cat-check">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                  </i>
                </span>
                <span>Empfänger</span>
              </div>
              <div class="cat-pill">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                Signiert
              </div>
              <div class="cat-blocks">
                <span>#8238</span><span>#8239</span><span>#8240</span><span class="cat-block-new">#8241</span>
              </div>
              <div class="cat-forever">Neuer Block – für immer gespeichert</div>
            </div>
          </div>
          <p class="ca-caption"><strong>So läuft es ab:</strong> Du unterschreibst mit deinem Schlüssel, das Netzwerk prüft die Transaktion und schreibt sie unwiderruflich in einen neuen Block. Eine Rückbuchung gibt es nicht. <a class="ca-next" href="#gebuehren">Weiter: Gas-Gebühren ↓</a></p>
        </div>
      </div>
    </section>

    <section class="crypto-section crypto-band" id="memecoin">
      <div class="crypto-container crypto-split">
        <div>
          <p class="crypto-eyebrow">Memecoins</p>
          <h2>Ein Witz kann trotzdem echtes Geld kosten.</h2>
        </div>
        <div class="crypto-prose">
          <p>
            Ein Memecoin kann Community, Symbol und Spaß sein. Das ist nicht automatisch schlecht.
            Gefährlich wird es, wenn aus einem Witz plötzlich eine Gewinnerwartung wird.
            Viele Memecoins haben keinen inneren Wert, keinen echten Nutzen und keine stabile Nachfrage.
          </p>
          <p>
            Valus (VAL) wird im Litepaper bewusst als experimenteller Memecoin ohne Nutzen- und
            Gewinnversprechen beschrieben. Genau diese Klarheit sollte auch bei anderen Memecoins
            dein Mindeststandard sein: Was ist es, was ist es nicht, und welches Risiko bleibt bei dir?
          </p>
          <div class="crypto-link-row">
            <a class="crypto-button crypto-button-primary" href="/valus-litepaper.html">Litepaper öffnen</a>
            <a class="crypto-button" href="/krypto-hinweis/">Risiko-Hinweis lesen</a>
          </div>
        </div>
      </div>
    </section>

    <section class="crypto-section" id="checkliste">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">Vor dem Kauf</p>
        <h2>Worauf du bei Tokenomics, Nutzen und Risiken achten solltest.</h2>
        <p>
          Diese Liste ist keine Anlageberatung. Sie ist eine Bremse gegen Hektik.
          Wenn du die Punkte nicht beantworten kannst, ist das ein Signal zum Innehalten.
        </p>
      </div>
      <div class="crypto-container crypto-check-grid">
        {checklist.map((item, index) => (
          <article class="crypto-check-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="crypto-section crypto-band" id="gebuehren">
      <div class="crypto-container crypto-split">
        <div>
          <p class="crypto-eyebrow">Gas</p>
          <h2>Warum zahlt man Gebühren, wenn man etwas überweist?</h2>
        </div>
        <div class="crypto-prose">
          <p>
            Bei einer Bank bezahlt oft die Bankinfrastruktur im Hintergrund. Bei einer Blockchain
            bezahlt der Absender direkt das Netzwerk. Diese Gebühr heißt häufig Gas.
            Sie bezahlt Rechenarbeit, verhindert Spam und sorgt dafür, dass deine Transaktion in
            einen Block aufgenommen werden kann.
          </p>
          <p>
            Wichtig: Du brauchst meistens die native Coin der jeweiligen Chain für Gebühren.
            Auf Base ist das zum Beispiel ETH auf Base. Ein Token allein reicht oft nicht, um ihn
            zu bewegen, wenn kein Gas vorhanden ist.
          </p>
          <div class="crypto-formula" aria-label="Einfache Gas-Formel">
            <span>Gas</span>
            <strong>=</strong>
            <span>Netzwerk-Arbeit</span>
            <strong>+</strong>
            <span>Auslastung</span>
            <strong>+</strong>
            <span>Dringlichkeit</span>
          </div>
        </div>
      </div>
      <div class="crypto-container">
        <div class="ca-card ca-card--center" data-reveal>
          <div class="ca-head">
            <h3>Gas in einem Bild</h3>
            <span class="ca-chip">Animation 3 von 4</span>
          </div>
          <div class="ca-stage" role="img" aria-label="Animierte Darstellung: Von 1,000 gesendeten ETH kommen 0,997 beim Empfänger an, 0,003 gehen als Gas-Gebühr an das Netzwerk">
            <div class="ca-scene ca-gas" aria-hidden="true">
              <div class="cag-send"><span>Du sendest</span><strong>1,000 ETH</strong></div>
              <span class="ca-coin cag-main">Ξ</span>
              <span class="ca-coin cag-fee">Ξ</span>
              <div class="cag-card cag-rcv">
                <span>Empfänger</span>
                <strong class="cag-amt">0,997 ETH</strong>
              </div>
              <div class="cag-card cag-net">
                <span>Gas ans Netzwerk</span>
                <strong class="cag-amt">0,003 ETH</strong>
                <span class="cag-gauge"><i></i></span>
              </div>
              <div class="ca-merksatz cag-merk">Ohne native Coin geht nichts – auch nicht bei Token</div>
            </div>
          </div>
          <p class="ca-caption"><strong>Das Bild dahinter:</strong> Ein kleiner Teil deiner Summe geht als Gas an das Netzwerk. Die Zahlen sind nur ein Beispiel – die Höhe hängt von Chain und Auslastung ab. <a class="ca-next" href="#bridge">Weiter: Die Bridge ↓</a></p>
        </div>
      </div>
    </section>

    <section class="crypto-section" id="bridge">
      <div class="crypto-container crypto-split crypto-bridge-layout">
        <div>
          <p class="crypto-eyebrow">Bridge</p>
          <h2>Warum muss man manchmal bridgen?</h2>
          <p class="crypto-section-copy">
            Blockchains sind wie eigene Länder mit eigenen Regeln. Token bewegen sich nicht einfach
            frei von Ethereum nach Base, Solana oder eine andere Chain. Eine Bridge ist die technische
            Übergangsstelle zwischen diesen Welten.
          </p>
        </div>
        <div class="ca-card" data-reveal="2">
          <div class="ca-head">
            <h3>Die Bridge</h3>
            <span class="ca-chip">Animation 4 von 4</span>
          </div>
          <div class="ca-stage" role="img" aria-label="Animierte Darstellung: Eine Bridge sperrt einen Token auf Ethereum und prägt ihn auf Base neu">
            <div class="ca-scene ca-bridge" aria-hidden="true">
              <div class="cab-line"></div>
              <div class="cab-tag">Bridge</div>
              <div class="cab-dot"></div>
              <div class="cab-chain cab-a">
                <span>Chain A</span>
                <strong>Ethereum</strong>
                <div class="cab-token">T
                  <i class="cab-lock">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  </i>
                </div>
                <em class="cab-lock-label">Token gesperrt</em>
              </div>
              <div class="cab-chain cab-b">
                <span>Chain B</span>
                <strong>Base</strong>
                <div class="cab-slot"><div class="cab-token cab-minted">T</div></div>
                <em class="cab-mint-label">Token geprägt</em>
              </div>
              <div class="ca-merksatz cab-merk">Auf der Ziel-Chain brauchst du wieder Gas – z. B. ETH auf Base</div>
            </div>
          </div>
          <p class="ca-caption"><strong>Merke:</strong> Die Bridge sperrt deine Token auf Chain A und prägt sie auf Chain B neu. Gleicher Wert, anderes Netzwerk – und dort brauchst du wieder Gas. <a class="ca-next" href="#chains">Weiter: Chains &amp; Coins ↓</a></p>
        </div>
      </div>
      <div class="crypto-container crypto-note-grid">
        <div class="crypto-note">
          <h3>Warum kostet das etwas?</h3>
          <p>Weil auf mindestens einem Netzwerk eine echte Transaktion ausgeführt wird. Je nach Bridge können mehrere Schritte, Wartezeiten und Servicekosten entstehen.</p>
        </div>
        <div class="crypto-note">
          <h3>Warum ist das riskant?</h3>
          <p>Bridges verbinden Systeme. Fehler im Smart Contract, falsche Bedienung oder ein Angriff auf die Bridge können zu Verlusten führen.</p>
        </div>
      </div>
    </section>

    <section class="crypto-section crypto-band" id="chains">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">Netzwerke</p>
        <h2>Gängige Blockchains und ihre nativen Coins.</h2>
        <p>
          Wichtig: Die native Coin ist die Währung, die du für Gebühren auf genau dieser
          Chain brauchst. Ein Token wie USDC, VAL oder ein Memecoin kann auf derselben Chain
          liegen, bezahlt aber normalerweise nicht automatisch die Netzwerkgebühr.
        </p>
      </div>
      <div class="crypto-container">
        <div class="crypto-chain-table" role="table" aria-label="Gängige Blockchains und native Coins">
          <div class="crypto-chain-head" role="row">
            <span role="columnheader">Blockchain</span>
            <span role="columnheader">Native Coin</span>
            <span role="columnheader">Typ</span>
            <span role="columnheader">Merken</span>
          </div>
          {commonChains.map((chain) => (
            <a class="crypto-chain-row" href={chain.href} target="_blank" rel="noopener noreferrer" role="row">
              <span role="cell">
                <strong>{chain.name}</strong>
              </span>
              <span role="cell" class="crypto-chain-coin">{chain.coin}</span>
              <span role="cell">{chain.type}</span>
              <span role="cell">{chain.note}</span>
            </a>
          ))}
        </div>
        <p class="crypto-table-note">
          Diese Übersicht ist eine praktische Auswahl gängiger Netzwerke, keine vollständige Weltkarte aller Chains.
          Prüfe vor einer Transaktion immer das konkrete Netzwerk in deiner Wallet.
        </p>
      </div>
    </section>

    <section class="crypto-section crypto-band" id="verantwortung">
      <div class="crypto-container crypto-split">
        <div>
          <p class="crypto-eyebrow">Eigenverantwortung</p>
          <h2>Keine Bank heißt auch: kein Sicherheitsnetz wie gewohnt.</h2>
        </div>
        <div class="crypto-prose">
          <p>
            Krypto gibt dir mehr direkte Kontrolle. Das ist der Reiz, aber auch die Last.
            Wenn du an eine falsche Adresse sendest, deine Seed Phrase teilst oder auf einen
            falschen Token klickst, kann das Geld dauerhaft weg sein.
          </p>
          <p>
            Denk daran wie bei Gesundheit und Wohlbefinden: Niemand kann täglich für dich
            schlafen, essen, trainieren oder Grenzen setzen. Andere können erklären und warnen,
            aber die Entscheidung und die Sorgfalt liegen am Ende bei dir.
          </p>
        </div>
      </div>
    </section>

    <section class="crypto-section" id="routine">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">5-Minuten-Routine</p>
        <h2>Bevor du kaufst, sendest oder eine Wallet verbindest.</h2>
        <p>Eine einfache Routine schützt nicht vor jedem Risiko, aber sie verhindert viele teure Alltagsfehler.</p>
      </div>
      <div class="crypto-container crypto-routine">
        <div><strong>1</strong><span>Offizielle Website und Contract-Adresse vergleichen.</span></div>
        <div><strong>2</strong><span>Netzwerk prüfen: Ethereum, Base, Polygon oder etwas anderes?</span></div>
        <div><strong>3</strong><span>Gebühren, Slippage und Bridge-Kosten vor dem Klick ansehen.</span></div>
        <div><strong>4</strong><span>Erst eine kleine Testtransaktion senden, wenn der Betrag wichtig ist.</span></div>
        <div><strong>5</strong><span>Nie Seed Phrase, Private Key oder Bildschirmfreigabe herausgeben.</span></div>
      </div>
    </section>

    <section class="crypto-section crypto-band" id="training" aria-labelledby="crypto-training-title">
      <div class="crypto-container crypto-split">
        <div>
          <p class="crypto-eyebrow">Übungsmodus</p>
          <h2 id="crypto-training-title">Erst hier üben, dann echt entscheiden.</h2>
        </div>
        <div class="crypto-prose">
          <p>
            Lesen ist gut, selbst klicken ist besser. Im interaktiven Krypto-Training
            durchläufst du den kompletten Weg einmal gefahrlos: Wallet erstellen,
            Seed Phrase sichern, Wallet verbinden, den Übungs-Coin Valus (VAL) kaufen,
            nach Polygon bridgen und sicher überweisen – mit Quizfragen und Hinweisen
            bei jedem Schritt.
          </p>
          <p>
            Alles ist Simulation: kein echtes Geld, keine echte Blockchain, keine
            Anlageberatung. Dafür merkst du sofort, wo im echten Ablauf die teuren
            Fehler passieren würden.
          </p>
          <div class="crypto-link-row">
            <a class="crypto-button crypto-button-primary" href="/krypto-training/">Training starten (ca. 10 Minuten)</a>
          </div>
        </div>
      </div>
    </section>

    <section class="crypto-section crypto-band" id="begriffe">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">Begriffe</p>
        <h2>Glossar für die Wörter, die ständig fallen.</h2>
        <p>
          Wenn ein Projekt diese Begriffe benutzt, sollte es sie auch verständlich erklären können.
          Unklare Sprache ist bei Krypto selten ein gutes Zeichen.
        </p>
      </div>
      <div class="crypto-container crypto-glossary-grid">
        {glossaryTerms.map((item) => (
          <article class="crypto-glossary-card">
            <h3>{item.term}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="crypto-section crypto-warning-section">
      <div class="crypto-container crypto-split">
        <div>
          <p class="crypto-eyebrow">Warnsignale</p>
          <h2>Wenn du das siehst, geh langsamer.</h2>
        </div>
        <ul class="crypto-red-flags">
          {redFlags.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="crypto-section crypto-final">
      <div class="crypto-container crypto-final-panel">
        <img src="/assets/valus-coin-cutout.png" alt="Goldene Valus-Münze" width="500" height="500" loading="lazy" decoding="async" />
        <div>
          <p class="crypto-eyebrow">Merksatz</p>
          <h2>Erst verstehen, dann klicken.</h2>
          <p>
            Krypto braucht keine Bank. Genau deshalb braucht es mehr Aufmerksamkeit:
            Contract prüfen, Chain prüfen, Gebühren prüfen, Risiko akzeptieren.
            Wenn ein Projekt nicht klar erklärt, was es ist, ist das bereits eine Antwort.
          </p>
          <div class="crypto-link-row">
            <a class="crypto-button crypto-button-primary" href="/valus-litepaper.html">Zum Valus Litepaper</a>
            <a class="crypto-button" href="#checkliste">Zur Checkliste</a>
          </div>
        </div>
      </div>
    </section>

    <section class="crypto-section crypto-sources" aria-labelledby="crypto-sources-title">
      <div class="crypto-container crypto-section-head">
        <p class="crypto-eyebrow">Weiterlesen</p>
        <h2 id="crypto-sources-title">Quellen und Hinweise.</h2>
        <p>Diese Seite ersetzt keine Finanz-, Rechts- oder Steuerberatung. Sie ist ein Einstieg in die Begriffe und Risiken.</p>
      </div>
      <div class="crypto-container crypto-source-list">
        {sources.map((source) => (
          <a href={source.href} target={source.href.startsWith('http') ? '_blank' : undefined} rel={source.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <span>{source.label}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
          </a>
        ))}
      </div>
    </section>
  </article>

  <style>
    .crypto-education {
      --crypto-ink: var(--text);
      --crypto-muted: var(--muted);
      --crypto-panel: var(--panel);
      --crypto-line: var(--line);
      --crypto-blue: #2f6f8f;
      --crypto-blue-rgb: 47, 111, 143;
      --crypto-orange: #b86436;
      --crypto-orange-rgb: 184, 100, 54;
      --crypto-gold: var(--gold);
      --crypto-mint: var(--mint);
      --ca-dur: 11s;
      --ca-wallet-bg: #2f6f8f;
      --ca-coin-edge: #b88c18;
      --ca-coin-ink: #5e4a08;
      --ca-green: #3d7d4a;
      --ca-green-rgb: 61, 125, 74;
      --ca-green-ink: #fff;
      color: var(--crypto-ink);
    }

    html[data-theme="dark"] .crypto-education {
      --crypto-blue: #84d7ff;
      --crypto-blue-rgb: 132, 215, 255;
      --crypto-orange: #ff9a6f;
      --crypto-orange-rgb: 255, 154, 111;
      --ca-wallet-bg: #1c4258;
      --ca-green: #8fd99b;
      --ca-green-rgb: 143, 217, 155;
      --ca-green-ink: #12291a;
    }

    .crypto-container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .crypto-hero,
    .crypto-section {
      padding: 5rem 0;
    }

    .crypto-hero {
      border-bottom: 1px solid var(--crypto-line);
      background:
        linear-gradient(120deg, rgba(var(--blue-rgb), .11), transparent 38%),
        linear-gradient(180deg, rgba(var(--gold-rgb), .10), transparent 62%);
    }

    .crypto-hero-grid,
    .crypto-split {
      display: grid;
      grid-template-columns: minmax(0, .95fr) minmax(320px, 1.05fr);
      gap: 3rem;
      align-items: center;
    }

    .crypto-eyebrow {
      margin: 0 0 .8rem;
      color: var(--crypto-blue);
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .crypto-hero h1,
    .crypto-section h2 {
      margin: 0;
      letter-spacing: 0;
      line-height: 1.02;
    }

    .crypto-hero h1 {
      max-width: 10ch;
      font-size: 4.85rem;
    }

    .crypto-section h2 {
      max-width: 13ch;
      font-size: 3.15rem;
    }

    .crypto-lead,
    .crypto-section-head p,
    .crypto-section-copy,
    .crypto-prose p,
    .crypto-final-panel p {
      color: var(--crypto-muted);
      font-size: 1.05rem;
      line-height: 1.72;
    }

    .crypto-lead {
      max-width: 64ch;
      margin: 1.25rem 0 0;
      font-size: 1.18rem;
    }

    .crypto-actions,
    .crypto-link-row {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
      margin-top: 1.6rem;
    }

    .crypto-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: .75rem 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      color: var(--crypto-ink);
      background: rgba(var(--blue-rgb), .06);
      text-decoration: none;
      font-weight: 850;
      cursor: pointer;
      transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, color 200ms ease;
    }

    .crypto-button:hover {
      transform: translateY(-2px);
      border-color: rgba(var(--blue-rgb), .44);
      background: rgba(var(--blue-rgb), .12);
    }

    .crypto-button:focus-visible,
    .crypto-source-list a:focus-visible {
      outline: 3px solid var(--crypto-blue);
      outline-offset: 4px;
    }

    .crypto-button-primary {
      border-color: transparent;
      background: var(--crypto-orange);
      color: #fffaf2;
      box-shadow: 0 16px 34px rgba(var(--crypto-orange-rgb), .22);
    }

    .crypto-button-primary:hover {
      border-color: transparent;
      background: #9f542c;
      color: #fffaf2;
    }

    html[data-theme="dark"] .crypto-button-primary:hover {
      background: #ffab84;
      color: #1d100a;
    }

    .crypto-visual {
      position: relative;
      overflow: hidden;
      min-height: 500px;
      padding: 1.15rem;
      border: 1px solid rgba(var(--blue-rgb), .24);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .10), rgba(var(--gold-rgb), .08)),
        var(--crypto-panel);
      box-shadow: 0 24px 70px rgba(58, 64, 38, .13);
    }

    .crypto-visual-title {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .8rem;
      align-items: center;
      padding-bottom: .9rem;
      border-bottom: 1px solid var(--crypto-line);
    }

    .crypto-visual-title span {
      color: var(--crypto-muted);
      font-size: .82rem;
      font-weight: 800;
    }

    .crypto-visual-title strong {
      color: var(--crypto-blue);
      font-size: .8rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .crypto-red-flags svg,
    .crypto-source-list svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ===== Erklär-Animationen (4 Szenen, verteilt über die Seite) ===== */

    .ca-card {
      padding: 1.1rem;
      border: 1px solid rgba(var(--blue-rgb), .24);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .08), rgba(var(--gold-rgb), .07)),
        var(--crypto-panel);
      box-shadow: 0 20px 55px rgba(58, 64, 38, .12);
    }

    .ca-card--center {
      width: min(100%, 680px);
      margin: 2.4rem auto 0;
    }

    .ca-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: .8rem;
      margin-bottom: .8rem;
    }

    .ca-head h3 {
      margin: 0;
      font-size: 1.35rem;
      line-height: 1.2;
    }

    .ca-chip {
      flex: 0 0 auto;
      padding: .28rem .62rem;
      border: 1px solid rgba(var(--blue-rgb), .3);
      border-radius: 999px;
      color: var(--crypto-blue);
      font-size: .7rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .ca-stage {
      position: relative;
      height: 280px;
      overflow: hidden;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .05);
    }

    .ca-scene {
      position: absolute;
      inset: 0;
      animation: caScene var(--ca-dur) linear infinite;
    }

    .ca-caption {
      margin: .9rem 0 0;
      color: var(--crypto-muted);
      font-size: .95rem;
      line-height: 1.55;
    }

    .ca-caption strong {
      color: var(--crypto-ink);
    }

    .ca-next {
      color: var(--crypto-blue);
      font-weight: 850;
      text-decoration: none;
      white-space: nowrap;
    }

    .ca-next:hover {
      text-decoration: underline;
    }

    .ca-next:focus-visible {
      outline: 3px solid var(--crypto-blue);
      outline-offset: 3px;
    }

    .ca-coin {
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      border: 2px solid var(--ca-coin-edge);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #f5dfa0, #d4a829);
      color: var(--ca-coin-ink);
      font-weight: 800;
      font-size: 1rem;
      box-shadow: 0 8px 18px rgba(0, 0, 0, .16);
    }

    .ca-merksatz {
      position: absolute;
      z-index: 3;
      padding: .45rem .7rem;
      border-radius: 8px;
      background: rgba(var(--ca-green-rgb), .14);
      color: var(--ca-green);
      font-size: .82rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .caw-key svg,
    .cat-icon svg,
    .cat-check svg,
    .cat-pill svg,
    .cab-lock svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Szene 1: Wallet */

    .ca-wallet .caw-card {
      position: absolute;
      left: 5%;
      top: 12%;
      display: flex;
      flex-direction: column;
      gap: .7rem;
      width: min(54%, 260px);
      padding: .9rem 1rem;
      border-radius: 12px;
      background: var(--ca-wallet-bg);
      box-shadow: 0 14px 30px rgba(0, 0, 0, .18);
      animation: cawCard var(--ca-dur) ease infinite;
    }

    .caw-kicker {
      color: rgba(255, 255, 255, .75);
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .caw-key {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      width: fit-content;
      padding: .4rem .7rem;
      border: 1px solid rgba(255, 255, 255, .25);
      border-radius: 999px;
      background: rgba(255, 255, 255, .12);
      color: #fff;
      font-size: .8rem;
      font-weight: 800;
      animation: cawKey var(--ca-dur) ease infinite;
    }

    .caw-key svg {
      width: .95rem;
      height: .95rem;
    }

    .caw-addr {
      display: flex;
      align-items: center;
      gap: .4rem;
      color: rgba(255, 255, 255, .85);
      font-size: .78rem;
      font-weight: 700;
    }

    .caw-type {
      display: inline-block;
      overflow: hidden;
      max-width: 12ch;
      white-space: nowrap;
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      animation: cawType var(--ca-dur) linear infinite;
    }

    .caw-chain {
      position: absolute;
      right: 5%;
      top: 14%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .6rem;
      animation: cawChain var(--ca-dur) ease infinite;
    }

    .caw-coins {
      display: flex;
      gap: .4rem;
      animation: caFloat 3.5s ease-in-out infinite;
    }

    .caw-coins .ca-coin {
      width: 2.2rem;
      height: 2.2rem;
    }

    .caw-chainnote {
      max-width: 175px;
      padding: .3rem .6rem;
      border: 1px solid var(--crypto-line);
      border-radius: 999px;
      background: var(--crypto-panel);
      color: var(--crypto-muted);
      font-size: .72rem;
      font-weight: 800;
      text-align: center;
    }

    .caw-merk {
      left: 5%;
      bottom: 9%;
      max-width: 88%;
      animation: cawMerk var(--ca-dur) ease infinite;
    }

    /* Szene 2: Transaktion */

    .cat-line {
      position: absolute;
      left: 12%;
      right: 12%;
      top: 71px;
      height: 2px;
      background-image: repeating-linear-gradient(90deg, rgba(var(--blue-rgb), .45) 0 8px, transparent 8px 16px);
      animation: caDash 1.2s linear infinite;
    }

    .cat-node {
      position: absolute;
      top: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .5rem;
      width: 108px;
      text-align: center;
      font-size: .8rem;
      font-weight: 850;
    }

    .cat-you { left: 3%; }

    .cat-net {
      left: 50%;
      transform: translateX(-50%);
    }

    .cat-rcv { right: 3%; }

    .cat-icon {
      position: relative;
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: var(--crypto-blue);
      color: #fff;
    }

    html[data-theme="dark"] .cat-icon {
      color: #10222c;
    }

    .cat-icon svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    .cat-icon-net {
      width: 60px;
      height: 60px;
      border: 2px solid rgba(var(--blue-rgb), .5);
      border-radius: 50%;
      background: var(--crypto-panel);
      color: var(--crypto-blue);
      animation: catNetPulse var(--ca-dur) ease infinite;
    }

    html[data-theme="dark"] .cat-icon-net {
      color: var(--crypto-blue);
    }

    .cat-icon-rcv {
      border: 2px solid var(--crypto-line);
      background: var(--crypto-panel);
      color: var(--crypto-muted);
    }

    html[data-theme="dark"] .cat-icon-rcv {
      color: var(--crypto-muted);
    }

    .cat-check {
      position: absolute;
      right: -8px;
      top: -8px;
      display: grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--ca-green);
      color: var(--ca-green-ink);
      animation: catCheck var(--ca-dur) ease infinite;
    }

    .cat-check svg {
      width: .7rem;
      height: .7rem;
      stroke-width: 3;
    }

    .cat-pill {
      position: absolute;
      left: 8%;
      top: 58px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .32rem .65rem;
      border: 1.5px solid rgba(var(--crypto-orange-rgb), .55);
      border-radius: 999px;
      background: var(--crypto-panel);
      color: var(--crypto-orange);
      font-size: .75rem;
      font-weight: 850;
      box-shadow: 0 6px 14px rgba(0, 0, 0, .12);
      animation: catPill var(--ca-dur) ease-in-out infinite;
    }

    .cat-pill svg {
      width: .8rem;
      height: .8rem;
    }

    .cat-blocks {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 52px;
      display: flex;
      justify-content: center;
      gap: .5rem;
    }

    .cat-blocks span {
      display: grid;
      place-items: center;
      width: 52px;
      height: 38px;
      border: 1.5px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
      color: var(--crypto-muted);
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      font-size: .72rem;
    }

    .cat-blocks .cat-block-new {
      border-color: rgba(var(--ca-green-rgb), .6);
      background: rgba(var(--ca-green-rgb), .16);
      color: var(--ca-green);
      font-weight: 800;
      animation: catBlock var(--ca-dur) ease infinite;
    }

    .cat-forever {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 16px;
      color: var(--crypto-muted);
      font-size: .78rem;
      font-weight: 800;
      text-align: center;
      animation: catForever var(--ca-dur) ease infinite;
    }

    /* Szene 3: Gas */

    .cag-send {
      position: absolute;
      left: 6%;
      top: 14%;
      display: flex;
      flex-direction: column;
      gap: .15rem;
      color: var(--crypto-muted);
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      animation: cagSend var(--ca-dur) ease infinite;
    }

    .cag-send strong {
      color: var(--crypto-ink);
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      font-size: 1.05rem;
      letter-spacing: 0;
      text-transform: none;
    }

    .cag-main {
      position: absolute;
      left: 9%;
      top: 42%;
      animation: cagMain var(--ca-dur) ease-in-out infinite;
    }

    .cag-fee {
      position: absolute;
      left: 13%;
      top: 56%;
      width: 2rem;
      height: 2rem;
      font-size: .8rem;
      animation: cagFee var(--ca-dur) ease-in-out infinite;
    }

    .cag-card {
      position: absolute;
      right: 6%;
      width: min(44%, 195px);
      padding: .6rem .8rem;
      border: 1.5px solid var(--crypto-line);
      border-radius: 10px;
      background: var(--crypto-panel);
      animation: cagCards var(--ca-dur) ease infinite;
    }

    .cag-card span {
      display: block;
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .cag-rcv {
      top: 8%;
      border-color: rgba(var(--ca-green-rgb), .55);
    }

    .cag-rcv span {
      color: var(--ca-green);
    }

    .cag-net {
      top: 50%;
      border-color: rgba(var(--crypto-orange-rgb), .55);
    }

    .cag-net span {
      color: var(--crypto-orange);
    }

    .cag-amt {
      display: block;
      margin-top: .15rem;
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      font-size: .95rem;
      animation: cagAmt var(--ca-dur) ease infinite;
    }

    .cag-gauge {
      display: block;
      margin-top: .45rem;
      height: 6px;
      border-radius: 999px;
      background: rgba(var(--crypto-orange-rgb), .18);
      overflow: hidden;
    }

    .cag-gauge i {
      display: block;
      width: 64%;
      height: 100%;
      border-radius: 999px;
      background: var(--crypto-orange);
      transform-origin: left center;
      animation: cagGauge var(--ca-dur) ease infinite;
    }

    .cag-merk {
      left: 6%;
      bottom: 7%;
      max-width: 48%;
      animation: cagMerk var(--ca-dur) ease infinite;
    }

    /* Szene 4: Bridge */

    .cab-line {
      position: absolute;
      left: 33%;
      right: 33%;
      top: 100px;
      height: 2px;
      background-image: repeating-linear-gradient(90deg, rgba(var(--blue-rgb), .45) 0 8px, transparent 8px 16px);
      animation: caDash 1.2s linear infinite;
    }

    .cab-tag {
      position: absolute;
      left: 50%;
      top: 62px;
      transform: translateX(-50%);
      padding: .22rem .7rem;
      border: 1px solid var(--crypto-line);
      border-radius: 999px;
      background: var(--crypto-panel);
      color: var(--crypto-muted);
      font-size: .66rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .cab-dot {
      position: absolute;
      left: 34%;
      top: 94px;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: var(--crypto-orange);
      animation: cabDot var(--ca-dur) ease-in-out infinite;
    }

    .cab-chain {
      position: absolute;
      top: 9%;
      width: min(31%, 152px);
      padding: .7rem .6rem .8rem;
      border: 1.5px solid var(--crypto-line);
      border-radius: 12px;
      background: var(--crypto-panel);
      text-align: center;
    }

    .cab-a {
      left: 5%;
      animation: cabInA var(--ca-dur) ease infinite;
    }

    .cab-b {
      right: 5%;
      border-color: rgba(var(--ca-green-rgb), .55);
      animation: cabInB var(--ca-dur) ease infinite;
    }

    .cab-chain span {
      display: block;
      color: var(--crypto-muted);
      font-size: .64rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .cab-b span {
      color: var(--ca-green);
    }

    .cab-chain strong {
      display: block;
      margin-top: .1rem;
      font-size: 1.12rem;
      line-height: 1.15;
    }

    .cab-token {
      position: relative;
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      margin: .6rem auto 0;
      border: 2px solid var(--ca-coin-edge);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #f5dfa0, #d4a829);
      color: var(--ca-coin-ink);
      font-weight: 800;
    }

    .cab-lock {
      position: absolute;
      right: -8px;
      bottom: -8px;
      display: grid;
      place-items: center;
      width: 21px;
      height: 21px;
      border-radius: 50%;
      background: var(--crypto-blue);
      color: #fff;
      animation: cabLock var(--ca-dur) ease infinite;
    }

    html[data-theme="dark"] .cab-lock {
      color: #10222c;
    }

    .cab-lock svg {
      width: .65rem;
      height: .65rem;
      stroke-width: 2.5;
    }

    .cab-slot {
      position: relative;
      width: 2.6rem;
      height: 2.6rem;
      margin: .6rem auto 0;
    }

    .cab-slot::before {
      content: "";
      position: absolute;
      inset: 0;
      border: 2px dashed var(--crypto-line);
      border-radius: 50%;
    }

    .cab-slot .cab-minted {
      position: absolute;
      inset: 0;
      margin: 0;
      animation: cabMint var(--ca-dur) ease infinite;
    }

    .cab-chain em {
      display: block;
      margin-top: .5rem;
      color: var(--crypto-muted);
      font-size: .68rem;
      font-style: normal;
      font-weight: 850;
    }

    .cab-lock-label {
      animation: cabLockLabel var(--ca-dur) ease infinite;
    }

    .cab-chain .cab-mint-label {
      color: var(--ca-green);
      animation: cabMintLabel var(--ca-dur) ease infinite;
    }

    .cab-merk {
      left: 50%;
      bottom: 8%;
      width: max-content;
      max-width: 88%;
      text-align: center;
      transform: translateX(-50%);
      animation: cabMerk var(--ca-dur) ease infinite;
    }

    .crypto-visual-steps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .6rem;
      margin: 0 0 .9rem;
      padding: 0;
      list-style: none;
    }

    .crypto-visual-steps li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: .5rem;
      align-items: start;
      min-height: 72px;
      padding: .65rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .06);
    }

    .crypto-visual-steps strong {
      display: grid;
      place-items: center;
      width: 1.55rem;
      height: 1.55rem;
      border-radius: 6px;
      background: var(--crypto-blue);
      color: #fff;
      font-size: .78rem;
      line-height: 1;
    }

    .crypto-visual-steps span {
      color: var(--crypto-muted);
      font-size: .82rem;
      line-height: 1.35;
    }

    .crypto-visual-note {
      margin: 0;
      color: var(--crypto-muted);
      font-size: .94rem;
      line-height: 1.5;
    }

    .crypto-facts {
      padding: 1.2rem 0;
      border-bottom: 1px solid var(--crypto-line);
      background: rgba(var(--blue-rgb), .055);
    }

    .crypto-fact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .85rem;
    }

    .crypto-fact {
      min-height: 96px;
      padding: 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-fact strong,
    .crypto-info-card h3,
    .crypto-check-card h3,
    .crypto-note h3 {
      display: block;
      margin: 0 0 .35rem;
      font-size: 1.08rem;
      line-height: 1.25;
    }

    .crypto-fact span,
    .crypto-info-card p,
    .crypto-check-card p,
    .crypto-note p,
    .crypto-routine span,
    .crypto-red-flags span {
      color: var(--crypto-muted);
      line-height: 1.58;
    }

    .crypto-section-head {
      max-width: 820px;
      margin-bottom: 2rem;
    }

    .crypto-section-head h2 {
      max-width: 15ch;
    }

    .crypto-basics-grid,
    .crypto-check-grid,
    .crypto-note-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .9rem;
    }

    .crypto-info-card,
    .crypto-check-card,
    .crypto-note {
      min-height: 100%;
      padding: 1.05rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
      transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;
    }

    .crypto-info-card:hover,
    .crypto-check-card:hover,
    .crypto-note:hover {
      transform: translateY(-3px);
      border-color: rgba(var(--blue-rgb), .38);
      background: rgba(var(--blue-rgb), .07);
    }

    .crypto-info-card span,
    .crypto-check-card span {
      display: inline-flex;
      margin-bottom: .8rem;
      color: var(--crypto-blue);
      font-size: .75rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .crypto-band {
      border-block: 1px solid var(--crypto-line);
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .08), transparent 46%),
        rgba(var(--gold-rgb), .055);
    }

    .crypto-prose p {
      margin: 0;
    }

    .crypto-prose p + p {
      margin-top: 1rem;
    }

    .crypto-check-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .crypto-check-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
    }

    .crypto-check-card span {
      grid-row: span 2;
      width: 2.4rem;
      height: 2.4rem;
      align-items: center;
      justify-content: center;
      margin: 0;
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .10);
      font-variant-numeric: tabular-nums;
    }

    .crypto-bridge-layout {
      align-items: start;
    }

    .crypto-note-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 1.4rem;
    }

    .crypto-chain-table {
      display: grid;
      overflow: hidden;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-chain-head,
    .crypto-chain-row {
      display: grid;
      grid-template-columns: minmax(160px, 1fr) minmax(92px, .42fr) minmax(140px, .72fr) minmax(260px, 1.42fr);
      gap: .9rem;
      align-items: center;
      padding: .85rem 1rem;
    }

    .crypto-chain-head {
      background: rgba(var(--blue-rgb), .10);
      color: var(--crypto-blue);
      font-size: .74rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .crypto-chain-row {
      min-height: 68px;
      border-top: 1px solid var(--crypto-line);
      color: var(--crypto-muted);
      text-decoration: none;
      transition: background 200ms ease, color 200ms ease;
    }

    .crypto-chain-row:hover {
      background: rgba(var(--blue-rgb), .07);
      color: var(--crypto-ink);
    }

    .crypto-chain-row:focus-visible {
      outline: 3px solid var(--crypto-blue);
      outline-offset: -3px;
    }

    .crypto-chain-row strong {
      color: var(--crypto-ink);
      font-size: 1rem;
    }

    .crypto-chain-coin {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      min-width: 4.4rem;
      min-height: 2rem;
      padding: .28rem .58rem;
      border: 1px solid rgba(var(--crypto-orange-rgb), .28);
      border-radius: 8px;
      background: rgba(var(--crypto-orange-rgb), .10);
      color: var(--crypto-orange);
      font-weight: 900;
      letter-spacing: .04em;
    }

    .crypto-table-note {
      margin: .85rem 0 0;
      color: var(--crypto-muted);
      font-size: .92rem;
      line-height: 1.55;
    }

    .crypto-formula {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      align-items: center;
      margin-top: 1.25rem;
      padding: 1rem;
      border: 1px solid rgba(var(--crypto-orange-rgb), .30);
      border-radius: 8px;
      background: rgba(var(--crypto-orange-rgb), .08);
    }

    .crypto-formula span,
    .crypto-formula strong {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: .45rem .7rem;
      border-radius: 8px;
      background: var(--crypto-panel);
      font-weight: 850;
    }

    .crypto-formula strong {
      color: var(--crypto-orange);
    }

    .crypto-routine {
      display: grid;
      gap: .75rem;
      counter-reset: routine;
    }

    .crypto-routine div {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: .8rem;
      align-items: center;
      min-height: 76px;
      padding: .9rem 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-routine strong {
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 8px;
      background: var(--crypto-blue);
      color: #fff;
      font-variant-numeric: tabular-nums;
    }

    .crypto-warning-section {
      border-block: 1px solid rgba(var(--crypto-orange-rgb), .24);
      background: rgba(var(--crypto-orange-rgb), .07);
    }

    .crypto-red-flags {
      display: grid;
      gap: .7rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .crypto-red-flags li {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: .7rem;
      align-items: start;
      padding: .9rem;
      border: 1px solid rgba(var(--crypto-orange-rgb), .26);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-red-flags svg {
      width: 1.18rem;
      height: 1.18rem;
      margin-top: .18rem;
      color: var(--crypto-orange);
    }

    .crypto-glossary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .85rem;
    }

    .crypto-glossary-card {
      min-height: 100%;
      padding: 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-glossary-card h3 {
      margin: 0 0 .45rem;
      color: var(--crypto-ink);
      font-size: 1rem;
      line-height: 1.25;
    }

    .crypto-glossary-card p {
      margin: 0;
      color: var(--crypto-muted);
      font-size: .92rem;
      line-height: 1.58;
    }

    .crypto-final {
      padding-top: 0;
    }

    .crypto-final-panel {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 1.4rem;
      align-items: center;
      padding: 1.4rem;
      border: 1px solid rgba(var(--blue-rgb), .24);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .08), rgba(var(--gold-rgb), .08)),
        var(--crypto-panel);
    }

    .crypto-final-panel img {
      width: 150px;
      aspect-ratio: 1;
      object-fit: contain;
      filter: drop-shadow(0 16px 30px rgba(0, 0, 0, .22));
    }

    .crypto-final-panel h2 {
      font-size: 2.4rem;
      max-width: none;
    }

    .crypto-source-list {

    .crypto-visual-title {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .8rem;
      align-items: center;
      padding-bottom: .9rem;
      border-bottom: 1px solid var(--crypto-line);
    }

    .crypto-visual-title span {
      color: var(--crypto-muted);
      font-size: .82rem;
      font-weight: 800;
    }

    .crypto-visual-title strong {
      color: var(--crypto-blue);
      font-size: .8rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .crypto-transfer-stage {
      position: relative;
      display: grid;
      grid-template-columns: minmax(170px, 1fr) minmax(200px, .86fr) minmax(170px, 1fr);
      gap: .9rem;
      align-items: stretch;
      min-height: 270px;
      margin: 1rem 0;
    }

    .crypto-chain-card,
    .crypto-bridge-device {
      position: relative;
      z-index: 2;
      min-height: 240px;
      padding: 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: rgba(255, 255, 255, .58);
    }

    html[data-theme="dark"] .crypto-chain-card,
    html[data-theme="dark"] .crypto-bridge-device {
      background: rgba(255, 255, 255, .045);
    }

    .crypto-chain-card {
      display: flex;
      flex-direction: column;
      gap: .55rem;
    }

    .crypto-chain-label {
      color: var(--crypto-blue);
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .crypto-chain-card strong {
      font-size: 1.55rem;
      line-height: 1.1;
    }

    .crypto-chain-card small {
      color: var(--crypto-muted);
      line-height: 1.45;
    }

    .crypto-wallet-mini {
      display: flex;
      align-items: center;
      gap: .55rem;
      margin-top: auto;
      min-height: 48px;
      padding: .65rem;
      border: 1px solid var(--crypto-line);

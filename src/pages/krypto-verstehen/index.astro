      background: var(--crypto-panel);
      color: var(--crypto-muted);
      font-size: .86rem;
      font-weight: 800;
    }

    .crypto-wallet-mini svg,
    .crypto-bridge-device svg,
    .crypto-red-flags svg,
    .crypto-source-list svg {
      width: 1.55rem;
      height: 1.55rem;

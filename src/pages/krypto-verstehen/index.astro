    .crypto-info-card span,
    .crypto-check-card span {
      display: inline-flex;
      margin-bottom: .8rem;
      color: var(--crypto-blue);
      font-size: .75rem;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .crypto-band {
      border-block: 1px solid var(--crypto-line);
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .08), transparent 46%),
        rgba(var(--gold-rgb), .055);
    }

    .crypto-prose p {
      margin: 0;
    }

    .crypto-prose p + p {
      margin-top: 1rem;
    }

    .crypto-check-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .crypto-check-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
    }

    .crypto-check-card span {
      grid-row: span 2;
      width: 2.4rem;
      height: 2.4rem;
      align-items: center;
      justify-content: center;
      margin: 0;
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .10);
      font-variant-numeric: tabular-nums;
    }

    .crypto-bridge-layout {
      align-items: start;
    }

    .crypto-bridge-flow {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: .7rem;
      align-items: stretch;
    }

    .crypto-flow-step {
      min-height: 150px;
      padding: 1rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
    }

    .crypto-flow-step strong {
      display: block;
      margin-bottom: .45rem;
    }

    .crypto-flow-step span {
      color: var(--crypto-muted);
      line-height: 1.55;
    }

    .crypto-flow-arrow {
      position: relative;
      width: 42px;
      align-self: center;
      height: 3px;
      border-radius: 999px;
      background: var(--crypto-orange);
      overflow: visible;
    }

    .crypto-flow-arrow::after {
      content: "";
      position: absolute;
      right: -1px;
      top: 50%;
      width: .65rem;
      height: .65rem;
      border-top: 3px solid var(--crypto-orange);
      border-right: 3px solid var(--crypto-orange);
      transform: translateY(-50%) rotate(45deg);
    }

    .crypto-flow-arrow::before {
      content: "";
      position: absolute;
      inset: -4px auto -4px 0;
      width: 18px;

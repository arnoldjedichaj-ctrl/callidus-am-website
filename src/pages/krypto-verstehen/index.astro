      line-height: 1.58;
    }

    .crypto-section-head {
      max-width: 820px;
      margin-bottom: 2rem;
    }

    .crypto-section-head h2 {
      max-width: 15ch;
    }

    .crypto-basics-grid,
    .crypto-check-grid,
    .crypto-note-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .9rem;
    }

    .crypto-info-card,
    .crypto-check-card,
    .crypto-note {
      min-height: 100%;
      padding: 1.05rem;
      border: 1px solid var(--crypto-line);
      border-radius: 8px;
      background: var(--crypto-panel);
      transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;

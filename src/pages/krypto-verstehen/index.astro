      box-shadow: 0 16px 38px rgba(var(--crypto-orange-rgb), .12);
    }

    .crypto-bridge-device strong {
      font-size: 1.15rem;
    }

    .crypto-bridge-device span {
      color: var(--crypto-muted);
      font-size: .86rem;
      line-height: 1.35;
    }

    .crypto-visual-steps {

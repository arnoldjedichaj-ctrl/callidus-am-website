---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Valus (VAL) — Dein Gesundheitswert | callidus A&M"
  description="Valus (VAL) ist das Guthaben-System von callidus A&M. Sammle VAL durch Aktivität, kaufe es vergünstigt und löse es für Kurse und Premium-Inhalte ein."
  lang="de"
>
  <!-- HERO -->
  <section class="section san-hero">
    <div class="san-hero-bg" aria-hidden="true">
      <div class="san-orb san-orb-1"></div>
      <div class="san-orb san-orb-2"></div>
      <div class="san-orb san-orb-3"></div>
    </div>
    <div class="container" style="position:relative;z-index:1">
      <div class="san-hero-inner">
        <div class="san-coin-hero" data-reveal aria-hidden="true">
          <div class="san-coin-scene">
            <div class="san-coin-3d">
              <div class="san-coin-face san-coin-front">
                <img src="/assets/sanitas-logo.svg" alt="" width="260" height="260" />
              </div>
              <div class="san-coin-face san-coin-back">
                <img src="/assets/valus-coin-back.svg" alt="" width="260" height="260" />
              </div>
            </div>
          </div>
        </div>
        <div class="san-hero-text" data-reveal="2">
          <div class="san-eyebrow">
            <span class="san-badge-pill">VAL</span>
            <span>Valus · Guthaben-System</span>
          </div>
          <h1 class="san-headline">Gesundheit,<br/>die sich<br/><em>auszahlt.</em></h1>
          <p class="san-claim">
            Valus (VAL) ist das Wert-System von callidus A&M.<br/>
            <strong>1 VAL = 1,00 € Rabatt</strong> auf Kurse, Premium und mehr.
          </p>
          <div class="san-cta-group">
            <a href="/wallet/" class="button san-primary-btn">Jetzt Wallet erstellen</a>
            <a href="#wie-es-funktioniert" class="button san-secondary-btn">Wie funktioniert VAL?</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <div class="san-stats-bar">
    <div class="container">
      <div class="san-stats">
        <div class="san-stat">
          <span class="san-stat-value">1 VAL</span>
          <span class="san-stat-label">= 1,00 € Rabatt</span>
        </div>
        <div class="san-stat-divider" aria-hidden="true"></div>
        <div class="san-stat">
          <span class="san-stat-value">0,75 €</span>
          <span class="san-stat-label">Einstiegspreis pro VAL</span>
        </div>
        <div class="san-stat-divider" aria-hidden="true"></div>
        <div class="san-stat">
          <span class="san-stat-value">100 XP</span>
          <span class="san-stat-label">= 1 VAL via App-Aktivität</span>
        </div>
        <div class="san-stat-divider" aria-hidden="true"></div>
        <div class="san-stat">
          <span class="san-stat-value">Kein Token</span>
          <span class="san-stat-label">Sicher, intern, DSGVO-konform</span>
        </div>
      </div>
    </div>
  </div>

  <!-- WIE ES FUNKTIONIERT -->
  <section class="section" id="wie-es-funktioniert">
    <div class="container">
      <p class="eyebrow" data-reveal>So funktioniert VAL</p>
      <h2 data-reveal="2">Drei Wege zu Valus-Guthaben.</h2>
      <div class="san-ways" data-reveal="3">

        <div class="san-way-card">
          <div class="san-way-icon" style="background:rgba(var(--san-gold-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <path d="M16 12a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/>
            </svg>
          </div>
          <div class="san-way-num">01</div>
          <h3>Kaufen</h3>
          <p>Erwerbe VAL-Pakete direkt über Digistore24. Der Kaufpreis liegt <strong>unter dem Einlösewert</strong> — du kaufst also mit sofortigem Gewinn.</p>
          <div class="san-way-table">
            <div class="san-way-row"><span>10 VAL</span><span class="san-price-buy">7,50 €</span><span class="san-price-value">→ 10 € Wert</span></div>
            <div class="san-way-row"><span>25 VAL</span><span class="san-price-buy">18,75 €</span><span class="san-price-value">→ 25 € Wert</span></div>
            <div class="san-way-row"><span>50 VAL</span><span class="san-price-buy">37,50 €</span><span class="san-price-value">→ 50 € Wert</span></div>
          </div>
          <a href="/wallet/" class="san-way-cta">VAL kaufen</a>
        </div>

        <div class="san-way-card san-way-featured">
          <div class="san-way-icon" style="background:rgba(var(--mint-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8Z"/>
            </svg>
          </div>
          <span class="san-featured-badge">Kostenlos</span>
          <div class="san-way-num">02</div>
          <h3>Verdienen</h3>
          <p>Sammle XP durch die Nutzung der callidus Apps. Täglich einloggen, Mahlzeiten tracken, Bewegung erfassen — alles bringt XP.</p>
          <div class="san-way-table">
            <div class="san-way-row"><span>100 XP</span><span class="san-price-value">→ 1 VAL</span></div>
            <div class="san-way-row"><span>Max. pro Monat</span><span class="san-price-value">→ 10 VAL</span></div>
            <div class="san-way-row"><span>NEXUS App</span><span class="san-price-value">XP-Quelle</span></div>
          </div>
          <a href="/nexus-app/" class="san-way-cta">NEXUS App holen</a>
        </div>

        <div class="san-way-card">
          <div class="san-way-icon" style="background:rgba(var(--blue-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z"/>
            </svg>
          </div>
          <div class="san-way-num">03</div>
          <h3>Bonus erhalten</h3>
          <p>Bundle-Käufe, Empfehlungen und besondere Aktionen bringen VAL als Bonus. Wer ein Bundle kauft, erhält einen VAL-Startersatz.</p>
          <div class="san-way-table">
            <div class="san-way-row"><span>Bundle-Kauf</span><span class="san-price-value">→ VAL Bonus</span></div>
            <div class="san-way-row"><span>Empfehlung</span><span class="san-price-value">→ Kommt bald</span></div>
            <div class="san-way-row"><span>Aktionen</span><span class="san-price-value">→ Monatlich</span></div>
          </div>
          <a href="/wallet/" class="san-way-cta">Wallet öffnen</a>
        </div>

      </div>
    </div>
  </section>

  <!-- EINLÖSEN -->
  <section class="section san-redeem-section">
    <div class="container split" style="align-items:center;gap:4rem">
      <div data-reveal>
        <p class="eyebrow">Einlösen</p>
        <h2>Was kann ich mit VAL kaufen?</h2>
        <p style="margin-bottom:1.5rem">VAL funktioniert als direkter Rabatt — du zahlst den Differenzbetrag normal, der VAL-Wert wird abgezogen.</p>
        <div class="san-redeem-list">
          <div class="san-redeem-item">
            <span class="san-redeem-icon mint">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 2v16M6 6l4-4 4 4M6 14l4 4 4-4"/></svg>
            </span>
            <div>
              <strong>7-Tage Stress-Reset-Kurs</strong>
              <p>Bis zu 50% des Preises mit VAL bezahlen</p>
            </div>
          </div>
          <div class="san-redeem-item">
            <span class="san-redeem-icon gold">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="8"/><path d="M10 6v8M7 9l3-3 3 3"/></svg>
            </span>
            <div>
              <strong>Premium-Abonnements</strong>
              <p>NEXUS, MOMUS, KAIROS — kommt bald</p>
            </div>
          </div>
          <div class="san-redeem-item">
            <span class="san-redeem-icon blue">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="14" height="10" rx="2"/><path d="M7 9h6M7 12h4"/></svg>
            </span>
            <div>
              <strong>Weitere Kurse & Bundles</strong>
              <p>Roadmap wird laufend erweitert</p>
            </div>
          </div>
        </div>
        <p class="san-rule-note">
          ℹ️ Max. 50% eines Produktpreises mit VAL · Kein VAL-zu-VAL-Kauf · Kein Auszahlen in Euro
        </p>
      </div>
      <div class="san-visual-coin" data-reveal="2" aria-hidden="true">
        <div class="san-big-coin">
          <img src="/assets/sanitas-logo.svg" alt="" width="220" height="220" />
        </div>
        <div class="san-coin-label">
          <span class="san-eyebrow-small">Valus</span>
          <span class="san-ticker">VAL</span>
          <span class="san-sub">Callidus Guthaben</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SICHERHEIT / RECHTLICHES -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow" data-reveal>Vertrauen & Sicherheit</p>
      <h2 data-reveal="2">VAL ist kein Krypto-Token.</h2>
      <div class="grid" data-reveal="3" style="margin-top:1.5rem">
        <div class="card">
          <div class="card-body">
            <span class="badge mint">Kein Investment</span>
            <h3>Internes Guthaben</h3>
            <p>VAL ist ein nicht-übertragbares Rabatt-Guthaben — kein handelbarer Token, keine Spekulation, kein Finanzprodukt.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <span class="badge gold">DSGVO</span>
            <h3>Serverbasiert & sicher</h3>
            <p>Alle Salden werden in Firebase gespeichert — keine Gesundheitsdaten auf der Blockchain, volle Kontrolle auf unserer Seite.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <span class="badge" style="background:var(--blue);color:#fff">Rechtlich geprüft</span>
            <h3>Gutschein-Charakter</h3>
            <p>VAL funktioniert rechtlich wie ein Prepaid-Gutschein. AGB und Gutscheinbedingungen gelten. Kein BaFin-Produkt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container" style="text-align:center;max-width:560px">
      <div class="san-coin-small" aria-hidden="true">
        <img src="/assets/sanitas-logo.svg" alt="" width="96" height="96" />
      </div>
      <h2 data-reveal style="margin-top:1rem">Bereit?</h2>
      <p data-reveal="2">Erstellen Sie Ihr kostenloses Callidus-Konto und erhalten Sie Ihr erstes VAL-Guthaben.</p>
      <a href="/wallet/" class="button san-primary-btn" data-reveal="3" style="margin-top:1.25rem;display:inline-flex">
        Wallet erstellen — kostenlos
      </a>
    </div>
  </section>

  <style>
    :root {
      --san-gold: #C9A84C;
      --san-gold-light: #E8C96A;
      --san-gold-dark: #A07830;
      --san-gold-rgb: 201, 168, 76;
    }
    html[data-theme="dark"] {
      --san-gold: #E8C96A;
      --san-gold-light: #F5DC8C;
      --san-gold-dark: #C9A84C;
    }

    .san-hero { position: relative; overflow: hidden; padding-block: clamp(4rem, 10vw, 8rem); }
    .san-hero-bg { position: absolute; inset: 0; pointer-events: none; }
    .san-orb { position: absolute; border-radius: 50%; filter: blur(80px); }
    .san-orb-1 { width: 480px; height: 480px; background: rgba(201,168,76,.18); top: -120px; right: -80px; }
    .san-orb-2 { width: 320px; height: 320px; background: rgba(63,127,90,.10); bottom: -60px; left: 10%; }
    .san-orb-3 { width: 200px; height: 200px; background: rgba(201,168,76,.08); top: 40%; left: -40px; }

    .san-hero-inner { display: flex; align-items: center; gap: clamp(2rem, 6vw, 5rem); flex-wrap: wrap; justify-content: center; }
    .san-hero-text { flex: 1; min-width: 280px; max-width: 520px; }
    .san-eyebrow { display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem; font-size: .875rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
    .san-badge-pill { background: var(--san-gold); color: #1a1200; font-size: .7rem; font-weight: 800; padding: .2rem .6rem; border-radius: 999px; letter-spacing: .08em; }
    .san-headline { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05; font-weight: 800; margin: 0 0 1.25rem; letter-spacing: -.02em; }
    .san-headline em { font-style: normal; color: var(--san-gold); }
    .san-claim { font-size: 1.1rem; color: var(--muted); line-height: 1.65; margin-bottom: 2rem; }
    .san-claim strong { color: var(--text); }
    .san-cta-group { display: flex; gap: .75rem; flex-wrap: wrap; }
    .san-primary-btn { background: var(--san-gold); color: #1a1200; border: none; font-weight: 700; }
    .san-primary-btn:hover { background: var(--san-gold-light); }
    .san-secondary-btn { border: 1px solid rgba(var(--san-gold-rgb),.4); color: var(--san-gold); }
    .san-secondary-btn:hover { background: rgba(var(--san-gold-rgb),.08); }

    /* 3D Coin Spin */
    .san-coin-hero { flex-shrink: 0; }
    .san-coin-scene { perspective: 900px; width: 260px; height: 260px; }
    .san-coin-3d {
      width: 100%; height: 100%; position: relative;
      transform-style: preserve-3d;
      animation: coinSpin 10s linear infinite;
      filter: drop-shadow(0 16px 40px rgba(160,110,0,.7));
    }
    .san-coin-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 50%; }
    .san-coin-back { transform: rotateY(180deg); }
    @keyframes coinSpin { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }

    /* Stats */
    .san-stats-bar { background: var(--san-gold); color: #1a1200; padding: 1.25rem 0; }
    html[data-theme="dark"] .san-stats-bar { background: rgba(201,168,76,.15); border-block: 1px solid rgba(201,168,76,.2); color: var(--text); }
    .san-stats { display: flex; align-items: center; justify-content: center; gap: 1.5rem; flex-wrap: wrap; padding: 0 clamp(1rem, 4vw, 3rem); }
    .san-stat { text-align: center; }
    .san-stat-value { display: block; font-size: 1.25rem; font-weight: 800; line-height: 1.2; }
    .san-stat-label { display: block; font-size: .75rem; opacity: .75; margin-top: .15rem; font-weight: 500; }
    .san-stat-divider { width: 1px; height: 2.5rem; background: rgba(26,18,0,.2); }
    html[data-theme="dark"] .san-stat-divider { background: rgba(201,168,76,.2); }

    /* Ways */
    .san-ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .san-way-card { background: var(--panel); border: 1px solid var(--line); border-radius: 1.25rem; padding: 1.75rem; display: flex; flex-direction: column; gap: .75rem; position: relative; transition: box-shadow .2s; }
    .san-way-card:hover { box-shadow: 0 12px 40px rgba(var(--san-gold-rgb),.15); border-color: rgba(var(--san-gold-rgb),.3); }
    .san-way-featured { border-color: rgba(var(--san-gold-rgb),.4); box-shadow: 0 8px 30px rgba(var(--san-gold-rgb),.1); }
    .san-featured-badge { position: absolute; top: 1rem; right: 1rem; background: var(--san-gold); color: #1a1200; font-size: .7rem; font-weight: 800; padding: .2rem .6rem; border-radius: 999px; }
    .san-way-icon { width: 3rem; height: 3rem; border-radius: .75rem; display: flex; align-items: center; justify-content: center; }
    .san-way-icon svg { width: 1.4rem; height: 1.4rem; color: var(--san-gold); }
    .san-way-num { font-size: .7rem; font-weight: 800; color: var(--muted); letter-spacing: .1em; }
    .san-way-card h3 { font-size: 1.2rem; margin: 0; }
    .san-way-card p { color: var(--muted); font-size: .9rem; margin: 0; line-height: 1.6; }
    .san-way-table { display: flex; flex-direction: column; gap: .35rem; margin-top: .25rem; border-top: 1px solid var(--line); padding-top: .75rem; }
    .san-way-row { display: flex; justify-content: space-between; font-size: .82rem; }
    .san-price-buy { color: var(--san-gold); font-weight: 600; }
    .san-price-value { color: var(--mint); font-weight: 600; font-size: .8rem; }
    .san-way-cta { margin-top: .5rem; display: inline-flex; align-items: center; gap: .4rem; font-size: .875rem; font-weight: 600; color: var(--san-gold); text-decoration: none; border-bottom: 1px solid rgba(var(--san-gold-rgb),.3); padding-bottom: .1rem; width: fit-content; }
    .san-way-cta:hover { border-bottom-color: var(--san-gold); }

    /* Redeem */
    .san-redeem-section { background: var(--bg-soft); }
    .san-redeem-list { display: flex; flex-direction: column; gap: 1rem; }
    .san-redeem-item { display: flex; align-items: flex-start; gap: 1rem; }
    .san-redeem-icon { flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: .625rem; display: flex; align-items: center; justify-content: center; }
    .san-redeem-icon svg { width: 1.1rem; height: 1.1rem; }
    .san-redeem-icon.mint { background: rgba(var(--mint-rgb),.12); color: var(--mint); }
    .san-redeem-icon.gold { background: rgba(var(--san-gold-rgb),.12); color: var(--san-gold); }
    .san-redeem-icon.blue { background: rgba(var(--blue-rgb),.12); color: var(--blue); }
    .san-redeem-item strong { display: block; margin-bottom: .2rem; }
    .san-redeem-item p { margin: 0; font-size: .875rem; color: var(--muted); }
    .san-rule-note { margin-top: 1.25rem; font-size: .8rem; color: var(--muted); background: rgba(var(--san-gold-rgb),.06); border: 1px solid rgba(var(--san-gold-rgb),.18); border-radius: .625rem; padding: .625rem 1rem; }

    /* Visual Coin */
    .san-visual-coin { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
    .san-big-coin { width: 220px; height: 220px; display: flex; align-items: center; justify-content: center; filter: drop-shadow(0 8px 28px rgba(180,130,20,.45)); animation: coinFloat 5s ease-in-out infinite; }
    @keyframes coinFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .san-coin-label { text-align: center; }
    .san-eyebrow-small { display: block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
    .san-ticker { display: block; font-size: 2rem; font-weight: 800; color: var(--san-gold); line-height: 1.1; }
    .san-sub { display: block; font-size: .8rem; color: var(--muted); margin-top: .25rem; }
    .san-coin-small { display: flex; justify-content: center; }
  </style>
</BaseLayout>

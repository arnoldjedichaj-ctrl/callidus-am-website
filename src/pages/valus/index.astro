---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Valus (VAL) — Dein Gesundheitswert | callidus A&M"
  description="Valus (VAL) ist das Guthaben-System von callidus A&M. Sammle VAL durch Aktivität, kaufe es vergünstigt und löse es für Kurse und Premium-Inhalte ein."
  lang="de"
>

  <!-- ═══════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════ -->
  <section class="section val-hero">
    <!-- ambient orbs -->
    <div class="val-bg" aria-hidden="true">
      <div class="val-orb val-orb-1"></div>
      <div class="val-orb val-orb-2"></div>
      <div class="val-orb val-orb-3"></div>
      <div class="val-orb val-orb-4"></div>
    </div>

    <div class="container" style="position:relative;z-index:1">
      <div class="val-hero-inner">

        <!-- COIN -->
        <div class="val-coin-wrap" aria-hidden="true">
          <div class="val-scene">
            <img class="val-coin-image" src="/assets/valus-coin.png" alt="" width="500" height="500" loading="eager" decoding="async" />
          </div>
        </div>

        <!-- TEXT -->
        <div class="val-hero-text" data-reveal>
          <div class="val-eyebrow">
            <span class="val-pill">VAL</span>
            <span>Valus · Guthaben-System</span>
          </div>
          <h1 class="val-h1">Gesundheit,<br/>die sich<br/><em>auszahlt.</em></h1>
          <p class="val-claim">
            Valus (VAL) ist das Wert-System von callidus A&M.<br/>
            <strong>1 VAL = 1,00 € Rabatt</strong> auf Kurse, Premium und mehr.
          </p>
          <div class="val-cta-row">
            <a href="https://metamask.io/download/" target="_blank" rel="noopener noreferrer" class="button val-btn-gold">Wallet erstellen</a>
            <a href="#wie-es-funktioniert" class="button val-btn-ghost">Wie funktioniert VAL?</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STATS BAR
       ═══════════════════════════════════════════════════════════ -->
  <div class="val-stats-bar">
    <div class="container">
      <div class="val-stats">
        <div class="val-stat">
          <span class="val-stat-v">1 VAL</span>
          <span class="val-stat-l">= 1,00 € Rabatt</span>
        </div>
        <div class="val-stat-sep" aria-hidden="true"></div>
        <div class="val-stat">
          <span class="val-stat-v">0,75 €</span>
          <span class="val-stat-l">Einstiegspreis pro VAL</span>
        </div>
        <div class="val-stat-sep" aria-hidden="true"></div>
        <div class="val-stat">
          <span class="val-stat-v">1000 XP</span>
          <span class="val-stat-l">= 1 VAL via NEXUS-Aktivität</span>
        </div>
        <div class="val-stat-sep" aria-hidden="true"></div>
        <div class="val-stat">
          <span class="val-stat-v">Kein Token</span>
          <span class="val-stat-l">Sicher · Intern · DSGVO</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       WIE ES FUNKTIONIERT
       ═══════════════════════════════════════════════════════════ -->
  <section class="section" id="wie-es-funktioniert">
    <div class="container">
      <p class="eyebrow" data-reveal>So funktioniert VAL</p>
      <h2 data-reveal="2">Drei Wege zu Valus-Guthaben.</h2>
      <div class="val-ways" data-reveal="3">

        <div class="val-card">
          <div class="val-card-icon" style="background:rgba(var(--valus-gold-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <rect x="2" y="5" width="20" height="14" rx="2"/>
              <path d="M16 12a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/>
            </svg>
          </div>
          <div class="val-card-num">01</div>
          <h3>Kaufen</h3>
          <p>Erwerbe VAL-Pakete direkt über Digistore24. Der Kaufpreis liegt <strong>unter dem Einlösewert</strong> — du kaufst mit sofortigem Gewinn.</p>
          <div class="val-table">
            <div class="val-row"><span>10 VAL</span><span class="val-price-buy">7,50 €</span><span class="val-price-val">→ 10 € Wert</span></div>
            <div class="val-row"><span>25 VAL</span><span class="val-price-buy">18,75 €</span><span class="val-price-val">→ 25 € Wert</span></div>
            <div class="val-row"><span>50 VAL</span><span class="val-price-buy">37,50 €</span><span class="val-price-val">→ 50 € Wert</span></div>
          </div>
          <a href="/wallet/" class="val-card-link">VAL kaufen →</a>
        </div>

        <div class="val-card val-card-featured">
          <span class="val-featured-badge">Kostenlos</span>
          <div class="val-card-icon" style="background:rgba(var(--mint-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8Z"/>
            </svg>
          </div>
          <div class="val-card-num">02</div>
          <h3>Verdienen</h3>
          <p>Sammle XP durch die Nutzung der NEXUS App. Täglich einloggen, Mahlzeiten tracken, Bewegung erfassen — alles bringt XP. MOMUS folgt nach der Freischaltung.</p>
          <div class="val-table">
            <div class="val-row"><span>1000 XP</span><span class="val-price-val">→ 1 VAL</span></div>
            <div class="val-row"><span>Max. pro Monat</span><span class="val-price-val">→ 10 VAL</span></div>
            <div class="val-row"><span>NEXUS App</span><span class="val-price-val">XP-Quelle</span></div>
          </div>
          <a href="/nexus-app/" class="val-card-link">NEXUS App holen →</a>
        </div>

        <div class="val-card">
          <div class="val-card-icon" style="background:rgba(var(--blue-rgb),.12)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z"/>
            </svg>
          </div>
          <div class="val-card-num">03</div>
          <h3>Bonus erhalten</h3>
          <p>Bundle-Käufe, Empfehlungen und besondere Aktionen bringen VAL als Bonus. Wer ein Bundle kauft, erhält einen VAL-Startersatz.</p>
          <div class="val-table">
            <div class="val-row"><span>Bundle-Kauf</span><span class="val-price-val">→ VAL Bonus</span></div>
            <div class="val-row"><span>Empfehlung</span><span class="val-price-val">→ Kommt bald</span></div>
            <div class="val-row"><span>Aktionen</span><span class="val-price-val">→ Monatlich</span></div>
          </div>
          <a href="/wallet/" class="val-card-link">Wallet öffnen →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       EINLÖSEN
       ═══════════════════════════════════════════════════════════ -->
  <section class="section val-redeem-section">
    <div class="container val-split">
      <div data-reveal>
        <p class="eyebrow">Einlösen</p>
        <h2>Was kann ich mit VAL kaufen?</h2>
        <p style="margin-bottom:1.5rem;color:var(--muted)">VAL funktioniert als direkter Rabatt — du zahlst den Differenzbetrag normal, der VAL-Wert wird abgezogen.</p>
        <div class="val-redeem-list">
          <div class="val-redeem-item">
            <span class="val-redeem-icon mint">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 2v16M6 6l4-4 4 4M6 14l4 4 4-4"/></svg>
            </span>
            <div>
              <strong>7-Tage Stress-Reset-Kurs</strong>
              <p>Bis zu 50% des Preises mit VAL bezahlen</p>
            </div>
          </div>
          <div class="val-redeem-item">
            <span class="val-redeem-icon gold">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="8"/><path d="M10 6v8M7 9l3-3 3 3"/></svg>
            </span>
            <div>
              <strong>Premium-Abonnements</strong>
              <p>NEXUS, MOMUS, KAIROS — kommt bald</p>
            </div>
          </div>
          <div class="val-redeem-item">
            <span class="val-redeem-icon blue">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="14" height="10" rx="2"/><path d="M7 9h6M7 12h4"/></svg>
            </span>
            <div>
              <strong>Weitere Kurse &amp; Bundles</strong>
              <p>Roadmap wird laufend erweitert</p>
            </div>
          </div>
        </div>
        <p class="val-rule-note">ℹ️ Max. 50% eines Produktpreises mit VAL · Kein VAL-zu-VAL-Kauf · Kein Auszahlen in Euro</p>
      </div>

      <!-- Value cards instead of static coin -->
      <div class="val-redeem-visual" data-reveal="2">
        <div class="val-value-showcase">
          <div class="val-value-card">
            <div class="val-vc-top">
              <span class="val-vc-amount">10 VAL</span>
              <span class="val-vc-badge">= 10 € Wert</span>
            </div>
            <div class="val-vc-bar">
              <div class="val-vc-fill" style="width:75%"></div>
            </div>
            <span class="val-vc-note">kaufen für 7,50 €</span>
          </div>
          <div class="val-value-card val-vc-mid">
            <div class="val-vc-top">
              <span class="val-vc-amount">25 VAL</span>
              <span class="val-vc-badge">= 25 € Wert</span>
            </div>
            <div class="val-vc-bar">
              <div class="val-vc-fill" style="width:75%"></div>
            </div>
            <span class="val-vc-note">kaufen für 18,75 €</span>
          </div>
          <div class="val-value-card">
            <div class="val-vc-top">
              <span class="val-vc-amount">50 VAL</span>
              <span class="val-vc-badge">= 50 € Wert</span>
            </div>
            <div class="val-vc-bar">
              <div class="val-vc-fill" style="width:75%"></div>
            </div>
            <span class="val-vc-note">kaufen für 37,50 €</span>
          </div>
          <div class="val-vc-saving">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><polyline points="1 4 4 7 8 2 12 7 15 4"/></svg>
            Immer 25% günstiger als der Einlösewert
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SICHERHEIT
       ═══════════════════════════════════════════════════════════ -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow" data-reveal>Vertrauen &amp; Sicherheit</p>
      <h2 data-reveal="2">VAL ist kein Krypto-Token.</h2>
      <div class="grid" data-reveal="3" style="margin-top:1.5rem">
        <div class="card">
          <div class="card-body">
            <span class="badge mint">Kein Investment</span>
            <h3>Internes Guthaben</h3>
            <p>VAL ist ein nicht-übertragbares Rabatt-Guthaben — kein handelbarer Token, keine Spekulation, kein Finanzprodukt.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <span class="badge gold">DSGVO</span>
            <h3>Serverbasiert &amp; sicher</h3>
            <p>Alle Salden werden in Firebase gespeichert — keine Gesundheitsdaten auf der Blockchain, volle Kontrolle auf unserer Seite.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <span class="badge" style="background:var(--blue);color:#fff">Rechtlich geprüft</span>
            <h3>Gutschein-Charakter</h3>
            <p>VAL funktioniert rechtlich wie ein Prepaid-Gutschein. AGB und Gutscheinbedingungen gelten. Kein BaFin-Produkt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CTA
       ═══════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container" style="text-align:center;max-width:580px">
      <!-- mini coin -->
      <div class="val-cta-coin" aria-hidden="true">
        <div class="val-mini-scene">
          <img class="val-mini-image" src="/assets/valus-coin.png" alt="" width="500" height="500" loading="lazy" decoding="async" />
        </div>
      </div>
      <h2 data-reveal style="margin-top:1.25rem">Bereit?</h2>
      <p data-reveal="2" style="color:var(--muted)">Erstellen Sie Ihr kostenloses Callidus-Konto und erhalten Sie Ihr erstes VAL-Guthaben.</p>
      <a href="/wallet/" class="button val-btn-gold" data-reveal="3" style="margin-top:1.25rem;display:inline-flex">
        Wallet erstellen — kostenlos
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLES
       ═══════════════════════════════════════════════════════════ -->
  <style>
    :root {
      --valus-gold: #C9A84C;
      --valus-gold-light: #E8C96A;
      --valus-gold-dark: #A07830;
      --valus-gold-rgb: 201, 168, 76;
    }
    html[data-theme="dark"] {
      --valus-gold: #E8C96A;
      --valus-gold-light: #F5DC8C;
      --valus-gold-dark: #C9A84C;
    }

    /* ── Hero ───────────────────────────────────────────────── */
    .val-hero {
      position: relative;
      overflow: hidden;
      padding-block: clamp(3.5rem, 8vw, 7rem);
    }
    .val-bg { position: absolute; inset: 0; pointer-events: none; }
    .val-orb { position: absolute; border-radius: 50%; filter: blur(90px); }
    .val-orb-1 { width: 560px; height: 560px; background: rgba(201,168,76,.20); top: -160px; right: -100px; }
    .val-orb-2 { width: 360px; height: 360px; background: rgba(201,168,76,.10); bottom: -80px; left: 5%; }
    .val-orb-3 { width: 220px; height: 220px; background: rgba(63,127,90,.08); top: 35%; left: -40px; }
    .val-orb-4 { width: 180px; height: 180px; background: rgba(201,168,76,.12); bottom: 20%; right: 15%; }

    .val-hero-inner {
      display: flex;
      align-items: center;
      gap: clamp(2.5rem, 7vw, 6rem);
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ── Coin presentation ──────────────────────────────────── */
    .val-coin-wrap {
      flex-shrink: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* dark circular plate — ensures coin has contrast against light bg */
    .val-scene {
      width: clamp(280px, 36vw, 420px);
      height: clamp(280px, 36vw, 420px);
      position: relative;
      z-index: 1;
    }
    .val-coin-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
      filter: drop-shadow(0 16px 38px rgba(120,80,0,.26));
    }

    /* ── Hero text ──────────────────────────────────────────── */
    .val-hero-text { flex: 1; min-width: 280px; max-width: 520px; }
    .val-eyebrow {
      display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem;
      font-size: .875rem; font-weight: 600; color: var(--muted);
      text-transform: uppercase; letter-spacing: .06em;
    }
    .val-pill {
      background: var(--valus-gold); color: #1a1200;
      font-size: .7rem; font-weight: 800; padding: .22rem .65rem;
      border-radius: 999px; letter-spacing: .08em;
    }
    .val-h1 {
      font-size: clamp(2.6rem, 6vw, 4.5rem);
      line-height: 1.05; font-weight: 800; margin: 0 0 1.25rem;
      letter-spacing: -.02em;
    }
    .val-h1 em { font-style: normal; color: var(--valus-gold); }
    .val-claim { font-size: 1.1rem; color: var(--muted); line-height: 1.65; margin-bottom: 2rem; }
    .val-claim strong { color: var(--text); }
    .val-cta-row { display: flex; gap: .75rem; flex-wrap: wrap; }
    .val-btn-gold {
      background: var(--valus-gold); color: #1a1200; border: none; font-weight: 700;
      box-shadow: 0 4px 20px rgba(var(--valus-gold-rgb),.45);
    }
    .val-btn-gold:hover { background: var(--valus-gold-light); transform: translateY(-1px); box-shadow: 0 6px 28px rgba(var(--valus-gold-rgb),.55); }
    .val-btn-ghost { border: 1px solid rgba(var(--valus-gold-rgb),.4); color: var(--valus-gold); }
    .val-btn-ghost:hover { background: rgba(var(--valus-gold-rgb),.08); }

    /* ── Stats bar ──────────────────────────────────────────── */
    .val-stats-bar { background: var(--valus-gold); color: #1a1200; padding: 1.25rem 0; }
    html[data-theme="dark"] .val-stats-bar {
      background: rgba(201,168,76,.12);
      border-block: 1px solid rgba(201,168,76,.2);
      color: var(--text);
    }
    .val-stats {
      display: flex; align-items: center; justify-content: center;
      gap: 1.5rem; flex-wrap: wrap;
      padding: 0 clamp(1rem, 4vw, 3rem);
    }
    .val-stat { text-align: center; }
    .val-stat-v { display: block; font-size: 1.2rem; font-weight: 800; line-height: 1.2; }
    .val-stat-l { display: block; font-size: .73rem; opacity: .75; margin-top: .15rem; font-weight: 500; }
    .val-stat-sep { width: 1px; height: 2.5rem; background: rgba(26,18,0,.2); }
    html[data-theme="dark"] .val-stat-sep { background: rgba(201,168,76,.2); }

    /* ── Ways / cards ───────────────────────────────────────── */
    .val-ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .val-card {
      background: var(--panel); border: 1px solid var(--line); border-radius: 1.25rem;
      padding: 1.75rem; display: flex; flex-direction: column; gap: .75rem;
      position: relative; transition: box-shadow .25s, border-color .25s, transform .25s;
    }
    .val-card:hover {
      box-shadow: 0 14px 44px rgba(var(--valus-gold-rgb),.16);
      border-color: rgba(var(--valus-gold-rgb),.3);
      transform: translateY(-3px);
    }
    .val-card-featured {
      border-color: rgba(var(--valus-gold-rgb),.45);
      box-shadow: 0 8px 32px rgba(var(--valus-gold-rgb),.12);
    }
    .val-featured-badge {
      position: absolute; top: 1rem; right: 1rem;
      background: var(--valus-gold); color: #1a1200;
      font-size: .7rem; font-weight: 800; padding: .2rem .65rem; border-radius: 999px;
    }
    .val-card-icon {
      width: 3rem; height: 3rem; border-radius: .75rem;
      display: flex; align-items: center; justify-content: center;
    }
    .val-card-icon svg { width: 1.4rem; height: 1.4rem; color: var(--valus-gold); }
    .val-card-num { font-size: .7rem; font-weight: 800; color: var(--muted); letter-spacing: .1em; }
    .val-card h3 { font-size: 1.2rem; margin: 0; }
    .val-card p { color: var(--muted); font-size: .9rem; margin: 0; line-height: 1.6; }
    .val-table { display: flex; flex-direction: column; gap: .35rem; margin-top: .25rem; border-top: 1px solid var(--line); padding-top: .75rem; }
    .val-row { display: flex; justify-content: space-between; font-size: .82rem; gap: .5rem; }
    .val-price-buy { color: var(--valus-gold); font-weight: 600; }
    .val-price-val { color: var(--mint); font-weight: 600; font-size: .8rem; }
    .val-card-link {
      margin-top: .5rem; display: inline-flex; align-items: center;
      font-size: .875rem; font-weight: 600; color: var(--valus-gold); text-decoration: none;
      border-bottom: 1px solid rgba(var(--valus-gold-rgb),.3); padding-bottom: .1rem; width: fit-content;
    }
    .val-card-link:hover { border-bottom-color: var(--valus-gold); }

    /* ── Redeem section ─────────────────────────────────────── */
    .val-redeem-section { background: var(--bg-soft); }
    .val-split { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
    @media (max-width: 800px) { .val-split { grid-template-columns: 1fr; } }
    .val-redeem-list { display: flex; flex-direction: column; gap: 1rem; }
    .val-redeem-item { display: flex; align-items: flex-start; gap: 1rem; }
    .val-redeem-icon {
      flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: .625rem;
      display: flex; align-items: center; justify-content: center;
    }
    .val-redeem-icon svg { width: 1.1rem; height: 1.1rem; }
    .val-redeem-icon.mint { background: rgba(var(--mint-rgb),.12); color: var(--mint); }
    .val-redeem-icon.gold { background: rgba(var(--valus-gold-rgb),.12); color: var(--valus-gold); }
    .val-redeem-icon.blue { background: rgba(var(--blue-rgb),.12); color: var(--blue); }
    .val-redeem-item strong { display: block; margin-bottom: .2rem; }
    .val-redeem-item p { margin: 0; font-size: .875rem; color: var(--muted); }
    .val-rule-note {
      margin-top: 1.25rem; font-size: .8rem; color: var(--muted);
      background: rgba(var(--valus-gold-rgb),.06);
      border: 1px solid rgba(var(--valus-gold-rgb),.18);
      border-radius: .625rem; padding: .625rem 1rem;
    }

    /* value-cards showcase */
    .val-redeem-visual { display: flex; align-items: center; justify-content: center; }
    .val-value-showcase { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 320px; }
    .val-value-card {
      background: var(--panel); border: 1px solid var(--line); border-radius: 1rem;
      padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: .5rem;
      transition: transform .2s, box-shadow .2s;
    }
    .val-vc-mid {
      border-color: rgba(var(--valus-gold-rgb),.4);
      box-shadow: 0 4px 20px rgba(var(--valus-gold-rgb),.12);
      transform: scale(1.03);
    }
    .val-vc-top { display: flex; justify-content: space-between; align-items: center; }
    .val-vc-amount { font-size: 1.05rem; font-weight: 700; }
    .val-vc-badge {

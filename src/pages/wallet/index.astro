---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Valus Wallet | callidus A&M"
  description="Dein persönliches Valus-Guthaben (VAL) — kaufen, einlösen und Wallet verbinden."
  lang="de"
>
  <section class="section wallet-section">
    <div class="container" style="max-width:720px">

      <!-- AUTH VIEWS -->
      <div id="view-loading" class="wallet-view" style="text-align:center;padding:4rem 0">
        <div class="valus-spinner"></div>
        <p class="muted" style="margin-top:1rem">Lade...</p>
      </div>

      <!-- LOGIN -->
      <div id="view-auth" class="wallet-view" hidden>
        <p class="eyebrow" data-reveal>Callidus Mitglieder-Bereich</p>
        <h1 data-reveal="2">Valus Wallet</h1>
        <p class="lede" data-reveal="3" style="max-width:480px">
          Erstelle ein kostenloses Konto oder melde dich an, um dein VAL-Guthaben zu verwalten und Kurse vergünstigt zu bekommen.
        </p>

        <div class="wallet-card" data-reveal="3" style="margin-top:2rem">
          <!-- TAB -->
          <div class="wallet-tabs">
            <button class="wallet-tab active" data-tab="login">Anmelden</button>
            <button class="wallet-tab" data-tab="register">Registrieren</button>
          </div>

          <form id="form-login" class="wallet-form" novalidate>
            <label>
              E-Mail
              <input type="email" id="login-email" autocomplete="email" required placeholder="ihre@email.de" />
            </label>
            <label>
              Passwort
              <input type="password" id="login-password" autocomplete="current-password" required placeholder="Passwort" />
            </label>
            <p id="login-error" class="form-error" hidden></p>
            <button type="submit" class="button primary" style="width:100%">Anmelden</button>
            <button type="button" id="btn-google-login" class="button" style="width:100%;margin-top:.5rem">
              Mit Google anmelden
            </button>
            <button type="button" id="btn-reset-pw" class="form-link">Passwort vergessen?</button>
          </form>

          <form id="form-register" class="wallet-form" hidden novalidate>
            <label>
              Name
              <input type="text" id="reg-name" required placeholder="Dein Name" />
            </label>
            <label>
              E-Mail
              <input type="email" id="reg-email" autocomplete="email" required placeholder="ihre@email.de" />
            </label>
            <label>
              Passwort
              <input type="password" id="reg-password" autocomplete="new-password" required placeholder="Mindestens 8 Zeichen" />
            </label>
            <p id="reg-error" class="form-error" hidden></p>
            <button type="submit" class="button primary" style="width:100%">Konto erstellen</button>
            <button type="button" id="btn-google-reg" class="button" style="width:100%;margin-top:.5rem">
              Mit Google fortfahren
            </button>
          </form>
        </div>
      </div>

      <!-- DASHBOARD -->
      <div id="view-dashboard" class="wallet-view" hidden>
        <div class="wallet-header" data-reveal>
          <div>
            <p class="eyebrow">Valus Wallet</p>
            <h1 id="user-greeting">Willkommen</h1>
            <p class="wallet-account-meta" id="wallet-account-id"></p>
          </div>
          <button id="btn-logout" class="button" style="align-self:flex-start">Abmelden</button>
        </div>

        <!-- BALANCE CARDS -->
        <div class="grid balance-grid" data-reveal="2" style="margin-top:1.5rem">
          <div class="wallet-card balance-card">
            <span class="balance-label">VAL-Guthaben</span>
            <span class="balance-amount" id="valus-balance">—</span>
            <span class="balance-sub">1 VAL = 1,00 € Rabatt</span>
          </div>
          <div class="wallet-card balance-card">
            <span class="balance-label">XP-Punkte</span>
            <span class="balance-amount" id="xp-balance">—</span>
            <span class="balance-sub">10000 XP → 1 VAL</span>
          </div>
        </div>
        <p id="balance-error" class="form-error wallet-balance-error" hidden></p>

        <!-- WALLET ADDRESS -->
        <div class="wallet-card" data-reveal="3" style="margin-top:1.5rem">
          <div style="display:flex;align-items:center;gap:1rem;justify-content:space-between;flex-wrap:wrap">
            <div>
              <strong>Crypto-Wallet</strong>
              <p class="muted" style="margin:.25rem 0 0;font-size:.875rem" id="wallet-address-display">Keine Wallet verbunden</p>
            </div>
            <div class="wallet-actions">
              <button id="btn-connect-wallet" class="button">Wallet verbinden</button>
              <button id="btn-unlink-wallet" class="wallet-unlink" type="button" hidden>Wallet trennen</button>
            </div>
          </div>
          <p class="muted" style="font-size:.8rem;margin-top:.75rem">
            Verbinde eine Ethereum-Wallet (MetaMask o.ä.), um als verifizierter Callidus-Inhaber zusätzliche Vorteile zu bekommen.
            Die Adresse bleibt deinem Konto zugeordnet, bis du sie hier trennst — ein Trennen in MetaMask allein genügt dafür nicht.
          </p>
          <p id="wallet-status" class="wallet-status" hidden></p>
        </div>

        <!-- VAL KAUFEN -->
        <div data-reveal style="margin-top:2.5rem">
          <h2>VAL kaufen</h2>
          <p class="muted">Kaufe Valus-Guthaben und löse es für Rabatte ein.</p>
          <div class="grid valus-packages" style="margin-top:1rem">
            <button class="wallet-card valus-package-card" data-package="valus_10" data-valus="10" data-eur="7.50">
              <span class="valus-amount">10 VAL</span>
              <span class="valus-price">7,50 €</span>
              <span class="valus-value-note">= 10,00 € Rabattwert</span>
            </button>
            <button class="wallet-card valus-package-card" data-package="valus_25" data-valus="25" data-eur="18.75">
              <span class="valus-badge">Beliebt</span>
              <span class="valus-amount">25 VAL</span>
              <span class="valus-price">18,75 €</span>
              <span class="valus-value-note">= 25,00 € Rabattwert</span>
            </button>
            <button class="wallet-card valus-package-card" data-package="valus_50" data-valus="50" data-eur="37.50">
              <span class="valus-amount">50 VAL</span>
              <span class="valus-price">37,50 €</span>
              <span class="valus-value-note">= 50,00 € Rabattwert</span>
            </button>
          </div>
          <p id="valus-purchase-error" class="form-error" hidden style="margin-top:.75rem"></p>
          <p class="muted" style="font-size:.75rem;margin-top:.5rem">
            * Nach dem Klick wirst du sicher zu Digistore24 weitergeleitet (SSL-verschlüsselt).
          </p>
        </div>

        <!-- STRESS RESET MIT VAL -->
        <div class="wallet-card valus-redeem-card" data-reveal style="margin-top:2rem">
          <div style="display:flex;gap:1rem;align-items:flex-start;flex-wrap:wrap">
            <div style="flex:1;min-width:200px">
              <span class="badge gold">Exklusiv</span>
              <h3 style="margin:.75rem 0 .5rem">Stress-Reset-Kurs</h3>
              <p class="muted" style="font-size:.9rem">Löse VAL als Rabatt auf den vollständigen Kurs ein. Maximal 50% des Preises mit VAL.</p>
            </div>
            <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-end;min-width:160px">
              <div class="valus-redeem-input">
                <label style="font-size:.8rem;color:var(--muted)">VAL einsetzen</label>
                <input type="number" id="redeem-amount" min="1" max="50" value="10" style="width:80px;text-align:center" />
              </div>
              <button id="btn-redeem" class="button primary">Rabattlink erhalten</button>
            </div>
          </div>
          <p id="redeem-result" class="form-success" hidden></p>
          <p id="redeem-error" class="form-error" hidden></p>
        </div>

        <!-- XP UMWANDELN -->
        <div class="wallet-card" data-reveal style="margin-top:1.5rem">
          <h3 style="margin:0 0 .5rem">XP in VAL umwandeln</h3>
          <p class="muted" style="font-size:.9rem;margin-bottom:1rem">10000 XP = 1 VAL · Max. 10 VAL pro Monat</p>
          <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap">
            <input type="number" id="xp-convert-amount" min="10000" max="100000" step="10000" value="10000" style="width:120px" />
            <span class="muted" style="font-size:.875rem">XP → <strong id="xp-convert-preview">1 VAL</strong></span>
            <button id="btn-xp-convert" class="button">Umwandeln</button>
          </div>
          <p id="xp-error" class="form-error" hidden style="margin-top:.5rem"></p>
        </div>

        <!-- LEDGER -->
        <div data-reveal style="margin-top:2.5rem">
          <h2>Transaktions-Historie</h2>
          <div id="ledger-list" class="ledger-list">
            <p class="muted">Lade...</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <style>
    .wallet-section { min-height: 70vh; }
    .wallet-view { animation: fadeIn .3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    .wallet-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 1rem;
      padding: 1.5rem;
      box-shadow: var(--shadow);
      transition: box-shadow .2s;
    }
    .wallet-card:where(button) { cursor: pointer; text-align: left; }
    .wallet-card:where(button):hover { box-shadow: 0 8px 30px rgba(var(--gold-rgb),.18); border-color: var(--gold); }

    .wallet-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
    .wallet-tab { background: none; border: none; padding: .75rem 1.5rem; cursor: pointer; color: var(--muted); font-weight: 500; border-bottom: 2px solid transparent; transition: .15s; }
    .wallet-tab.active { color: var(--text); border-bottom-color: var(--gold); }

    .wallet-form { display: flex; flex-direction: column; gap: 1rem; }
    .wallet-form[hidden] { display: none !important; }
    .wallet-form label { display: flex; flex-direction: column; gap: .35rem; font-size: .875rem; font-weight: 500; }
    .wallet-form input { padding: .6rem .875rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--bg-soft); color: var(--text); font-size: 1rem; }
    .wallet-form input:focus { outline: 2px solid var(--gold); border-color: transparent; }

    .form-error { color: var(--coral); font-size: .875rem; margin: -.25rem 0; }
    .form-success { color: var(--mint); font-size: .875rem; }
    .form-link { background: none; border: none; color: var(--muted); cursor: pointer; font-size: .85rem; text-decoration: underline; padding: 0; }

    .wallet-actions { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .wallet-unlink {
      background: none; border: 1px solid var(--line); border-radius: .5rem;
      padding: .5rem .875rem; color: var(--muted); font: inherit; font-size: .875rem; cursor: pointer;
      transition: .15s;
    }
    .wallet-unlink:hover:not([disabled]) { border-color: #b44632; color: #b44632; }
    .wallet-unlink[hidden] { display: none; }
    .wallet-unlink[disabled] { opacity: .5; cursor: not-allowed; }
    .wallet-status { margin: .75rem 0 0; font-size: .85rem; }
    .wallet-status[hidden] { display: none; }
    .wallet-status[data-state='ok'] { color: var(--gold); }
    .wallet-status[data-state='error'] { color: #b44632; }

    .wallet-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .wallet-account-meta { color: var(--muted); font-size: .82rem; margin: .35rem 0 0; overflow-wrap: anywhere; }

    .balance-grid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
    .balance-card { display: flex; flex-direction: column; gap: .35rem; }
    .balance-label { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
    .balance-amount { font-size: 2.5rem; font-weight: 700; color: var(--gold); line-height: 1; }
    .balance-sub { font-size: .78rem; color: var(--muted); }
    .wallet-balance-error { margin: .75rem 0 0; }

    .valus-packages { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
    .valus-package-card { display: flex; flex-direction: column; gap: .4rem; position: relative; }
    .valus-package-card[disabled] { opacity: .65; cursor: progress; }
    .valus-amount { font-size: 1.5rem; font-weight: 700; }
    .valus-price { font-size: 1.1rem; color: var(--gold); font-weight: 600; }
    .valus-value-note { font-size: .78rem; color: var(--muted); }
    .valus-badge { position: absolute; top: .75rem; right: .75rem; background: var(--gold); color: var(--on-accent); font-size: .7rem; font-weight: 700; padding: .15rem .5rem; border-radius: 999px; text-transform: uppercase; }

    .valus-redeem-card { border-color: rgba(var(--gold-rgb),.3); }
    .valus-redeem-input { display: flex; flex-direction: column; gap: .25rem; align-items: flex-end; }
    .valus-redeem-input input { padding: .4rem .6rem; border: 1px solid var(--line); border-radius: .375rem; background: var(--bg-soft); color: var(--text); }

    .ledger-list { display: flex; flex-direction: column; gap: .5rem; margin-top: .75rem; }
    .ledger-item { display: flex; justify-content: space-between; align-items: center; padding: .75rem 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: .625rem; font-size: .875rem; }
    .ledger-item .ledger-desc { color: var(--text); }
    .ledger-item .ledger-valus { font-weight: 700; }
    .ledger-item .ledger-valus.plus { color: var(--mint); }
    .ledger-item .ledger-valus.minus { color: var(--coral); }
    .ledger-item .ledger-date { color: var(--muted); font-size: .78rem; }

    .valus-spinner { width: 2.5rem; height: 2.5rem; border: 3px solid var(--line); border-top-color: var(--gold); border-radius: 50%; animation: spin .8s linear infinite; margin: 0 auto; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .muted { color: var(--muted); }
  </style>

  <script>
    (() => {
      // ── Firebase lazy import ──────────────────────────────────
      const FB_CONFIG = {
        apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
        authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
        projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
        storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
        messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
        appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
      };

      // Digistore24 Pakete (muss mit Cloud Functions übereinstimmen)
      const PACKAGES = {
        valus_10: { valus: 10, eur: 7.50, label: '10 VAL' },
        valus_25: { valus: 25, eur: 18.75, label: '25 VAL' },
        valus_50: { valus: 50, eur: 37.50, label: '50 VAL' },
      };

      // ── View helpers ──────────────────────────────────────────
      const show = (id) => {
        ['view-loading','view-auth','view-dashboard'].forEach(v => {
          const el = document.getElementById(v);
          if (el) el.hidden = v !== id;
        });
      };
      const $ = (id) => document.getElementById(id);
      const setError = (id, msg) => { const el = $(id); if (el) { el.textContent = msg; el.hidden = !msg; } };
      const setSuccess = (id, msg) => { const el = $(id); if (el) { el.textContent = msg; el.hidden = !msg; } };

      // ── Tab switching ─────────────────────────────────────────
      const setupTabs = () => {
        document.querySelectorAll('.wallet-tab').forEach(tab => {
          tab.addEventListener('click', () => {
            document.querySelectorAll('.wallet-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            const target = tab.dataset.tab;
            $('form-login').hidden = target !== 'login';
            $('form-register').hidden = target !== 'register';
          });
        });
      };

      // ── XP preview ───────────────────────────────────────────
      const setupXpPreview = () => {
        const input = $('xp-convert-amount');
        const preview = $('xp-convert-preview');
        if (!input || !preview) return;
        input.addEventListener('input', () => {
          const xp = parseInt(input.value) || 0;
          preview.textContent = `${Math.floor(xp / 10000)} VAL`;
        });
      };

      // ── Firebase init (lazy via CDN) ─────────────────────────
      let firebaseReady = false;
      let auth, db, fns;

      async function initFirebase() {
        if (firebaseReady) return;
        const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-app.js');
        const { getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, signOut, GoogleAuthProvider, signInWithPopup, sendPasswordResetEmail, updateProfile } =
          await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-auth.js');
        const { getFirestore, doc, getDoc, collection, query, orderBy, limit, getDocs } =
          await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-firestore.js');
        const { getFunctions, httpsCallable } =
          await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-functions.js');

        const app = getApps().length === 0 ? initializeApp(FB_CONFIG) : getApps()[0];
        auth = getAuth(app);
        db = getFirestore(app);
        fns = getFunctions(app, 'us-central1');
        firebaseReady = true;

        // ── Auth state ──────────────────────────────────────────
        onAuthStateChanged(auth, async (user) => {
          if (!user) { show('view-auth'); return; }
          show('view-dashboard');
          $('user-greeting').textContent = `Hallo, ${user.displayName || user.email?.split('@')[0] || 'Mitglied'}`;
          const shortUid = `${user.uid.slice(0, 8)}...${user.uid.slice(-4)}`;
          $('wallet-account-id').textContent = user.email
            ? `Eingeloggt als ${user.email} · Konto ${shortUid}`
            : `Eingeloggt mit Konto ${shortUid}`;
          loadDashboard(user, db, fns, { doc, getDoc, collection, query, orderBy, limit, getDocs, httpsCallable });
        });

        // ── Login ───────────────────────────────────────────────
        $('form-login')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          setError('login-error', '');
          try {
            await signInWithEmailAndPassword(auth, $('login-email').value, $('login-password').value);
          } catch (err) {
            setError('login-error', mapAuthError(err.code));
          }
        });

        // ── Register ────────────────────────────────────────────
        $('form-register')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          setError('reg-error', '');
          try {
            const cred = await createUserWithEmailAndPassword(auth, $('reg-email').value, $('reg-password').value);
            await updateProfile(cred.user, { displayName: $('reg-name').value });
          } catch (err) {
            setError('reg-error', mapAuthError(err.code));
          }
        });

        // ── Google ──────────────────────────────────────────────
        const googleSignIn = async () => {
          try { await signInWithPopup(auth, new GoogleAuthProvider()); }
          catch (err) { console.error(err); }
        };
        $('btn-google-login')?.addEventListener('click', googleSignIn);
        $('btn-google-reg')?.addEventListener('click', googleSignIn);

        // ── Password reset ───────────────────────────────────────
        $('btn-reset-pw')?.addEventListener('click', async () => {
          const email = $('login-email').value;
          if (!email) { setError('login-error', 'Bitte E-Mail eingeben'); return; }
          await sendPasswordResetEmail(auth, email);
          setError('login-error', '');
          alert('E-Mail zum Zurücksetzen wurde gesendet.');
        });

        // ── Logout ───────────────────────────────────────────────
        $('btn-logout')?.addEventListener('click', () => signOut(auth));
      }

      async function loadDashboard(user, db, fns, helpers) {
        const { doc, getDoc, collection, query, orderBy, limit, getDocs, httpsCallable } = helpers;

        const numericValues = (...values) => values
          .map((value) => Number(value))
          .filter((value) => Number.isFinite(value));
        const maxNumberValue = (...values) => {
          const numbers = numericValues(...values);
          return numbers.length ? Math.max(0, ...numbers) : 0;
        };
        const valusFromSources = (balance = {}, userDoc = {}) => {
          const canonical = maxNumberValue(balance.valus, balance.val);
          if (balance.valus_legacy_migrated) return canonical;
          const legacy = maxNumberValue(
            balance.san,
            balance.valus_balance,
            balance.val_balance,
            balance.san_balance,
            balance.valusBalance,
            balance.sanBalance,
            balance.current_valus,
            balance.current_san,
            balance.balance?.valus,
            balance.balance?.val,
            balance.balance?.san,
            userDoc.valus,
            userDoc.val,
            userDoc.san,
            userDoc.valus_balance,
            userDoc.val_balance,
            userDoc.san_balance,
            userDoc.valusBalance,
            userDoc.sanBalance,
            userDoc.current_valus,
            userDoc.current_san,
            userDoc.balance?.valus,
            userDoc.balance?.val,
            userDoc.balance?.san,
          );
          if (canonical > 0 && canonical >= legacy) return canonical;
          return canonical + legacy;
        };
        const normalizeBalance = (payload = {}) => {
          const raw = payload.balance || payload.balances || payload;
          const userDoc = payload.user || payload.userDoc || {};
          const valus = valusFromSources(raw, userDoc);
          const xp = Number(raw.xp ?? raw.current_xp ?? raw.total_xp ?? 0);
          return {
            valus: Number.isFinite(valus) ? valus : 0,
            xp: Number.isFinite(xp) ? xp : 0,
          };
        };
        const ledgerTime = (entry = {}) => {
          const value = entry.created_at || entry.timestamp || entry.date;
          const date = value?.toDate?.() || (value ? new Date(value) : null);
          return date && !Number.isNaN(date.getTime()) ? date.getTime() : 0;
        };
        const cleanLedgerDescription = (value) => String(value || '')
          .replace(new RegExp(['Sani', 'tas'].join(''), 'gi'), 'Valus')
          .replace(/\bSAN\b/g, 'VAL')
          .trim();
        const escapeHtml = (value) => String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
        const entryAmount = (entry = {}) => {
          const amount = Number(entry.amount ?? entry.valus ?? entry.val ?? entry.san ?? entry.valus_amount ?? 0);
          return Number.isFinite(amount) ? amount : 0;
        };
        const renderBalance = (bal) => {
          $('valus-balance').textContent = bal.valus.toFixed(0);
          $('xp-balance').textContent = bal.xp.toFixed(0);
        };

        // Balance: erst Callable, dann Firestore-Fallback. Die Function kann NEXUS-XP aus dem User-Dokument mitrechnen.
        try {
          setError('balance-error', '');
          const fn = httpsCallable(fns, 'getValusBalance');
          const result = await fn({});
          renderBalance(normalizeBalance(result.data || {}));
        } catch (callableErr) {
          try {
            const [balSnap, userSnap] = await Promise.all([
              getDoc(doc(db, 'users', user.uid, 'balances', 'current')),
              getDoc(doc(db, 'users', user.uid)),
            ]);
            renderBalance(normalizeBalance({
              balance: balSnap.exists() ? balSnap.data() : {},
              user: userSnap.exists() ? userSnap.data() : {},
            }));
            setError('balance-error', '');
          } catch (directErr) {
            $('valus-balance').textContent = '—';
            $('xp-balance').textContent = '—';
            setError('balance-error', 'Guthaben konnte nicht geladen werden. Bitte abmelden, neu anmelden oder Support mit der oben sichtbaren Konto-ID kontaktieren.');
            console.error('Balance load failed', callableErr, directErr);
          }
        }

        // Wallet address
        // Die angezeigte Adresse stammt aus dem Nutzerdokument, nicht aus
        // MetaMask. Deshalb muss sie nach jedem Verknuepfen und Trennen aus
        // derselben Stelle neu gesetzt werden.
        const setWalletStatus = (message, kind = '') => {
          const el = $('wallet-status');
          if (!el) return;
          el.textContent = message || '';
          el.hidden = !message;
          el.dataset.state = kind;
        };

        const renderWallet = (walletAddr) => {
          if (walletAddr) {
            $('wallet-address-display').textContent = `${walletAddr.slice(0,6)}...${walletAddr.slice(-4)}`;
            $('btn-connect-wallet').textContent = 'Wallet wechseln';
            $('btn-unlink-wallet').hidden = false;
          } else {
            $('wallet-address-display').textContent = window.ethereum
              ? 'Keine Wallet verbunden'
              : 'Keine Browser-Wallet erkannt.';
            $('btn-connect-wallet').textContent = window.ethereum ? 'Wallet verbinden' : 'Wallet erstellen';
            $('btn-unlink-wallet').hidden = true;
          }
        };

        try {
          const userSnap = await getDoc(doc(db, 'users', user.uid));
          renderWallet(userSnap.data()?.wallet_address);
        } catch (_) {}

        // Ledger
        const renderLedger = (entries = []) => {
          const list = $('ledger-list');
          if (!entries.length) {
            list.innerHTML = '<p class="muted">Noch keine Transaktionen.</p>';
            return;
          }
          list.innerHTML = entries.map(data => {
            const amount = entryAmount(data);
            const sign = amount > 0 ? '+' : '';
            const cls = amount > 0 ? 'plus' : 'minus';
            const rawDate = data.created_at || data.timestamp || data.date;
            const parsedDate = data.created_at?.toDate?.() || (rawDate ? new Date(rawDate) : null);
            const date = parsedDate && !Number.isNaN(parsedDate.getTime())
              ? parsedDate.toLocaleDateString('de-DE')
              : '-';
            const description = cleanLedgerDescription(data.description || data.type) || 'Transaktion';
            return `<div class="ledger-item">
              <span class="ledger-desc">${escapeHtml(description)}</span>
              <span class="ledger-date">${escapeHtml(date)}</span>
              <span class="ledger-valus ${cls}">${sign}${amount} VAL</span>
            </div>`;
          }).join('');
        };

        try {
          const fn = httpsCallable(fns, 'getValusLedger');
          const result = await fn({ limit: 20 });
          renderLedger(result.data?.entries || []);
        } catch (callableErr) {
          try {
            const legacyLedgerName = ['sani', 'tas_ledger'].join('');
            const [valusSnap, legacySnap] = await Promise.all([
              getDocs(query(collection(db, 'users', user.uid, 'valus_ledger'), orderBy('created_at', 'desc'), limit(20))),
              getDocs(query(collection(db, 'users', user.uid, legacyLedgerName), orderBy('created_at', 'desc'), limit(20))).catch(() => ({ docs: [], empty: true })),
            ]);
            const entries = [...valusSnap.docs, ...legacySnap.docs]
              .map(d => ({ id: d.id, ...d.data() }))
              .sort((a, b) => ledgerTime(b) - ledgerTime(a))
              .slice(0, 20);
            renderLedger(entries);
          } catch (directErr) {
            $('ledger-list').innerHTML = '<p class="muted">Transaktionen konnten nicht geladen werden.</p>';
            console.error('Ledger load failed', callableErr, directErr);
          }
        }

        // VAL kaufen → Digistore24
        document.querySelectorAll('.valus-package-card').forEach(card => {
          card.addEventListener('click', async () => {
            const packageId = card.dataset.package;
            setError('valus-purchase-error', '');
            card.disabled = true;
            card.setAttribute('aria-busy', 'true');
            try {
              const fn = httpsCallable(fns, 'getValusCheckoutUrl');
              const result = await fn({ packageId });
              if (result.data?.url) {
                window.location.href = result.data.url;
              }
            } catch (err) {
              const detail = err?.message || err?.details || 'Bitte versuche es erneut.';
              setError('valus-purchase-error', `Checkout konnte nicht gestartet werden: ${detail}`);
              console.error(err);
            } finally {
              card.disabled = false;
              card.removeAttribute('aria-busy');
            }
          });
        });

        // Stress Reset einlösen
        $('btn-redeem')?.addEventListener('click', async () => {
          setError('redeem-error', '');
          setSuccess('redeem-result', '');
          const valusAmount = parseInt($('redeem-amount')?.value || '0');
          if (valusAmount < 1) { setError('redeem-error', 'Bitte Betrag eingeben.'); return; }
          try {
            const fn = httpsCallable(fns, 'redeemValus');
            const result = await fn({ productId: 'stress_reset_kurs', valusAmount });
            if (result.data?.discountUrl) {
              setSuccess('redeem-result', `Dein Rabattlink wurde erstellt. VAL werden erst nach bestaetigtem Kauf abgezogen. Du wirst weitergeleitet...`);
              setTimeout(() => window.open(result.data.discountUrl, '_blank'), 1500);
            }
          } catch (err) {
            setError('redeem-error', err.message || 'Einlösung fehlgeschlagen.');
          }
        });

        // XP umwandeln
        $('btn-xp-convert')?.addEventListener('click', async () => {
          setError('xp-error', '');
          const xpAmount = parseInt($('xp-convert-amount')?.value || '0');
          if (xpAmount < 10000) { setError('xp-error', 'Minimum 10000 XP.'); return; }
          if (xpAmount % 10000 !== 0) { setError('xp-error', 'Bitte in 10000-XP-Schritten umwandeln.'); return; }
          const valusAmount = Math.floor(xpAmount / 10000);
          if (!window.confirm(`${xpAmount} NEXUS-XP wirklich in ${valusAmount} VAL umwandeln? Dieser Schritt kann nicht automatisch rueckgaengig gemacht werden.`)) return;
          try {
            const fn = httpsCallable(fns, 'convertNexusXpToValus');
            await fn({ xpAmount, source: 'nexus' });
            window.location.reload();
          } catch (err) {
            setError('xp-error', err.message || 'Umwandlung fehlgeschlagen.');
          }
        });

        // Wallet verbinden (MetaMask)
        $('btn-connect-wallet')?.addEventListener('click', async () => {
          if (!window.ethereum) {
            $('wallet-address-display').textContent = 'Keine Browser-Wallet erkannt. MetaMask wird geoeffnet.';
            window.location.href = 'https://metamask.io/download/';
            return;
          }
          try {
            const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
            const address = accounts[0];
            const message = `Callidus Wallet-Verknüpfung für ${user.uid} — ${Date.now()}`;
            const signature = await window.ethereum.request({
              method: 'personal_sign',
              params: [message, address],
            });
            const fn = httpsCallable(fns, 'linkWalletAddress');
            await fn({ address, message, signature });
            renderWallet(address);
            setWalletStatus('Wallet verknüpft.', 'ok');
          } catch (err) {
            alert('Wallet-Verknüpfung fehlgeschlagen: ' + (err.message || err));
          }
        });

        // Wallet trennen
        $('btn-unlink-wallet')?.addEventListener('click', async () => {
          const ok = window.confirm(
            'Wallet wirklich von diesem Konto trennen? Die Adresse wird aus deinem Konto entfernt. '
            + 'Du kannst jederzeit wieder eine Wallet verbinden.',
          );
          if (!ok) return;

          const button = $('btn-unlink-wallet');
          button.disabled = true;
          setWalletStatus('Wallet wird getrennt…', 'pending');
          try {
            await httpsCallable(fns, 'unlinkWalletAddress')({});
            renderWallet(null);
            setWalletStatus('Wallet getrennt. Die Adresse ist nicht mehr deinem Konto zugeordnet.', 'ok');
          } catch (err) {
            setWalletStatus('Trennen fehlgeschlagen: ' + (err.message || err), 'error');
          } finally {
            button.disabled = false;
          }
        });
      }

      function mapAuthError(code) {
        const map = {
          'auth/invalid-email': 'Ungültige E-Mail-Adresse.',
          'auth/user-not-found': 'Kein Konto mit dieser E-Mail gefunden.',
          'auth/wrong-password': 'Falsches Passwort.',
          'auth/email-already-in-use': 'Diese E-Mail wird bereits verwendet.',
          'auth/weak-password': 'Passwort muss mindestens 6 Zeichen haben.',
          'auth/too-many-requests': 'Zu viele Versuche. Bitte warten.',
          'auth/invalid-credential': 'E-Mail oder Passwort ungültig.',
        };
        return map[code] || 'Anmeldung fehlgeschlagen. Bitte erneut versuchen.';
      }

      setupTabs();
      setupXpPreview();
      show('view-loading');
      initFirebase();

      document.addEventListener('astro:page-load', () => {
        setupTabs();
        setupXpPreview();
        if (!firebaseReady) { show('view-loading'); initFirebase(); }
      });
    })();
  </script>
</BaseLayout>

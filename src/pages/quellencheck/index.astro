---
import BaseLayout from '../../layouts/BaseLayout.astro';
import beispiel from '../../data/quellencheck-beispiel.json';

const title = 'Quellencheck: Was sagt die Forschung? | callidus A&M';
const description = 'Gesundheitsaussage eingeben und sehen, was Studien dazu zeigen: Studienlage auf einer Skala, Belegsicherheit und wörtliche Belegstellen aus der Forschung.';
const beispiele = [
  'Vitamin C verhindert Erkältungen.',
  'Magnesium hilft gegen Wadenkrämpfe.',
  'Intervallfasten senkt den Blutdruck.',
];
const fbConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
const stufen = [
  { cls: 'pos', name: 'Gut belegt', text: 'Gute Studien sprechen klar dafür, dass die Aussage zutrifft, für die untersuchten Gruppen.' },
  { cls: 'pos-soft', name: 'Eher belegt', text: 'Studien sprechen eher dafür, die Belege sind aber nicht eindeutig.' },
  { cls: 'mid', name: 'Gemischt', text: 'Die Studien kommen zu unterschiedlichen Ergebnissen.' },
  { cls: 'neg-soft', name: 'Eher nicht belegt', text: 'Studien sprechen eher dagegen.' },
  { cls: 'neg', name: 'Studien widersprechen', text: 'Gute Studien sprechen dagegen, dass die Aussage zutrifft.' },
];
---

<BaseLayout lang="de" title={title} description={description}>
  <div class="qc-page">
    <section class="section qc-hero">
      <div class="container qc-hero-grid">
        <div class="qc-intro" data-reveal>
          <p class="eyebrow">Callidus Quellencheck</p>
          <h1>Was sagt die Forschung wirklich?</h1>
          <p class="lede">Gib eine Gesundheitsaussage ein. Wir prüfen sie gegen Studien und zeigen, wie gut sie belegt ist.</p>
          <button type="button" class="qc-info-trigger" data-qc-info-open aria-haspopup="dialog">
            <span class="qc-info-dot" aria-hidden="true">i</span>So entsteht die Bewertung
          </button>
        </div>

        <form class="qc-console qc-glass" data-qc-form data-reveal="2" novalidate>
          <label for="qc-text" class="qc-label">Aussage oder kurzer Text</label>
          <textarea id="qc-text" name="text" rows="4" maxlength="1200" required
            aria-describedby="qc-help qc-error"
            placeholder="z. B. aus einem Artikel, einer Werbung oder einem Social-Media-Post"></textarea>
          <div class="qc-console-row">
            <p id="qc-help" class="qc-help"><span class="qc-mono" data-qc-count>0</span> / 1.200 Zeichen, bis zu drei Aussagen</p>
            <p id="qc-error" class="qc-error" data-qc-error role="alert" hidden></p>
          </div>
          <div class="qc-chips" aria-label="Beispielaussagen">
            {beispiele.map((b) => <button type="button" class="qc-chip" data-qc-example={b}>{b}</button>)}
          </div>
          <div class="qc-actions">
            <button type="submit" class="qc-run" data-qc-submit>Aussage prüfen</button>
            <button type="button" class="qc-link" data-qc-demo>Beispielergebnis ansehen</button>
          </div>
        </form>
      </div>
    </section>

    <section class="section tight qc-results-section" aria-live="polite">
      <div class="container">
        <div class="qc-loading qc-glass" data-qc-loading hidden>
          <div class="qc-scan" aria-hidden="true"><span></span></div>
          <div>
            <p class="qc-loading-title">Studien werden gesucht und gelesen <span class="qc-mono" data-qc-elapsed>0</span><span class="qc-mono"> s</span></p>
            <ol class="qc-steps">
              <li>Aussagen im Text erkennen</li>
              <li>Passende Studien in Europe PMC suchen</li>
              <li>Jede Studie einzeln gegen die Aussage prüfen</li>
            </ol>
          </div>
        </div>
        <p class="qc-notice" data-qc-notice hidden></p>
        <div class="qc-results" data-qc-results></div>
        <p class="qc-disclaimer">Automatische Auswertung von Studienzusammenfassungen. Kann Fehler enthalten, ersetzt keine ärztliche Beratung und bewertet keine persönliche Situation.</p>
      </div>
    </section>
  </div>

  <dialog class="qc-dialog" data-qc-dialog aria-labelledby="qc-dialog-title">
    <div class="qc-dialog-inner">
      <header class="qc-dialog-head">
        <h2 id="qc-dialog-title">So entsteht die Bewertung</h2>
        <button type="button" class="qc-close" data-qc-info-close aria-label="Fenster schließen">×</button>
      </header>
      <ol class="qc-flow">
        <li><span class="qc-flow-n qc-mono">01</span><div><strong>Studien finden</strong><p>Passende Studien werden in Europe PMC gesucht, zuerst viel zitierte Übersichtsarbeiten. Zurückgezogene Studien und Protokolle fallen heraus.</p></div></li>
        <li><span class="qc-flow-n qc-mono">02</span><div><strong>Jede Studie einzeln prüfen</strong><p>Die KI liest jede Zusammenfassung und sagt nur, ob sie zur Aussage passt und in welche Richtung sie zeigt.</p></div></li>
        <li><span class="qc-flow-n qc-mono">03</span><div><strong>Wörtlicher Beleg</strong><p>Jede Einschätzung braucht einen Satz, der wörtlich in der Studie steht. Fehlt er, zählt die Studie nicht.</p></div></li>
        <li><span class="qc-flow-n qc-mono">04</span><div><strong>Feste Regel statt KI-Urteil</strong><p>Meta-Analysen zählen dreifach, randomisierte Studien doppelt, andere Arbeiten halb. Ein Urteil gibt es erst mit mindestens einer direkt passenden Meta-Analyse oder randomisierten Studie.</p></div></li>
      </ol>
      <h3 class="qc-dialog-sub">Was die Skala bedeutet</h3>
      <ul class="qc-legend">
        {stufen.map((s) => <li><span class={`qc-swatch qc-swatch-${s.cls}`} aria-hidden="true"></span><strong>{s.name}</strong><span>{s.text}</span></li>)}
        <li><span class="qc-swatch qc-swatch-none" aria-hidden="true"></span><strong>Keine Bewertung</strong><span>Zu wenig passende, belastbare Studien. Das heißt nicht, dass die Aussage falsch ist.</span></li>
      </ul>
      <p class="qc-dialog-note">Die Belegsicherheit zeigt getrennt davon, wie viele starke Studien es gibt und wie einig sie sind. Kein Ergebnis ist eine Garantie für den Einzelfall. Mehr unter <a href="/quellen-methodik/">Quellen &amp; Methodik</a>.</p>
    </div>
  </dialog>

  <template id="qc-claim-template">
    <article class="qc-claim qc-glass">
      <header class="qc-claim-head">
        <div>
          <p class="qc-kicker">Geprüfte Aussage</p>
          <h3 class="qc-claim-text"></h3>
        </div>
        <button type="button" class="qc-info-mini" data-qc-info-open aria-label="So entsteht die Bewertung">i</button>
      </header>
      <div class="qc-verdict">
        <figure class="qc-dial">
          <div class="qc-dial-stage">
          <svg class="qc-gauge" viewBox="0 0 260 146" role="img">
            <title></title>
            <defs>
              <linearGradient class="qc-grad" gradientUnits="userSpaceOnUse" x1="22" y1="0" x2="238" y2="0">
                <stop offset="0" style="stop-color: var(--qc-neg)"></stop>
                <stop offset="0.25" style="stop-color: var(--qc-neg-soft)"></stop>
                <stop offset="0.5" style="stop-color: var(--qc-mid)"></stop>
                <stop offset="0.75" style="stop-color: var(--qc-pos-soft)"></stop>
                <stop offset="1" style="stop-color: var(--qc-pos)"></stop>
              </linearGradient>
            </defs>
            <g class="qc-ticks"></g>
            <path class="qc-track" d="M 22 130 A 108 108 0 0 1 238 130"></path>
            <path class="qc-fill" pathLength="1"></path>
            <g class="qc-knob">
              <circle class="qc-knob-ring" cx="130" cy="22" r="12"></circle>
              <circle class="qc-knob-dot" cx="130" cy="22" r="5"></circle>
            </g>
          </svg>
          <div class="qc-dial-readout">
            <span class="qc-dial-label"></span>
            <span class="qc-dial-sub">Studienlage</span>
          </div>
          </div>
          <figcaption class="qc-gauge-scale"><span>widerspricht</span><span>gemischt</span><span>gut belegt</span></figcaption>
        </figure>
        <div class="qc-panel">
          <p class="qc-meaning"></p>
          <div class="qc-stats"></div>
          <div class="qc-certainty">
            <span class="qc-certainty-label"></span>
            <span class="qc-segments" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <aside class="qc-limit"><strong>Wichtig zu wissen</strong><span class="qc-limit-text"></span></aside>
        </div>
      </div>
      <div class="qc-sources">
        <h4 class="qc-sources-title"></h4>
        <ul class="qc-source-list"></ul>
        <details class="qc-other" hidden>
          <summary></summary>
          <ul class="qc-source-list qc-source-list-other"></ul>
        </details>
      </div>
    </article>
  </template>

  <script is:inline define:vars={{ BEISPIEL: beispiel, QC_FB_CONFIG: fbConfig }}>
    (() => {
      const STANCE = {
        stuetzt: { label: 'stützt', cls: 'pos' },
        widerspricht: { label: 'widerspricht', cls: 'neg' },
        gemischt: { label: 'gemischt', cls: 'mid' },
        keine_aussage: { label: 'keine klare Aussage', cls: 'none' },
      };
      const RELEVANZ = { passt: 'passt genau', teilweise: 'passt teilweise', passt_nicht: 'passt nicht' };
      const CERTAINTY = { niedrig: 1, mittel: 2, hoch: 3 };
      const ACCENT = { widerspricht: '--qc-neg', eher_nicht: '--qc-neg-soft', gemischt: '--qc-mid', eher_belegt: '--qc-pos-soft', belegt: '--qc-pos' };
      const MEANING = {
        belegt: 'Gute Studien sprechen klar dafür, dass die Aussage zutrifft, zumindest für die untersuchten Gruppen.',
        eher_belegt: 'Studien sprechen eher dafür, dass die Aussage zutrifft. Die Belege sind aber nicht eindeutig.',
        gemischt: 'Die Studien kommen zu unterschiedlichen Ergebnissen. Ob die Aussage zutrifft, ist offen.',
        eher_nicht: 'Studien sprechen eher dagegen, dass die Aussage zutrifft.',
        widerspricht: 'Gute Studien sprechen dagegen, dass die Aussage zutrifft.',
      };
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const form = document.querySelector('[data-qc-form]');
      const textarea = form.querySelector('textarea');
      const count = form.querySelector('[data-qc-count]');
      const errorEl = form.querySelector('[data-qc-error]');
      const submit = form.querySelector('[data-qc-submit]');
      const loading = document.querySelector('[data-qc-loading]');
      const elapsedEl = document.querySelector('[data-qc-elapsed]');
      const notice = document.querySelector('[data-qc-notice]');
      const results = document.querySelector('[data-qc-results]');
      const template = document.getElementById('qc-claim-template');
      const dialog = document.querySelector('[data-qc-dialog]');

      // Info-Fenster: oeffnet sich ueber jeden Info-Knopf, schliesst per Knopf, Esc oder Klick daneben.
      document.addEventListener('click', (event) => {
        if (event.target.closest('[data-qc-info-open]')) dialog.showModal();
        if (event.target.closest('[data-qc-info-close]') || event.target === dialog) dialog.close();
      });

      const svgNs = 'http://www.w3.org/2000/svg';
      const CX = 130, CY = 130, R = 108;
      const point = (v, r = R) => {
        const rad = ((90 - v * 90) * Math.PI) / 180;
        return [CX + r * Math.cos(rad), CY - r * Math.sin(rad)];
      };

      function drawDial(svg, value, index) {
        const gradId = `qc-grad-${index}-${Date.now()}`;
        svg.querySelector('.qc-grad').id = gradId;
        svg.querySelector('.qc-track').style.stroke = `url(#${gradId})`;
        const ticks = svg.querySelector('.qc-ticks');
        const majors = [-1, -0.6, -0.2, 0.2, 0.6, 1];
        for (let i = 0; i <= 40; i += 1) {
          const v = -1 + i / 20;
          const major = majors.some((m) => Math.abs(m - v) < 0.001);
          const [x1, y1] = point(v, R + 14);
          const [x2, y2] = point(v, R + (major ? 22 : 18));
          const line = document.createElementNS(svgNs, 'line');
          line.setAttribute('x1', x1.toFixed(1));
          line.setAttribute('y1', y1.toFixed(1));
          line.setAttribute('x2', x2.toFixed(1));
          line.setAttribute('y2', y2.toFixed(1));
          if (major) line.setAttribute('class', 'is-major');
          ticks.append(line);
        }
        const fill = svg.querySelector('.qc-fill');
        const knob = svg.querySelector('.qc-knob');
        if (value === null) {
          fill.remove();
          knob.remove();
          return;
        }
        const [ex, ey] = point(value);
        fill.setAttribute('d', `M ${CX} ${CY - R} A ${R} ${R} 0 0 ${value >= 0 ? 1 : 0} ${ex.toFixed(2)} ${ey.toFixed(2)}`);
        fill.style.stroke = `url(#${gradId})`;
        const target = value * 90;
        const finish = () => {
          fill.style.strokeDashoffset = '0';
          knob.style.transform = `rotate(${target}deg)`;
        };
        if (reduceMotion) finish();
        else requestAnimationFrame(() => requestAnimationFrame(finish));
      }

      function sessionId() {
        try {
          let id = localStorage.getItem('qc_session');
          if (!id) {
            id = crypto.randomUUID();
            localStorage.setItem('qc_session', id);
          }
          return id;
        } catch {
          return 'anon';
        }
      }

      function sourceItem(q) {
        const stance = STANCE[q.richtung] || STANCE.keine_aussage;
        const li = document.createElement('li');
        li.className = `qc-source qc-stance-${stance.cls}`;
        const meta = document.createElement('p');
        meta.className = 'qc-source-meta';
        const badge = document.createElement('span');
        badge.className = 'qc-badge';
        badge.textContent = stance.label;
        const info = document.createElement('span');
        info.textContent = [q.art, q.jahr, RELEVANZ[q.relevanz]].filter(Boolean).join(', ');
        meta.append(badge, info);
        const titleLink = document.createElement('a');
        titleLink.className = 'qc-source-title';
        titleLink.href = q.url;
        titleLink.target = '_blank';
        titleLink.rel = 'noopener';
        titleLink.textContent = q.titel;
        li.append(meta, titleLink);
        if (q.erklaerung) {
          const p = document.createElement('p');
          p.className = 'qc-source-note';
          p.textContent = q.erklaerung;
          li.append(p);
        }
        if (q.zitat) {
          const details = document.createElement('details');
          details.className = 'qc-quote';
          const summary = document.createElement('summary');
          summary.textContent = 'Beleg aus der Studie';
          const quote = document.createElement('blockquote');
          quote.lang = 'en';
          quote.textContent = `„${q.zitat}“`;
          details.append(summary, quote);
          li.append(details);
        } else if (!q.verified) {
          const p = document.createElement('p');
          p.className = 'qc-source-flag';
          p.textContent = 'Kein wörtlicher Beleg, zählt nicht zur Bewertung.';
          li.append(p);
        }
        return li;
      }

      function stats(quellen) {
        const counted = quellen.filter((q) => q.verified && q.relevanz !== 'passt_nicht');
        const n = (r) => counted.filter((q) => q.richtung === r).length;
        return [
          { cls: 'pos', count: n('stuetzt'), label: 'stützen' },
          { cls: 'neg', count: n('widerspricht'), label: 'widersprechen' },
          { cls: 'mid', count: n('gemischt'), label: 'gemischt' },
        ].map((x) => {
          const tile = document.createElement('div');
          tile.className = `qc-stat qc-stat-${x.cls}`;
          const num = document.createElement('span');
          num.className = 'qc-stat-num qc-mono';
          num.textContent = String(x.count);
          const label = document.createElement('span');
          label.className = 'qc-stat-label';
          label.textContent = x.label;
          tile.append(num, label);
          return tile;
        });
      }

      function renderClaim(a, index) {
        const node = template.content.firstElementChild.cloneNode(true);
        node.style.setProperty('--qc-index', index);
        node.querySelector('.qc-claim-text').textContent = a.aussage;
        const e = a.ergebnis || {};
        const unclear = e.level === 'unklar' || e.level === 'fehler' || e.value === null || e.value === undefined;
        node.dataset.level = unclear ? 'unklar' : e.level;
        node.style.setProperty('--qc-accent', `var(${unclear ? '--qc-mid' : ACCENT[e.level]})`);
        if (unclear) node.classList.add('is-unclear');
        const svg = node.querySelector('.qc-gauge');
        drawDial(svg, unclear ? null : Math.max(-1, Math.min(1, e.value)), index);
        svg.querySelector('title').textContent = unclear
          ? `Keine Bewertung: ${e.label || 'zu wenig passende Studien'}`
          : `Studienlage: ${e.label}, Belegsicherheit ${e.certainty}`;
        node.querySelector('.qc-dial-label').textContent = unclear ? 'Keine Bewertung' : e.label;
        node.querySelector('.qc-meaning').textContent = unclear
          ? `${e.label || 'Zu wenig passende Studien'}. Für ein Urteil fehlen passende, belastbare Studien. Das heißt nicht, dass die Aussage falsch ist.`
          : MEANING[e.level];
        const statsEl = node.querySelector('.qc-stats');
        const cert = node.querySelector('.qc-certainty');
        if (unclear) {
          statsEl.remove();
          cert.remove();
        } else {
          stats(a.quellen || []).forEach((tile) => statsEl.append(tile));
          cert.dataset.bars = CERTAINTY[e.certainty] || 1;
          node.querySelector('.qc-certainty-label').textContent = `Belegsicherheit: ${e.certainty}`;
        }
        const limit = node.querySelector('.qc-limit');
        if (a.einschraenkung) node.querySelector('.qc-limit-text').textContent = a.einschraenkung;
        else limit.remove();
        const fitting = (a.quellen || []).filter((q) => q.relevanz !== 'passt_nicht');
        const other = (a.quellen || []).filter((q) => q.relevanz === 'passt_nicht');
        node.querySelector('.qc-sources-title').textContent = fitting.length === 1
          ? '1 passende Studie'
          : `${fitting.length} passende Studien`;
        const list = node.querySelector('.qc-source-list');
        if (fitting.length) fitting.forEach((q) => list.append(sourceItem(q)));
        else {
          const li = document.createElement('li');
          li.className = 'qc-source-empty';
          li.textContent = 'Keine passende Studie gefunden.';
          list.append(li);
        }
        if (other.length) {
          const details = node.querySelector('.qc-other');
          details.hidden = false;
          details.querySelector('summary').textContent = other.length === 1
            ? '1 weitere gefundene Studie passt nicht zur Aussage'
            : `${other.length} weitere gefundene Studien passen nicht zur Aussage`;
          other.forEach((q) => details.querySelector('.qc-source-list-other').append(sourceItem(q)));
        }
        return node;
      }

      function render(data) {
        results.replaceChildren();
        notice.hidden = true;
        if (data.beispiel) {
          notice.textContent = 'Beispielergebnis einer echten Prüfung. Gib oben eine eigene Aussage ein.';
          notice.hidden = false;
        }
        if (!data.aussagen || !data.aussagen.length) {
          notice.textContent = data.hinweis || 'Im Text wurde keine überprüfbare Gesundheitsaussage gefunden.';
          notice.hidden = false;
          return;
        }
        data.aussagen.forEach((a, i) => results.append(renderClaim(a, i)));
        (data.beispiel ? notice : results.firstElementChild)?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      }

      function setError(message) {
        errorEl.textContent = message;
        errorEl.hidden = !message;
        textarea.setAttribute('aria-invalid', message ? 'true' : 'false');
      }

      let timer = null;
      function setLoading(on) {
        loading.hidden = !on;
        submit.disabled = on;
        submit.textContent = on ? 'Prüfung läuft' : 'Aussage prüfen';
        clearInterval(timer);
        if (on) {
          const start = Date.now();
          elapsedEl.textContent = '0';
          timer = setInterval(() => { elapsedEl.textContent = String(Math.round((Date.now() - start) / 1000)); }, 1000);
          results.replaceChildren();
          notice.hidden = true;
        }
      }

      let callable = null;
      async function getCallable() {
        if (callable) return callable;
        if (!QC_FB_CONFIG?.apiKey) return null;
        const { initializeApp, getApps } = await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-app.js');
        const { getFunctions, httpsCallable } = await import('https://www.gstatic.com/firebasejs/11.8.1/firebase-functions.js');
        const app = getApps().length === 0 ? initializeApp(QC_FB_CONFIG) : getApps()[0];
        callable = httpsCallable(getFunctions(app, 'us-central1'), 'checkHealthClaims', { timeout: 160000 });
        return callable;
      }

      textarea.addEventListener('input', () => {
        count.textContent = String(textarea.value.length);
        if (!errorEl.hidden) setError('');
      });
      form.querySelectorAll('[data-qc-example]').forEach((chip) => chip.addEventListener('click', () => {
        textarea.value = chip.dataset.qcExample;
        count.textContent = String(textarea.value.length);
        textarea.focus();
      }));
      form.querySelector('[data-qc-demo]').addEventListener('click', () => render(BEISPIEL));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const text = textarea.value.trim();
        if (text.length < 12) {
          setError('Bitte gib mindestens einen kurzen Satz ein, zum Beispiel „Vitamin C verhindert Erkältungen.“');
          textarea.focus();
          return;
        }
        setError('');
        setLoading(true);
        try {
          const call = window.__qcCall || await getCallable();
          if (!call) throw new Error('Der Quellencheck ist gerade nicht erreichbar.');
          const response = await call({ text, sessionId: sessionId() });
          render(response.data || response);
        } catch (error) {
          notice.textContent = error?.message || 'Die Prüfung ist gerade nicht möglich. Bitte versuche es später erneut.';
          notice.hidden = false;
        } finally {
          setLoading(false);
        }
      });

      if (new URLSearchParams(location.search).has('beispiel')) render(BEISPIEL);
    })();
  </script>
</BaseLayout>

<style is:global>
  /* Farben der Skala: divergierend, farbenblind-geprüft (Pole und neutrale Mitte). */
  .qc-page, .qc-dialog {
    --qc-neg: #c25a2c; --qc-neg-soft: #dd9b7a; --qc-mid: #b9bcab; --qc-pos-soft: #6fb0c6; --qc-pos: #00789a;
    --qc-glass: rgba(255, 255, 255, 0.62);
    --qc-glass-edge: rgba(255, 255, 255, 0.85);
    --qc-glass-line: rgba(77, 86, 58, 0.16);
    --qc-mono: ui-monospace, "SF Mono", "Cascadia Mono", Consolas, monospace;
  }
  html[data-theme="dark"] .qc-page, html[data-theme="dark"] .qc-dialog {
    --qc-neg: #d6683a; --qc-neg-soft: #9b5a3e; --qc-mid: #5c665e; --qc-pos-soft: #2b7e92; --qc-pos: #14a2c4;

---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Kuratierte Krypto-Werkzeuge und offizielle Links.
// Quelle: geteilte "offizielle links"-Tabelle (web3universe.de). Einige Links
// enthalten Referral-/Affiliate-Codes des Tabellen-Erstellers.
const categories = [
  {
    title: 'Krypto kaufen (Börsen / CEX)',
    note: 'Zentrale Börsen. Anmeldung, Verifizierung (KYC) und Verwahrung laufen beim Anbieter.',
    links: [
      { label: 'Phemex', href: 'https://phemex.com/en/promo/activity/338?referralCode=CVYSP8', ref: true },
    ],
  },
  {
    title: 'Wallets',
    links: [
      { label: 'MetaMask (EVM)', href: 'https://metamask.io/download/' },
      { label: 'Rabby (EVM, Alternative)', href: 'https://rabby.io/' },
      { label: 'Phantom (Solana)', href: 'https://phantom.app/' },
      { label: 'Tonkeeper (TON)', href: 'https://ton.org/en/wallets?locale=en&pagination[page]=1&pagination[pageSize]=25' },
      { label: 'Keplr (Cosmos)', href: 'https://www.keplr.app/' },
    ],
  },
  {
    title: 'Hardware-Wallets',
    note: 'Für die langfristige Aufbewahrung („HODL“). Kaufe Hardware-Wallets nur direkt beim Hersteller.',
    links: [
      { label: 'Ledger', href: 'https://shop.ledger.com/?r=208899b9b5de', ref: true },
    ],
  },
  {
    title: 'DeFi & Portfolio',
    links: [
      { label: 'DeFiLlama', href: 'https://defillama.com/' },
      { label: 'DeBank (Portfolio-Tracker EVM)', href: 'https://debank.com/' },
      { label: 'Sonar.watch (Portfolio-Tracker Solana)', href: 'https://sonar.watch/portfolio' },
      { label: 'Kamino (Lending, Solana)', href: 'https://kamino.com/earn/lend' },
    ],
  },
  {
    title: 'Steuern',
    links: [
      { label: 'CoinTracking', href: 'https://cointracking.info/?ref=M479806', ref: true, note: '10 % Rabatt mit diesem Code.' },
    ],
  },
  {
    title: 'Rechner & Infos',
    links: [
      { label: 'Impermanent-Loss-Rechner (DailyDeFi)', href: 'https://dailydefi.org/tools/impermanent-loss-calculator/' },
      { label: 'Gas-Gebühren (EthereumPrice)', href: 'https://ethereumprice.org/gas/' },
      { label: 'Blockchains hinzufügen (Chainlist)', href: 'https://chainlist.org/' },
      { label: 'Zeitzonen-Umrechner (World Time Buddy)', href: 'https://www.worldtimebuddy.com/' },
    ],
  },
  {
    title: 'Block-Explorer',
    links: [
      { label: 'Etherscan (Ethereum)', href: 'https://etherscan.io/' },
    ],
  },
  {
    title: 'Kurse & Preis-Informationen',
    links: [
      { label: 'CoinGecko', href: 'https://www.coingecko.com/de' },
      { label: 'CoinMarketCap', href: 'https://coinmarketcap.com/de/' },
      { label: 'DEXTools', href: 'https://dextools.io/' },
      { label: 'DexScreener', href: 'https://dexscreener.com/' },
      { label: 'GeckoTerminal', href: 'https://www.geckoterminal.com/de' },
    ],
  },
  {
    title: 'Dezentrale Börsen (DEX) zum Swappen',
    links: [
      { label: 'DeFiLlama Swap', href: 'https://swap.defillama.com/' },
      { label: '1inch', href: 'https://1inch.io/' },
      { label: 'Odos', href: 'https://app.odos.xyz/' },
      { label: 'SushiSwap', href: 'https://app.sushi.com/' },
      { label: 'Uniswap', href: 'https://app.uniswap.org/' },
      { label: 'QuickSwap', href: 'https://quickswap.exchange/' },
    ],
  },
  {
    title: 'Bridges',
    note: 'Achtung: Multichain nicht mehr verwenden.',
    links: [
      { label: 'Bungee', href: 'https://www.bungee.exchange/', note: 'Nur schauen – sucht aus allen Bridges die beste Route.' },
      { label: 'Jumper', href: 'https://jumper.exchange/' },
      { label: 'Across', href: 'https://app.across.to/bridge' },
      { label: 'Portal Bridge', href: 'https://portalbridge.com/' },
      { label: 'Hop', href: 'https://app.hop.exchange/' },
      { label: 'Squid Router', href: 'https://app.squidrouter.com/' },
      { label: 'Stargate', href: 'https://stargate.finance/transfer' },
      { label: 'Connext', href: 'https://bridge.connext.network/' },
    ],
  },
  {
    title: 'LP / Staking',
    links: [
      { label: 'Grass Foundation', href: 'https://grassfoundation.io/stake' },
      { label: 'Infrared', href: 'https://infrared.finance/' },
      { label: 'Honey (Berachain)', href: 'https://honey.berachain.com/' },
      { label: 'Resolv', href: 'https://app.resolv.xyz/ref/web3universe2023', ref: true },
      { label: 'Aerodrome (Base)', href: 'https://aerodrome.finance/' },
      { label: 'ExtraFi', href: 'https://app.extrafi.io/farm' },
      { label: 'Velodrome', href: 'https://velodrome.finance/' },
      { label: 'Turtle Club', href: 'https://app.turtle.club/?ref=WEB32025', ref: true },
      { label: 'Turtle Club – Katana', href: 'https://app.turtle.club/campaigns/katana?ref=WEB32025', ref: true },
      { label: 'ether.fi', href: 'https://www.ether.fi/' },
      { label: 'Lido (Liquid Staking)', href: 'https://lido.fi/' },
      { label: 'Marinade (Solana Staking)', href: 'https://app.marinade.finance/manage/' },
    ],
  },
  {
    title: 'Lending',
    links: [
      { label: 'Aave', href: 'https://aave.com/' },
      { label: 'Compound', href: 'https://app.compound.finance/' },
    ],
  },
  {
    title: 'Futures- / Trading-Plattformen',
    note: 'Hebel-Trading ist hochriskant und für Einsteiger ungeeignet – ein Totalverlust ist jederzeit möglich.',
    risk: true,
    links: [
      { label: 'Hyperliquid (ARB)', href: 'https://app.hyperliquid.xyz/join/WEB3', ref: true, note: '4 % Feediscount mit Invite-Link.' },
      { label: 'dYdX (ETH)', href: 'https://dydx.exchange/' },
      { label: 'Paradex', href: 'https://app.paradex.trade/r/Web3Universe', ref: true },
      { label: 'Ostium', href: 'https://ostium.app/trade?from=SPX&to=USD&ref=1ETXS', ref: true },
      { label: 'Lighter', href: 'https://app.lighter.xyz/trade/ETH?referral=4QGSFQALMLGX', ref: true },
    ],
  },
  {
    title: 'Sicherheit: Freigaben widerrufen (Revoke)',
    note: 'Alte Token-Freigaben regelmäßig prüfen und entfernen.',
    links: [
      { label: 'Revoke.cash', href: 'https://revoke.cash/' },
      { label: 'Etherscan Token Approvals', href: 'https://etherscan.io/tokenapprovalchecker' },
    ],
  },
  {
    title: 'Weiteres',
    links: [
      { label: 'OpenSea (NFT-Marktplatz)', href: 'https://opensea.io/nft-world-official' },
      { label: 'web3universe – Track Record', href: 'https://web3universe.de/track-record' },
      { label: 'web3universe – Track Record (Bitbull)', href: 'https://web3universe.de/track-record-bitbull' },
    ],
  },
];

const securityRules = [
  {
    title: 'Keine FOMO – Ruhe bewahren',
    points: [
      'Fear of Missing Out ist einer deiner größten Gegner.',
      'Nimm dir Zeit und kontrolliere alles doppelt.',
      'Keine Transaktionen im Halbschlaf, nebenbei oder betrunken.',
    ],
  },
  {
    title: 'Links nur aus sicheren Quellen öffnen',
    points: [
      'Öffne Links möglichst nur über vertrauenswürdige Quellen wie DeFiLlama oder die offizielle Projektseite.',
      'Niemals über Links aus Twitter/X, Google-Anzeigen oder E-Mails.',
      'Im Zweifel: nachfragen und die Adresse manuell tippen statt klicken.',
    ],
  },
  {
    title: 'Wallet-Verbindungen genau prüfen',
    points: [
      'Kontrolliere immer: Woher kommt der Link? Ist es wirklich die offizielle Seite?',
      'Keine unbegrenzten Freigaben (Approvals) erteilen.',
      'Widerrufe regelmäßig alte Freigaben über revoke.cash.',
    ],
  },
  {
    title: 'Seed Phrase & Private Keys schützen',
    points: [
      'Gib deine Seed Phrase oder Private Keys niemals weiter.',
      'Nicht an Tools, Webseiten, Chat-DMs oder angebliche „Support“-Accounts.',
      'Offizielle Projekte schreiben dich niemals zuerst per DM an.',
    ],
  },
  {
    title: 'Social Engineering & Fake-DMs',
    points: [
      'Ignoriere DMs von unbekannten Accounts.',
      'Achte auf kopierte Logos, Fake-Namen und manipulierte Links.',
      'Prüfe alles doppelt, bevor du klickst.',
    ],
  },
  {
    title: 'Versteckte NFTs sind fast immer Scam',
    points: [
      'Interagiere nicht mit NFTs, die plötzlich in deiner Wallet auftauchen.',
      '99 % davon sind betrügerisch oder gefährlich.',
    ],
  },
  {
    title: 'Wallet- & Sicherheitsmanagement',
    points: [
      'Nutze getrennte Wallets: eine für langfristige Investments, eine für Airdrops und riskante Transaktionen.',
      'Hardware-Wallet für dein langfristiges HODL-Portfolio.',
      'Keine großen Bestände in Handy-Wallets – dort passieren die meisten Hacks.',
    ],
  },
  {
    title: 'Approvals = Risiko, auch mit Hardware-Wallet',
    points: [
      'Die meisten „Hacks“ sind falsche Freigaben – keine echten Hacks.',
      'Wenn du einen Scam-Contract freigibst, schützt auch eine Hardware-Wallet nicht mehr.',
    ],
  },
  {
    title: 'System aktuell halten & schützen',
    points: [
      'Halte Wallets, Apps und Betriebssystem immer auf dem neuesten Stand.',
      'Nutze Virenschutz und sichere dein System.',
      'Verwende ein eigenes Browser-Profil nur für DeFi – ohne unnötige Erweiterungen.',
    ],
  },
  {
    title: 'Immer Testtransaktionen machen',
    points: [
      'Vor jeder größeren Transaktion zuerst eine kleine Testüberweisung senden.',
    ],
  },
  {
    title: 'Backups erstellen & sicher aufbewahren',
    points: [
      'Seed Phrase offline sichern (Papier, Metall – niemals digital).',
      'Schutz gegen Feuer und Wasser, z. B. eine Stahlplatte.',
      'Lagerung an einem sicheren Ort wie Safe oder Tresor.',
    ],
  },
  {
    title: 'Ponzi-Systeme & Scam-Projekte erkennen',
    points: [
      'Unrealistische Renditeversprechen sind eine rote Flagge.',
      'Recherchiere gründlich, bevor du investierst.',
    ],
  },
];

const totalLinks = categories.reduce((sum, cat) => sum + cat.links.length, 0);
---

<BaseLayout
  title="Sichere Krypto-Links & Werkzeuge | callidus A&M"
  description="Kuratierte Sammlung geprüfter Krypto-Werkzeuge: Wallets, Block-Explorer, DEX, Bridges, Preis-Infos, Revoke-Tools und DeFi-Sicherheitsregeln."
  lang="de"
  ogImage="/assets/valus-coin.png"
>
  <article class="crypto-links">
    <section class="cl-hero" aria-labelledby="cl-title">
      <div class="cl-container">
        <p class="cl-eyebrow">Werkzeugkasten</p>
        <h1 id="cl-title">Sichere Krypto-Links &amp; Werkzeuge.</h1>
        <p class="cl-lead">
          Eine kuratierte Sammlung von {totalLinks} geprüften Werkzeugen rund um Wallets, Handel,
          Bridges, Kurse und Sicherheit. Speichere diese Seite als verlässliche Startrampe – so
          öffnest du wichtige Tools über eine bekannte Quelle statt über zufällige Suchtreffer.
        </p>
        <div class="cl-actions">
          <a class="cl-btn cl-btn-primary" href="#sicherheit">Zu den Sicherheitsregeln</a>
          <a class="cl-btn" href="/krypto-verstehen/">Krypto-Leitfaden</a>
          <a class="cl-btn" href="/krypto-training/">Krypto-Training</a>
        </div>

        <div class="cl-disclaimer" role="note">
          <strong>Bitte lesen:</strong> Dies sind externe Angebote von Drittanbietern, keine
          Empfehlung und keine Anlageberatung. Einige Links enthalten Referral-/Affiliate-Codes.
          Prüfe jede Adresse vor dem Verbinden deiner Wallet selbst. Krypto bleibt riskant –
          mehr dazu im <a href="/krypto-hinweis/">Krypto-Hinweis</a>.
        </div>
      </div>
    </section>

    <section class="cl-section" aria-label="Krypto-Werkzeuge nach Kategorie">
      <div class="cl-container cl-grid">
        {categories.map((cat) => (
          <article class={`cl-card${cat.risk ? ' cl-card-risk' : ''}`}>
            <h2>{cat.title}</h2>
            {cat.note && <p class="cl-card-note">{cat.note}</p>}
            <ul class="cl-linklist">
              {cat.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer nofollow">
                    <span class="cl-link-main">
                      <span class="cl-link-label">{link.label}</span>
                      {link.ref && <span class="cl-ref" title="Enthält einen Referral-Code">Ref</span>}
                    </span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
                  </a>
                  {link.note && <span class="cl-link-note">{link.note}</span>}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="cl-section cl-security" id="sicherheit" aria-labelledby="cl-security-title">
      <div class="cl-container">
        <div class="cl-section-head">
          <p class="cl-eyebrow">Security-Grundregeln</p>
          <h2 id="cl-security-title">So bleibst du sicher in der DeFi-Welt.</h2>
          <p>
            Die meisten Verluste entstehen nicht durch geniale Hacks, sondern durch Eile,
            unbedachte Freigaben und Social Engineering. Diese Regeln kosten dich Sekunden –
            und ersparen dir im Ernstfall alles.
          </p>
        </div>
        <div class="cl-rules-grid">
          {securityRules.map((rule, index) => (
            <article class="cl-rule">
              <span class="cl-rule-num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{rule.title}</h3>
              <ul>
                {rule.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cl-section cl-final">
      <div class="cl-container cl-final-panel">
        <div>
          <p class="cl-eyebrow">Nächster Schritt</p>
          <h2>Erst üben, dann echt handeln.</h2>
          <p>
            Wenn du den Ablauf noch nicht sicher beherrschst: Im interaktiven Krypto-Training
            klickst du Wallet, Kauf, Bridge und Überweisung einmal gefahrlos durch.
          </p>
        </div>
        <div class="cl-final-actions">
          <a class="cl-btn cl-btn-primary" href="/krypto-training/">Zum Krypto-Training</a>
          <a class="cl-btn" href="/krypto-verstehen/">Zum Krypto-Leitfaden</a>
        </div>
      </div>
    </section>
  </article>

  <style>
    .crypto-links {
      --cl-blue: #2f6f8f;
      --cl-blue-rgb: 47, 111, 143;
      --cl-orange: #b86436;
      --cl-orange-rgb: 184, 100, 54;
      --cl-green: var(--mint);
      --cl-green-rgb: 63, 127, 90;
      color: var(--text);
    }

    html[data-theme="dark"] .crypto-links {
      --cl-blue: #84d7ff;
      --cl-blue-rgb: 132, 215, 255;
      --cl-orange: #ff9a6f;
      --cl-orange-rgb: 255, 154, 111;
      --cl-green-rgb: 114, 242, 180;
    }

    .cl-container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .cl-hero {
      padding: 4rem 0 2.6rem;
      border-bottom: 1px solid var(--line);
      background:
        linear-gradient(120deg, rgba(var(--blue-rgb), .11), transparent 40%),
        linear-gradient(180deg, rgba(var(--gold-rgb), .10), transparent 60%);
    }

    .cl-section {
      padding: 3.4rem 0;
    }

    .cl-eyebrow {
      margin: 0 0 .8rem;
      color: var(--cl-blue);
      font-size: .78rem;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .crypto-links h1,
    .crypto-links h2 {
      margin: 0;
      line-height: 1.05;
    }

    .cl-hero h1 {
      max-width: 16ch;
      font-size: 3.6rem;
    }

    .cl-lead {
      max-width: 64ch;
      margin: 1.2rem 0 0;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.7;
    }

    .cl-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .7rem;
      margin-top: 1.6rem;
    }

    .cl-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: .7rem 1.15rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .06);
      color: var(--text);
      font-weight: 850;
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .cl-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(var(--blue-rgb), .44);
      background: rgba(var(--blue-rgb), .12);
    }

    .cl-btn:focus-visible {
      outline: 3px solid var(--cl-blue);
      outline-offset: 3px;
    }

    .cl-btn-primary {
      border-color: transparent;
      background: var(--cl-orange);
      color: #fffaf2;
      box-shadow: 0 14px 30px rgba(var(--cl-orange-rgb), .22);
    }

    .cl-btn-primary:hover {
      border-color: transparent;
      background: #9f542c;
      color: #fffaf2;
    }

    html[data-theme="dark"] .cl-btn-primary {
      color: #1d100a;
    }

    html[data-theme="dark"] .cl-btn-primary:hover {
      background: #ffab84;
      color: #1d100a;
    }

    .cl-disclaimer {
      max-width: 78ch;
      margin-top: 1.8rem;
      padding: .95rem 1.1rem;
      border: 1px solid rgba(var(--cl-orange-rgb), .35);
      border-radius: 8px;
      background: rgba(var(--cl-orange-rgb), .08);
      color: var(--muted);
      font-size: .92rem;
      line-height: 1.6;
    }

    .cl-disclaimer strong {
      color: var(--text);
    }

    .cl-disclaimer a,
    .cl-card-note a {
      color: var(--cl-blue);
      font-weight: 800;
    }

    .cl-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      align-items: start;
    }

    .cl-card {
      padding: 1.15rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
    }

    .cl-card-risk {
      border-color: rgba(var(--cl-orange-rgb), .4);
      background: rgba(var(--cl-orange-rgb), .05);
    }

    .cl-card h2 {
      font-size: 1.12rem;
      line-height: 1.25;
    }

    .cl-card-note {
      margin: .55rem 0 0;
      color: var(--muted);
      font-size: .85rem;
      line-height: 1.5;
    }

    .cl-card-risk .cl-card-note {
      color: var(--cl-orange);
      font-weight: 700;
    }

    .cl-linklist {
      display: grid;
      gap: .45rem;
      margin: .9rem 0 0;
      padding: 0;
      list-style: none;
    }

    .cl-linklist li {
      display: grid;
      gap: .2rem;
    }

    .cl-linklist a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .6rem;
      min-height: 44px;
      padding: .55rem .75rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(var(--blue-rgb), .04);
      color: var(--text);
      text-decoration: none;
      font-weight: 750;
      transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .cl-linklist a:hover {
      transform: translateY(-1px);
      border-color: rgba(var(--blue-rgb), .4);
      background: rgba(var(--blue-rgb), .1);
    }

    .cl-linklist a:focus-visible {
      outline: 3px solid var(--cl-blue);
      outline-offset: 2px;
    }

    .cl-link-main {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      min-width: 0;
    }

    .cl-link-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cl-ref {
      flex: 0 0 auto;
      padding: .1rem .4rem;
      border: 1px solid rgba(var(--cl-orange-rgb), .4);
      border-radius: 999px;
      background: rgba(var(--cl-orange-rgb), .12);
      color: var(--cl-orange);
      font-size: .64rem;
      font-weight: 900;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .cl-linklist svg {
      flex: 0 0 auto;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--cl-blue);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cl-link-note {
      padding: 0 .2rem;
      color: var(--muted);
      font-size: .78rem;
      line-height: 1.45;
    }

    /* Sicherheit */

    .cl-security {
      border-top: 1px solid var(--line);
      background:
        linear-gradient(135deg, rgba(var(--blue-rgb), .07), transparent 46%),
        rgba(var(--gold-rgb), .05);
    }

    .cl-section-head {
      max-width: 760px;
      margin-bottom: 2rem;
    }

    .cl-section-head h2 {
      max-width: 18ch;
      font-size: 2.5rem;
    }

    .cl-section-head p {
      margin: 1rem 0 0;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .cl-rules-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .cl-rule {
      position: relative;
      padding: 1.15rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
    }

    .cl-rule-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.1rem;
      height: 2.1rem;
      margin-bottom: .7rem;
      border-radius: 8px;
      background: rgba(var(--cl-green-rgb), .14);
      color: var(--cl-green);
      font-weight: 900;
      font-variant-numeric: tabular-nums;
    }

    .cl-rule h3 {
      margin: 0 0 .6rem;

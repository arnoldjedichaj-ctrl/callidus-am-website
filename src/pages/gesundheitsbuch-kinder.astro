---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Callis Gesundheits-Kompass | callidus A&M';
const description = 'MVP fuer Band 1 einer callidus A&M Kinderbuchserie: ein Vorlesebuch ueber Koerperzeichen, Schlaf, Essen, Bewegung, Gefuehle und kleine starke Gewohnheiten.';
const cover = '/assets/media/gesundheitskompass-kids-cover-concept.png';
const preview = '/assets/documents/gesundheitskompass-kids-mvp.html';
const imageCards = [
  {
    src: '/assets/media/gesundheitskompass-kids-sleep-spread-concept.png',
    alt: 'Kinderbuch-Illustration einer ruhigen Schlafwerkstatt',
    label: 'Schlaf',
    title: 'Die Nachtwerkstatt',
    text: 'Schlaf wird nicht als langweilige Pause erklaert, sondern als leise Werkstatt fuer Kopf, Koerper und Gefuehle.',
  },
  {
    src: '/assets/media/gesundheitskompass-kids-food-spread-concept.png',
    alt: 'Kinderbuch-Illustration mit buntem Teller und freundlicher Verdauungs-Metapher',
    label: 'Ernaehrung',
    title: 'Der bunte Teller',
    text: 'Essen wird ohne Scham und ohne Verbote erklaert: als Mischung aus Energie, Bausteinen und kleinen Alltagsentscheidungen.',
  },
];
const facts = [
  ['Band 1', 'Hoer auf deinen Koerper'],
  ['Umfang', '64 Seiten als Ziel fuer den Vollband'],
  ['Alter', 'Vorlesen ab 5, Amazon Reading Age 6-8'],
  ['Serie', 'Weitere Baende fuer aeltere Kinder geplant'],
  ['Website', 'eBook-Download als PDF/EPUB moeglich'],
];
---

<BaseLayout lang="de" title={title} description={description} ogImage={cover}>
  <section class="kids-book-hero" style={`--hero-image: url('${cover}')`}>
    <div class="kids-book-hero-inner" data-reveal>
      <p class="eyebrow">callidus A&M Kinderbuchserie</p>
      <h1>Callis Gesundheits-Kompass</h1>
      <p class="lede">
        Band 1 wird ein warmes Vorlesebuch fuer Eltern und Kinder:
        Koerperzeichen verstehen, lachen, hinhoeren und kleine starke Gewohnheiten finden.
      </p>
      <div class="actions">
        <a class="button primary icon-button" href={preview} download>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12"></path>
            <path d="m7 10 5 5 5-5"></path>
            <path d="M5 21h14"></path>
          </svg>
          MVP herunterladen
        </a>
        <a class="button icon-button" href={preview}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
          </svg>
          Vorschau ansehen
        </a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container kids-book-facts" data-reveal>
      {facts.map(([label, value]) => (
        <article>
          <span>{label}</span>
          <strong>{value}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container split kids-book-intro">
      <div data-reveal>
        <p class="eyebrow">Warum dieses Format</p>
        <h2>Ein Vorlesebuch, das Kinder nicht belehrt, sondern mitnimmt.</h2>
      </div>
      <div data-reveal="2">
        <p>
          Die empfohlene Vollversion hat 64 farbige Innenseiten. Dadurch koennen
          zusammengehoerige Themen in einem Kapitel bleiben: erst die Geschichte,
          dann das Koerperbild, dann eine kleine Mitmachfrage fuer die Familie.
        </p>
        <p>
          Statt ein einziges Buch fuer 5 bis 12 zu ueberladen, entsteht eine Serie.
          Band 1 ist fuer Eltern, die vorlesen. Spaetere Baende koennen aeltere
          Kinder mit mehr Fakten, Experimenten und Forscherseiten abholen.
        </p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow" data-reveal>Bildwelt</p>
      <h2 data-reveal="2">Warm, klar und kindgerecht.</h2>
      <div class="grid kids-book-gallery">
        {imageCards.map((item, index) => (
          <article class="card" data-reveal={String((index % 2) + 1)}>
            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            <div class="card-body">
              <span class="badge mint">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section kids-book-path">
    <div class="container split">
      <div class="sticky-note" data-reveal>
        <p class="eyebrow">Amazon & Download</p>
        <h2>Die beste Strategie: Website-eBook plus Amazon-Druck.</h2>
        <p>
          Das eBook kann auf callidus-am.de als Download laufen. Die Amazon-Version
          wird als Paperback angelegt und als Band 1 einer Serie gefuehrt. Bei
          Kindle Select waere Vorsicht noetig, weil dort das Kindle-eBook exklusiv
          bleiben muss.
        </p>
      </div>
      <div class="kids-book-steps" data-reveal="2">
        <article>
          <span>1</span>
          <div>
            <strong>MVP pruefen</strong>
            <p>Reihentitel, Bandtitel, Calli als Figur, Bildstil und Umfang bestaetigen.</p>
          </div>
        </article>
        <article>
          <span>2</span>
          <div>
            <strong>Vollmanuskript setzen</strong>
            <p>64-Seiten-Raster, thematische Kapitel, Mitmachseiten und Elternhinweise.</p>
          </div>
        </article>
        <article>
          <span>3</span>
          <div>
            <strong>KDP-Dateien bauen</strong>
            <p>Manuskript-PDF, Cover-PDF, Metadaten, AI-Hinweis und Druck-Proof.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    .kids-book-hero {
      min-height: min(56vh, 540px);
      display: grid;
      align-items: end;
      padding: clamp(3.8rem, 7vw, 5rem) clamp(1rem, 4vw, 3rem) clamp(1rem, 3vw, 1.6rem);
      color: #fffaf0;
      background:
        linear-gradient(90deg, rgba(16, 28, 21, .88), rgba(16, 28, 21, .42) 48%, rgba(16, 28, 21, .16)),
        var(--hero-image) center / cover;
    }

    .kids-book-hero-inner {
      width: min(1180px, 100%);
      margin: 0 auto;
    }

    .kids-book-hero h1 {
      max-width: 16ch;
      color: #fffaf0;
      font-size: clamp(2.45rem, 4.45vw, 4.1rem);
      text-shadow: 0 14px 48px rgba(0,0,0,.38);
    }

    .kids-book-hero .lede {
      max-width: 50ch;
      color: rgba(255,250,240,.9);
      font-size: clamp(1rem, 1.5vw, 1.16rem);
      line-height: 1.58;
      text-shadow: 0 8px 28px rgba(0,0,0,.36);
    }

    .kids-book-hero .actions {
      margin-top: 1rem;
    }

    .kids-book-hero .eyebrow {
      color: #f3d68b;
    }

    .icon-button {
      gap: .55rem;
      min-height: 3rem;
    }

    .icon-button svg {
      width: 1.1rem;
      height: 1.1rem;
      flex: 0 0 auto;
    }

    .kids-book-facts {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: .75rem;
      margin-top: -1rem;
    }

    .kids-book-facts article,
    .kids-book-steps article {
      border: 1px solid var(--line);
      border-radius: .75rem;
      background: var(--panel);
      box-shadow: 0 16px 42px rgba(58, 64, 38, .10);
    }

    .kids-book-facts article {
      display: grid;
      gap: .45rem;
      padding: 1rem;
      min-height: 7rem;
    }

    .kids-book-facts span,
    .kids-book-steps span {
      color: var(--gold);
      font-size: .72rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .1em;
    }

    .kids-book-facts strong {
      color: var(--text);
      line-height: 1.3;
    }

    .kids-book-intro p {
      font-size: 1.02rem;
    }

    .kids-book-gallery {
      margin-top: 1.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .kids-book-gallery .card img {
      aspect-ratio: 16 / 10;
      object-fit: cover;
    }

    .kids-book-steps {
      display: grid;
      gap: .8rem;
    }

    .kids-book-steps article {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: .8rem;
      align-items: start;
      padding: 1rem;
    }

    .kids-book-steps span {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: rgba(var(--mint-rgb), .11);
      color: var(--mint);
      letter-spacing: 0;
      font-size: 1rem;
    }

    .kids-book-steps strong {
      color: var(--text);
      font-size: 1.08rem;
    }

    .kids-book-steps p {
      margin: .25rem 0 0;
      line-height: 1.55;
    }

    @media (max-width: 900px) {
      .kids-book-facts,
      .kids-book-gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .kids-book-hero {
        min-height: 72vh;
        background:
          linear-gradient(180deg, rgba(16, 28, 21, .34), rgba(16, 28, 21, .9)),
          var(--hero-image) center / cover;
      }

      .kids-book-facts,
      .kids-book-gallery {
        grid-template-columns: 1fr;
      }

      .kids-book-steps article {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
// Buchseite „Heute mal nicht alles“ (Callidus A&M, KDP 2026).
// Das Buch druckt die Kurzadresse callidus-am.de/heute-mal-nicht-alles (Weiterleitung hierher)
// und verweist auf die Vordrucke. Pfad des PDFs nicht mehr ändern.
const asset = '/assets/books/heute-mal-nicht-alles';
const vordrucke = '/downloads/heute-mal-nicht-alles-vordrucke.pdf';
const atembegleiter = '/downloads/heute-mal-nicht-alles-atembegleiter.mp3';
const readingSample = `${asset}/leseprobe.pdf`;
// Sobald die Ausgaben bei Amazon live sind: Link auf /dp/<ASIN> setzen.
const amazonUrl = '';

const inside = [
  { title: '28 Tage mit kurzen Testläufen', text: 'Jeder Tag beginnt mit einer Alltagsszene und endet mit einer kleinen Übung: eine Minute, etwa fünf Minuten oder länger, wenn du Lust hast. Die Minute zählt voll.', accent: 'mint' },
  { title: '8 Werkzeuge, die in echte Tage passen', text: 'Orientieren, langes Ausatmen, Bewegungspausen, ein Abendübergang – und in Woche 3 das, was oft am meisten bringt: streichen, abgeben, konkret bitten.', accent: 'coral' },
  { title: '6 Mythen-Labore', text: 'Vagus-Reset, Eisbaden, Summen, Ohr-Clips, Smartwatch-Werte: Jedes Versprechen wird gegen Studien geprüft, mit getrennten Urteilen für Evidenz und Sicherheit.', accent: 'gold' },
  { title: 'Ehrlich, wo Belege fehlen', text: '37 Studien und Fachquellen, jede Aussage zugeordnet. Kein Heilversprechen, keine Diagnose. Und eine Pizza-Regel für die Tage, an denen gar nichts geht.', accent: 'mint' },
];
const downloads = [
  'Akuthilfe-Karte fürs Portemonnaie (zum Ausschneiden und Falten)',
  'Deine Startseite und der Vergleich nach vier Wochen',
  'Logbuch für Woche 1 bis 4',
  'Die Liste der Dinge, die heute nicht passieren',
  'Mein Plan für Mist-Tage',
  'Wochencheck und dein Plan auf einer halben Seite',
];
const people = [
  { name: 'Jana, 43', text: 'Projektleiterin, zwei Kinder, Elternchat mit 47 ungelesenen Nachrichten. Merkt die Anspannung erst, wenn sie die Brotdose zuklappt.' },
  { name: 'Birgit, 54', text: 'Pflegekraft im Schichtdienst, Galgenhumor, hört laute Gitarrenmusik im geparkten Auto. Ihre Mutter schickt Sprachnachrichten von knapp vier Minuten.' },
  { name: 'Selin, 36', text: 'Agentur, Smartwatch, misst ihren Schlaf jede Nacht. Probiert jeden Trend aus – und nimmt dich mit in die Mythen-Labore.' },
];
const editions = [
  { name: 'Taschenbuch', detail: '120 Seiten · 15,2 × 22,9 cm · Logbuch und Vordrucke zum Reinschreiben', price: '16,99 €' },
  { name: 'Kindle E-Book', detail: 'Farbige Abbildungen · Quellen verlinkt · Vordrucke hier zum Ausdrucken', price: '7,99 €' },
];
---
<BaseLayout
  lang="de"
  title="Heute mal nicht alles: Nervensystem regulieren | Callidus"
  description="Ein ehrliches 4-Wochen-Programm gegen Daueranspannung: etwa 10 Minuten am Tag, 8 alltagstaugliche Werkzeuge, 6 Mythen-Labore zu Vagus-Trends und kostenlose Vordrucke zum Ausdrucken."
  ogImage={`${asset}/og.jpg`}
>
  <section class="section">
    <div class="container hm-hero">
      <figure class="hm-cover" data-reveal>
        <img src={`${asset}/cover.jpg`} alt="Buchcover: Heute mal nicht alles – Nervensystem regulieren gegen Daueranspannung, etwa 10 Minuten am Tag, von Callidus" width="600" height="960" loading="eager" />
      </figure>
      <div>
        <p class="eyebrow" data-reveal>Neues Buch · Ratgeber</p>
        <h1 data-reveal="2">Heute mal nicht alles</h1>
        <p class="hm-sub" data-reveal="2">Nervensystem regulieren: Das ehrliche 4-Wochen-Programm gegen Daueranspannung</p>
        <p class="lede" data-reveal="3">
          Für alle, die abends noch an sind. Vier Wochen, acht kleine Werkzeuge, etwa zehn Minuten am Tag.
          Ohne Vagus-Reset, ohne Eisbad, ohne schlechtes Gewissen. Dafür mit drei Frauen, deren Dienstagabende
          dir bekannt vorkommen dürften, und mit ehrlichen Antworten darauf, was wirklich belegt ist.
        </p>
        <div class="actions" data-reveal="3">
          {amazonUrl
            ? <a class="button primary" href={amazonUrl} target="_blank" rel="noopener">Bei Amazon ansehen</a>
            : <a class="button primary" href="#vordrucke">Vordrucke herunterladen</a>}
          <a class="button" href={readingSample} target="_blank" rel="noopener">Kostenlose Leseprobe (PDF)</a>
        </div>
        <ul class="hm-facts" data-reveal="3">
          <li><strong>4</strong><span>Wochen</span></li>
          <li><strong>8</strong><span>Werkzeuge</span></li>
          <li><strong>~10</strong><span>Min. am Tag</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band" id="vordrucke">
    <div class="container hm-download">
      <div data-reveal>
        <p class="eyebrow">Kostenloser Download</p>
        <h2>Alle Vordrucke zum Ausdrucken</h2>
        <p>
          Für Leserinnen des Kindle-E-Books – und für alle, die lieber auf Papier am Küchentisch schreiben.
          Zehn Seiten A4, ohne Anmeldung:
        </p>
        <ul class="hm-list">
          {downloads.map((d) => <li>{d}</li>)}
        </ul>
        <div class="hm-audio" id="atembegleiter">
          <h3>Atembegleiter zum Anhören</h3>
          <p>
            Werkzeug ② „Langes Ausatmen“ aus Woche 1, mit ruhiger Stimme und leiser Hintergrundmusik. Etwa 10 Minuten.
            Die Stimme leitet dich an und zählt leise mit – als Angebot: Du musst weder mitzählen noch dem Takt folgen.
            Hör auf und atme normal weiter, wenn dir schwindelig wird, du schlechter Luft bekommst oder Angst aufkommt.
          </p>
          <audio controls preload="none" src={atembegleiter}>
            <a href={atembegleiter}>Atembegleiter (MP3) herunterladen</a>
          </audio>
          <a class="hm-audio-dl" href={atembegleiter} download>MP3 herunterladen (10 Min. · 13 MB)</a>
          <small>Die Stimme ist KI-generiert. Musik: „Deep Meditation“ von Grand_Project (Pixabay).</small>
        </div>
      </div>
      <div class="hm-download-card" data-reveal="2">
        <strong>heute-mal-nicht-alles-vordrucke.pdf</strong>
        <small>10 Seiten · A4 · PDF · 0,2 MB</small>
        <a class="button primary" href={vordrucke} download>Vordrucke kostenlos herunterladen</a>
        <small>Die Nummern auf der Akuthilfe-Karte gelten für Deutschland. Im Notfall: 112.</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Das steckt im Buch</p>
      <h2 data-reveal="2">Weniger Programm, mehr Alltag</h2>
      <div class="hm-grid">
        {inside.map((item, index) => (
          <article class={`hm-card ${item.accent}`} data-reveal={String((index % 3) + 1)}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow" data-reveal>Die Menschen im Buch</p>
      <h2 data-reveal="2">Jana, Birgit und Selin gibt es nicht. Ihre Dienstagabende schon.</h2>
      <div class="hm-grid">
        {people.map((p, index) => (
          <article class="hm-person" data-reveal={String(index + 1)}>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <blockquote class="hm-quote" data-reveal>
        „Ich ruf dich in zehn Minuten zurück“ ist ein vollständiger Satz.
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Ausgaben</p>
      <h2 data-reveal="2">Taschenbuch oder Kindle</h2>
      <div class="hm-editions">
        {editions.map((ed) => (
          <div class="hm-edition" data-reveal>
            <h3>{ed.name}</h3>
            <p>{ed.detail}</p>
            <span class="hm-price">{ed.price}</span>
          </div>
        ))}
      </div>
      <div class="actions" style="margin-top:1.2rem">
        {amazonUrl
          ? <a class="button primary" href={amazonUrl} target="_blank" rel="noopener">Bei Amazon ansehen</a>
          : <span class="button is-disabled" aria-disabled="true">Erscheint in Kürze bei Amazon</span>}
      </div>
      <p class="hm-note">Preise für Amazon.de, Taschenbuch inklusive Mehrwertsteuer.</p>
    </div>
  </section>

  <section class="section band">
    <div class="container hm-honest" data-reveal>
      <h2>Ehrlich, was dieses Buch ist</h2>
      <p>
        Dieses Buch bietet allgemeine Informationen zu Stress, Erholung und Alltagsorganisation. Es ersetzt keine
        medizinische oder psychotherapeutische Beratung, Diagnose oder Behandlung. Für das Programm als Ganzes gibt es
        keinen Wirksamkeitsnachweis; die einzelnen Aussagen sind mit Quellen belegt oder ausdrücklich als unklar
        markiert. Recherche, Text und Illustrationen entstanden mit Unterstützung von KI-Werkzeugen und wurden gegen die
        angegebenen Quellen geprüft. Eine fachliche Prüfung durch eine Ärztin oder Psychotherapeutin hat nicht
        stattgefunden. Wenn es dir akut schlecht geht: 112 oder TelefonSeelsorge 0800 111 0 111.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hm-hero { display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (max-width: 760px) { .hm-hero { grid-template-columns: 1fr; } .hm-cover { max-width: 240px; } }
  .hm-hero > *, .hm-download > *, .hm-grid > *, .hm-editions > * { min-width: 0; }
  .hm-hero .actions { flex-wrap: wrap; }
  .hm-cover { margin: 0; }
  .hm-cover img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 24px 60px rgba(30, 59, 51, 0.38); }
  .hm-sub { font-size: 1.15rem; font-weight: 700; margin: -0.3rem 0 0.8rem; color: var(--gold); }
  .hm-facts { display: flex; gap: 1.6rem; list-style: none; padding: 0; margin: 1.4rem 0 0; }
  .hm-facts li { display: grid; }
  .hm-facts strong { font-size: 1.8rem; line-height: 1; color: var(--mint); }
  .hm-facts span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .hm-download { display: grid; grid-template-columns: 1fr minmax(260px, 360px); gap: 1.5rem; align-items: center; }
  @media (max-width: 760px) { .hm-download { grid-template-columns: 1fr; } }
  .hm-list { margin: 0.4rem 0 0.8rem; padding-left: 1.2rem; }
  .hm-list li { margin-bottom: 0.25rem; }
  .hm-download-card { display: grid; gap: 0.5rem; padding: 1.4rem; border-radius: 12px; background: var(--bg-soft); border-top: 4px solid var(--gold); }
  .hm-download-card small { color: var(--muted); }
  .hm-download-card strong { word-break: break-all; }
  .hm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .hm-card { padding: 1.4rem; border-radius: 10px; background: var(--bg-soft); border-top: 4px solid var(--mint); }
  .hm-card.coral { border-top-color: var(--coral); }
  .hm-card.gold { border-top-color: var(--gold); }
  .hm-card h3, .hm-person h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
  .hm-card p, .hm-person p { margin: 0; }
  .hm-person { padding: 1.4rem; border-radius: 10px; background: #fff; border: 1px solid var(--line); }
  .hm-quote { margin: 1.6rem 0 0; padding: 1rem 1.2rem; border-left: 4px solid var(--gold); font-size: 1.15rem; font-style: italic; max-width: 720px; }
  .hm-editions { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .hm-edition { padding: 1.4rem; border-radius: 10px; background: var(--bg-soft); border: 1px solid var(--line); }
  .hm-edition h3 { margin: 0 0 0.4rem; }
  .hm-edition p { margin: 0 0 0.8rem; color: var(--muted); }
  .hm-price { font-size: 1.5rem; font-weight: 800; color: var(--mint); }
  .button.is-disabled { opacity: 0.6; cursor: default; pointer-events: none; }
  .hm-audio { margin-top: 1.4rem; padding: 1.2rem 1.4rem; border-radius: 12px; background: var(--bg-soft); border-left: 4px solid var(--mint); display: grid; gap: 0.6rem; }
  .hm-audio h3 { margin: 0; font-size: 1.05rem; }
  .hm-audio p { margin: 0; }
  .hm-audio audio { width: 100%; }
  .hm-audio-dl { font-weight: 700; }
  .hm-audio small { color: var(--muted); }
  .hm-note { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); max-width: 720px; }
  .hm-honest { max-width: 820px; }
  .hm-honest p { color: var(--muted); }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
// Deutsche Buchseite: „Krafttraining für Frauen ab 40“ (Callidus, KDP 2026).
// Der Pfad des kostenlosen Vorlagen-PDFs ist im Kindle-E-Book verlinkt – nicht verschieben.
const asset = '/assets/books/krafttraining-frauen-ab-40';
const companionPdf = '/downloads/krafttraining-frauen-ab-40-vorlagen.pdf';
const readingSample = `${asset}/leseprobe.pdf`;
// Amazon.de-Suche nach Titel, bis die deutsche Ausgabe eine ASIN hat.
const amazonUrl = 'https://www.amazon.de/s?k=Krafttraining+f%C3%BCr+Frauen+ab+40+Callidus';

const inside = [
  { title: '24 Einheiten, komplett ausgeschrieben', text: 'Jedes Training des 12-Wochen-Plans mit Übungen, Sätzen, Wiederholungen, Pausen und einer einfachen Regel, wann du mehr Gewicht nimmst.', accent: 'mint' },
  { title: '12 Übungen, je 3 Stufen', text: 'Jede Übung hat eine leichtere und eine schwerere Variante – du startest dort, wo du stehst, und wirst auch in Woche 12 noch gefordert.', accent: 'coral' },
  { title: 'Gemacht für echte Wochen', text: 'Was du nach einer verpassten Einheit, einer schlechten Nacht oder einer ganzen Woche Pause tust – ohne schlechtes Gewissen und ohne Nachholtraining.', accent: 'gold' },
  { title: 'Ernährung, die dein Training unterstützt', text: 'Fünf einfache Gewohnheiten nach DGE-Referenzwerten, sechs eiweißreiche Rezepte, drei Beispieltage und ein ehrlicher Blick auf Nahrungsergänzung.', accent: 'mint' },
];
const examples = [
  { src: `/assets/books/strength-training-women-over-40/ex-01C-chair-squat.jpg`, title: 'Stuhl-Kniebeuge', label: 'Kniebeuge' },
  { src: `/assets/books/strength-training-women-over-40/ex-03C-rdl.jpg`, title: 'Hüftbeuge mit Hanteln', label: 'Hüftbeuge' },
  { src: `/assets/books/strength-training-women-over-40/ex-08C-row.jpg`, title: 'Rudern mit Stuhlstütze', label: 'Ziehen' },
  { src: `/assets/books/strength-training-women-over-40/ex-07C-overhead-press.jpg`, title: 'Schulterdrücken im Sitzen', label: 'Drücken' },
];
const editions = [
  { name: 'Taschenbuch', detail: '143 Seiten · 17,8 × 25,4 cm · Trainingskarten zum Eintragen', price: '16,99 €' },
  { name: 'Kindle E-Book', detail: 'Farbige Abbildungen · Trainingstabellen fürs Handy', price: '6,99 €' },
];
---
<BaseLayout
  lang="de"
  alternatePath="/en/books/strength-training-women-over-40/"
  title="Krafttraining für Frauen ab 40: 12-Wochen-Hantelplan | Callidus"
  description="Ein klarer 12-Wochen-Hantelplan für Frauen ab 40: zwei Einheiten à etwa 30 Minuten pro Woche zu Hause, 12 illustrierte Übungen mit leichteren und schwereren Varianten, Rezepte und kostenlose Vorlagen zum Ausdrucken."
  ogImage={`${asset}/og.jpg`}
>
  <section class="section">
    <div class="container st-hero">
      <figure class="st-cover" data-reveal>
        <img src={`${asset}/cover.jpg`} alt="Buchcover: Krafttraining für Frauen ab 40 – Dein 12-Wochen-Hantelplan für zu Hause, von Callidus" width="600" height="857" loading="eager" />
      </figure>
      <div>
        <p class="eyebrow" data-reveal>Stark auf Dauer · Band 1</p>
        <h1 data-reveal="2">Krafttraining für Frauen ab 40</h1>
        <p class="st-sub" data-reveal="2">Dein 12-Wochen-Hantelplan für zu Hause</p>
        <p class="lede" data-reveal="3">
          Zwei Einheiten pro Woche à etwa 30 Minuten, zu Hause – mit zwei Hantelpaaren, einem Stuhl, einer Wand
          und deiner Küchenarbeitsplatte. Jede Einheit ist für dich ausgeschrieben: was du machst, wie viele
          Wiederholungen, wie lange Pause und woran du erkennst, dass du bereit für mehr Gewicht bist.
        </p>
        <div class="actions" data-reveal="3">
          <a class="button primary" href={amazonUrl} target="_blank" rel="noopener">Bei Amazon ansehen</a>
          <a class="button" href={readingSample} target="_blank" rel="noopener">Kostenlose Leseprobe (PDF)</a>
        </div>
        <ul class="st-facts" data-reveal="3">
          <li><strong>12</strong><span>Wochen</span></li>
          <li><strong>2×</strong><span>pro Woche</span></li>
          <li><strong>~30</strong><span>Minuten</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band" id="free-log">
    <div class="container st-download">
      <div data-reveal>
        <p class="eyebrow">Kostenloser Download</p>
        <h2>Trainingsprotokoll & Meilenstein-Checks zum Ausdrucken</h2>
        <p>
          Für Leserinnen des Kindle-E-Books – und für alle, die zusätzliche Seiten möchten: das komplette
          12-Wochen-Protokoll für Einheit A und B sowie die Meilenstein-Checks für Woche 0, 4 und 12.
          Zehn Seiten, fertig zum Ausdrucken. Ohne Anmeldung.
        </p>
      </div>
      <div class="st-download-card" data-reveal="2">
        <strong>krafttraining-frauen-ab-40-vorlagen.pdf</strong>
        <small>10 Seiten · PDF · 1,2 MB</small>
        <a class="button primary" href={companionPdf} download>Vorlagen kostenlos herunterladen</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Das steckt im Buch</p>
      <h2 data-reveal="2">Ein Plan, den du wirklich umsetzen kannst</h2>
      <div class="st-grid">
        {inside.map((item, index) => (
          <article class={`st-card ${item.accent}`} data-reveal={String((index % 3) + 1)}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow" data-reveal>Ein Blick auf die Übungen</p>
      <h2 data-reveal="2">Klare Abbildungen für jede Bewegung</h2>
      <div class="st-gallery">
        {examples.map((ex) => (
          <figure class="st-ex" data-reveal>
            <img src={ex.src} alt={`Abbildung: ${ex.title}, Start- und Endposition`} loading="lazy" />
            <figcaption><span>{ex.label}</span><strong>{ex.title}</strong></figcaption>
          </figure>
        ))}
      </div>
      <p class="st-note">Im Kindle-E-Book sind die Abbildungen farbig, das Taschenbuch ist schwarz-weiß gedruckt.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>Ausgaben</p>
      <h2 data-reveal="2">Taschenbuch oder Kindle</h2>
      <div class="st-editions">
        {editions.map((ed) => (
          <div class="st-edition" data-reveal>
            <h3>{ed.name}</h3>
            <p>{ed.detail}</p>
            <span class="st-price">{ed.price}</span>
          </div>
        ))}
      </div>
      <div class="actions" style="margin-top:1.2rem">
        <a class="button primary" href={amazonUrl} target="_blank" rel="noopener">Bei Amazon ansehen</a>
      </div>
      <p class="st-note">
        Preise für Amazon.de. Neue Titel erscheinen erst nach einigen Tagen in der Amazon-Suche.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container st-honest" data-reveal>
      <h2>Ehrlich, was dieses Buch ist</h2>
      <p>
        Dieses Buch bietet allgemeine Informationen zu Training und Ernährung. Es ist keine medizinische Beratung
        und kein persönlicher Trainingsplan. Wenn du eine Herzerkrankung, Osteoporose, eine frische Verletzung oder
        Operation oder eine andere Erkrankung hast, sprich vor dem Start mit deiner Ärztin oder deinem Arzt. Text und
        Abbildungen wurden mit KI-Unterstützung erstellt und mit veröffentlichten Leitlinien abgeglichen; sie wurden
        nicht von einer zertifizierten Trainerin oder Physiotherapeutin geprüft.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .st-hero { display: grid; grid-template-columns: minmax(200px, 340px) 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (max-width: 760px) { .st-hero { grid-template-columns: 1fr; } .st-cover { max-width: 260px; } }
  .st-hero > *, .st-download > *, .st-grid > *, .st-editions > * { min-width: 0; }
  .st-hero .actions { flex-wrap: wrap; }
  .st-cover img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 24px 60px rgba(15, 76, 92, 0.35); }
  .st-sub { font-size: 1.2rem; font-weight: 700; margin: -0.3rem 0 0.8rem; color: var(--coral); }
  .st-facts { display: flex; gap: 1.6rem; list-style: none; padding: 0; margin: 1.4rem 0 0; }
  .st-facts li { display: grid; }
  .st-facts strong { font-size: 1.8rem; line-height: 1; color: var(--mint); }
  .st-facts span { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .st-download { display: grid; grid-template-columns: 1fr minmax(260px, 360px); gap: 1.5rem; align-items: center; }
  @media (max-width: 760px) { .st-download { grid-template-columns: 1fr; } }
  .st-download-card { display: grid; gap: 0.5rem; padding: 1.4rem; border-radius: 12px; background: var(--bg-soft); border-top: 4px solid var(--mint); }
  .st-download-card small { color: var(--muted); }
  .st-download-card strong { word-break: break-all; }
  .st-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .st-card { padding: 1.4rem; border-radius: 10px; background: var(--bg-soft); border-top: 4px solid var(--mint); }
  .st-card.coral { border-top-color: var(--coral); }
  .st-card.gold { border-top-color: var(--gold); }
  .st-card h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
  .st-card p { margin: 0; }
  .st-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .st-ex { margin: 0; overflow: hidden; border-radius: 10px; background: #fff; border: 1px solid var(--line); }
  .st-ex img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: contain; background: #fff; }
  .st-ex figcaption { padding: 0.8rem 0.9rem; background: var(--bg-soft); }
  .st-ex span { display: block; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--gold); }
  .st-ex strong { color: var(--text); }
  .st-editions { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .st-edition { padding: 1.4rem; border-radius: 10px; background: var(--bg-soft); border: 1px solid var(--line); }
  .st-edition h3 { margin: 0 0 0.4rem; }
  .st-edition p { margin: 0 0 0.8rem; color: var(--muted); }
  .st-price { font-size: 1.5rem; font-weight: 800; color: var(--mint); }
  .st-note { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); max-width: 720px; }
  .st-honest { max-width: 820px; }
  .st-honest p { color: var(--muted); }
</style>

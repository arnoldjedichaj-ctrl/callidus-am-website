---
import BaseLayout from '../../layouts/BaseLayout.astro';
// callidus KIDS — Buchserie „Callis Gesundheits-Kompass". Band 1 & 2 erhältlich.
// Verkauf der PDF-eBooks über Digistore24. Digistore-Links unten je Band eintragen;
// solange leer, führt der Kauf-Button sicher zur kostenlosen Leseprobe.
const buecher = [
  {
    nr: 'Band 1', titel: 'Hör auf deinen Körper',
    text: 'Dein Körper redet den ganzen Tag — er knurrt, gähnt, zappelt und kribbelt. Calli zeigt Mira und Noah, wie sie ihre Körpersignale verstehen.',
    cover: '/assets/kinderbuch/cover-band1.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band1-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/709550',
    preis: '9,90 €', status: 'Erhältlich', accent: 'mint',
  },
  {
    nr: 'Band 2', titel: 'Das Zucker-Monster',
    text: 'Essen, Trinken & Energie — mit dem Regenbogen-Teller, der Gemüse-Bande und Schlecki, dem Zucker-Monster, das gar nicht böse ist. Ohne Verbote, mit viel Genuss.',
    cover: '/assets/kinderbuch/cover-band2.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band2-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/709996',
    preis: '9,90 €', status: 'Erhältlich', accent: 'coral',
  },
  {
    nr: 'Band 3', titel: 'Der Zappelmotor',
    text: 'Bewegung, Pausen & Gute-Laune-Funken — mit Flitz, dem Funken, der beim Toben sprüht. Warum Bewegung stark, wach und fröhlich macht, ganz ohne Wettkampf.',
    cover: '/assets/kinderbuch/cover-band3.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band3-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710152',
    preis: '9,90 €', status: 'Erhältlich', accent: 'gold',
  },
  {
    nr: 'Band 4', titel: 'Die Schlaf-Werkstatt',
    text: 'Schlaf, Träume & die innere Uhr — mit Nino, dem Nachtfreund. Was nachts im Körper passiert, warum ein Abendritual hilft und wie die Angst vor dem Bett verschwindet.',
    cover: '/assets/kinderbuch/cover-band4.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band4-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710833',
    preis: '9,90 €', status: 'Erhältlich', accent: 'blue',
  },
  {
    nr: 'Band 5', titel: 'Das Gefühls-Wetter',
    text: 'Gefühle, Mut & Hilfe holen — mit Wolki, der Gefühls-Wolke, die jedes Gefühl als Wetter zeigt. Alle Gefühle sind erlaubt, sie ziehen vorbei wie Wetter, und Hilfe holen ist stark.',
    cover: '/assets/kinderbuch/cover-band5.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band5-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710837',
    preis: '9,90 €', status: 'Erhältlich', accent: 'coral',
  },
  {
    nr: 'Band 6', titel: 'Die Abwehr-Polizei',
    text: 'Immunsystem, Hygiene & keine Angst vorm Doktor — mit Willi, dem Wächter, und seiner Abwehr-Polizei. Das große Serienfinale mit einem Wiedersehen aller Freunde aus Band 1 bis 5.',
    cover: '/assets/kinderbuch/cover-band6.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band6-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/711028',
    preis: '9,90 €', status: 'Neu erschienen', accent: 'mint',
  },
];
const kaufB2 = buecher[1].digistore || buecher[1].leseprobe;
const geplant = [];
const sceneImages = [
  { src: '/assets/media/kinderbuch-band6-scenes/web/b6-s01.jpg', title: 'Willi, der Wächter', label: 'Band 6' },
  { src: '/assets/media/kinderbuch-band5-scenes/web/b5-s01.jpg', title: 'Wolki, die Gefühls-Wolke', label: 'Band 5' },
  { src: '/assets/media/kinderbuch-band4-scenes/web/b4-s12-gute-nacht-geschichte.jpg', title: 'Die Gute-Nacht-Geschichte', label: 'Band 4' },
  { src: '/assets/media/kinderbuch-band3-scenes/web/b3-s09-frosch-baer.jpg', title: 'Die Tier-Olympiade', label: 'Band 3' },
  { src: '/assets/media/kinderbuch-band2-scenes/web/b2-s07-zucker-flummi.jpg', title: 'Schlecki, der Zucker-Flummi', label: 'Band 2' },
  { src: '/assets/media/kinderbuch-scenes/web/mvp-06-knurr-bauch-post.jpg', title: 'KNURR! Die Bauch-Post', label: 'Band 1' },
];
---
<BaseLayout
  title="Callis Gesundheits-Kompass — Kinderbuchserie | callidus A&M"
  description="Callis Gesundheits-Kompass: warme Vorlese-Bilderbücher für Kinder von 5 bis 8. Band 1 bis 5 (Körper, Ernährung, Bewegung, Schlaf, Gefühle) — jetzt erhältlich. Mit Aquarellbildern, Schlau-Seiten, Mitmach-Ideen und Urkunde."
  lang="de"
  ogImage="/assets/kinderbuch/cover-band4.jpg"
>
  <!-- HERO -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>callidus KIDS · Buchserie</p>
      <h1 data-reveal="2">Callis Gesundheits-Kompass</h1>
      <p class="lede" data-reveal="3">
        Warme, lustige Vorlese-Bilderbücher für Kinder von 5 bis 8. Calli, der kleine Kompass,
        nimmt Mira und Noah mit auf Entdeckungsreisen durch den eigenen Körper — mit Aquarellbildern
        auf jeder Seite, Schlau-Seiten, Mitmach-Ideen und Eltern-Impulsen. <strong>Band 1 bis 4
        sind jetzt erhältlich.</strong>
      </p>
    </div>
  </section>

  <!-- DIE BÜCHER -->
  <section class="section" id="buecher">
    <div class="container">
      <div class="kb-books" data-reveal>
        {buecher.map((b) => {
          const kauf = b.digistore || b.leseprobe;
          return (
            <article class={`kb-book ${b.accent}`}>
              <figure class="kb-book-cover">
                <img src={b.cover} alt={`Cover: Callis Gesundheits-Kompass, ${b.nr} – ${b.titel}`} width="360" height="576" loading="eager" />
              </figure>
              <div class="kb-book-body">
                <p class="kb-band-nr">{b.nr} · <em>{b.status}</em></p>
                <h2>{b.titel}</h2>
                <p>{b.text}</p>
                <div class="kb-buybar">
                  <span class="kb-price">{b.preis}</span>
                  <a class="button primary" href={kauf} rel="noopener">Jetzt kaufen</a>
                  <a class="button" href={b.leseprobe}>Leseprobe</a>
                </div>
                <p class="kb-buy-note">
                  {b.digistore ? 'Sichere Abwicklung & Download über Digistore24.' : 'Kauf-Link folgt in Kürze — jetzt schon reinlesen.'}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- WAS DIE BÜCHER BESONDERS MACHT -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>So funktionieren die Bücher</p>
      <h2 data-reveal="2">Zuhören, lachen, mitmachen.</h2>
      <div class="kb-grid" data-reveal="3">
        <article class="kb-card mint"><h3>Vorlese-Geschichte</h3><p>Mira, Noah und Calli erleben kurze Abenteuer — perfekt für den Abend, in warmen Aquarellbildern.</p></article>
        <article class="kb-card blue"><h3>Callis Schlau-Seiten</h3><p>Kleine Staun-Fakten für neugierige Köpfe, kindgerecht und ohne erhobenen Zeigefinger.</p></article>
        <article class="kb-card gold"><h3>Mach-mit-Ideen</h3><p>Kleine Missionen für die ganze Familie — vom Körper-Radio bis zur Regenbogen-Jagd.</p></article>
        <article class="kb-card coral"><h3>Eltern-Impulse &amp; Urkunde</h3><p>Sanfte Tipps für Eltern auf eigenen Seiten — und am Ende die Urkunde zum Ausschneiden.</p></article>
      </div>
    </div>
  </section>

  <!-- EINBLICK -->
  <section class="section" id="einblick">
    <div class="container">
      <p class="eyebrow" data-reveal>Ein Blick in die Bücher</p>
      <h2 data-reveal="2">Warme Aquarellbilder auf jeder Seite.</h2>
      <div class="kb-scene-gallery" data-reveal="3">
        {sceneImages.map((scene) => (
          <article class="kb-scene-card">
            <img src={scene.src} alt={`Illustration: ${scene.title}`} loading="lazy" decoding="async" />
            <div><span>{scene.label}</span><strong>{scene.title}</strong></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DIE SERIE -->
  <section class="section" id="serie">
    <div class="container">
      <p class="eyebrow" data-reveal>Die Serie</p>
      <h2 data-reveal="2">Sechs Bände. Ein Kompass.</h2>
      <p class="lede" data-reveal="3">Jedes Thema bekommt seinen eigenen Band — dem callidus-Gesundheits-Kompass folgend, vom Körper bis zur Seele. Die Reihe ist vollständig: Alle sechs Bände sind jetzt erhältlich.</p>
      {geplant.length > 0 && (
        <div class="kb-grid" data-reveal="4">
          {geplant.map((band) => (
            <article class={`kb-card ${band.accent}`}>
              <p class="kb-band-nr">{band.nr} · <em>Geplant</em></p>
              <h3>{band.titel}</h3>
              <p>{band.text}</p>
            </article>
          ))}
        </div>
      )}
      <p class="kb-note" data-reveal="4">Diese Bücher vermitteln allgemeines Gesundheitswissen für Familien und ersetzen keine ärztliche Beratung, Diagnose oder Behandlung. Die Illustrationen sind digitale, KI-gestützt erstellte und redaktionell überarbeitete Aquarellbilder.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .kb-books { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; margin-top: 1rem; }
  @media (max-width: 820px) { .kb-books { grid-template-columns: 1fr; } }
  .kb-book { display: grid; grid-template-columns: minmax(140px, 200px) 1fr; gap: 1.4rem; padding: 1.4rem; border-radius: 12px; background: var(--bg-soft); border-top: 4px solid var(--mint); }
  .kb-book.coral { border-top-color: var(--coral); }
  .kb-book.gold { border-top-color: var(--gold); }
  .kb-book.blue { border-top-color: var(--blue); }
  @media (max-width: 520px) { .kb-book { grid-template-columns: 1fr; } }
  .kb-book-cover img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 14px 36px rgba(var(--mint-rgb), 0.25); }
  .kb-book-body h2 { margin: 0.1rem 0 0.5rem; font-size: 1.5rem; }
  .kb-band-nr { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gold); margin: 0 0 0.2rem; }
  .kb-buybar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin-top: 1rem; }
  .kb-price { font-size: 1.5rem; font-weight: 800; color: var(--mint); margin-right: 0.2rem; }
  .kb-buy-note { margin-top: 0.5rem; font-size: 0.8rem; opacity: 0.7; }
  .kb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .kb-card { border-radius: 8px; padding: 1.4rem; background: var(--bg-soft); border-top: 4px solid var(--mint); }
  .kb-card.coral { border-top-color: var(--coral); }
  .kb-card.blue { border-top-color: var(--blue); }
  .kb-card.gold { border-top-color: var(--gold); }
  .kb-card h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
  .kb-card p { margin: 0 0 0.4rem; }
  .kb-scene-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .kb-scene-card { overflow: hidden; border-radius: 8px; background: var(--bg-soft); border: 1px solid rgba(var(--mint-rgb), 0.16); box-shadow: 0 18px 42px rgba(var(--mint-rgb), 0.12); }
  .kb-scene-card img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: center 36%; }
  .kb-scene-card div { padding: 0.9rem; }
  .kb-scene-card span { display: block; margin-bottom: 0.25rem; color: var(--gold); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
  .kb-scene-card strong { display: block; color: var(--text); line-height: 1.25; }
  .kb-note { margin-top: 1.4rem; font-size: 0.85rem; opacity: 0.75; max-width: 720px; }
</style>

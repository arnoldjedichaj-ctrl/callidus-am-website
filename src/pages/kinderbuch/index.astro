---
import BaseLayout from '../../layouts/BaseLayout.astro';
// callidus KIDS — Buchserie „Callis Gesundheits-Kompass". Band 1 & 2 erhältlich.
// Verkauf der PDF-eBooks über Digistore24. Digistore-Links unten je Band eintragen;
// solange leer, führt der Kauf-Button sicher zur kostenlosen Leseprobe.
const buecher = [
  {
    id: 'band1',
    nr: 'Band 1', titel: 'Hör auf deinen Körper',
    text: 'Dein Körper redet den ganzen Tag — er knurrt, gähnt, zappelt und kribbelt. Calli zeigt Mira und Noah, wie sie ihre Körpersignale verstehen.',
    cover: '/assets/kinderbuch/cover-band1.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band1-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/709550',
    amazon: 'https://amzn.to/4vme60t',
    preis: '9,90 €', preisCents: 990, status: 'Erhältlich', accent: 'mint',
  },
  {
    id: 'band2',
    nr: 'Band 2', titel: 'Das Zucker-Monster',
    text: 'Essen, Trinken & Energie — mit dem Regenbogen-Teller, der Gemüse-Bande und Schlecki, dem Zucker-Monster, das gar nicht böse ist. Ohne Verbote, mit viel Genuss.',
    cover: '/assets/kinderbuch/cover-band2.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band2-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/709996',
    amazon: 'https://amzn.to/4gSazU7',
    preis: '9,90 €', preisCents: 990, status: 'Erhältlich', accent: 'coral',
  },
  {
    id: 'band3',
    nr: 'Band 3', titel: 'Der Zappelmotor',
    text: 'Bewegung, Pausen & Gute-Laune-Funken — mit Flitz, dem Funken, der beim Toben sprüht. Warum Bewegung stark, wach und fröhlich macht, ganz ohne Wettkampf.',
    cover: '/assets/kinderbuch/cover-band3.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band3-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710152',
    amazon: 'https://amzn.to/3R4vrwP',
    preis: '9,90 €', preisCents: 990, status: 'Erhältlich', accent: 'gold',
  },
  {
    id: 'band4',
    nr: 'Band 4', titel: 'Die Schlaf-Werkstatt',
    text: 'Schlaf, Träume & die innere Uhr — mit Nino, dem Nachtfreund. Was nachts im Körper passiert, warum ein Abendritual hilft und wie die Angst vor dem Bett verschwindet.',
    cover: '/assets/kinderbuch/cover-band4.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band4-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710833',
    amazon: 'https://amzn.to/4vXOGHj',
    preis: '9,90 €', preisCents: 990, status: 'Erhältlich', accent: 'blue',
  },
  {
    id: 'band5',
    nr: 'Band 5', titel: 'Das Gefühls-Wetter',
    text: 'Gefühle, Mut & Hilfe holen — mit Wolki, der Gefühls-Wolke, die jedes Gefühl als Wetter zeigt. Alle Gefühle sind erlaubt, sie ziehen vorbei wie Wetter, und Hilfe holen ist stark.',
    cover: '/assets/kinderbuch/cover-band5.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band5-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/710837',
    amazon: 'https://amzn.to/4h8GNdD',
    preis: '9,90 €', preisCents: 990, status: 'Erhältlich', accent: 'coral',
  },
  {
    id: 'band6',
    nr: 'Band 6', titel: 'Die Abwehr-Polizei',
    text: 'Immunsystem, Hygiene & keine Angst vorm Doktor — mit Willi, dem Wächter, und seiner Abwehr-Polizei. Das große Serienfinale mit einem Wiedersehen aller Freunde aus Band 1 bis 5.',
    cover: '/assets/kinderbuch/cover-band6.jpg',
    leseprobe: '/assets/kinderbuch/callis-kompass-band6-leseprobe.html',
    digistore: 'https://www.digistore24.com/product/711028',
    amazon: 'https://amzn.to/4vuBVmN',
    preis: '9,90 €', preisCents: 990, status: 'Neu erschienen', accent: 'mint',
  },
];
const kaufB2 = buecher[1].digistore || buecher[1].leseprobe;
const geplant = [];
const sceneImages = [
  { src: '/assets/media/kinderbuch-band6-scenes/web/b6-s01.jpg', title: 'Willi, der Wächter', label: 'Band 6' },
  { src: '/assets/media/kinderbuch-band5-scenes/web/b5-s01.jpg', title: 'Wolki, die Gefühls-Wolke', label: 'Band 5' },
  { src: '/assets/media/kinderbuch-band4-scenes/web/b4-s12-gute-nacht-geschichte.jpg', title: 'Die Gute-Nacht-Geschichte', label: 'Band 4' },
  { src: '/assets/media/kinderbuch-band3-scenes/web/b3-s09-frosch-baer.jpg', title: 'Die Tier-Olympiade', label: 'Band 3' },
  { src: '/assets/media/kinderbuch-band2-scenes/web/b2-s07-zucker-flummi.jpg', title: 'Schlecki, der Zucker-Flummi', label: 'Band 2' },
  { src: '/assets/media/kinderbuch-scenes/web/mvp-06-knurr-bauch-post.jpg', title: 'KNURR! Die Bauch-Post', label: 'Band 1' },
];
const ausmalbilder = [
  { band: 'Band 1', titel: 'Der knurrende Bauch', file: '/assets/kinderbuch/ausmalbilder/blatt-band1-bauch-post.png', accent: 'mint' },
  { band: 'Band 2', titel: 'Schlecki, das Zucker-Monster', file: '/assets/kinderbuch/ausmalbilder/blatt-band2-zucker-monster.png', accent: 'coral' },
  { band: 'Band 3', titel: 'Der Zappelmotor', file: '/assets/kinderbuch/ausmalbilder/blatt-band3-zappelmotor.png', accent: 'gold' },
  { band: 'Band 4', titel: 'Gute Nacht, Noah!', file: '/assets/kinderbuch/ausmalbilder/blatt-band4-schlaf-batterie.png', accent: 'blue' },
  { band: 'Band 5', titel: 'Wolki, die Gefühls-Wolke', file: '/assets/kinderbuch/ausmalbilder/blatt-band5-gefuehls-wolke.png', accent: 'coral' },
  { band: 'Band 6', titel: 'Die Abwehr-Polizei', file: '/assets/kinderbuch/ausmalbilder/blatt-band6-abwehr-polizei.png', accent: 'mint' },
  { band: 'Extra', titel: 'Das sind Mira & Noah', file: '/assets/kinderbuch/ausmalbilder/blatt-mira-und-noah.png', accent: 'gold' },
];
const redemptionBooks = buecher.map((buch) => ({
  id: buch.id,
  nr: buch.nr,
  titel: buch.titel,
  preis: buch.preis,
  preisCents: buch.preisCents,
  digistore: buch.digistore,
}));
---
<BaseLayout
  title="Callis Gesundheits-Kompass — Kinderbuchserie | callidus A&M"
  description="Callis Gesundheits-Kompass: warme Vorlese-Bilderbücher für Kinder von 5 bis 8. Band 1 bis 6 (Körper, Ernährung, Bewegung, Schlaf, Gefühle, Immunsystem) — jetzt erhältlich. Mit Aquarellbildern, Schlau-Seiten, Mitmach-Ideen und Urkunde."
  lang="de"
  ogImage="/assets/kinderbuch/cover-band4.jpg"
>
  <!-- HERO -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>callidus KIDS · Buchserie</p>
      <h1 data-reveal="2">Callis Gesundheits-Kompass</h1>
      <p class="lede" data-reveal="3">
        Warme, lustige Vorlese-Bilderbücher für Kinder von 5 bis 8. Calli, der kleine Kompass,
        nimmt Mira und Noah mit auf Entdeckungsreisen durch den eigenen Körper — mit Aquarellbildern
        auf jeder Seite, Schlau-Seiten, Mitmach-Ideen und Eltern-Impulsen. <strong>Band 1 bis 6
        sind jetzt erhältlich.</strong>
      </p>
    </div>
  </section>

  <!-- XP / VAL EINLOESUNG -->
  <section class="section" id="xp-einloesung">
    <div class="container">
      <div class="kb-redemption-panel" data-kb-redemption data-reveal>
        <div class="kb-redemption-copy">
          <p class="eyebrow">VAL einlösen</p>
          <h2>VAL-Guthaben für Kinderbücher verwenden.</h2>
          <p>
            Dein <strong>VAL-Guthaben</strong> kannst du als Rabattwert für alle sechs PDF-Kinderbücher einsetzen
            (<strong>1 VAL = 1,00 €</strong>). Du kannst einen Band vollständig oder nur teilweise einlösen und den
            Rest normal über Digistore24 bezahlen. App-XP wandelst du vorher selbst auf der
            <a href="/valus/">VAL-Seite</a> in VAL um – so entscheidest du, wie viel XP du einsetzt.
          </p>
        </div>

        <div class="kb-redemption-app">
          <div id="kb-redeem-loading" class="kb-redeem-state">
            <strong>Guthaben wird geprüft...</strong>
            <small>Wenn du bereits im Portal angemeldet bist, erscheint dein XP-/VAL-Stand automatisch.</small>
          </div>

          <div id="kb-redeem-auth" class="kb-redeem-state" hidden>
            <strong>Anmelden, dann einlösen</strong>
            <small>Deine XP und VAL werden sicher über dein Callidus-Konto geladen.</small>
            <a class="button primary" href="/portal/">Zum Portal-Login</a>
          </div>

          <div id="kb-redeem-dashboard" hidden>
            <div class="kb-wallet-row">
              <div>
                <span>XP</span>
                <strong id="kb-xp-balance">-</strong>
              </div>
              <div>
                <span>VAL</span>
                <strong id="kb-val-balance">-</strong>
              </div>
              <div>
                <span>Einlösbar</span>
                <strong id="kb-credit-balance">-</strong>
              </div>
            </div>

            <form class="kb-redemption-form" id="kb-redemption-form">
              <label for="kb-redemption-book">Buch auswählen</label>
              <select id="kb-redemption-book">
                {buecher.map((buch) => (
                  <option value={buch.id}>{buch.nr} · {buch.titel}</option>
                ))}
              </select>

              <label for="kb-redemption-euro">Rabattwert einsetzen</label>
              <div class="kb-redemption-input-row">
                <input id="kb-redemption-euro" type="number" min="0.10" max="9.90" step="0.10" value="9.90" />
                <button class="button" type="button" id="kb-redemption-full">Maximal</button>
              </div>

              <div class="kb-redemption-preview" id="kb-redemption-preview">
                9,90 € Rabatt = 99000 XP · Restbetrag 0,00 €
              </div>

              <button class="button primary" type="submit" id="kb-redemption-submit">Einlösecode erstellen</button>
              <p class="kb-redemption-status" id="kb-redemption-status" hidden></p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIE BÜCHER -->
  <section class="section" id="buecher">
    <div class="container">
      <div class="kb-books" data-reveal>
        {buecher.map((b) => {
          const kauf = b.digistore || b.leseprobe;
          return (
            <article class={`kb-book ${b.accent}`}>
              <figure class="kb-book-cover">
                <img src={b.cover} alt={`Cover: Callis Gesundheits-Kompass, ${b.nr} – ${b.titel}`} width="360" height="576" loading="eager" />
              </figure>
              <div class="kb-book-body">
                <p class="kb-band-nr">{b.nr} · <em>{b.status}</em></p>
                <h2>{b.titel}</h2>
                <p>{b.text}</p>
                <div class="kb-buybar">
                  <span class="kb-price">{b.preis}</span>
                  <a class="button primary" href={kauf} rel="noopener">Jetzt kaufen</a>
                  <button class="button kb-redeem-open" type="button" data-book-id={b.id}>XP/VAL einlösen</button>
                  {b.amazon && (
                    <a class="button" href={b.amazon} target="_blank" rel="sponsored noopener">Taschenbuch bei Amazon</a>
                  )}
                  <a class="button" href={b.leseprobe}>Leseprobe</a>
                </div>
                <p class="kb-buy-note">
                  {b.digistore ? 'PDF-Download: sichere Abwicklung über Digistore24.' : 'Kauf-Link folgt in Kürze — jetzt schon reinlesen.'}
                  {b.amazon && ' Taschenbuch bei Amazon (Partner-/Affiliate-Link).'}
                </p>
              </div>
            </article>
          );
        })}
      </div>
      <p class="kb-note" data-reveal>Als Amazon-Partner verdient callidus A&amp;M an qualifizierten Verkäufen. Die „Taschenbuch bei Amazon"-Links sind Partner-/Affiliate-Links — für dich entstehen dabei keine Mehrkosten.</p>
    </div>
  </section>

  <!-- HOERGESCHICHTE BAND 4 -->
  <section class="section" id="hoergeschichte">
    <div class="container">
      <div class="kb-audio-feature blue" data-reveal>
        <img
          src="/assets/media/kinderbuch-band4-scenes/web/b4-s12-gute-nacht-geschichte.jpg"
          alt="Noah liegt mit Nino, dem Nachtfreund, in seinem gemütlichen Zimmer"
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
        <div class="kb-audio-copy">
          <p class="eyebrow">Gratis Hörgeschichte zu Band 4</p>
          <h2>Noahs Schlaf-Akku</h2>
          <p>
            Noah möchte seinen Bauklotzturm unbedingt noch fertig bauen. Doch sein Kopf fährt schon im Kreis.
            Mit Mira, Calli und Nino findet er einen guten Parkplatz für seine Idee und entdeckt, wie sein
            Schlaf-Akku neue Kraft für morgen sammelt.
          </p>
          <p class="kb-audio-meta">Etwa 5 Minuten · Für Kinder ab 5 Jahren</p>
          <audio class="kb-audio-player" controls preload="metadata">
            <source src="/audio/kinderbuch/noahs-schlaf-akku.mp3" type="audio/mpeg" />
            Dein Browser kann diese Hörgeschichte leider nicht abspielen.
          </audio>
          <p class="kb-audio-note">Die Stimmen von Noah, Mira, Calli und Nino sind synthetisch erzeugte Stimmen für diese fiktiven Figuren.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WAS DIE BÜCHER BESONDERS MACHT -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>So funktionieren die Bücher</p>
      <h2 data-reveal="2">Zuhören, lachen, mitmachen.</h2>
      <div class="kb-grid" data-reveal="3">
        <article class="kb-card mint"><h3>Vorlese-Geschichte</h3><p>Mira, Noah und Calli erleben kurze Abenteuer — perfekt für den Abend, in warmen Aquarellbildern.</p></article>
        <article class="kb-card blue"><h3>Callis Schlau-Seiten</h3><p>Kleine Staun-Fakten für neugierige Köpfe, kindgerecht und ohne erhobenen Zeigefinger.</p></article>
        <article class="kb-card gold"><h3>Mach-mit-Ideen</h3><p>Kleine Missionen für die ganze Familie — vom Körper-Radio bis zur Regenbogen-Jagd.</p></article>
        <article class="kb-card coral"><h3>Eltern-Impulse &amp; Urkunde</h3><p>Sanfte Tipps für Eltern auf eigenen Seiten — und am Ende die Urkunde zum Ausschneiden.</p></article>
      </div>
    </div>
  </section>

  <!-- EINBLICK -->
  <section class="section" id="einblick">
    <div class="container">
      <p class="eyebrow" data-reveal>Ein Blick in die Bücher</p>
      <h2 data-reveal="2">Warme Aquarellbilder auf jeder Seite.</h2>
      <div class="kb-scene-gallery" data-reveal="3">
        {sceneImages.map((scene) => (
          <article class="kb-scene-card">
            <img src={scene.src} alt={`Illustration: ${scene.title}`} loading="lazy" decoding="async" />
            <div><span>{scene.label}</span><strong>{scene.title}</strong></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AUSMALBILDER -->
  <section class="section" id="ausmalbilder">
    <div class="container">
      <p class="eyebrow" data-reveal>Gratis zum Ausdrucken</p>
      <h2 data-reveal="2">Ausmalbilder zu jedem Band.</h2>
      <p class="lede" data-reveal="3">
        Zu jedem der sechs Bände gibt es ein Ausmalbild mit Mira, Noah und Callis Freunden — als
        druckfertiges DIN-A4-Blatt (PDF-taugliches PNG). Einfach herunterladen, ausdrucken und los.
      </p>
      <div class="kb-ausmal-gallery" data-reveal="3">
        {ausmalbilder.map((blatt) => (
          <article class={`kb-ausmal-card ${blatt.accent}`}>
            <a href={blatt.file} download class="kb-ausmal-thumb">
              <img src={blatt.file} alt={`Ausmalbild: ${blatt.titel} (${blatt.band})`} loading="lazy" decoding="async" width="248" height="350" />
            </a>
            <div class="kb-ausmal-body">
              <span>{blatt.band}</span>
              <strong>{blatt.titel}</strong>
              <a class="button primary" href={blatt.file} download>Herunterladen</a>
            </div>
          </article>
        ))}
      </div>
      <p class="kb-note" data-reveal>Nur zum privaten Gebrauch. Die Ausmalbilder sind digital, KI-gestützt erstellt und redaktionell überarbeitet.</p>
    </div>
  </section>

  <!-- DIE SERIE -->
  <section class="section" id="serie">
    <div class="container">
      <p class="eyebrow" data-reveal>Die Serie</p>
      <h2 data-reveal="2">Sechs Bände. Ein Kompass.</h2>
      <p class="lede" data-reveal="3">Jedes Thema bekommt seinen eigenen Band — dem callidus-Gesundheits-Kompass folgend, vom Körper bis zur Seele. Die Reihe ist vollständig: Alle sechs Bände sind jetzt erhältlich.</p>
      {geplant.length > 0 && (
        <div class="kb-grid" data-reveal="4">
          {geplant.map((band) => (
            <article class={`kb-card ${band.accent}`}>
              <p class="kb-band-nr">{band.nr} · <em>Geplant</em></p>
              <h3>{band.titel}</h3>
              <p>{band.text}</p>
            </article>
          ))}
        </div>
      )}
      <p class="kb-note" data-reveal="4">Diese Bücher vermitteln allgemeines Gesundheitswissen für Familien und ersetzen keine ärztliche Beratung, Diagnose oder Behandlung. Die Illustrationen sind digitale, KI-gestützt erstellte und redaktionell überarbeitete Aquarellbilder.</p>
    </div>
  </section>
  <script id="kb-book-data" type="application/json" set:html={JSON.stringify(redemptionBooks)}></script>
  <script>
    import { onAuthStateChanged } from 'firebase/auth';
    import { doc, getDoc } from 'firebase/firestore';
    import { auth, db, getValusBalance, createKinderbuchRedemption } from '../../lib/firebase-client.js';

    (() => {
      const XP_PER_CENT = 100;
      const CENTS_PER_EURO = 100;
      const books = JSON.parse(document.getElementById('kb-book-data')?.textContent || '[]');
      const root = document.querySelector('[data-kb-redemption]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const state = {
        user: null,
        balance: { xp: 0, valus: 0 },
      };

      const $ = (id) => document.getElementById(id);
      const formatInt = (value) => new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 }).format(Number(value) || 0);
      const formatEuro = (cents) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format((Number(cents) || 0) / CENTS_PER_EURO);
      const bookById = (id) => books.find((book) => book.id === id) || books[0];
      const creditCents = () => Math.floor((Number(state.balance.valus) || 0) * CENTS_PER_EURO);
      const show = (id) => {
        ['kb-redeem-loading', 'kb-redeem-auth', 'kb-redeem-dashboard'].forEach((viewId) => {
          const el = $(viewId);
          if (el) el.hidden = viewId !== id;
        });
      };
      const setStatus = (message, kind = '') => {
        const el = $('kb-redemption-status');
        if (!el) return;
        el.textContent = message || '';
        el.hidden = !message;
        el.dataset.state = kind;
      };

      function normalizeBalance(payload = {}) {
        const raw = payload.balance || payload.balances || payload;
        const user = payload.user || payload.userDoc || {};
        const valus = Math.max(0, Number(raw.valus ?? raw.val ?? user.valus ?? user.val ?? user.valus_balance ?? 0) || 0);
        const xp = Math.max(0, Number(raw.xp ?? raw.current_xp ?? raw.total_xp ?? user.current_xp ?? user.total_xp ?? 0) || 0);
        return { valus, xp };
      }

      function updateBalanceView() {
        $('kb-xp-balance').textContent = `${formatInt(state.balance.xp)} XP`;
        $('kb-val-balance').textContent = `${new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(state.balance.valus)} VAL`;
        $('kb-credit-balance').textContent = formatEuro(creditCents());
        updatePreview();
      }

      function selectedCreditCents() {
        const euro = Number.parseFloat(String($('kb-redemption-euro')?.value || '0').replace(',', '.'));
        return Math.max(0, Math.round((Number.isFinite(euro) ? euro : 0) * CENTS_PER_EURO));
      }

      function updatePreview() {
        const book = bookById($('kb-redemption-book')?.value);
        const available = creditCents();
        const desired = selectedCreditCents();
        const maxCents = Math.min(book?.preisCents || 0, available);
        const usable = Math.min(desired, maxCents);
        const rest = Math.max(0, (book?.preisCents || 0) - usable);
        const xpEquivalent = usable * XP_PER_CENT;
        const preview = $('kb-redemption-preview');
        if (!preview || !book) return;
        if (available < 1) {
          preview.textContent = 'Noch kein einlösbares VAL-Guthaben sichtbar. XP kannst du auf der VAL-Seite in VAL umwandeln.';
          return;
        }
        const tooHigh = desired > maxCents ? ` · maximal aktuell ${formatEuro(maxCents)}` : '';
        preview.textContent = `${formatEuro(usable)} Rabatt = ${(usable / CENTS_PER_EURO).toLocaleString('de-DE', { maximumFractionDigits: 2 })} VAL · Restbetrag ${formatEuro(rest)}${tooHigh}`;
      }

      async function loadBalance(user) {
        try {
          const callable = getValusBalance();
          const result = await callable({});
          state.balance = normalizeBalance(result.data || {});
        } catch (error) {
          try {
            const [balanceSnap, userSnap] = await Promise.all([
              getDoc(doc(db, 'users', user.uid, 'balances', 'current')),
              getDoc(doc(db, 'users', user.uid)),
            ]);
            state.balance = normalizeBalance({
              balance: balanceSnap.exists() ? balanceSnap.data() : {},
              user: userSnap.exists() ? userSnap.data() : {},
            });
          } catch (fallbackError) {
            console.warn('Kinderbuch balance load failed', error, fallbackError);
            state.balance = { xp: 0, valus: 0 };
            setStatus('Guthaben konnte gerade nicht geladen werden. Bitte im Portal anmelden und erneut versuchen.', 'error');
          }
        }
        updateBalanceView();
      }

      function initAuth() {
        onAuthStateChanged(auth, async (user) => {
          state.user = user;
          if (!user) {
            show('kb-redeem-auth');
            return;
          }
          show('kb-redeem-dashboard');
          await loadBalance(user);
        });
      }

      $('kb-redemption-book')?.addEventListener('change', updatePreview);
      $('kb-redemption-euro')?.addEventListener('input', updatePreview);
      $('kb-redemption-full')?.addEventListener('click', () => {
        const book = bookById($('kb-redemption-book')?.value);
        const maxCents = Math.min(book?.preisCents || 0, creditCents());
        $('kb-redemption-euro').value = (maxCents / CENTS_PER_EURO).toFixed(2);
        updatePreview();
      });
      document.querySelectorAll('.kb-redeem-open').forEach((button) => {
        button.addEventListener('click', () => {
          const bookId = button.dataset.bookId;
          const select = $('kb-redemption-book');
          if (select && bookId) select.value = bookId;
          const book = bookById(bookId);
          const maxCents = Math.min(book?.preisCents || 0, creditCents() || book?.preisCents || 0);
          if ($('kb-redemption-euro')) $('kb-redemption-euro').value = (maxCents / CENTS_PER_EURO).toFixed(2);
          updatePreview();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      $('kb-redemption-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setStatus('');
        if (!state.user) {
          show('kb-redeem-auth');
          setStatus('Bitte zuerst im Portal anmelden.', 'error');
          return;
        }
        const book = bookById($('kb-redemption-book')?.value);
        const desired = selectedCreditCents();
        const maxCents = Math.min(book?.preisCents || 0, creditCents());
        const credit = Math.min(desired, maxCents);
        if (!book || credit < 1) {
          setStatus('Bitte ein Buch und einen einlösbaren Betrag auswählen.', 'error');
          return;
        }
        const button = $('kb-redemption-submit');
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        setStatus('Einlösecode wird erstellt...', 'pending');
        try {
          const callable = createKinderbuchRedemption();
          const result = await callable({ bookId: book.id, creditCents: credit });
          const data = result.data || {};
          const rest = formatEuro(data.remainingCents || 0);
          const checkoutUrl = data.checkoutUrl || data.book?.checkoutUrl;
          setStatus(`Rabattcode ${data.code} wurde erstellt (${formatEuro(data.creditCents || credit)} Rabatt, Restbetrag ${rest}). Der Code wird im Digistore24-Checkout automatisch angewendet. Dein XP/VAL-Guthaben wird erst nach bestätigtem Kauf abgebucht.`, 'ok');
          if (checkoutUrl) {
            setTimeout(() => {
              window.open(checkoutUrl, '_blank', 'noopener');
            }, 900);
          }
        } catch (error) {
          setStatus(error?.message || 'Einlösung konnte nicht erstellt werden.', 'error');
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });

      show('kb-redeem-loading');
      try {
        initAuth();
      } catch (error) {
        console.warn('Kinderbuch Firebase init failed', error);
        show('kb-redeem-auth');
        setStatus('Portal konnte gerade nicht geladen werden. Bitte später erneut versuchen.', 'error');
      }
    })();
  </script>
</BaseLayout>


---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Begleitseite zum Buch „Digitaler Nachlass für Angehörige“. Diese URL und der
// PDF-Pfad sind im Buch abgedruckt – beide dürfen nicht umziehen.
const pdf = '/downloads/digitaler-nachlass-vorlagen.pdf';
const stand = 'November 2026';

// Korrekturen und Aktualisierungen nach Erscheinen, neueste zuerst.
const updates = [];
---

<BaseLayout
  lang="de"
  title="Digitaler Nachlass für Angehörige: Vorlagen und Aktualisierungen"
  description="Begleitseite zum Buch „Digitaler Nachlass für Angehörige“ von Arnold Jedich: Vorlagen zum kostenlosen Herunterladen ohne Registrierung, Korrekturen und Aktualisierungen."
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow" data-reveal>Begleitseite zum Buch</p>
      <h1 data-reveal="2">Digitaler Nachlass für Angehörige</h1>
      <p class="lede" data-reveal="3">
        Hier findest du die Vorlagen aus dem Anhang zum Ausdrucken und alle Korrekturen und
        Aktualisierungen zum Buch. Ohne Anmeldung, ohne E-Mail-Adresse.
      </p>
    </div>
  </section>

  <section class="section band" id="vorlagen">
    <div class="container narrow">
      <h2 data-reveal>Vorlagen zum Herunterladen</h2>
      <p data-reveal="2">
        Das PDF enthält die Übersicht der wichtigen Daten, die Gesamtliste, das Kontaktprotokoll,
        die Geräteliste und die drei Musterschreiben. Alles im Querformat zum Ausdrucken.
      </p>
      <p data-reveal="2">
        <a class="button primary" href={pdf} download>Vorlagen als PDF herunterladen</a>
      </p>
      <p class="note" data-reveal="2">
        Schreib keine Passwörter, Wiederherstellungscodes oder Wiederherstellungswörter in die
        Vorlagen. Die Musterschreiben sind Vorschläge und keine Rechtsberatung.
      </p>
    </div>
  </section>

  <section class="section" id="aktualisierungen">
    <div class="container narrow">
      <h2 data-reveal>Korrekturen und Aktualisierungen</h2>
      <p data-reveal="2">
        Anbieter ändern ihre Abläufe, und auch in einem sorgfältig geprüften Buch können Fehler
        stecken. Was sich seit dem Druck geändert hat, steht hier.
      </p>
      {updates.length === 0 ? (
        <p data-reveal="2"><strong>Stand {stand}:</strong> Bisher gibt es keine Korrekturen.</p>
      ) : (
        <ul class="updates" data-reveal="2">
          {updates.map((u) => (
            <li><strong>{u.date}, {u.where}:</strong> {u.text}</li>
          ))}
        </ul>
      )}
      <p data-reveal="2">
        Du hast einen Fehler gefunden oder ein Anbieter arbeitet inzwischen anders? Schreib uns an
        <a href="mailto:info@callidus-am.de">info@callidus-am.de</a>.
      </p>
      <p class="note" data-reveal="2">
        Das Buch und diese Seite sind keine Rechtsberatung. Bei Fragen zu Erbe, Ausschlagung oder
        Streit wende dich an das Nachlassgericht, ein Notariat, eine Anwaltskanzlei oder die
        Verbraucherzentrale.
      </p>
    </div>
  </section>

  <style>
    .container.narrow { max-width: 760px; }
    .note { font-size: .95rem; opacity: .85; }
    .updates { display: grid; gap: .6rem; padding-left: 1.2rem; }
  </style>
</BaseLayout>

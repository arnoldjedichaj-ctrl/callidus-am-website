  <script is:inline>
    (() => {
      const COOKIE_KEY = 'callidus-cookie-consent';
      const setupVideoEmbeds = () => {
        document.querySelectorAll('[data-video-embed]').forEach((wrapper) => {
          if (wrapper.dataset.embedReady) return;
          wrapper.dataset.embedReady = 'true';
          const youtubeId = wrapper.dataset.youtubeId;
          const title = wrapper.dataset.title || 'Callidus Video';
          if (!youtubeId) return;

          const mount = () => {
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}`;
            iframe.title = title;
            iframe.loading = 'lazy';
            iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            iframe.allowFullscreen = true;
            wrapper.innerHTML = '';
            wrapper.append(iframe);
            wrapper.classList.add('is-loaded');
          };

          if (localStorage.getItem(COOKIE_KEY) === 'all') {
            mount();
            return;
          }

          wrapper.querySelector('[data-load-youtube]')?.addEventListener('click', () => {
            localStorage.setItem(COOKIE_KEY, 'all');
            document.documentElement.dataset.consent = 'all';
            window.dispatchEvent(new CustomEvent('callidus-consent', { detail: 'all' }));
            mount();
          });

          window.addEventListener('callidus-consent', (event) => {
            if (event.detail === 'all') mount();
          });
        });
      };
      setupVideoEmbeds();
      document.addEventListener('astro:page-load', setupVideoEmbeds);
    })();
  </script>
  {pageConversion && (
    <script is:inline define:vars={{ conv: pageConversion }}>
      (() => {
        // Feuert nur mit Einwilligung: ohne sie ist das Google-Tag gar nicht
        // geladen und Consent Mode steht auf "denied".
        const KEY = 'callidus-conversion-' + conv.id;
        const hasConsent = () =>
          localStorage.getItem('callidus-cookie-consent-v2') === 'all';
        const fire = () => {
          // Nicht feuern, solange gtag.js nicht geladen ist: der Aufruf landete
          // sonst nur in der Warteschlange, der Flag unten waere aber gesetzt
          // und die Conversion damit still verloren.
          if (!hasConsent() || !window.callidusGtagReady || typeof window.gtag !== 'function') return;
          // Einmal pro Sitzung. Die transaction_id laesst Google zusaetzlich
          // serverseitig entdoppeln, falls die Seite neu geladen wird.
          if (sessionStorage.getItem(KEY)) return;
          const transactionId =
            conv.id + '-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
          sessionStorage.setItem(KEY, transactionId);
          window.gtag('event', 'conversion', {
            send_to: conv.sendTo,
            value: conv.value,
            currency: conv.currency,
            transaction_id: transactionId,
          });
        };
        fire();
        // Wer erst auf dieser Seite zustimmt, wird ebenfalls gezaehlt - dann
        // aber erst, sobald das Google-Tag fertig geladen ist.
        window.addEventListener('callidus-gtag-ready', fire);
        window.addEventListener('callidus-consent', (event) => {
          if (event.detail === 'all') fire();
        });
      })();
    </script>
  )}
</BaseLayout>

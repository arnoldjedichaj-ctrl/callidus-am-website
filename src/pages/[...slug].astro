---
import BaseLayout from '../layouts/BaseLayout.astro';
import inventory from '../data/inventory.json';
import images from '../data/images.json';
import specialPages from '../data/special-pages.json';
import legalPages from '../data/legal-pages.json';
import articleSources from '../data/article-sources.json';
import knowledgeSources from '../data/knowledge-sources.json';
import videos from '../data/videos.json';
import structure from '../data/site-structure.json';
import { categoryForLang } from '../data/i18n.js';
import { allArticles, momusAll, appBadgeMeta } from '../data/all-articles.js';
import { audience, mission, vision, brandPromise } from '../data/positioning.js';
import { portalAppList } from '../data/portal.js';
import Faq from '../components/Faq.astro';
import { faqGroupsById, faqJsonLd } from '../data/faq.js';

// Welche FAQ-Gruppen unter welcher Seite erscheinen.
// /unsere-empfehlungen/ und /gesundheits-kompass/ haben eigene Seitendateien
// und binden den Faq-Block dort selbst ein.
const faqBySlug = {
  'nexus-app': ['nexus'],
  'uber-uns': ['allgemein'],
};

// Der frühere Import von articles.json ist jetzt durch allArticles ersetzt,
// damit auch Momus-Artikel als statische Seiten gebaut werden.
const articles = allArticles;

const imageMap = new Map(images.filter((item) => item.status === 'ok').map((item) => [item.url, item.localPath.replace('source/assets/original/', '/assets/original/')]));
const knowledgeSourceMap = new Map(knowledgeSources.map((source) => [source.id, source]));
const customSpecialPages = {
  'nexus-app': {
    slug: 'nexus-app',
    kind: 'product',
    title: 'NEXUS, MOMUS & KAIROS | Die Callidus Apps im Google Play Store',
    hero: 'NEXUS - Ihre persönliche Gesundheits-KI',
    lead: 'Schluss mit manuellem Tippen. NEXUS kombiniert moderne künstliche Intelligenz mit deinen Vitaldaten, damit du Ernährung, Training, Regeneration und Wohlbefinden wirklich verstehst.',
    blocks: [
      { type: 'heading', level: 2, text: 'Lernen Sie NEXUS kennen - Ihre persönliche Gesundheits-KI' },
      { type: 'paragraph', text: 'Die meisten Fitness-Apps sind lediglich stumme Datenspeicher. Sie zählen Schritte oder Kalorien, erklären dir aber nicht, was das bedeutet. Callidus ändert das.' },
      { type: 'paragraph', text: 'Im Zentrum unserer App steht NEXUS - eine fortschrittliche KI, die wie ein Expertenteam arbeitet und dir hilft, dich jeden Tag gesünder, fitter und glücklicher zu fühlen.' },
      { type: 'heading', level: 2, text: 'Das Herzstück: Ihr Expertenrat' },
      { type: 'paragraph', text: 'Auf Basis deiner Daten analysiert Nexus deine Situation täglich aus vier Perspektiven: Psychologie, Sportwissenschaft, Ernährung und Gesundheitsanalyse.' },
      { type: 'listItem', text: 'Der Psychologe behält dein mentales Gleichgewicht und deinen Stresspegel im Blick.' },
      { type: 'listItem', text: 'Der Sportwissenschaftler optimiert dein Training und deine Regeneration.' },
      { type: 'listItem', text: 'Der Ernährungsexperte prüft auf Nährstoffmängel und deine Stoffwechselgesundheit.' },
      { type: 'listItem', text: 'Der Gesundheitsanalyst erkennt Trends und warnt dich vor Burnout oder Übertraining.' },
      { type: 'heading', level: 2, text: 'Warum Callidus anders ist' },
      { type: 'heading', level: 3, text: 'Intelligente Fotoanalyse' },
      { type: 'paragraph', text: 'Schluss mit dem lästigen Tippen: Fotografiere einfach dein Essen. Die KI erkennt das Gericht, schätzt Kalorien und die wichtigsten Nährstoffe und gibt dir sofort Feedback.' },
      { type: 'heading', level: 3, text: 'KI-Koch und Rezeptgenerator' },
      { type: 'paragraph', text: 'Sag Nexus, was in deinem Kühlschrank ist. Der KI-Koch erstellt in Sekunden ein personalisiertes Rezept - inklusive Nährwertangaben, Zubereitungsschritten und Express-Option.' },
      { type: 'heading', level: 3, text: 'Dynamischer Wochenplan' },
      { type: 'paragraph', text: 'Nexus erstellt jede Woche einen neuen Plan: Erholungsmodus bei Stress, Leistungsmodus für volle Energie oder Stoffwechselbalance für Gewichtsverlust.' },
      { type: 'heading', level: 3, text: 'Professionelle PDF-Berichte' },
      { type: 'paragraph', text: 'Erstelle mit nur einem Klick Berichte zu Gesundheitstrends und Nährstoffaufnahme - hilfreich für Arzt, Trainer oder die eigene Übersicht.' },
      { type: 'heading', level: 2, text: 'Weitere Funktionen' },
      { type: 'paragraph', text: 'Gamifizierung, Motivation, Chat mit Nexus und eine Wissensbibliothek begleiten dich im Alltag. Deine Gesundheitsdaten dienen nur einem Zweck: dir zu helfen.' },
      { type: 'paragraph', text: 'Hör auf, Daten nur zu sammeln. Fang an, sie zu verstehen. Hol dir Nexus an deine Seite.' },
    ],
  },
  'uber-uns': {
    slug: 'uber-uns',
    kind: 'about',
    title: 'Über uns: Mission, Vision und wie wir arbeiten | callidus A&M',
    hero: 'Unsere Geschichte: Gesundheit als Herzensangelegenheit',
    lead: 'Herzlich willkommen bei callidus A&M. Wir sind Arnold und Margarita, die Gesichter und Herzen hinter diesem Projekt.',
    blocks: [
      { type: 'heading', level: 2, text: 'Unsere Geschichte: Gesundheit als Herzensangelegenheit' },
      { type: 'paragraph', text: 'Herzlich willkommen bei callidus A&M. Wir sind Arnold und Margarita, die Gesichter und Herzen hinter diesem Projekt.' },
      { type: 'paragraph', text: 'Unsere Reise begann nicht mit einem Geschäftsplan, sondern mit einer tiefen persönlichen Überzeugung: dass wahres Wohlbefinden in der Harmonie von Körper, Geist und Seele liegt.' },
      { type: 'paragraph', text: 'Seit über 5 Jahren beschäftigt sich Margarita intensiv mit Naturheilkunde, ganzheitlicher Ernährung und den kraftvollen Werkzeugen, die uns die Natur zur Verfügung stellt.' },
      { type: 'paragraph', text: 'Was als private Leidenschaft begann, um die Gesundheit unserer eigenen Familie zu stärken, wurde schnell zur Berufung. Immer wieder wurden wir im Freundes- und Bekanntenkreis um Rat gefragt und sahen, wie groß der Bedarf an verständlichen, ehrlichen und fundierten Informationen ist.' },
      { type: 'paragraph', text: 'Mit callidus A&M teilen wir dieses Wissen mit dir. Wir sind keine große Firma, sondern eine Familie, die fest daran glaubt, dass jeder die Kontrolle über seine Gesundheit selbst in die Hand nehmen kann.' },

      { type: 'heading', level: 2, text: 'Unsere Mission' },
      { type: 'paragraph', text: mission.statement },
      { type: 'paragraph', text: 'Das heißt konkret: keine Panikmache, keine Wunderversprechen und keine Zahlen, die wir nicht belegen können. Wenn eine Studienlage dünn ist, schreiben wir das hin, statt sie größer klingen zu lassen, als sie ist.' },

      { type: 'heading', level: 2, text: 'Unsere Vision' },
      { type: 'paragraph', text: vision.statement },
      { type: 'paragraph', text: 'Genau deshalb wächst Callidus in mehrere Richtungen gleichzeitig: Der Ratgeber liefert das Wissen, der Gesundheits-Kompass ordnet deine Situation ein, die Apps begleiten dich im Alltag und das Portal führt beides zusammen. Es ist ein Vorhaben, kein Sammelsurium.' },

      { type: 'heading', level: 2, text: 'Für wen wir schreiben' },
      { type: 'paragraph', text: audience.summary },
      { type: 'paragraph', text: 'Du bist bei uns richtig, wenn:' },
      ...audience.fits.map((text) => ({ type: 'listItem', text })),
      { type: 'paragraph', text: 'Wir sind ehrlicherweise nicht die richtige Adresse, wenn:' },
      ...audience.fitsNot.map((text) => ({ type: 'listItem', text })),

      { type: 'heading', level: 2, text: 'Unsere Philosophie: von uns selbst geprüft' },
      { type: 'paragraph', text: 'Jedes Produkt, das du in unseren Empfehlungen findest, und jeder Ratschlag in unserem Ratgeber hat einen einfachen Ursprung: Wir nutzen und leben es selbst.' },
      { type: 'paragraph', text: 'Wir bieten nur an, was uns persönlich überzeugt hat und was den höchsten Qualitäts- und BIO-Standards entspricht. Kein Hersteller kann sich bei uns in eine Empfehlung einkaufen.' },
      { type: 'paragraph', text: 'Unser Ziel ist es, dein vertrauenswürdiger Kompass in der oft unübersichtlichen Welt der Gesundheitsprodukte zu sein. Wir freuen uns, dich auf deinem Weg zu mehr Wohlbefinden zu begleiten.' },

      { type: 'heading', level: 2, text: 'Wie wir Inhalte prüfen' },
      { type: 'paragraph', text: 'Gesundheit braucht Vertrauen. Deshalb trennen wir persönliche Erfahrung, redaktionelle Einordnung, Quellenlage und Produktempfehlung sichtbar voneinander.' },
      { type: 'listItem', text: 'Wir bevorzugen Quellen von Fachgesellschaften, Behörden, wissenschaftlichen Reviews und transparenten Datenbanken.' },
      { type: 'listItem', text: 'Wir kennzeichnen Grenzen klar: Callidus ersetzt keine Diagnose, keine Therapie und keine individuelle medizinische Beratung.' },
      { type: 'listItem', text: 'Empfehlungen werden nicht nur nach Nutzen, sondern auch nach Alltagstauglichkeit, Risiko, Preis und Transparenz eingeordnet.' },
      { type: 'listItem', text: 'Affiliate-Links kennzeichnen wir mit einem Sternchen. Kaufst du darüber, ändert sich für dich am Preis nichts.' },

      { type: 'heading', level: 2, text: 'Wofür wir stehen' },
      ...brandPromise.pillars.map((pillar) => ({ type: 'listItem', text: `${pillar.title}: ${pillar.text}` })),

      { type: 'heading', level: 2, text: 'Warum du uns vertrauen kannst' },
      { type: 'paragraph', text: 'Callidus A&M verbindet praktische Naturheilkunde-Erfahrung, digitale Gesundheitsbegleitung und eine konsequente Quellen-Methodik. Unser Anspruch ist nicht Lautstärke, sondern nachvollziehbare Orientierung.' },
      { type: 'paragraph', text: 'Offene Fragen? Die häufigsten beantworten wir gesammelt auf unserer FAQ-Seite. Alles andere gern direkt an info@callidus-am.de.' },
      { type: 'paragraph', text: 'Herzlichst, Arnold & Margarita' },
    ],
  },
};

export function getStaticPaths() {
  const pathForStatic = (page) => new URL(page.url).pathname;
  const nexusPaths = inventory
    .filter((page) => page.slug !== 'home' && page.status === 'ok' && pathForStatic(page) !== '/ratgeber/')
    .filter((page) => !pathForStatic(page).startsWith('/unsere-empfehlungen/'))
    .map((page) => ({
      params: { slug: pathForStatic(page).replace(/^\//, '').replace(/\/$/, '') },
      props: { page },
    }));

  const legalPaths = legalPages.map((page) => ({
    params: { slug: page.slug },
    props: {
      page: {
        slug: page.slug,
        url: page.originalUrl || `https://www.callidus-am.de/${page.slug}/`,
        title: page.title,
        description: page.lead || '',
        status: 'ok',
        h1: [page.title],
        h2: page.sections?.map((section) => section.heading).filter(Boolean) || [],
        images: ['https://www.callidus-am.de/wp-content/uploads/go-x/u/bdfcc883-6576-4ab2-951d-c90c6ccf47d3/image-911x911.png'],
        imageCount: 1,
      },
    },
  }));

  // Momus-Artikel als eigene statische Routen
  const momusPaths = momusAll.map((article) => ({
    params: { slug: article.slug },
    props: {
      page: {
        slug: article.slug,
        url: `https://www.callidus-am.de${article.path}`,
        title: article.title,
        description: article.description,
        status: 'ok',
        h1: [],
        h2: [],
        images: article.image ? [article.image] : [],
        imageCount: article.image ? 1 : 0,
      },
    },
  }));

  // Falls ein Momus-Slug zufaellig mit einem Nexus-Slug kollidiert, gewinnt Nexus
  const nexusSlugs = new Set(nexusPaths.map((p) => p.params.slug));
  const filteredLegal = legalPaths.filter((p) => !nexusSlugs.has(p.params.slug));
  const primarySlugs = new Set([...nexusSlugs, ...filteredLegal.map((p) => p.params.slug)]);
  const filteredMomus = momusPaths.filter((p) => !nexusSlugs.has(p.params.slug));

  // Der Stress-Reset-Kurs hat eigene Seiten (src/pages/stress-reset-kurs.astro usw.).
  const ownPageSlugs = new Set(['stress-reset-kurs', 'reset-hub', 'kurs-mitgliederbereich', 'modul-4', 'modul-5']);
  return [...nexusPaths, ...filteredLegal, ...filteredMomus.filter((p) => !primarySlugs.has(p.params.slug))]
    .filter((p) => !ownPageSlugs.has(p.params.slug));
}

const { page } = Astro.props;
const article = articles.find((item) => item.slug === page.slug);
const articleVideos = article
  ? videos.filter((video) => video.status !== 'hidden' && (video.relatedArticleSlugs || []).includes(article.slug))
  : [];
const articleSourceEntries = article
  ? (articleSources[article.slug] || [])
      .map((entry) => {
        const source = knowledgeSourceMap.get(entry.sourceId);
        return source ? { ...source, ...entry } : null;
      })
      .filter(Boolean)
  : [];
const formatArticleDate = (value) => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) return null;
  return new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' }).format(date);
};
const articlePublishedAt = article?.publishedAt || undefined;
const articleModifiedAt = article?.updatedAt || articlePublishedAt;
const articleUpdatedLabel = formatArticleDate(articleModifiedAt) || 'Kein belegtes Datum';
const specialPage = specialPages.find((item) => item.slug === page.slug) || customSpecialPages[page.slug];
const legalPage = legalPages.find((item) => item.slug === page.slug);
const noindexSlugs = new Set([
  'bitte-bestaetigen',
  'download',
]);
const pageRobots = noindexSlugs.has(page.slug) ? 'noindex, follow' : undefined;
const pageFaqGroups = faqGroupsById(...(faqBySlug[page.slug] || []));

// Google-Ads-Conversions: Slug -> Ereignis. Bewusst als Tabelle, damit sich
// die Zielseite aendern laesst, ohne im Markup zu suchen.
// Beide Seiten sind der Moment "Lead-Formular gesendet", je nachdem wohin das
// Brevo-Formular zurueckleitet: "download" nutzt das Vitamin-Kompendium-Formular,
// "bitte-bestaetigen" die uebrigen. Gleiche id und gleiches sendTo bedeuten:
// Wer in einer Sitzung beide Seiten sieht, wird trotzdem nur einmal gezaehlt.
const leadConversion = {
  id: 'lead-formular',
  sendTo: 'AW-17709649802/SZtyCIGa9uYcEIqfz_xB',
  value: 1.0,
  currency: 'EUR',
};
const conversionPages = {
  'bitte-bestaetigen': leadConversion,
  download: leadConversion,
};
const pageConversion = conversionPages[page.slug] || null;
const categoryRedirect = structure.categories.find((item) => new URL(page.url).pathname === item.legacyPath);
const categoryRedirectPath = categoryRedirect ? `/ratgeber/#${categoryRedirect.slug}` : null;
const title = categoryRedirect?.title || legalPage?.title || specialPage?.title || page.title || page.h1?.[0] || 'callidus A&M';
// SEO-Titel/-Description nur für <head> und JSON-LD; die sichtbare H1 und der Lead bleiben unverändert.
const seoTitle = article?.seoTitle || title;
// Sichtbare H1 ohne den Marken-Suffix aus dem Title-Tag.
const displayTitle = title.replace(/\s*\|\s*callidus A&M\s*$/i, '');
const seoDescription = article?.seoDescription || page.description || article?.description || 'callidus A&M';
const heroLead = legalPage?.lead || (specialPage?.kind === 'lexicon' ? '' : specialPage?.lead) || page.description;
const aboutImage = page.slug === 'uber-uns' ? '/assets/media/about/arnold-margarita-callidus-v3.png' : null;
const mainImage = aboutImage || article?.image || (page.slug === 'nexus-app' ? imageMap.get(page.images?.[1]) : null) || imageMap.get(page.images?.[1]) || imageMap.get(page.images?.[0]);
const sectionEyebrow = article
  ? `${article.readingTime} Min. Lesezeit`
  : categoryRedirect
    ? 'Ratgeber'
    : legalPage
    ? 'Rechtliches'
    : specialPage?.kind === 'lexicon'
      ? 'Lexicon Vitae'
      : specialPage?.kind === 'product'
        ? 'NEXUS'
        : specialPage?.kind === 'about'
          ? 'Über uns'
          : specialPage
            ? 'callidus Bereich'
            : 'Migration Preview';
const headings = article?.blocks?.filter((block) => block.type === 'heading').slice(0, 8) || [];
const slugify = (value) => value.toLowerCase().replace(/[^a-z0-9äöüß]+/gi, '-').replace(/^-|-$/g, '');
const categorize = (item) => {
  if (item.category) {
    const direct = structure.categories.find((category) => category.slug === item.category);
    if (direct) return direct;
  }
  const haystack = `${item.slug || ''} ${item.title || ''} ${item.description || ''} ${(item.h2 || []).join(' ')}`.toLowerCase();
  return structure.categories.find((category) => category.keywords.some((keyword) => haystack.includes(keyword))) || structure.categories[0];
};
const rawCategory = article ? categorize(article) : null;
const category = rawCategory ? categoryForLang(rawCategory, 'de') : null;
const related = article && rawCategory
  ? articles.filter((item) => item.slug !== article.slug && categorize(item).slug === rawCategory.slug).slice(0, 3)
  : [];
const articleBridgeLinks = article
  ? [
      {
        label: 'Kompass',
        title: 'Gesundheits-Kompass starten',
        text: 'Fokus finden und passende Inhalte direkt öffnen.',
        href: '/gesundheits-kompass/',
      },
      {
        label: 'Check',
        title: 'Health IQ oder Radar',
        text: 'Stress, Mikronährstoffe oder Wissen genauer prüfen.',
        href: '/gesundheits-checks/',
      },
      {
        label: 'Portal',
        title: 'Im Portal weiterführen',
        text: 'Verlauf, App-Daten und Coach nach Anmeldung verbinden.',
        href: '/portal/',
      },
      {
        label: 'Wissen',
        title: category ? `${category.title} vertiefen` : 'Wissenskarten ansehen',
        text: 'Passende Karten, Quellen und Empfehlungen ansehen.',
        href: rawCategory ? `/ratgeber/#${rawCategory.slug}` : '/wissenskarten/',
      },
    ]
  : [];
const videoSourceLabel = (count) => `${count} ${count === 1 ? 'Studie' : 'Studien'}`;
const baseSpecialLinks = specialPage?.links?.filter((link) => link.label && link.href) || [];
const specialLinks = baseSpecialLinks;
const displaySpecialLinks = specialLinks;
const resourceTypeLabel = (link) => {
  if (link.type === 'video' || link.href?.includes('youtube.com')) return 'Video';
  if (link.href?.includes('sibforms.com')) return 'Brevo';
  if (link.download) return 'PDF';
  return link.external ? 'Extern' : 'Weiter';
};
const resourceClass = (link) => [
  'resource-link',
  link.external ? 'external' : '',
  link.type === 'video' || link.href?.includes('youtube.com') ? 'video' : '',
].filter(Boolean).join(' ');
const resourceRel = (link) => {
  if (!link.external) return undefined;
  return link.type === 'video' || link.href?.includes('youtube.com') ? 'noopener' : 'sponsored nofollow noopener';
};
const inlineHtml = (value = '') => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/~~([^~]+)~~/g, '<s>$1</s>');
const lexiconIntro = specialPage?.kind === 'lexicon'
  ? specialPage.blocks.filter((block) => block.type === 'paragraph').slice(0, 3)
  : [];
const lexiconSource = specialPages.find((item) => item.kind === 'lexicon');
const lexiconEntries = lexiconSource?.lexiconEntries || [];
const textForMatch = (item) => [
  item?.title,
  item?.hero,
  item?.lead,
  item?.description,
  ...(item?.blocks || []).map((block) => block.text || ''),
].join(' ').toLowerCase();
const lexiconSlug = (entry) => `/lexicon-vitae/#${slugify(entry.term)}`;
const articleLexiconRefs = article
  ? lexiconEntries.filter((entry) => textForMatch(article).includes(entry.term.toLowerCase())).slice(0, 8)
  : [];
const specialLexiconRefs = specialPage && specialPage.kind !== 'lexicon'
  ? lexiconEntries.filter((entry) => textForMatch(specialPage).includes(entry.term.toLowerCase())).slice(0, 8)
  : [];
const lexiconGroups = specialPage?.kind === 'lexicon'
  ? Object.entries(
      (specialPage.lexiconEntries || []).reduce((groups, entry) => {
        const letter = entry.term.charAt(0).toUpperCase();
        groups[letter] = groups[letter] || [];
        groups[letter].push(entry);
        return groups;
      }, {})
    ).sort(([a], [b]) => a.localeCompare(b, 'de'))
  : [];
const lexiconUsage = specialPage?.kind === 'lexicon'
  ? new Map((specialPage.lexiconEntries || []).map((entry) => [
      entry.term,
      [
        ...articles
          .filter((item) => textForMatch(item).includes(entry.term.toLowerCase()))
          .slice(0, 4)
          .map((item) => ({ title: item.title, path: item.path })),
        ...specialPages
          .filter((item) => item.slug !== 'lexicon-vitae' && textForMatch(item).includes(entry.term.toLowerCase()))
          .slice(0, 3)
          .map((item) => ({ title: item.hero || item.title, path: item.path })),
      ],
    ]))
  : new Map();
const specialBlockClass = (block) => {
  const text = block.text || '';
  if (specialPage?.kind !== 'course') return block.type === 'listItem' ? 'special-list-item' : '';
  if (/^Der 5-|^JETZT DAS|^Jetzt starten/.test(text)) return 'course-callout';
  if (/^\d+\./.test(text) || /^Tag \d/.test(text)) return 'course-step';
  if (/^â€¢|^•/.test(text)) return 'special-list-item course-benefit';
  if (/RegulÃ¤rer Wert|Ihr persÃ¶nliches|Regulärer Wert|Ihr persönliches/.test(text)) return 'course-price';
  if (/Wichtiger Hinweis|Hinweis zur Darstellung/.test(text)) return 'course-note';
  return '';
};
const articleUrl = new URL(page.path || `/${page.slug}/`, 'https://www.callidus-am.de').href;
const articleJsonLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${articleUrl}#article`,
  headline: seoTitle,
  description: seoDescription,
  url: articleUrl,
  image: mainImage ? new URL(mainImage, 'https://www.callidus-am.de').href : undefined,
  citation: articleSourceEntries.length ? articleSourceEntries.map((source) => source.url) : undefined,
  inLanguage: 'de-DE',
  datePublished: articlePublishedAt,
  dateModified: articleModifiedAt,
  author: { '@id': 'https://www.callidus-am.de/#organization', name: 'callidus A&M' },
  publisher: {
    '@id': 'https://www.callidus-am.de/#organization',
    name: 'callidus A&M',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
} : null;
---
<BaseLayout
  lang="de"
  alternatePath={article && article.app === 'momus' && Array.isArray(article.blocksEn) && article.blocksEn.length > 0
    ? `/en/guide/${article.slug}/`
    : undefined}
  title={seoTitle}
  description={seoDescription}
  ogImage={mainImage}
  pageType={article ? 'article' : 'website'}
  publishedTime={articlePublishedAt}
  modifiedTime={articleModifiedAt}
  robots={pageRobots}
  jsonLd={pageFaqGroups.length > 0 ? faqJsonLd(pageFaqGroups) : undefined}
>
  {articleJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
  )}
  <section class="section">
    <article class="article-shell">
      <div class="article-hero">
        <p class="eyebrow">{sectionEyebrow}</p>
        {article?.app && (
          <span class={appBadgeMeta(article.app).className} aria-label={`App: ${appBadgeMeta(article.app).label}`}>{appBadgeMeta(article.app).label}</span>
        )}
        <h1>{specialPage?.hero || displayTitle}</h1>
        {heroLead && <p class="lede">{heroLead}</p>}
        {article?.app === 'momus' && (
          <div class="notice momus-satire-notice" role="note">
            <strong>Satire:</strong>
